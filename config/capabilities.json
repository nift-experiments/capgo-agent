{
  "version": 1,
  "providerBaseEnvironment": "CAPGO_PROVIDER_URL",
  "serverTokenEnvironment": "CAPGO_PROVIDER_TOKEN",
  "baselineMode": "snapshot",
  "endpoints": {
    "plans": {
      "method": "GET",
      "path": "/api/plans",
      "upstreamPath": "/private/plans",
      "fallback": "recorded public snapshot"
    },
    "credits": {
      "method": "GET",
      "path": "/api/credits",
      "upstreamPath": "/private/credits",
      "fallback": "recorded public snapshot"
    },
    "metrics": {
      "method": "GET",
      "path": "/api/metrics",
      "upstreamPath": "/private/website_stats",
      "fallback": "explicit unavailable unless snapshot supplied"
    },
    "rankings": {
      "method": "GET",
      "path": "/api/rankings",
      "upstreamPath": "/private/store_top",
      "fallback": "explicit unavailable unless snapshot supplied"
    },
    "contact": {
      "method": "POST",
      "path": "/api/contact",
      "upstreamPath": "/contact",
      "fallback": "setup required; never claim a message was sent"
    },
    "registration": {
      "method": "external",
      "path": "https://console.capgo.app/register",
      "fallback": "configured provider signup URL"
    },
    "udid": {
      "method": "external",
      "path": "https://capgo.app/tools/ios-udid-finder/",
      "fallback": "requires deployed signed device-profile workflow; not a local device-identification claim"
    },
    "liveUpdateMetrics": {
      "method": "GET",
      "path": "/live-update-metrics.json",
      "upstreamPath": "/live-update-metrics.json",
      "schema": "object",
      "fallback": "setup required; compatible own provider required"
    },
    "builderMetrics": {
      "method": "GET",
      "path": "/builder-metrics.json",
      "upstreamPath": "/builder-metrics.json",
      "schema": "object",
      "fallback": "setup required; compatible own provider required"
    },
    "creditCalculation": {
      "method": "POST",
      "path": "/private/credits",
      "upstreamPath": "/private/credits",
      "schema": "creditCost",
      "fallback": "setup required; compatible own provider required"
    },
    "iosCertificate": {
      "method": "POST",
      "path": "/api/tools/ios-certificate-generator",
      "upstreamPath": "/api/tools/ios-certificate-generator",
      "schema": "generatedFiles",
      "fallback": "setup required; compatible own provider required"
    },
    "androidKeystore": {
      "method": "POST",
      "path": "/api/tools/android-keystore-generator",
      "upstreamPath": "/api/tools/android-keystore-generator",
      "schema": "generatedFiles",
      "fallback": "setup required; compatible own provider required"
    }
  },
  "rules": [
    "browser receives no server token",
    "same-origin runtime API; server allowlisted endpoint paths",
    "live mode never silently substitutes snapshots",
    "baseline build never fetches live APIs",
    "validate response schemas and timeout/error states",
    "private account console and unfrozen translation excluded"
  ]
}
