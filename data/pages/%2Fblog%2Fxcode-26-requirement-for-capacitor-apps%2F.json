  "metadata": {
    "slug": "xcode-26-requirement-for-capacitor-apps",
    "title": "Apple's Xcode 26 Requirement for Capacitor Apps",
    "description": "Apple now requires Xcode 26 and the iOS 26 SDK for App Store Connect submissions. Here is what changed for Capacitor teams and why Capgo Build users are already covered.",
    "author": "Martin Donadieu",
    "author_image_url": "https://avatars.githubusercontent.com/u/4084527?v=4",
    "author_url": "https://github.com/riderx",
    "created_at": "2026-04-29 09:30:00+00:00",
    "updated_at": "2026-08-27 16:41:24+00:00",
    "head_image": "/build_list.webp",
    "head_image_alt": "Apple's Xcode 26 Requirement for Capacitor Apps Capgo blog illustration",
    "keywords": "Apple, Xcode 26, iOS 26 SDK, Capacitor, App Store Connect, Capgo Build, cloud builds",
    "tag": "Development, Mobile, Cloud",
    "published": true,
    "locale": "en",
    "origin": "human",
    "next_blog": ""
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "Starting April 28, 2026, Apple requires every app and app update uploaded to App Store Connect to be built with Xcode 26 or later, using the iOS 26 SDK or the matching 26 SDKs for iPadOS, tvOS, visionOS, and watchOS. If you ship a Capacitor app, this is the deadline that matters."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "The good news: for most teams, this is a build environment change, not a full app migration. And if you already use "
        },
        {
          "type": "link",
          "location": {
            "line": 4,
            "column": 117
          },
          "url": "/native-build/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 4,
                "column": 118
              },
              "text": "Capgo Build"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 146
          },
          "text": ", your iOS build system is already on Xcode 26."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "What Apple Changed"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "Apple published the requirement in its "
        },
        {
          "type": "link",
          "location": {
            "line": 8,
            "column": 40
          },
          "url": "https://developer.apple.com/news/upcoming-requirements/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 8,
                "column": 41
              },
              "text": "Upcoming Requirements"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 120
          },
          "text": " page and repeats it on the "
        },
        {
          "type": "link",
          "location": {
            "line": 8,
            "column": 148
          },
          "url": "https://developer.apple.com/ios/submit/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 8,
                "column": 149
              },
              "text": "App Store submission"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 211
          },
          "text": " page."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Starting on "
        },
        {
          "type": "strong",
          "location": {
            "line": 10,
            "column": 13
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 10,
                "column": 15
              },
              "text": "April 28, 2026"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 31
          },
          "text": ", App Store Connect no longer accepts uploads built with Xcode earlier than 26 or without the required 26 SDKs. Existing apps already live on the App Store keep working, but the next binary you submit must come from the new toolchain."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 12,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 4
          },
          "text": "What It Means for Capacitor Teams"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 14,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 1
          },
          "text": "For most Capacitor apps, this is mainly about how you build the app, not about replacing Capacitor or rewriting your project."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "Ensure every build path uses Xcode 26 or later:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 18,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 18,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 18,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 18,
                    "column": 3
                  },
                  "text": "Local Mac builds: install and select Xcode 26 or later."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 19,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 19,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 19,
                    "column": 3
                  },
                  "text": "Self-managed CI: use a macOS runner image with Xcode 26 or later."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 20,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 20,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 20,
                    "column": 3
                  },
                  "text": "Native dependencies and older plugins: rebuild on the new SDK and test a fresh archive before your next release."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 22,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 1
          },
          "text": "The failure mode here is simple: everything may still work in development, but App Store Connect will block the upload if the build came from an older Xcode line."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 24,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 4
          },
          "text": "Capgo Build Is Already on Xcode 26"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 26,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 1
          },
          "text": "If you build with "
        },
        {
          "type": "link",
          "location": {
            "line": 26,
            "column": 19
          },
          "url": "/native-build/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 26,
                "column": 20
              },
              "text": "Capgo Build"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 48
          },
          "text": ", you do not need to scramble to update your build environment for this Apple deadline. As of April 29, 2026, our current iOS build system is already running on Xcode 26 or later through "
        },
        {
          "type": "link",
          "location": {
            "line": 26,
            "column": 235
          },
          "url": "/native-build/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 26,
                "column": 236
              },
              "text": "Capgo Build"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 264
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 28,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 1
          },
          "text": "That means teams using Capgo Build are already aligned with Apple's April 28, 2026 submission requirement. No local Mac refresh, no runner image hunt, and no last-minute Xcode upgrade just to keep shipping."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 30,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 4
          },
          "text": "When You Still Need to Act"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 32,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 1
          },
          "text": "You still need to make changes if any of these apply:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 34,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 34,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 34,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 34,
                    "column": 3
                  },
                  "text": "You build and archive iOS apps locally and have not moved to Xcode 26 or later yet."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 35,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 35,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 35,
                    "column": 3
                  },
                  "text": "Your self-managed CI pipeline is pinned to an older Xcode image than Xcode 26."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 36,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 36,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 36,
                    "column": 3
                  },
                  "text": "One of your native SDKs or plugins has trouble when rebuilt with the iOS 26 SDK."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 38,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 1
          },
          "text": "If that is your setup, update the toolchain first, then run a clean build and a TestFlight submission before planning a production release."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 40,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 4
          },
          "text": "Final Take"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 42,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 1
          },
          "text": "This is Apple’s normal yearly toolchain cutoff, but the enforcement date is real: "
        },
        {
          "type": "strong",
          "location": {
            "line": 42,
            "column": 83
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 42,
                "column": 85
              },
              "text": "since April 28, 2026"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 107
          },
          "text": ", older Xcode builds are no longer enough for App Store uploads."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "If you use Capgo Build, you are already on Xcode 26 or later. If you build elsewhere, update your environment to Xcode 26 or later before your next iOS release."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 46,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 4
          },
          "text": "Keep going from Apple's Xcode 26 Requirement for Capacitor Apps"
        }
      ]
    },
