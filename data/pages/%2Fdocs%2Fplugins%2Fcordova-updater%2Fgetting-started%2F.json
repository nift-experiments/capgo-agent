                    "line": 20,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 20,
                        "column": 4
                      },
                      "text": "Install the plugin from npm and pass your Capgo app ID:"
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 22,
                    "column": 4
                  },
                  "lang": "bash",
                  "meta": null,
                  "text": "cordova plugin add @capgo/cordova-updater --variable APP_ID=YOUR_CAPGO_APP_ID"
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 26,
                "column": 1
              },
              "spread": true,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 26,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 26,
                        "column": 4
                      },
                      "text": "Optional: override defaults at install time (same variables as the Capacitor updater):"
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 28,
                    "column": 4
                  },
                  "lang": "bash",
                  "meta": null,
                  "text": "cordova plugin add @capgo/cordova-updater \\\n  --variable APP_ID=YOUR_CAPGO_APP_ID \\\n  --variable DEFAULT_CHANNEL=production \\\n  --variable UPDATE_URL=https://plugin.capgo.app/updates \\\n  --variable AUTO_UPDATE=atBackground"
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 36,
                "column": 1
              },
              "spread": true,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 36,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 36,
                        "column": 4
                      },
                      "text": "Prepare native projects after changing plugin variables:"
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 38,
                    "column": 4
                  },
                  "lang": "bash",
                  "meta": null,
                  "text": "cordova prepare android ios"
                }
              ]
            }
          ]
        }
