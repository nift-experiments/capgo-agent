              "type": "text",
              "location": {
                "line": 7,
                "column": 3
              },
              "text": "Do "
            },
            {
              "type": "strong",
              "location": {
                "line": 7,
                "column": 6
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 7,
                    "column": 8
                  },
                  "text": "not"
                }
              ]
            },
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 13
              },
              "text": " use "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 7,
                "column": 18
              },
              "text": "cordova-plugin-ionic-webview"
            },
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 48
              },
              "text": " with this plugin. Ionic WebView bypasses Cordova's scheme handlers, so downloaded bundles will not load."
            }
          ]
        }
