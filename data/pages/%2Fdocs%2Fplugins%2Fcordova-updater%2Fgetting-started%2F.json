          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 48,
        "column": 1
      },
      "lang": "javascript",
      "meta": null,
      "text": "document.addEventListener('deviceready', async () => {\n  const { Updater } = cordova.plugins;\n\n  await Updater.notifyAppReady();\n\n  const latest = await Updater.getLatest();\n  if (latest.url && !latest.error) {\n    const bundle = await Updater.download({\n      url: latest.url,\n      version: latest.version,\n      checksum: latest.checksum,\n    });\n\n    await Updater.next({ id: bundle.id });\n  }\n});"
    },
    {
