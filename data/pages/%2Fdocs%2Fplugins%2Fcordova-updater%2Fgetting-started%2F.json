          "type": "inlineCode",
          "location": {
            "line": 46,
            "column": 7
          },
          "text": "deviceready"
        },
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 20
          },
          "text": ", the plugin is available as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 46,
            "column": 49
          },
          "text": "cordova.plugins.Updater"
        },
        {
          "type": "text",
          "location": {
            "line": 46,
