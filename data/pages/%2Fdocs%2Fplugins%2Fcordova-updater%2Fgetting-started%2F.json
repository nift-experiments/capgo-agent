      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "This guide walks you through adding "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 37
          },
          "text": "@capgo/cordova-updater"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 61
          },
          "text": " to a Cordova app so you can receive Capgo live updates on iOS and Android."
        }
      ]
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {
        "type": "caution"
