    {
      "type": "heading",
      "location": {
        "line": 127,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 127,
            "column": 4
          },
          "text": "Important iOS note"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 129,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 129,
            "column": 1
          },
          "text": "On iOS 17.4 and newer, the plugin uses the browser-style client-data API so the configured HTTPS origin is reflected in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 129,
            "column": 121
          },
          "text": "clientDataJSON"
        },
        {
          "type": "text",
          "location": {
            "line": 129,
            "column": 137
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 131,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 131,
            "column": 4
          },
          "text": "Important Android caveat"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 133,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 133,
            "column": 1
          },
          "text": "Android Credential Manager can share the same relying party and passkeys as your website when Digital Asset Links are configured, but the native assertion origin is not identical to a browser origin. If your backend strictly validates "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 133,
            "column": 236
          },
          "text": "clientDataJSON.origin"
        },
        {
          "type": "text",
          "location": {
            "line": 133,
            "column": 259
          },
          "text": ", make sure it accepts the Android app origin alongside your website origin."
        }
      ]
    },
