      ]
    },
    {
      "type": "code",
      "location": {
        "line": 46,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const map = await NativeMap.create({\n  id: 'stores-map',\n  toBack: true,\n  apiKey: 'YOUR_GOOGLE_MAPS_API_KEY',\n  config: {\n    center: { lat: 40.7128, lng: -74.006 },\n    zoom: 11,\n    x: 0,\n    y: 0,\n    width: window.innerWidth,\n    height: window.innerHeight,\n  },\n});\n\nawait map.updateLayout({\n  x: 0,\n  y: 0,\n  width: window.innerWidth,\n  height: window.innerHeight,\n});"
    },
