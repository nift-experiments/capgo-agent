      "lang": "typescript",
      "meta": null,
      "text": "import { SavePassword } from '@capgo/capacitor-autofill-save-password';\n\nawait SavePassword.promptDialog({\n  username: 'your-username',\n  password: 'your-password'\n});"
    },
