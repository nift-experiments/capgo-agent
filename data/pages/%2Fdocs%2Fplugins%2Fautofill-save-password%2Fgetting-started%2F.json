          "type": "text",
          "location": {
            "line": 46,
            "column": 1
          },
          "text": "Read a password from the keychain. Requires the developer to setup associated domain for the app for iOS."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 48,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { SavePassword } from '@capgo/capacitor-autofill-save-password';\n\nconst result = await SavePassword.readPassword();\n// The result holds sensitive values: use it without logging it."
