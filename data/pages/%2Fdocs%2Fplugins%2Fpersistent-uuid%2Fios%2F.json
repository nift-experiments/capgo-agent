  "metadata": {
    "title": "iOS Behavior",
    "description": "How @capgo/capacitor-persistent-uuid persists identifiers on iOS.",
    "sidebar": {
      "order": 4
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Storage Model"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "On iOS, the plugin stores the UUID in Keychain as a generic password item. The item is device-only and uses the bundle identifier as the default scope."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "This survives app updates and iOS updates. It also survives reinstall flows as long as iOS keeps the Keychain item and the app keeps compatible Keychain access through the same bundle and Apple team rules."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 8,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 4
          },
          "text": "Stable Scope Rules"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Use the default scope when the bundle identifier is stable."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await PersistentUuid.getId();"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "Use a custom scope when multiple build variants should resolve to one app identifier."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await PersistentUuid.getId({ scope: 'com.example.app' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 22,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 4
          },
          "text": "Limits"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 24,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 1
          },
          "text": "The UUID can be lost if the user erases the device, Keychain data is cleared, Keychain access changes, the bundle/team access changes, or the app calls resetId."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 26,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 4
          },
          "text": "Keep going from iOS Behavior"
        }
      ]
    },
    {
