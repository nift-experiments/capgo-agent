  "metadata": {
    "title": "Troubleshooting",
    "description": "Fix common @capgo/capacitor-social-login setup issues from the plugin README.",
    "sidebar": {
      "order": 6
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Invalid Privacy Manifest (ITMS-91056)"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "If App Store Connect reports this error:"
        }
      ]
    },
    {
      "type": "blockquote",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 6,
            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 6,
                "column": 3
              },
              "text": "ITMS-91056: Invalid privacy manifest - The PrivacyInfo.xcprivacy file from the following path is invalid: ..."
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "Check your app-level "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 8,
            "column": 22
          },
          "text": "PrivacyInfo.xcprivacy"
        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 45
          },
          "text": " file:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 10,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 10,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 10,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 10,
                    "column": 3
                  },
                  "text": "The file must be valid JSON."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 11,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 11,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 11,
                    "column": 3
                  },
                  "text": "Use only Apple-documented keys and values."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 12,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 12,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 12,
                    "column": 3
                  },
                  "text": "Do not add a privacy manifest to the plugin package; add it to your app."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 14,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 1
          },
          "text": "See "
        },
        {
          "type": "link",
          "location": {
            "line": 14,
            "column": 5
          },
          "url": "/docs/plugins/social-login/privacy-and-ios-handlers/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 14,
                "column": 6
              },
              "text": "Privacy manifest and iOS URL handlers"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 98
          },
          "text": " for examples."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 16,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 4
          },
          "text": "Google Play Console AD_ID permission error"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "After submitting an app to Google Play, you may see:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 20,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Google Api Error: Invalid request - This release includes the com.google.android.gms.permission.AD_ID permission\nbut your declaration on Play Console says your app doesn't use advertising ID."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "The Facebook SDK includes "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 27
          },
          "text": "AD_ID"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 34
          },
          "text": " and other advertising-related permissions. If your app does not use Facebook Login, disable the Facebook provider in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 152
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 173
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 27,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\n\nconst config: CapacitorConfig = {\n  plugins: {\n    SocialLogin: {\n      providers: {\n        google: true,\n        facebook: false,\n        apple: true,\n      },\n    },\n  },\n};\n\nexport default config;"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 45,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 1
          },
          "text": "Then run:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 47,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx cap sync"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "The plugin uses stub classes instead of the real Facebook SDK, so Facebook dependencies and permissions are not included in your build."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 53,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 4
          },
          "text": "Google Sign-In 28444 on Android"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "GetCredentialCustomException: [28444] Developer console is not set up correctly"
        },
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 82
          },
          "text": " comes from Google Credential Manager when the installed APK's signing certificate, package name, or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 55,
            "column": 183
          },
          "text": "webClientId"
        },
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 196
          },
          "text": " does not match Google Cloud Console."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 57,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 1
          },
          "text": "Use the full "
        },
        {
          "type": "link",
          "location": {
            "line": 57,
            "column": 14
          },
          "url": "/docs/plugins/social-login/google/android/#troubleshooting",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 57,
                "column": 15
              },
              "text": "Android Google troubleshooting checklist"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 116
          },
          "text": ". After a failed login, filter Logcat for "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 57,
            "column": 158
          },
          "text": "GoogleProvider"
        },
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 174
          },
          "text": "; the plugin prints "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 57,
            "column": 194
          },
          "text": "package"
        },
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 203
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 57,
            "column": 205
          },
          "text": "signingSha1"
        },
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 218
          },
          "text": ", and a masked "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 57,
            "column": 233
          },
          "text": "webClientId"
        },
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 246
          },
          "text": " to compare with your OAuth clients."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 59,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 59,
            "column": 4
          },
          "text": "Google Sign-In with Family Link supervised accounts"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 61,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 1
          },
          "text": "Family Link supervised accounts can fail with:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 63,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "NoCredentialException: No credentials available"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 67,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 1
          },
          "text": "For apps that need to support Family Link accounts, disable authorized-account filtering for the Google login call:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 69,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { SocialLogin } from '@capgo/capacitor-social-login';\n\nawait SocialLogin.login({\n  provider: 'google',\n  options: {\n    style: 'bottom',\n    filterByAuthorizedAccounts: false,\n    scopes: ['profile', 'email'],\n  },\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 82,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 1
          },
          "text": "Key points:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 84,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 84,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 84,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 84,
                    "column": 3
                  },
                  "text": "Set "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 84,
                    "column": 7
                  },
                  "text": "filterByAuthorizedAccounts"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 84,
                    "column": 35
                  },
                  "text": " to "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 84,
                    "column": 39
                  },
                  "text": "false"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 84,
                    "column": 46
                  },
                  "text": "; the default is "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 84,
                    "column": 63
                  },
                  "text": "true"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 84,
                    "column": 69
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 85,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 85,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 85,
                    "column": 3
                  },
                  "text": "The plugin automatically retries with "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 85,
                    "column": 41
                  },
                  "text": "standard"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 85,
                    "column": 51
                  },
                  "text": " style if "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 85,
                    "column": 61
                  },
                  "text": "bottom"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 85,
                    "column": 69
                  },
                  "text": " style fails with "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 85,
                    "column": 87
                  },
                  "text": "NoCredentialException"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 85,
                    "column": 110
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 86,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 86,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 86,
                    "column": 3
                  },
                  "text": "These options only affect Android. iOS handles Family Link accounts normally."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 87,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 87,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 87,
                    "column": 3
                  },
                  "text": "The error message suggests disabling "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 87,
                    "column": 40
                  },
                  "text": "filterByAuthorizedAccounts"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 87,
                    "column": 68
                  },
                  "text": " when this failure is detected."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 89,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 89,
            "column": 4
          },
          "text": "Where to store access tokens"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 91,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 91,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "link",
          "location": {
            "line": 91,
            "column": 5
          },
          "url": "https://github.com/Cap-go/capacitor-persistent-account",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 91,
                "column": 6
              },
              "text": "@capgo/capacitor-persistent-account"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 91,
            "column": 98
          },
          "text": " when your app needs native secure storage for access or refresh tokens."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 93,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 93,
            "column": 1
          },
          "text": "On Android, it stores data in Account Manager. On iOS, it stores data in Keychain."
        }
      ]
    },
