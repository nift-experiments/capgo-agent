    },
    {
      "type": "code",
      "location": {
        "line": 40,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Permissions } from '@capgo/capacitor-permissions';\n\ndocument.getElementById('camera-settings')?.addEventListener('click', async () => {\n  const { status } = await Permissions.check({ permission: 'camera' });\n  if (status === 'blocked') {\n    await Permissions.openSettings({ type: 'application' });\n  }\n});"
    },
