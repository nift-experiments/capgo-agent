    "title": "Getting Started",
    "description": "Install @capgo/capacitor-date-picker and present native date pickers from a Capacitor app.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-date-picker` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-date-picker\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { DatePicker } from '@capgo/capacitor-date-picker';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "Pick A Date"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 31,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await DatePicker.present({\n  mode: 'date',\n  date: '2026-05-27',\n  min: '2026-01-01',\n  max: '2026-12-31',\n  format: 'yyyy-MM-dd',\n  title: 'Select date',\n});\n\nconsole.log(result.value);"
    },
    {
      "type": "heading",
      "location": {
        "line": 44,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 4
          },
          "text": "Pick A Time"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 46,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await DatePicker.present({\n  mode: 'time',\n  is24h: true,\n  minuteStep: 15,\n  format: 'HH:mm',\n  title: 'Select time',\n});\n\nconsole.log(result.value);"
    },
    {
      "type": "heading",
      "location": {
        "line": 58,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 58,
            "column": 4
          },
          "text": "Pick Date And Time"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 60,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await DatePicker.present({\n  mode: 'dateAndTime',\n  date: '2026-05-27T14:30:00',\n  format: \"yyyy-MM-dd'T'HH:mm:ss\",\n  title: 'Select date and time',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 69,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 4
          },
          "text": "Pick A Month"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 71,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await DatePicker.present({\n  mode: 'yearAndMonth',\n  date: '2026-05-01',\n  format: 'yyyy-MM',\n  title: 'Select month',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 80,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 80,
            "column": 4
          },
          "text": "Pick A Range"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 82,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const range = await DatePicker.presentRange({\n  start: '2026-05-01',\n  end: '2026-05-27',\n  format: 'yyyy-MM-dd',\n  startTitle: 'Start date',\n  endTitle: 'End date',\n});\n\nconsole.log(range.start, range.end, range.value);"
    },
    {
      "type": "heading",
      "location": {
        "line": 94,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 94,
            "column": 4
          },
          "text": "Hide The Picker"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 96,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await DatePicker.hide();"
    },
    {
      "type": "heading",
      "location": {
        "line": 100,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 100,
            "column": 4
          },
          "text": "Platform Options"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 102,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await DatePicker.present({\n  mode: 'date',\n  date: '2026-05-27',\n  title: 'Select date',\n  ios: {\n    style: 'inline',\n    theme: 'light',\n  },\n  android: {\n    theme: 'light',\n  },\n});"
    },
