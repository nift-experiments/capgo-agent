      "text": "export type HealthDataType =\n  | 'steps'\n  | 'distance'\n  | 'calories'\n  | 'heartRate'\n  | 'weight'\n  | 'sleep'\n  | 'respiratoryRate'\n  | 'oxygenSaturation'\n  | 'restingHeartRate'\n  | 'heartRateVariability'\n  | 'bloodPressure'\n  | 'bloodGlucose'\n  | 'bodyTemperature'\n  | 'height'\n  | 'flightsClimbed'\n  | 'exerciseTime'\n  | 'distanceCycling'\n  | 'bodyFat'\n  | 'basalBodyTemperature'\n  | 'basalCalories'\n  | 'totalCalories'\n  | 'mindfulness'\n  | 'workouts';"
