              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 29,
                    "column": 3
                  },
                  "text": "Background task execution does not run reliably in the simulator. Test on a physical device."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 30,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
