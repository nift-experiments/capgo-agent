                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 30,
                    "column": 3
                  },
                  "text": "The plugin re-schedules the next background processing request after each task launch."
                }
              ]
            }
          ]
        }
      ]
