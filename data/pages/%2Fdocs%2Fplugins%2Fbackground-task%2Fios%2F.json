        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "iOS background processing uses "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 2,
            "column": 32
          },
          "text": "BGTaskScheduler"
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 49
          },
          "text": ". The app must declare the background mode and the permitted task identifier before scheduling can work on a physical device."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
