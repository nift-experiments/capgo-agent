        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 1
          },
          "text": "Opens the device's location settings page. Useful for directing users to enable location services or adjust permissions."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 68,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { BackgroundGeolocation } from '@capgo/background-geolocation';\n\n// Direct user to location settings\nawait BackgroundGeolocation.openSettings();"
    },
    {
      "type": "heading",
