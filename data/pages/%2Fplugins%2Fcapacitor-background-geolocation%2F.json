        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 77,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 77,
            "column": 1
          },
          "text": "Plays a sound file when the user deviates from the planned route. This should be used to play a sound (in the background too, only for native)."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 79,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { BackgroundGeolocation } from '@capgo/background-geolocation';\n\nawait BackgroundGeolocation.setPlannedRoute({\n  soundFile: \"notification.mp3\",\n  route: [[-74.0060, 40.7128], [-118.2437, 34.0522]]\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 88,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 88,
            "column": 5
          },
          "text": "Native geofencing"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 90,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 90,
            "column": 1
          },
          "text": "Monitor stores, job sites, delivery zones, campuses, or check-in areas with native iOS and Android geofences. Add an HTTP or HTTPS "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 90,
            "column": 132
          },
          "text": "url"
        },
        {
          "type": "text",
          "location": {
            "line": 90,
            "column": 137
          },
          "text": " to let native code POST transition payloads while the WebView is suspended."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 92,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { BackgroundGeolocation } from '@capgo/background-geolocation';\n\nawait BackgroundGeolocation.setupGeofencing({\n  url: 'https://api.example.com/geofences',\n  notifyOnEntry: true,\n  notifyOnExit: true,\n  payload: { userId: '123' },\n});\n\nawait BackgroundGeolocation.addGeofence({\n  identifier: 'warehouse',\n  latitude: 40.7128,\n  longitude: -74.006,\n  radius: 200,\n});\n\nconst listener = await BackgroundGeolocation.addListener(\n  'geofenceTransition',\n  (event) => console.log(event.identifier, event.transition),\n);\n\nconst errorListener = await BackgroundGeolocation.addListener(\n  'geofenceError',\n  (event) => console.error(event.identifier, event.message),\n);\n\nawait BackgroundGeolocation.removeGeofence({ identifier: 'warehouse' });\nawait listener.remove();\nawait errorListener.remove();"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 124,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 124,
            "column": 1
          },
          "text": "On Android, add "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 124,
            "column": 17
          },
          "text": "ACCESS_BACKGROUND_LOCATION"
        },
        {
          "type": "text",
          "location": {
            "line": 124,
            "column": 45
          },
          "text": " to your app manifest only when you need background geofencing:"
        }
      ]
    },
