    },
    {
      "type": "code",
      "location": {
        "line": 81,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "if (transaction.billingPlanType === 'monthly') {\n  console.log('Current billing period:', transaction.commitmentInfo?.billingPeriodNumber);\n  console.log('Total billing periods:', transaction.commitmentInfo?.totalBillingPeriods);\n  console.log('Commitment ends:', transaction.commitmentInfo?.expirationDate);\n  console.log('Commitment total:', transaction.commitmentInfo?.price);\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 90,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 90,
            "column": 1
          },
          "text": "Renewal info can include the next commitment state:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 92,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { purchases } = await NativePurchases.getPurchases({\n  productType: PURCHASE_TYPE.SUBS,\n  onlyCurrentEntitlements: true,\n});\n\nfor (const purchase of purchases) {\n  const commitment = purchase.renewalInfo?.commitmentInfo;\n  if (!commitment) continue;\n\n  console.log('Renews into another commitment:', commitment.willAutoRenew);\n  console.log('Next billing plan:', commitment.renewalBillingPlanType);\n  console.log('Next renewal date:', commitment.renewalDate);\n}"
    },
