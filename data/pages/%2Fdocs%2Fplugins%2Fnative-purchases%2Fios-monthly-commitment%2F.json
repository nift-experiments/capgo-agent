  "metadata": {
    "title": "iOS Monthly Commitment Billing Plans",
    "description": "Learn how to merchandise and purchase StoreKit monthly subscriptions with a 12-month commitment using @capgo/native-purchases.",
    "sidebar": {
      "order": 9
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "Apple supports subscriptions that bill monthly while committing the customer to a longer 12-month term. When StoreKit and the running OS support this billing plan, "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 2,
            "column": 165
          },
          "text": "@capgo/native-purchases"
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 190
          },
          "text": " exposes the pricing terms, lets you select the monthly billing plan during purchase, and returns commitment metadata on transactions and renewal info."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Use this for annual subscription offers where users prefer monthly payments but you still want the retention and predictability of a committed annual term."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
