      "location": {
        "line": 62,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const transaction = await NativePurchases.purchaseProduct({\n  productIdentifier: 'com.example.app.premium.yearly',\n  productType: PURCHASE_TYPE.SUBS,\n  billingPlanType: 'monthly',\n  appAccountToken: userStoreUuid,\n});"
    },
