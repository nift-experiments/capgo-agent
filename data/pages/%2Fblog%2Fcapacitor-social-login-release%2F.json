            {
              "type": "text",
              "location": {
                "line": 27,
                "column": 89
              },
              "text": "example backend"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 171
          },
          "text": " for Login with Apple 🍎"
        }
      ]
    },
