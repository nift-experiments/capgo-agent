        "line": 22,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\n\nconst config: CapacitorConfig = {\n  appId: 'com.example.app',\n  appName: 'Example',\n  webDir: 'dist',\n  plugins: {\n    CapacitorPatch: {\n      patches: ['upstream-pr-8418-android'],\n      strict: true,\n    },\n  },\n};\n\nexport default config;"
    },
