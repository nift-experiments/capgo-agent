                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 15,
                    "column": 3
                  },
                  "text": "Your backend can keep the same challenge and verification pipeline."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 17,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 4
          },
          "text": "What changes on Android"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 19,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 1
          },
          "text": "Android native passkeys are not identical to a browser trust model."
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 21,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
