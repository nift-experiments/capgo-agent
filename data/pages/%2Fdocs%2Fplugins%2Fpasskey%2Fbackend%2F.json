          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 21,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 21,
                    "column": 3
                  },
                  "text": "Digital Asset Links let Android share the same relying party and credential ecosystem as your website."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 22,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
