                {
                  "type": "inlineCode",
                  "location": {
                    "line": 23,
                    "column": 42
                  },
                  "text": "https://your-domain"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 23,
                    "column": 63
                  },
                  "text": ", Android native assertions can fail even when the passkey is otherwise valid."
                }
              ]
            }
          ]
        }
      ]
    },
