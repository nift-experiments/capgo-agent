                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 3
                  },
                  "text": "The literal "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 22,
                    "column": 15
                  },
                  "text": "clientDataJSON.origin"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 38
                  },
                  "text": " value can still differ from the website origin."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 23,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
