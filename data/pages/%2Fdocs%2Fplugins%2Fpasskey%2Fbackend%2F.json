    {
      "type": "heading",
      "location": {
        "line": 9,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 9,
            "column": 4
          },
          "text": "What stays the same"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 11,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 1
          },
          "text": "The plugin is designed to preserve the front-end shape of your existing WebAuthn code."
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 13,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 13,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 13,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 13,
                    "column": 3
                  },
                  "text": "On the web, it forwards to the real browser WebAuthn API."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 14,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 14,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 14,
                    "column": 3
                  },
                  "text": "On native Capacitor, it returns browser-like credential objects backed by native passkey APIs."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 15,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
