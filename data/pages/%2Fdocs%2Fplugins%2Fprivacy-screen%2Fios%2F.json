                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 17,
                    "column": 3
                  },
                  "text": "masking especially sensitive UI before presenting it"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 18,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
