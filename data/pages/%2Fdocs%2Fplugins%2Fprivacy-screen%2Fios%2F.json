    "title": "iOS Behavior",
    "description": "Understand how Privacy Screen protects your Capacitor app in the iOS app switcher.",
    "sidebar": {
      "order": 3
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "How iOS protection works"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "On iOS, the plugin adds a temporary native overlay while the app resigns active. That overlay is what appears in the app switcher snapshot instead of your real interface."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "This means the plugin protects:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 8,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 8,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 8,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 8,
                    "column": 3
                  },
                  "text": "the app switcher preview"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 9,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 9,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 9,
                    "column": 3
                  },
                  "text": "the snapshot iOS keeps when your app moves to the background"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 11,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 4
          },
          "text": "What it does not do"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 13,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 1
          },
          "text": "iOS does not offer the same screenshot blocking API as Android. The plugin cannot prevent a user from taking a screenshot while actively using the app."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 15,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 1
          },
          "text": "If you need stronger policy controls on iOS, combine this plugin with app-level choices such as:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 17,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
