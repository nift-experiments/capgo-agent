    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { FirebaseApp } from '@capgo/capacitor-firebase-app';\n\nconst result = await FirebaseApp.getName();\nconsole.log(result);"
    },
    {
