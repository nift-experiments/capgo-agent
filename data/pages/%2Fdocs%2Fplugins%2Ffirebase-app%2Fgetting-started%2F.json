      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Get the configuration options for this app."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 46,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { FirebaseApp } from '@capgo/capacitor-firebase-app';\n\nconst result = await FirebaseApp.getOptions();\n// The result holds sensitive values: use it without logging it."
    },
