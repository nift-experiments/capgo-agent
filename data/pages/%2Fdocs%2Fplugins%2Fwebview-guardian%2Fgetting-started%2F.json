        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { WebviewGuardian } from '@capgo/capacitor-webview-guardian';\n\nconst result = await WebviewGuardian.stopMonitoring();\nconsole.log(result);"
    },
