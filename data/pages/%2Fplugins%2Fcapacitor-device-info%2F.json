    },
    {
      "type": "code",
      "location": {
        "line": 28,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { DeviceInfo } from '@capgo/capacitor-device-info';\n\nconst snapshot = await DeviceInfo.getInfo();\n\nconsole.log(snapshot.cpu.cores);\nconsole.log(snapshot.memory.usedPercent);\nconsole.log(snapshot.gpu?.renderer);\nconsole.log(snapshot.sensors?.pressureHpa);"
    },
    {
      "type": "heading",
      "location": {
        "line": 39,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 39,
            "column": 4
          },
          "text": "Stream metrics into a chart"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 41,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { DeviceInfo } from '@capgo/capacitor-device-info';\n\nconst samples: number[] = [];\n\nconst handle = await DeviceInfo.addListener('deviceInfoUpdate', (sample) => {\n  if (typeof sample.cpu.usagePercent === 'number') {\n    samples.push(sample.cpu.usagePercent);\n  }\n});\n\nawait DeviceInfo.startMonitoring({\n  intervalMs: 1000,\n  emitImmediately: true,\n});\n\n// Later:\nawait DeviceInfo.stopMonitoring();\nawait handle.remove();"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 62,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 1
          },
          "text": "Monitoring defaults to a 1000 ms interval, clamps intervals below 250 ms, and emits an immediate sample unless you set "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 62,
            "column": 120
          },
          "text": "emitImmediately: false"
        },
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 144
          },
          "text": ". Calling "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 62,
            "column": 154
          },
          "text": "startMonitoring()"
        },
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 173
          },
          "text": " again restarts the active session with the new options. Each event includes its "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 62,
            "column": 254
          },
          "text": "sequence"
        },
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 264
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 62,
            "column": 266
          },
          "text": "startedAt"
        },
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 277
          },
          "text": ", and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 62,
            "column": 283
          },
          "text": "elapsedMs"
        },
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 294
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 64,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 64,
            "column": 5
          },
          "text": "durationMs"
        },
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 17
          },
          "text": " or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 64,
            "column": 21
          },
          "text": "sampleCount"
        },
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 34
          },
          "text": " to stop automatically. If you no longer need any listener, call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 64,
            "column": 99
          },
          "text": "await DeviceInfo.removeAllListeners()"
        },
