            "column": 59
          },
          "url": "/blog/update-your-capacitor-apps-seamlessly-using-capacitor-updater/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 6,
                "column": 60
              },
              "text": "Tutorial"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 8,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 4
          },
          "text": "Commit convention"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "First you need to start following the commit convention "
        },
        {
          "type": "link",
          "location": {
            "line": 10,
            "column": 57
          },
          "url": "https://www.conventionalcommits.org/en/v1.0.0/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 10,
                "column": 58
              },
              "text": "conventional commits"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 127
          },
          "text": "` this will help the tooling understand how to upgrade the version number, it's 5 min to learn it."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "image",
          "location": {
            "line": 12,
            "column": 1
          },
          "url": "/conventional_commits.webp",
          "title": null,
          "alt": "Conventional commits"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 14,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 4
          },
          "text": "GitHub actions for tag"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "Then you have to create your first GitHub action to automatically build and create tag."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "Create a file at this path: "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 18,
            "column": 29
          },
          "text": ".github/workflows/bump_version.yml"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 20,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 20,
            "column": 1
          },
          "text": "with this content:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 22,
        "column": 1
      },
      "lang": "toml",
      "meta": null,
      "text": "name: Bump version\n\non:\n  push:\n    branches:\n      - main\n\njobs:\n  bump-version:\n    if: \"!startsWith(github.event.head_commit.message, 'chore(release):')\"\n    runs-on: ubuntu-latest\n    name: \"Bump version and create changelog with standard version\"\n    steps:\n      - name: Check out\n        uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n          filter: blob:none\n          token: '${{ secrets.PERSONAL_ACCESS_TOKEN }}'\n      - name: Git config\n        run: |\n          git config --local user.name \"github-actions[bot]\"\n          git config --local user.email \"github-actions[bot]@users.noreply.github.com\"\n      - name: Create bump and changelog\n        run: npx capacitor-standard-version\n      - name: Push to origin\n        run: |\n          CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)\n          remote_repo=\"https://${GITHUB_ACTOR}:${{ secrets.PERSONAL_ACCESS_TOKEN }}@github.com/${GITHUB_REPOSITORY}.git\"\n          git pull $remote_repo $CURRENT_BRANCH\n          git push $remote_repo HEAD:$CURRENT_BRANCH --follow-tags --tags"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 56,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 56,
            "column": 1
          },
          "text": "This will release a tag for every commit in your main branch. And add a changelog entry for each commit in the main branch in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 56,
            "column": 127
          },
          "text": "CHANGELOG.md"
        },
        {
          "type": "text",
          "location": {
            "line": 56,
            "column": 141
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 58,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 58,
            "column": 1
          },
          "text": "Don't worry if you don't have this file, it will be created for you."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 60,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 60,
            "column": 1
          },
          "text": "To make this work, create a "
        },
        {
          "type": "link",
          "location": {
            "line": 60,
            "column": 29
          },
          "url": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/creating-a-personal-access-token/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 60,
                "column": 30
              },
              "text": "PERSONAL ACCESS TOKEN"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 60,
            "column": 166
          },
          "text": " and add it to your GitHub "
        },
        {
          "type": "link",
          "location": {
            "line": 60,
            "column": 193
          },
          "url": "https://docs.github.com/en/actions/security-guides/encrypted-secrets",
          "title": "GitHub secrets",
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 60,
                "column": 194
              },
              "text": "secrets"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 60,
            "column": 289
          },
          "text": " as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 60,
            "column": 293
          },
          "text": "PERSONAL_ACCESS_TOKEN"
        },
        {
          "type": "text",
          "location": {
            "line": 60,
            "column": 316
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 62,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 1
          },
          "text": "This is necessary to let the CI commit the changelog."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 64,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 1
          },
          "text": "When you create the token, choose expiration as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 64,
            "column": 49
          },
          "text": "never"
        },
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 56
          },
          "text": " and the scope as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 64,
            "column": 74
          },
          "text": "repo"
        },
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 80
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 66,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 1
          },
          "text": "Lastly, set the version in your "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 66,
            "column": 33
          },
          "text": "package.json"
        },
        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 47
          },
          "text": " file, sync it with your Native version number that will facilitate, then next step."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 68,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 68,
            "column": 1
          },
          "text": "This is only necessary the first time, then the tools will keep it up to date."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 70,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 1
          },
          "text": "You can now commit this both files and see your first tag appear in GitHub!"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 72,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 1
          },
          "text": "Both native and web platform will have the version number bump after each commit."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 73,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 4
          },
          "text": "GitHub actions for build"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 75,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 75,
            "column": 1
          },
          "text": "Create a file at this path: "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 75,
            "column": 29
          },
          "text": ".github/workflows/build.yml"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 77,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 77,
            "column": 1
          },
          "text": "with this content:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 79,
        "column": 1
      },
      "lang": "yml",
      "meta": null,
      "text": "name: Build source code and send to Capgo\n\non:\n  push:\n    tags:\n      - '*'\n      \njobs:\n  deploy:\n    runs-on: ubuntu-latest\n    name: \"Build code and release\"\n    steps:\n      - name: Check out\n        uses: actions/checkout@v6\n      - name: Install dependencies\n        id: install_code\n        run: npm i\n      - name: Build\n        id: build_code\n        run: npm run build\n        env: # Remove both lines  if you don't need it\n          FIREBASE_CONFIG: ${{ secrets.FIREBASE_CONFIG }} # Example of env var coming from a secret\n      - name: Create Release\n        id: create_release\n        run: npx @capgo/cli@latest bundle upload -a ${{ secrets.CAPGO_TOKEN }} -c production"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 107,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
