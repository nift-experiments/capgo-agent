          ]
        },
        {
          "type": "text",
          "location": {
            "line": 111,
            "column": 179
          },
          "text": " as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 111,
            "column": 183
          },
          "text": "CAPGO_TOKEN"
        },
        {
          "type": "text",
          "location": {
            "line": 111,
            "column": 196
          },
          "text": "."
        }
      ]
    },
    {
