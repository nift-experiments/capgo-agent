                    "column": 48
                  },
                  "text": "200"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 34,
                    "column": 53
                  },
                  "text": " and no "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 34,
                    "column": 61
                  },
                  "text": ".json"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 34,
                    "column": 68
                  },
                  "text": " extension."
                }
              ]
