  "metadata": {
    "title": "iOS Setup",
    "description": "Configure passkeys on iOS for @capgo/capacitor-passkey with Associated Domains and the apple-app-site-association file.",
    "sidebar": {
      "order": 3
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "On iOS, passkeys only work when the app is associated with the same relying-party domain as the website."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "What the plugin handles"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "After you add the plugin config and run "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 41
          },
          "text": "bunx cap sync"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 56
          },
          "text": ", the plugin patches the generated iOS host project so you do not need to keep editing it manually:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 8,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 8,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 8,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 8,
                    "column": 3
                  },
                  "text": "adds the "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 8,
                    "column": 12
                  },
                  "text": "webcredentials:"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 8,
                    "column": 29
                  },
                  "text": " associated domains entries for the configured domains"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 9,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 9,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 9,
                    "column": 3
                  },
                  "text": "wires "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 9,
                    "column": 9
                  },
                  "text": "CODE_SIGN_ENTITLEMENTS"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 9,
                    "column": 33
                  },
                  "text": " when the generated app target does not already point at an entitlements file"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 11,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 4
          },
          "text": "What you still need to host"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 13,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 1
          },
          "text": "You must publish "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 13,
            "column": 18
          },
          "text": "apple-app-site-association"
        },
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 46
          },
          "text": " on the relying-party domain:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 15,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "https://signin.example.com/.well-known/apple-app-site-association"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 19,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 1
          },
          "text": "Example:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 21,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"webcredentials\": {\n    \"apps\": [\"ABCDE12345.app.capgo.passkey.example\"]\n  }\n}"
    },
