                  "type": "inlineCode",
                  "location": {
                    "line": 34,
                    "column": 9
                  },
                  "text": "apple-app-site-association"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 34,
                    "column": 37
                  },
                  "text": " with HTTP "
                },
