      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Initialize the WeChat SDK with your application credentials."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "You can also set these values in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 35,
            "column": 34
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 55
          },
          "text": " under the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 35,
            "column": 66
          },
          "text": "CapacitorWechat"
        },
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 83
          },
          "text": "\nplugin configuration. Calling this method overrides any bundled configuration at runtime."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 38,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWechat } from '@capgo/capacitor-wechat';\n\nawait CapacitorWechat.initialize({\n  appId: 'wx1234567890',\n  universalLink: 'https://example.com/app/'\n});"
    },
