        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 1
          },
          "text": "Check if WeChat app is installed on the device."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 51,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWechat } from '@capgo/capacitor-wechat';\n\nconst { installed } = await CapacitorWechat.isInstalled();\nif (installed) {\n  console.log('WeChat is installed');\n}"
    },
    {
