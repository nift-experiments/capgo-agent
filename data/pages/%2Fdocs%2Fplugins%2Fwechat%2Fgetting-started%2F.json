      "location": {
        "line": 123,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWechat } from '@capgo/capacitor-wechat';\n\nconst { extMsg } = await CapacitorWechat.openMiniProgram({\n  username: 'gh_xxxxxxxxxxxxx',\n  path: 'pages/index/index',\n  type: 0 // 0 = Release, 1 = Test, 2 = Preview\n});"
    },
