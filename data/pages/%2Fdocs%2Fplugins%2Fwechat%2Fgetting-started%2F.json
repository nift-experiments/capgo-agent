      "location": {
        "line": 60,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 60,
            "column": 5
          },
          "text": "auth"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 62,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 1
          },
          "text": "Authenticate user with WeChat OAuth."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 64,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWechat } from '@capgo/capacitor-wechat';\n\nconst { code, state } = await CapacitorWechat.auth({\n  scope: 'snsapi_userinfo',\n  state: 'my_state'\n});\n// Use code to get access token from your server"
    },
    {
      "type": "heading",
      "location": {
        "line": 74,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 74,
            "column": 5
          },
          "text": "share"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 76,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 76,
            "column": 1
          },
          "text": "Share content to WeChat."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 78,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWechat } from '@capgo/capacitor-wechat';\n\n// Share text\nawait CapacitorWechat.share({\n  scene: 0, // 0 = Session, 1 = Timeline, 2 = Favorite\n  type: 'text',\n  text: 'Hello WeChat!'\n});\n\n// Share link\nawait CapacitorWechat.share({\n  scene: 1,\n  type: 'link',\n  title: 'My Website',\n  description: 'Check out my website',\n  link: 'https://example.com',\n  imageUrl: 'https://example.com/image.jpg'\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 99,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 99,
            "column": 5
          },
          "text": "sendPaymentRequest"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 101,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 101,
            "column": 1
          },
          "text": "Send payment request to WeChat Pay."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 103,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWechat } from '@capgo/capacitor-wechat';\n\n// Get payment params from your server first\nconst paymentParams = await fetchPaymentParamsFromServer();\n\nawait CapacitorWechat.sendPaymentRequest({\n  partnerId: paymentParams.partnerId,\n  prepayId: paymentParams.prepayId,\n  nonceStr: paymentParams.nonceStr,\n  timeStamp: paymentParams.timeStamp,\n  package: paymentParams.package,\n  sign: paymentParams.sign\n});"
    },
    {
