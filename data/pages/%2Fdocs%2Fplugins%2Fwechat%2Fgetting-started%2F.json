      "text": "import { CapacitorWechat } from '@capgo/capacitor-wechat';\n\nconst { cards } = await CapacitorWechat.chooseInvoice({\n  appId: 'your_app_id',\n  signType: 'SHA1',\n  cardSign: 'signature',\n  timeStamp: '1234567890',\n  nonceStr: 'random_string'\n});\nconsole.log('Selected cards:', cards);"
