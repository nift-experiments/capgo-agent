  "sourceSha256": "27a37a0954148fc77b3d12f4c59c57bebb191f55ad06184e0618b210229f3b7e",
  "metadata": {
    "title": "Android setup",
    "description": "Configure Android Auto for @capgo/capacitor-auto.",
    "sidebar": {
      "order": 4
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "Android car support uses AndroidX Car App Library and a templated "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 2,
            "column": 67
          },
          "text": "CarAppService"
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 82
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "The plugin ships the service declaration, "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 43
          },
          "text": "template"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 53
          },
          "text": " capability, and a default Android Auto category so the host can discover it after sync."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "Included manifest"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "The plugin contributes this native service:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 10,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<service\n  android:name=\"app.capgo.auto.AutoCarAppService\"\n  android:exported=\"true\">\n  <intent-filter>\n    <action android:name=\"androidx.car.app.CarAppService\" />\n    <category android:name=\"androidx.car.app.category.IOT\" />\n  </intent-filter>\n</service>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 21,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 21,
            "column": 1
          },
          "text": "It also includes:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 23,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<automotiveApp>\n  <uses name=\"template\" />\n</automotiveApp>"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "Category"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 31,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 1
          },
          "text": "The default category is "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 25
          },
          "text": "IOT"
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 30
          },
          "text": ". Your app must qualify for that category before publishing."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "If your app belongs to another Android Auto category, override the service declaration in your app manifest and use the category required by Google for your use case."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 35,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 4
          },
          "text": "Sync"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 37,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx cap sync android"
    },
    {
      "type": "heading",
      "location": {
        "line": 41,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 41,
            "column": 4
          },
          "text": "Behavior"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 43,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
