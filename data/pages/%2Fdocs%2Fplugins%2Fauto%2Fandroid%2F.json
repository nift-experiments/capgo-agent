                  "type": "text",
                  "location": {
                    "line": 43,
                    "column": 20
                  },
                  "text": " updates the Android Auto list screen."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 44,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
