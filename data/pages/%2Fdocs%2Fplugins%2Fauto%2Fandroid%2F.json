              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 44,
                    "column": 3
                  },
                  "text": "Android Auto row selection emits "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 44,
                    "column": 36
                  },
                  "text": "carAction"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 44,
                    "column": 47
                  },
                  "text": " to JavaScript."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 45,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 45,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 45,
                    "column": 3
                  },
                  "text": "Sections are flattened on Android Auto; row title, subtitle, id, and payload are preserved."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 46,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 46,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 46,
                    "column": 3
                  },
                  "text": "Debug builds allow all hosts; release builds use AndroidX's sample host allowlist."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 48,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 4
          },
          "text": "Limits"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 50,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 1
          },
          "text": "Android Auto does not render your Capacitor WebView. The car host renders approved templates from the AndroidX Car App Library."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 52,
