  "metadata": {
    "title": "Getting Started",
    "description": "Install @capgo/capacitor-background-task and schedule periodic background fetch work.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "@capgo/capacitor-background-task"
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 35
          },
          "text": " lets a Capacitor app register named periodic jobs for sync, cache refreshes, analytics delivery, and other background fetch operations."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 14,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-background-task` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 20,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-background-task\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 25,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 4
          },
          "text": "iOS Setup"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 27,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 1
          },
          "text": "Add the background processing mode and permitted task identifier to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 27,
            "column": 69
          },
          "text": "ios/App/App/Info.plist"
        },
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 93
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 29,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>UIBackgroundModes</key>\n<array>\n  <string>processing</string>\n</array>\n<key>BGTaskSchedulerPermittedIdentifiers</key>\n<array>\n  <string>app.capgo.backgroundtask.processing</string>\n</array>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 40,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 1
          },
          "text": "Then run:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 42,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bunx cap sync ios"
    },
    {
      "type": "heading",
      "location": {
        "line": 46,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 48,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { BackgroundTask, BackgroundTaskResult } from '@capgo/capacitor-background-task';"
    },
    {
      "type": "heading",
      "location": {
        "line": 52,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 4
          },
          "text": "Define A Task"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 54,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 1
          },
          "text": "Define the callback at module scope so it is registered as soon as the app is started by the operating system."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 56,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { BackgroundTask, BackgroundTaskResult } from '@capgo/capacitor-background-task';\n\nconst SYNC_TASK = 'sync-offline-data';\n\nBackgroundTask.defineTask(SYNC_TASK, async () => {\n  try {\n    await fetch('https://api.example.com/sync', { method: 'POST' });\n    return BackgroundTaskResult.Success;\n  } catch {\n    return BackgroundTaskResult.Failed;\n  }\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 71,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 71,
            "column": 4
          },
          "text": "Register The Schedule"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 73,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 1
          },
          "text": "Call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 73,
            "column": 6
          },
          "text": "registerTaskAsync"
        },
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 25
          },
          "text": " after your app has enough context to enable the background job."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 75,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await BackgroundTask.registerTaskAsync(SYNC_TASK, {\n  minimumInterval: 30,\n  requiresNetwork: true,\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 82,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 82,
            "column": 1
          },
          "text": "minimumInterval"
        },
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 18
          },
          "text": " is in minutes. Android enforces a minimum of 15 minutes. iOS treats the value as an earliest begin date and may run later."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 84,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 4
          },
          "text": "Check Status"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 86,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const status = await BackgroundTask.getStatusAsync();\nconst isRegistered = await BackgroundTask.isTaskRegisteredAsync(SYNC_TASK);\nconst registeredTasks = await BackgroundTask.getRegisteredTasksAsync();\n\nconsole.log({ status, isRegistered, registeredTasks });"
    },
    {
      "type": "heading",
      "location": {
        "line": 94,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 94,
            "column": 4
          },
          "text": "Trigger A Test Run"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 96,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 96,
            "column": 1
          },
          "text": "Use the test trigger in development or QA. It calls every registered task immediately."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 98,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await BackgroundTask.triggerTaskWorkerForTestingAsync();"
    },
    {
      "type": "heading",
      "location": {
        "line": 102,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 102,
            "column": 4
          },
          "text": "Unregister A Task"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 104,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await BackgroundTask.unregisterTaskAsync(SYNC_TASK);"
    },
    {
      "type": "heading",
      "location": {
        "line": 108,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 108,
            "column": 4
          },
          "text": "iOS Expiration"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 110,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 110,
            "column": 1
          },
          "text": "iOS can stop a background task before your JavaScript work finishes. Listen for expiration events when cleanup or checkpointing matters."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 112,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const expiration = await BackgroundTask.addExpirationListener((event) => {\n  console.warn('Background task expired', event.taskName, event.taskId);\n});\n\nawait expiration.remove();"
    },
    {
      "type": "heading",
      "location": {
        "line": 120,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 120,
            "column": 4
          },
          "text": "React Native Background Task Compatibility"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 122,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 122,
            "column": 1
          },
          "text": "The plugin also exposes a small compatibility layer for apps migrating from "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 122,
            "column": 77
          },
          "text": "react-native-background-task"
        },
        {
          "type": "text",
          "location": {
            "line": 122,
            "column": 107
          },
          "text": "."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 124,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { BackgroundTask } from '@capgo/capacitor-background-task';\n\nBackgroundTask.define(async () => {\n  await fetch('https://api.example.com/sync', { method: 'POST' });\n});\n\nawait BackgroundTask.schedule({\n  period: 1800,\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 136,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 136,
            "column": 4
          },
          "text": "Production Notes"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 138,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 138,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 138,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 138,
                    "column": 3
                  },
                  "text": "Background scheduling is opportunistic, not exact."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 139,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 139,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 139,
                    "column": 3
                  },
                  "text": "Keep work short and idempotent."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 140,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 140,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 140,
                    "column": 3
                  },
                  "text": "Persist any state you need before returning "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 140,
                    "column": 47
                  },
                  "text": "BackgroundTaskResult.Success"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 140,
                    "column": 77
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 141,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 141,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 141,
                    "column": 3
                  },
                  "text": "Avoid relying on background tasks for user-visible deadlines or alarms."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 143,
        "column": 1
      },
