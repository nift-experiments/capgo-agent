              },
              "text": "Register here today!"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 77,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 77,
            "column": 4
          },
          "text": "Keep going from Self-hosted Live Updates"
        }
      ]
    },
