  "metadata": {
    "title": "iOS Setup",
    "description": "Configure the required iOS deeplink hooks for Contentsquare in-app features in Capacitor apps.",
    "sidebar": {
      "order": 3
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "Contentsquare tracking starts automatically once the plugin is installed, but iOS in-app features such as SDK logs, screenshot capture, and replay configuration still need the upstream URL handling setup."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "1. Add the URL scheme"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "Add "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 5
          },
          "text": "cs-$(PRODUCT_BUNDLE_IDENTIFIER)"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 38
          },
          "text": " to your app URL schemes in Xcode or your host app's "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 91
          },
          "text": "Info.plist"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 103
          },
          "text": "."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>CFBundleURLTypes</key>\n<array>\n  <dict>\n    <key>CFBundleURLSchemes</key>\n    <array>\n      <string>cs-$(PRODUCT_BUNDLE_IDENTIFIER)</string>\n    </array>\n  </dict>\n</array>"
    },
    {
      "type": "heading",
      "location": {
        "line": 20,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 20,
            "column": 4
          },
          "text": "2. Forward Contentsquare deeplinks"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 22,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 1
          },
          "text": "Wherever your Capacitor host app handles incoming URLs, forward them to the native SDK:"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 24,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 5
          },
          "text": "AppDelegate"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 26,
        "column": 1
      },
      "lang": "swift",
      "meta": null,
      "text": "import ContentsquareModule\n\nfunc application(\n  _ app: UIApplication,\n  open url: URL,\n  options: [UIApplication.OpenURLOptionsKey : Any] = [:]\n) -> Bool {\n  Contentsquare.handle(url: url)\n  return true\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 39,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 39,
            "column": 5
          },
          "text": "SceneDelegate"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 41,
        "column": 1
      },
      "lang": "swift",
      "meta": null,
      "text": "import ContentsquareModule\n\nfunc scene(_ scene: UIScene, openURLContexts urlContexts: Set<UIOpenURLContext>) {\n  if let url = urlContexts.first?.url {\n    Contentsquare.handle(url: url)\n  }\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 51,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 5
          },
          "text": "SwiftUI"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 53,
        "column": 1
      },
      "lang": "swift",
      "meta": null,
      "text": "import ContentsquareModule\n\n.onOpenURL { url in\n  Contentsquare.handle(url: url)\n}"
    },
