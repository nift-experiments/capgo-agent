      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 78,
            "column": 5
          },
          "text": "ShareReceivedEvent"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 79,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 1
          },
          "text": "Event data received when content is shared to the application."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 80,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface ShareReceivedEvent {\n  /**\n   * The title of the shared content.\n   *\n   * @since 0.1.0\n   */\n  title: string;\n\n  /**\n   * Array of text content shared to the application.\n   *\n   * @since 0.1.0\n   */\n  texts: string[];\n\n  /**\n   * Array of files shared to the application.\n   *\n   * @since 0.2.0\n   */\n  files: SharedFile[];\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 105,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 105,
            "column": 5
          },
          "text": "SharedFile"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 106,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 106,
            "column": 1
          },
          "text": "Represents a file shared to the application."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 107,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface SharedFile {\n  /**\n   * The URI of the shared file. On Android/iOS this will be a file path or data URL.\n   * On web this will be a cached URL accessible via fetch.\n   *\n   * @since 0.1.0\n   */\n  uri: string;\n\n  /**\n   * The name of the shared file, with or without extension.\n   *\n   * @since 0.1.0\n   */\n  name: string;\n\n  /**\n   * The MIME type of the shared file.\n   *\n   * @since 0.1.0\n   */\n  mimeType: string;\n}"
    },
