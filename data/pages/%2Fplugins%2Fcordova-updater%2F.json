        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "@capgo/cordova-updater"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 25
          },
          "text": " brings Capgo live updates to Cordova iOS and Android apps with the same JavaScript API as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 116
          },
          "text": "@capgo/capacitor-updater"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 142
          },
          "text": ". Install the Cordova plugin, call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 177
          },
          "text": "notifyAppReady()"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 195
          },
          "text": " on every launch, and upload bundles with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 237
          },
          "text": "@capgo/cli"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 249
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "Installation"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "cordova plugin add @capgo/cordova-updater --variable APP_ID=com.example.app\ncordova prepare android ios"
    },
    {
      "type": "heading",
      "location": {
        "line": 13,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 4
          },
          "text": "Basic usage"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 15,
        "column": 1
      },
      "lang": "javascript",
      "meta": null,
      "text": "document.addEventListener('deviceready', async () => {\n  const { Updater } = cordova.plugins;\n\n  await Updater.notifyAppReady();\n\n  const { bundle } = await Updater.current();\n  console.log('Active bundle', bundle);\n\n  const latest = await Updater.getLatest();\n  if (latest.url && !latest.error) {\n    const downloaded = await Updater.download({\n      url: latest.url,\n      version: latest.version,\n      checksum: latest.checksum,\n    });\n\n    await Updater.next({ id: downloaded.id });\n  }\n});"
    },
