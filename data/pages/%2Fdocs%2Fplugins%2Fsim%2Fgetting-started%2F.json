        "line": 102,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 102,
            "column": 1
          },
          "text": "Result of a permission check or request."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 103,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface PermissionStatus {\n  readSimCard: PermissionState;\n}"
    },
    {
      "type": "heading",
      "location": {
