    "title": "Getting Started",
    "description": "Install @capgo/capacitor-sim and start using its current Capacitor API.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-sim` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-sim\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Sim } from '@capgo/capacitor-sim';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "getSimCards"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Get information from the device's SIM cards."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "Retrieves details about all SIM cards installed in the device.\nOn dual-SIM devices, returns information for both SIM cards.\nRequires READ_PHONE_STATE permission on Android."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 39,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Sim } from '@capgo/capacitor-sim';\n\nconst { simCards } = await Sim.getSimCards();\nsimCards.forEach((sim, index) => {\n  console.log(`SIM ${index + 1}:`);\n  console.log(`  Carrier: ${sim.carrierName}`);\n  console.log(`  Country: ${sim.isoCountryCode}`);\n  console.log(`  MCC: ${sim.mobileCountryCode}`);\n  console.log(`  MNC: ${sim.mobileNetworkCode}`);\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 52,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 52,
            "column": 5
          },
          "text": "checkPermissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 54,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 1
          },
          "text": "Check permission to access SIM card information."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 56,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 56,
            "column": 1
          },
          "text": "Checks if the app has permission to read SIM card data.\nOn Android, checks READ_PHONE_STATE permission.\nOn iOS, the status is always granted.\nOn Web, the status is always denied."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 61,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Sim } from '@capgo/capacitor-sim';\n\nconst status = await Sim.checkPermissions();\nif (status.readSimCard === 'granted') {\n  console.log('Permission granted');\n} else {\n  console.log('Permission not granted');\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 72,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 72,
            "column": 5
          },
          "text": "requestPermissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 74,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 74,
            "column": 1
          },
          "text": "Request permission to access SIM card information."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 76,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 76,
            "column": 1
          },
          "text": "Prompts the user to grant permission to read SIM card data.\nOn Android, requests READ_PHONE_STATE permission.\nOn iOS, the status is always granted without prompting.\nOn Web, the status remains denied."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 81,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Sim } from '@capgo/capacitor-sim';\n\nconst status = await Sim.requestPermissions();\nif (status.readSimCard === 'granted') {\n  // Now you can call getSimCards()\n  const simCards = await Sim.getSimCards();\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 91,
        "column": 1
      },
      "depth": 2,
      "blocks": [
