      "location": {
        "line": 4,
        "column": 1
      }
    },
    {
      "type": "heading",
      "location": {
        "line": 8,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 4
          },
          "text": "Why Electron Updater?"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Electron's built-in auto-updater requires shipping a full new binary for every update. This plugin solves that by enabling JavaScript/HTML/CSS updates without rebuilding."
        }
      ]
    },
