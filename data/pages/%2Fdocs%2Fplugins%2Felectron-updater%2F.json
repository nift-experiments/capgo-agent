              "type": "text",
              "location": {
                "line": 5,
                "column": 3
              },
              "text": "New to Capgo? The Electron Updater brings the same powerful live update capabilities from mobile to desktop. If you're already using "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 5,
                "column": 136
              },
              "text": "@capgo/capacitor-updater"
            },
            {
              "type": "text",
              "location": {
                "line": 5,
                "column": 162
              },
              "text": ", you'll feel right at home."
            }
          ]
