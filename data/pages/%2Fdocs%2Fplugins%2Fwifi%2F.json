              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 28,
                    "column": 26
                  },
                  "text": "Request location permissions from the user. Location permission is required for Wi-Fi operations on both platforms."
                }
              ]
            }
          ]
        },
