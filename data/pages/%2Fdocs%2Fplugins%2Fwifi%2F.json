              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 24,
                    "column": 19
                  },
                  "text": "Get comprehensive information about the currently connected WiFi network. This method provides detailed network information including SSID, BSSID, IP address, frequency, link speed, and signal strength in a single call. On iOS, some fields may not be available and will be undefined."
                }
              ]
            }
