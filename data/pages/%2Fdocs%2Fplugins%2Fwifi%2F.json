              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 26,
                    "column": 17
                  },
                  "text": "Start scanning for Wi-Fi networks. Only available on Android. Results are delivered via the 'networksScanned' event listener. Note: May fail due to system throttling or hardware issues."
