          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-app-tracking-transparency` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-app-tracking-transparency\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AppTrackingTransparency } from '@capgo/capacitor-app-tracking-transparency';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "getStatus"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Gets the current tracking authorization status without prompting the user."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AppTrackingTransparency } from '@capgo/capacitor-app-tracking-transparency';\n\nconst { status } = await AppTrackingTransparency.getStatus();\nif (status === 'authorized') {\n  console.log('Tracking is authorized');\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 44,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 44,
            "column": 5
          },
          "text": "requestPermission"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 46,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 1
          },
          "text": "Requests user authorization to access app-related data for tracking.\nDisplays the native iOS tracking permission dialog."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 49,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 1
          },
          "text": "Note: This method will only show the dialog once. Subsequent calls\nwill return the stored authorization status without showing the dialog."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 52,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AppTrackingTransparency } from '@capgo/capacitor-app-tracking-transparency';\n\nconst { status } = await AppTrackingTransparency.requestPermission();\nswitch (status) {\n  case 'authorized':\n    console.log('User authorized tracking');\n    break;\n  case 'denied':\n    console.log('User denied tracking');\n    break;\n  case 'restricted':\n    console.log('Tracking is restricted');\n    break;\n  case 'notDetermined':\n    console.log('Status not determined');\n    break;\n}"
    },
    {
