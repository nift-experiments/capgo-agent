        "line": 15,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 1
          },
          "text": "Optional URL schemes for companion spoof apps you want to detect with "
        },
        {
          "type": "inlineCode",
