    {
      "type": "code",
      "location": {
        "line": 40,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { MockLocationDetector } from '@capgo/capacitor-mock-location-detector';\n\nconst result = await MockLocationDetector.analyze({\n  requestLocationSample: true,\n  additionalMockAppUrlSchemes: ['anyto', 'pokeep'],\n});"
