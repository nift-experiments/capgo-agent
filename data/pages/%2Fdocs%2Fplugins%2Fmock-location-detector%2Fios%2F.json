    },
    {
      "type": "code",
      "location": {
        "line": 17,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>LSApplicationQueriesSchemes</key>\n<array>\n  <string>anyto</string>\n  <string>imyfone-anyto</string>\n  <string>igo</string>\n  <string>igomarkto</string>\n  <string>fakegps</string>\n  <string>mockgps</string>\n  <string>pokeep</string>\n</array>"
    },
