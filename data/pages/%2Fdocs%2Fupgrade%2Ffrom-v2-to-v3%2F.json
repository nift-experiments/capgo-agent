{
  "version": 1,
  "route": "/docs/upgrade/from-v2-to-v3/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/upgrade/from-v2-to-v3.md",
  "sourceSha256": "a70e0520984fac49b6402181b626a3d7243cff9d6770641636281dc52d3bedbc",
  "metadata": {
    "title": "From V2 to V3",
    "description": "A comprehensive guide on transitioning from version 2 to version 3 of Capgo updater, detailing the necessary steps and considerations for a successful upgrade process",
    "sidebar": {
      "order": 4
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "This documentation will explain how to upgrade to the version 3 of auto-update."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "First migrate to the last tooling:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm remove -g capgo\nnpm remove capacitor-updater\n\nnpm i @capgo/cli\nnpm i @capgo/capacitor-updater@3\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 15,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 4
          },
          "text": "Remove all your previous config:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 17,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  CapacitorUpdater: {\n      autoUpdateURL: \"https...\",\n      ...\n  },\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 26,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 1
          },
          "text": "to only let this:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 28,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"CapacitorUpdater\": {\n    \"autoUpdate\": true\n  }\n}"
    },
    {
      "type": "blockquote",
      "location": {
        "line": 36,
        "column": 1
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 36,
            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 36,
                "column": 3
              },
              "text": "⚠️ If you were using your server, with "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 36,
                "column": 42
              },
              "text": "autoUpdateURL"
            },
            {
              "type": "text",
              "location": {
                "line": 36,
                "column": 57
              },
              "text": ", I will upgrade this guide soon for you. Meanwhile, take a look at the new upload option "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 36,
                "column": 147
              },
              "text": "external"
            },
            {
              "type": "text",
              "location": {
                "line": 36,
                "column": 157
              },
              "text": " which allows you to send only the link of your zip, not the code in Capgo cloud. This has been made for companies with strict privacy policies. In external mode, the code will never land on Capgo server, we just store the URL and send it to the device, which will directly download it. In the standard way, the code is zipped and stored in our server, but we will never open it or use it either."
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 38,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 4
          },
          "text": "What change"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 40,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 1
          },
          "text": "All configurations become server-side for auto-update, to give you more control on how you send an update to users."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 42,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 1
          },
          "text": "That allows us to revert, even deploy just to one user with channels! These settings are added back to the web interface:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 44,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 44,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 44,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 44,
                    "column": 3
                  },
                  "text": "disable revert under native"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 45,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 45,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 45,
                    "column": 3
                  },
                  "text": "disable update above major"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "blockquote",
      "location": {
        "line": 47,
        "column": 1
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 47,
            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 47,
                "column": 3
              },
              "text": "⚠️ They will become true by default for all channels"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 49,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 1
          },
          "text": "This will also remove the need to update often the plugin, most updates will be done server side, and you will get it without any change in your side."
        }
      ]
    },
    {
      "type": "blockquote",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 51,
            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 51,
                "column": 3
              },
              "text": "⚠️ Reset when an update becomes the default, so if you prefer not to remove all download versions when updating from the store, do this:"
            }
          ]
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 53,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"CapacitorUpdater\": {\n    \"autoUpdate\": true,\n    \"resetWhenUpdate\": false\n  }\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 62,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 4
          },
          "text": "Update your code"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 64,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 1
          },
          "text": "Lastly, update all your imports in JS from:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 66,
        "column": 1
      },
      "lang": null,
      "meta": null,
      "text": "import { CapacitorUpdater } from 'capacitor-updater'"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 70,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 1
          },
          "text": "to"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 72,
        "column": 1
      },
      "lang": null,
      "meta": null,
      "text": "import { CapacitorUpdater } from '@capgo/capacitor-updater'"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 76,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 76,
            "column": 1
          },
          "text": "Then build your code again "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 76,
            "column": 28
          },
          "text": "npm run build"
        },
        {
          "type": "text",
          "location": {
            "line": 76,
            "column": 43
          },
          "text": " and copy assets once more "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 76,
            "column": 70
          },
          "text": "npx cap copy"
        },
        {
          "type": "text",
          "location": {
            "line": 76,
            "column": 84
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 78,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 78,
            "column": 1
          },
          "text": "You should be able now to test the last auto-update system"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 80,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 80,
            "column": 1
          },
          "text": "Send your version with:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 82,
        "column": 1
      },
      "lang": null,
      "meta": null,
      "text": "npx @capgo/cli@latest bundle upload"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 86,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 1
          },
          "text": "instead of"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 88,
        "column": 1
      },
      "lang": null,
      "meta": null,
      "text": "npx capgo upload"
    },
    {
      "type": "heading",
      "location": {
        "line": 92,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 92,
            "column": 4
          },
          "text": "Future evolution"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 94,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 94,
            "column": 1
          },
          "text": "For now only the first public channel is in use, in the future, public will change for multi public channels, if more than one is set."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 96,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 96,
            "column": 4
          },
          "text": "Common problems:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 98,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 98,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 98,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 98,
                    "column": 3
                  },
                  "text": "Build problem after upgrade: if you have already opened the source code of the plugin in Android studio or Xcode, sometimes the sync doesn't remove them, that the cause of the issue. Open the native IDE and remove "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 98,
                    "column": 217
                  },
                  "text": "capacitor-updater"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 98,
                    "column": 236
                  },
                  "text": " by hands and do "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 98,
                    "column": 253
                  },
                  "text": "npx cap sync"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 98,
                    "column": 267
                  },
                  "text": " this should solve."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 100,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 100,
            "column": 4
          },
          "text": "Keep going from From V2 to V3"
        }
      ]
    },
