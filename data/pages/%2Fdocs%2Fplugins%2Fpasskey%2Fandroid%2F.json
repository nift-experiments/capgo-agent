                {
                  "type": "text",
                  "location": {
                    "line": 42,
                    "column": 23
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 43,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 43,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 43,
                    "column": 4
                  },
                  "text": "Use your real Android package name in "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 43,
                    "column": 42
                  },
                  "text": "assetlinks.json"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 43,
                    "column": 59
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 44,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 44,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 44,
                    "column": 4
                  },
                  "text": "Add every signing certificate fingerprint you need, including debug or internal signing keys if you test those builds."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 45,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 45,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 45,
                    "column": 4
                  },
                  "text": "Host the file on the same domain you use as the relying-party ID."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 47,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 4
          },
          "text": "Important behavior difference from a browser"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 49,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 1
          },
          "text": "With Digital Asset Links configured, Android can use the same relying party and passkeys as your website. The remaining difference is the literal origin reported in native "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 49,
            "column": 173
          },
          "text": "clientDataJSON"
        },
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 189
          },
          "text": "."
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 51,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 51,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 51,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 51,
                    "column": 3
                  },
                  "text": "A normal Android app does not behave like a privileged browser."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 52,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 52,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 52,
                    "column": 3
                  },
                  "text": "The assertion origin can be tied to the Android app signature instead of your website origin."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 53,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 53,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 53,
                    "column": 3
                  },
                  "text": "If your backend strictly validates "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 53,
                    "column": 38
                  },
                  "text": "clientDataJSON.origin"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 53,
                    "column": 61
                  },
                  "text": ", accept the Android app origin alongside the website origin."
                }
              ]
            }
          ]
        }
      ]
    },
    {
