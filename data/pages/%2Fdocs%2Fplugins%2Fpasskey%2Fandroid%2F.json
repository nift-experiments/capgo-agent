  "metadata": {
    "title": "Android Setup",
    "description": "Configure passkeys on Android for @capgo/capacitor-passkey with Digital Asset Links and assetlinks.json.",
    "sidebar": {
      "order": 4
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "On Android, passkeys work with your website when the app and the relying-party domain are connected through Digital Asset Links."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "What the plugin handles"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "After you add the plugin config and run "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 41
          },
          "text": "bunx cap sync"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 56
          },
          "text": ", the plugin patches the generated Android host project:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 8,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 8,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 8,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 8,
                    "column": 3
                  },
                  "text": "injects the "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 8,
                    "column": 15
                  },
                  "text": "asset_statements"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 8,
                    "column": 33
                  },
                  "text": " manifest metadata"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 9,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 9,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 9,
                    "column": 3
                  },
                  "text": "writes the generated string resource referenced by that metadata"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 11,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 4
          },
          "text": "What you still need to host"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 13,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 1
          },
          "text": "You must publish "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 13,
            "column": 18
          },
          "text": "assetlinks.json"
        },
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 35
          },
          "text": " on the relying-party domain:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 15,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "https://signin.example.com/.well-known/assetlinks.json"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 19,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 1
          },
          "text": "Example:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 21,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "[\n  {\n    \"relation\": [\n      \"delegate_permission/common.handle_all_urls\",\n      \"delegate_permission/common.get_login_creds\"\n    ],\n    \"target\": {\n      \"namespace\": \"android_app\",\n      \"package_name\": \"app.capgo.passkey.example\",\n      \"sha256_cert_fingerprints\": [\n        \"AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99\"\n      ]\n    }\n  }\n]"
    },
    {
      "type": "heading",
      "location": {
        "line": 39,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 39,
            "column": 4
          },
          "text": "Checklist"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 41,
        "column": 1
      },
      "ordered": true,
      "start": 1,
      "spread": false,
      "blocks": [
