              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 42,
                    "column": 4
                  },
                  "text": "Run "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 42,
                    "column": 8
                  },
                  "text": "bunx cap sync"
