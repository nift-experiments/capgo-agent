              "type": "paragraph",
              "location": {
                "line": 41,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 41,
                    "column": 4
                  },
                  "text": "Set "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 41,
                    "column": 8
                  },
                  "text": "origin"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 41,
                    "column": 16
                  },
                  "text": " and "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 41,
                    "column": 21
                  },
                  "text": "domains"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 41,
                    "column": 30
                  },
                  "text": " in "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 41,
                    "column": 34
                  },
                  "text": "plugins.CapacitorPasskey"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 41,
                    "column": 60
                  },
                  "text": " in "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 41,
                    "column": 64
                  },
                  "text": "capacitor.config.*"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 41,
                    "column": 84
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 42,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
