          },
          "text": "Package Preparation"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 32,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 1
          },
          "text": "Be sure to have your build command in your "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 44
          },
          "text": "package.json"
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 58
          },
          "text": " script.\nThen add the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 33,
            "column": 14
          },
          "text": "sync:ios"
        },
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 24
          },
          "text": " command like below."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"scripts\": {\n    \"build\": \"YOUR BUILD COMMAND\",\n    \"sync:ios\": \"cap sync ios\"\n  }\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 43,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 43,
            "column": 1
          },
          "text": "This step will make the post script work simply"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 45,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 4
          },
          "text": "Post clone script"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 46,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 1
          },
          "text": "This script will be run by Xcode cloud after the clone step"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 48,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "#!/usr/bin/env bash\n\nset -x\n\nexport HOMEBREW_NO_INSTALL_CLEANUP=TRUE\n# Install CocoaPods\necho \"📦 Install CocoaPods\"\nbrew install cocoapods\nbrew install node@18\nbrew link node@18\n\n# Install dependencies\n# XCode Cloud is literally broken for 2 months now - https://developer.apple.com/forums/thread/738136?answerId=774510022#774510022\nnpm config set maxsockets 3\nnpm ci\n# or `pnpm install --frozen-lockfile` or `yarn add --frozen-lockfile` or bun install\nnpm run build \n# or npm run build\nnpm run sync:ios"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 70,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 1
          },
          "text": "Save this file in the root of your project and name it "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 70,
            "column": 56
          },
          "text": "ios/App/ci_scripts/ci_post_clone.sh"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 72,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 1
          },
          "text": "Then make this file executable with this command "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 72,
            "column": 50
          },
          "text": "chmod +x ios/App/ci_scripts/ci_post_clone.sh"
        }
      ]
    },
