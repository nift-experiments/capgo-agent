        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "What this tutorial will cover?"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "This tutorial will show how to use capacitor updater in a dev environment with self hosted capgo"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "Requirements"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 8,
        "column": 2
      },
      "ordered": true,
      "start": 1,
      "spread": false,
