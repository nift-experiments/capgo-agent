        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 10,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 4
          },
          "text": "Getting started"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "To use the capacitor updater with self-hosted capgo edit the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 12,
            "column": 62
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 83
          },
          "text": " from your app directory and set it like this:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 14,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const config: CapacitorConfig = {\n  appId: 'com.demo.app',\n  appName: 'demoApp',\n  webDir: 'dist',\n  bundledWebRuntime: false,\n  plugins: {\n    CapacitorUpdater : {\n      statsUrl: \"https://localhost:54321/functions/v1/stats\",\n      channelUrl: \"https://localhost:54321/functions/v1/channel_self\",\n      updateUrl: \"https://localhost:54321/functions/v1/updates\"\n    },\n  },\n};"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 30,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 1
          },
          "text": "This will enable you to use local capgo in development. However, by default, this is not enough."
        }
      ]
    },
    {
      "type": "blockquote",
      "location": {
        "line": 32,
        "column": 1
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 32,
            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 32,
                "column": 3
              },
              "text": "By default iOS, Android, and Electron expect you to use HTTPS, you need to use a tool like Ngrock or localcan to proxy your API in https."
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 34,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 1
          },
          "text": "There is a way in Android to enable "
        },
        {
          "type": "link",
          "location": {
            "line": 34,
            "column": 37
          },
          "url": "https://developer.android.com/topic/security/risks/cleartext",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 34,
                "column": 38
              },
              "text": "plaintext communication"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 124
          },
          "text": ".\nThis can be achieved by modifying "
        },
        {
          "type": "link",
          "location": {
            "line": 35,
            "column": 35
          },
          "url": "https://github.com/Cap-go/capacitor-updater/blob/main/android/src/main/AndroidManifest.xml",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 35,
                "column": 36
              },
              "text": "AndroidManifest.xml"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 148
          },
          "text": " and adding "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 35,
            "column": 160
          },
          "text": "android:usesCleartextTraffic=\"true\""
        },
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 197
          },
          "text": " in the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 35,
            "column": 205
          },
          "text": "application"
        },
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 218
          },
          "text": " tag\nA full example of this change can be seen "
        },
        {
          "type": "link",
          "location": {
            "line": 36,
            "column": 43
          },
          "url": "https://gist.github.com/WcaleNieWolny/061a015acdebe35eaf3afd7030797701",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 36,
                "column": 44
              },
              "text": "here"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 38,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 1
          },
          "text": "There also could be a problem that prevents the android app from connecting. If you do not see any requests being send to edge functions run"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 39,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "adb reverse tcp:54321 tcp:54321"
    },
