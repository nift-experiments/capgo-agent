            "line": 71,
            "column": 1
          },
          "text": "A: "
        },
        {
          "type": "link",
          "location": {
            "line": 71,
            "column": 4
          },
          "url": "/docs/getting-help/#support-by-chat",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 71,
                "column": 5
              },
              "text": "Please contact capgo's support directly"
            }
          ]
        }
      ]
    },
