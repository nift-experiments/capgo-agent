          },
          "text": "Request the current Play Age Signals for the active user."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "Only available on Android devices with Google Play installed."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 37,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AgeSignals } from '@capgo/capacitor-android-age-signals';\n\nconst result = await AgeSignals.checkAgeSignals();\nconsole.log(result);"
    },
    {
