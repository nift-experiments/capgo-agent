        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-uploader` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-uploader\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Uploader } from '@capgo/capacitor-uploader';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "startUpload"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Start uploading a file to a server."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "The upload will continue in the background even if the app is closed or backgrounded.\nListen to upload events to track progress, completion, or failure."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 38,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Uploader } from '@capgo/capacitor-uploader';\n\nconst { id } = await Uploader.startUpload({\n  filePath: 'file:///path/to/file.jpg',\n  serverUrl: 'https://example.com/upload',\n  headers: {\n    'Authorization': 'Bearer token'\n  },\n  method: 'POST',\n  uploadType: 'multipart',\n  fileField: 'photo'\n});\nconsole.log('Upload started with ID:', id);"
    },
    {
      "type": "heading",
      "location": {
        "line": 54,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 54,
            "column": 5
          },
          "text": "removeUpload"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 56,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 56,
            "column": 1
          },
          "text": "Cancel and remove an ongoing upload."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 58,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 58,
            "column": 1
          },
          "text": "This will stop the upload if it's in progress and clean up resources."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 60,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Uploader } from '@capgo/capacitor-uploader';\n\nawait Uploader.removeUpload({ id: 'upload-123' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 66,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 4
          },
          "text": "Type Reference"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 68,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 68,
            "column": 5
          },
          "text": "uploadOption"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "Configuration options for uploading a file."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 70,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface uploadOption {\n  /**\n   * The local file path of the file to upload.\n   * Can be a file:// URL or an absolute path.\n   *\n   * @since 0.0.1\n   */\n  filePath: string;\n\n  /**\n   * The server URL endpoint where the file should be uploaded.\n   *\n   * @since 0.0.1\n   */\n  serverUrl: string;\n\n  /**\n   * The title of the upload notification shown to the user.\n   * Android only.\n   *\n   * @default 'Uploading'\n   * @since 0.0.1\n   */\n  notificationTitle?: string;\n\n  /**\n   * HTTP headers to send with the upload request.\n   * Useful for authentication tokens, content types, etc.\n   *\n   * @since 0.0.1\n   * @example\n   * ```typescript\n   * headers: {\n   *   'Authorization': 'Bearer token123',\n   *   'X-Custom-Header': 'value'\n   * }\n   * ```\n   */\n  headers: {\n    [key: string]: string;\n  };\n\n  /**\n   * The HTTP method to use for the upload request.\n   *\n   * @default 'POST'\n   * @since 0.0.1\n   */\n  method?: 'PUT' | 'POST';\n\n  /**\n   * The MIME type of the file being uploaded.\n   * If not specified, the plugin will attempt to determine it automatically.\n   *\n   * @since 0.0.1\n   * @example 'image/jpeg', 'application/pdf', 'video/mp4'\n   */\n  mimeType?: string;\n\n  /**\n   * Additional form parameters to send with the upload request.\n   * These will be included as form data in multipart uploads.\n   *\n   * @since 0.0.1\n   */\n  parameters?: { [key: string]: string };\n\n  /**\n   * The maximum number of times to retry the upload if it fails.\n   *\n   * @since 0.0.1\n   * @default 0\n   */\n  maxRetries?: number;\n\n  /**\n   * The type of upload to perform.\n   * - 'binary': Uploads the file as raw binary data in the request body\n   * - 'multipart': Uploads the file as multipart/form-data\n   *\n   * @default 'binary'\n   * @since 0.0.2\n   */\n  uploadType?: 'binary' | 'multipart';\n\n  /**\n   * The form field name for the file when using multipart upload type.\n   * Only used when uploadType is 'multipart'.\n   *\n   * @default 'file'\n   * @since 0.0.2\n   */\n  fileField?: string;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 167,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 167,
            "column": 5
          },
          "text": "UploadEvent"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 168,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 168,
            "column": 1
          },
          "text": "Event emitted during the upload lifecycle."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 169,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface UploadEvent {\n  /**\n   * The current status of the upload.\n   * - 'uploading': Upload is in progress\n   * - 'completed': Upload finished successfully\n   * - 'failed': Upload encountered an error\n   *\n   * @since 0.0.1\n   */\n  name: 'uploading' | 'completed' | 'failed';\n\n  /**\n   * Additional data about the upload event.\n   *\n   * @since 0.0.1\n   */\n  payload: {\n    /**\n     * Upload progress percentage from 0 to 100.\n     * Only present during 'uploading' events.\n     *\n     * @since 0.0.1\n     */\n    percent?: number;\n\n    /**\n     * Error message if the upload failed.\n     * Only present during 'failed' events.\n     *\n     * @since 0.0.1\n     */\n    error?: string;\n\n    /**\n     * HTTP status code returned by the server.\n     * Present during 'completed' and 'failed' events.\n     *\n     * @since 0.0.1\n     */\n    statusCode?: number;\n  };\n\n  /**\n   * Unique identifier for this upload task.\n   *\n   * @since 0.0.1\n   */\n  id: string;\n}"
    },
