    },
    {
      "type": "code",
      "location": {
        "line": 81,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { IntuneMAM } from '@capgo/capacitor-intune';\n\nconst auth = await IntuneMAM.acquireToken({\n  scopes: ['https://graph.microsoft.com/.default'],\n});\n\nawait IntuneMAM.registerAndEnrollAccount({\n  accountId: auth.accountId,\n});"
    },
