      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "1. Add the Intune Gradle plugin"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "In your app project's top-level "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 33
          },
          "text": "android/build.gradle"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 55
          },
          "text": ", add the Intune Gradle plugin JAR to the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 97
          },
          "text": "buildscript"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 110
          },
          "text": " classpath. The plugin package includes:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 6,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 6,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 6,
                "column": 3
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 6,
                    "column": 3
                  },
                  "text": "android/ms-intune-app-sdk-android/GradlePlugin/com.microsoft.intune.mam.build.jar"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "Also include the Duo Maven feed that Ionic documents for current Intune Android SDK releases:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 10,
        "column": 1
      },
      "lang": "kotlin",
      "meta": null,
      "text": "maven {\n  url 'https://pkgs.dev.azure.com/MicrosoftDeviceSDK/DuoSDK-Public/_packaging/Duo-SDK-Feed/maven/v1'\n  name 'Duo-SDK-Feed'\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 17,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 4
          },
          "text": "2. Update the app module"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 19,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 1
          },
          "text": "In "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 19,
            "column": 4
          },
          "text": "android/app/build.gradle"
        },
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 30
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 21,
        "column": 1
      },
      "lang": "kotlin",
      "meta": null,
      "text": "apply plugin: 'com.microsoft.intune.mam'"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "And keep resource optimization disabled:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 27,
        "column": 1
      },
      "lang": "properties",
      "meta": null,
      "text": "android.enableResourceOptimizations=false"
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 4
          },
          "text": "3. Provide "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 15
          },
          "text": "auth_config.json"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Create "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 33,
            "column": 8
          },
          "text": "android/app/src/main/res/raw/auth_config.json"
        },
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 55
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"client_id\": \"YOUR_CLIENT_ID\",\n  \"authorization_user_agent\": \"BROWSER\",\n  \"redirect_uri\": \"msauth://YOUR_PACKAGE/YOUR_SIGNATURE_HASH\",\n  \"broker_redirect_uri_registered\": true,\n  \"account_mode\": \"MULTIPLE\",\n  \"authorities\": [\n    {\n      \"type\": \"AAD\",\n      \"audience\": {\n        \"type\": \"AzureADMyOrg\"\n      }\n    }\n  ]\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 53,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 1
          },
          "text": "The plugin expects that file at runtime for both MSAL and the Intune auth callback."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 55,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 4
          },
          "text": "4. Configure the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 55,
            "column": 21
          },
          "text": "<application>"
        },
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 36
          },
          "text": " tag"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 57,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 1
          },
          "text": "If your app does not already define a custom "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 57,
            "column": 46
          },
          "text": "Application"
        },
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 59
          },
          "text": ", set:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 59,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<application\n  android:name=\"app.capgo.intune.IntuneApplication\"\n  android:enableOnBackInvokedCallback=\"false\">"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 65,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 1
          },
          "text": "If you already have a custom "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 65,
            "column": 30
          },
          "text": "Application"
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 43
          },
          "text": ", extend "
        },
        {
          "type": "inlineCode",
          "location": {
