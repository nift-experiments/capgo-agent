    {
      "type": "code",
      "location": {
        "line": 11,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { SocialLoginAuthConnect } from '@capgo/capacitor-social-login';\n\nawait SocialLoginAuthConnect.initialize({\n  authConnect: {\n    okta: {\n      issuer: 'https://dev-12345.okta.com/oauth2/default',\n      clientId: 'your-okta-client-id',\n      redirectUrl: 'myapp://oauth/okta',\n    },\n  },\n});\n\nconst result = await SocialLoginAuthConnect.login({\n  provider: 'okta',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
