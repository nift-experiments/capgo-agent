  "metadata": {
    "title": "Contributing",
    "description": "A detailed guide on how to contribute to Capgo's open source projects, including the benefits of contributing, the steps involved in making contributions, and the resources available to assist contributors in the process",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Why contribute?"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "First of all, thank you for considering contributing to capgo open source projects! It's people like you that make capgo open source projects such great tools."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "Here are some reasons you might want to cinsder to contribute:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 8,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 8,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 8,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 8,
                    "column": 3
                  },
                  "text": "Contributing to capgo open source projects is a great way to earn some money from the "
                },
                {
                  "type": "link",
                  "location": {
                    "line": 8,
                    "column": 89
                  },
                  "url": "https://console.algora.io/org/Capgo",
                  "title": null,
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 8,
                        "column": 90
                      },
                      "text": "countless bounties"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 8,
                    "column": 146
                  },
                  "text": " that are offered by the capgo team"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 9,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 9,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 9,
                    "column": 3
                  },
                  "text": "Contributing to capgo open source projects is a great way to add a feature you would like to see"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 10,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 10,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 10,
                    "column": 3
                  },
                  "text": "Contributing to capgo open source projects is a great way to fix a bug you encountered"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 11,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 11,
                "column": 3
              },
              "blocks": [
                {
                  "type": "link",
                  "location": {
                    "line": 11,
                    "column": 3
                  },
                  "url": "https://github.com/Cap-go/capgo/blob/main/LICENSE",
                  "title": null,
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 11,
                        "column": 4
                      },
                      "text": "Capgo main's license"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 11,
                    "column": 76
                  },
                  "text": " requires you to open source any changes you make to it. By contributing your code, you get to keep your changes open source and let others use it"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 13,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 4
          },
          "text": "How to contribute"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 15,
        "column": 2
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 15,
            "column": 2
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 15,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 15,
                    "column": 4
                  },
                  "text": "First of all, you need to fork the repository you want to contribute to"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 16,
            "column": 2
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 16,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 16,
                    "column": 4
                  },
                  "text": "Second of all you need to commit and push your changes to that repository"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 17,
            "column": 2
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 17,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 17,
                    "column": 4
                  },
                  "text": "Lastly, you need to open a pull request"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 18,
            "column": 2
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 18,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 18,
                    "column": 4
                  },
                  "text": "That's it! Now you just need to wait for the capgo team to review your PR"
                }
              ]
            }
          ]
        }
      ]
    },
