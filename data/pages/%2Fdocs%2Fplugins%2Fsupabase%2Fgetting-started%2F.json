        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-supabase` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-supabase\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Android Minimum SDK"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "The Android implementation requires Android 8.0 or newer. Set "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 63
          },
          "text": "minSdkVersion = 26"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 83
          },
          "text": " in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 87
          },
          "text": "android/variables.gradle"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 113
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 27,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 4
          },
          "text": "Initialize The Client"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 29,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { CapacitorSupabase } from '@capgo/capacitor-supabase';\n\nawait CapacitorSupabase.initialize({\n  supabaseUrl: 'https://your-project.supabase.co',\n  supabaseKey: 'your-anon-key',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 38,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 4
          },
          "text": "Sign In And Access The JWT"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 40,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const { session, user } = await CapacitorSupabase.signInWithPassword({\n  email: 'user@example.com',\n  password: 'password123',\n});\n\nconsole.log('User', user?.id);\nconsole.log('JWT available', Boolean(session?.accessToken));"
    },
    {
      "type": "heading",
      "location": {
        "line": 50,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 4
          },
          "text": "Listen For Auth Changes"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 52,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const listener = await CapacitorSupabase.addListener('authStateChange', ({ event, session }) => {\n  console.log('Auth event', event);\n  console.log('Current JWT available', Boolean(session?.accessToken));\n});\n\nawait listener.remove();"
    },
    {
      "type": "heading",
      "location": {
        "line": 61,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 4
          },
          "text": "Pair Native Auth With supabase-js"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 63,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { createClient } from '@supabase/supabase-js';\n\nconst { session } = await CapacitorSupabase.getSession();\n\nconst supabase = createClient('https://your-project.supabase.co', 'your-anon-key', {\n  global: {\n    headers: {\n      Authorization: `Bearer ${session?.accessToken}`,\n    },\n  },\n});\n\nconst { data } = await supabase.from('table').select('*');\nconsole.log(data);"
    },
    {
      "type": "heading",
      "location": {
        "line": 80,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 80,
            "column": 4
          },
          "text": "Native Database Helpers"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 82,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const { data, error } = await CapacitorSupabase.select({\n  table: 'users',\n  columns: 'id, name, email',\n  filter: { active: true },\n  limit: 10,\n  orderBy: 'created_at',\n  ascending: false,\n});\n\nconsole.log(data, error);"
    },
