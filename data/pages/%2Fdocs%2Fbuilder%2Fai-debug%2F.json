  "metadata": {
    "title": "AI Build Diagnosis",
    "description": "When a native build fails, Capgo's AI reads the build log and tells you the likely cause, the evidence, and how to fix it.",
    "sidebar": {
      "order": 8,
      "label": "AI Debug"
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "Native build logs are long. When an iOS (Xcode / Fastlane) or Android (Gradle / Fastlane) build fails, Capgo can run the log through an AI build engineer that pinpoints "
        },
        {
          "type": "strong",
          "location": {
            "line": 2,
            "column": 170
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 2,
                "column": 172
              },
              "text": "what went wrong and how to fix it"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 207
          },
          "text": " — so you don't have to scroll thousands of lines yourself."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "Enable it"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "Add "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 5
          },
          "text": "--ai-analytics"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 21
          },
          "text": " to your build:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bunx @capgo/cli@latest build request com.example.app --platform android --ai-analytics"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "The diagnosis only kicks in when a build "
        },
