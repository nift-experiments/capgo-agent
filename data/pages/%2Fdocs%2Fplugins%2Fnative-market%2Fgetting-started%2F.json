  "metadata": {
    "title": "Getting Started",
    "description": "Install @capgo/capacitor-native-market and start using its current Capacitor API.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-native-market` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-native-market\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativeMarket } from '@capgo/capacitor-native-market';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "openStoreListing"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Launch app listing page in Play Store (Android) or App Store (iOS)."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativeMarket } from '@capgo/capacitor-native-market';\n\n// Open app in store\nawait NativeMarket.openStoreListing({\n  appId: 'com.example.app'\n});\n\n// Open app in specific country store (iOS only)\nawait NativeMarket.openStoreListing({\n  appId: 'com.example.app',\n  country: 'IT'\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 50,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 50,
            "column": 5
          },
          "text": "openDevPage"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 52,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 1
          },
          "text": "Deep-link directly to a developer's page in the Play Store.\nAndroid only."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 55,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativeMarket } from '@capgo/capacitor-native-market';\n\nawait NativeMarket.openDevPage({\n  devId: 'Google+LLC'\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 63,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 63,
            "column": 5
          },
          "text": "openCollection"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 65,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 1
          },
          "text": "Link users to a collection or top charts in the Play Store.\nAndroid only."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 68,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativeMarket } from '@capgo/capacitor-native-market';\n\nawait NativeMarket.openCollection({\n  name: 'featured'\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 76,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 76,
            "column": 5
          },
          "text": "openEditorChoicePage"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 78,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 78,
            "column": 1
          },
          "text": "Link users to Editor's choice page in the Play Store.\nAndroid only."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 81,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativeMarket } from '@capgo/capacitor-native-market';\n\nawait NativeMarket.openEditorChoicePage({\n  editorChoice: 'editorial_fitness_apps_us'\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 89,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 89,
            "column": 5
          },
          "text": "search"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 91,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 91,
            "column": 1
          },
          "text": "Search the Play Store with custom search terms.\nAndroid only."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 94,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativeMarket } from '@capgo/capacitor-native-market';\n\nawait NativeMarket.search({\n  terms: 'fitness apps'\n});"
    },
