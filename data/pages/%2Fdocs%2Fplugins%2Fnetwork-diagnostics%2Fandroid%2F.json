        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "Android can expose whether the active network is internet validated or marked as captive portal capable. These flags help explain cases where the device is connected to Wi-Fi but the app cannot reach your backend."
        }
      ]
    },
    {
      "type": "heading",
