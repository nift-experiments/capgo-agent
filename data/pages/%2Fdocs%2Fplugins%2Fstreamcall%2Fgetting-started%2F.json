      "lang": "typescript",
      "meta": null,
      "text": "export type CallState =\n  // User-facing states\n  | 'idle'\n  | 'ringing'\n  | 'joining'\n  | 'reconnecting'\n  | 'joined'\n  | 'leaving'\n  | 'left'\n  // Event-specific states\n  | 'created'\n  | 'session_started'\n  | 'rejected'\n  | 'participant_counts'\n  | 'missed'\n  | 'accepted'\n  | 'ended'\n  | 'camera_enabled'\n  | 'camera_disabled'\n  | 'speaker_enabled'\n  | 'speaker_disabled'\n  | 'microphone_enabled'\n  | 'microphone_disabled'\n  | 'outgoing_call_ended'\n  | 'unknown';"
