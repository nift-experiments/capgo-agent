          "location": {
            "line": 5,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 7,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-android-kiosk\nbunx cap sync"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "bunx cap sync"
        },
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 16
          },
          "text": " copies the plugin's native code into your native projects. Run it again after every plugin upgrade."
