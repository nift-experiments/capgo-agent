                "column": 19
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 24,
                    "column": 21
                  },
                  "text": "Checks if the app is currently running in kiosk mode."
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "location": {
            "line": 25,
            "column": 1
          },
          "blocks": [
            {
