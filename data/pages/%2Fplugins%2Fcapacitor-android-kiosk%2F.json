        "line": 3,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "Capacitor Android Kiosk Plugin for controlling kiosk mode and launcher functionality. This plugin is Android-only. For iOS kiosk mode, use the device's Guided Access feature."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 5,
        "column": 1
      },
      "depth": 2,
      "blocks": [
