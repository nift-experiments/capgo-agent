                  },
                  "text": "isSetAsLauncher"
                }
              ]
            },
            {
              "type": "tableCell",
              "location": {
                "line": 25,
                "column": 21
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 25,
                    "column": 23
                  },
                  "text": "Checks if the app is set as the device launcher (home app)."
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "location": {
            "line": 26,
            "column": 1
          },
          "blocks": [
            {
              "type": "tableCell",
              "location": {
                "line": 26,
                "column": 1
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 26,
                    "column": 3
                  },
                  "text": "enterKioskMode"
                }
              ]
            },
            {
              "type": "tableCell",
              "location": {
                "line": 26,
                "column": 20
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 26,
                    "column": 22
                  },
                  "text": "Enters kiosk mode, hiding system UI and blocking hardware buttons. Also starts a foreground keep-alive service so the app is less likely to be killed by the system. The app must be set as the device launcher for this to work effectively."
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "location": {
            "line": 27,
            "column": 1
          },
          "blocks": [
            {
              "type": "tableCell",
              "location": {
                "line": 27,
                "column": 1
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 27,
                    "column": 3
                  },
                  "text": "exitKioskMode"
                }
              ]
            },
            {
              "type": "tableCell",
              "location": {
                "line": 27,
                "column": 19
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 27,
                    "column": 21
                  },
                  "text": "Exits kiosk mode, restoring normal system UI and hardware button functionality. Also stops the foreground keep-alive service started in enterKioskMode()."
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "location": {
            "line": 28,
            "column": 1
          },
          "blocks": [
            {
              "type": "tableCell",
              "location": {
                "line": 28,
                "column": 1
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 28,
                    "column": 3
                  },
                  "text": "setAsLauncher"
                }
              ]
            },
            {
              "type": "tableCell",
              "location": {
                "line": 28,
                "column": 19
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 28,
                    "column": 21
                  },
                  "text": "Opens the device's home screen settings to allow user to set this app as the launcher. This is required for full kiosk mode functionality."
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "location": {
            "line": 29,
            "column": 1
          },
          "blocks": [
            {
              "type": "tableCell",
              "location": {
                "line": 29,
                "column": 1
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 29,
                    "column": 3
                  },
                  "text": "setAllowedKeys"
                }
              ]
            },
            {
              "type": "tableCell",
              "location": {
                "line": 29,
                "column": 20
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 29,
                    "column": 22
                  },
                  "text": "Sets which hardware keys are allowed to function in kiosk mode. By default, all hardware keys are blocked in kiosk mode."
                }
              ]
            }
          ]
        }
      ]
