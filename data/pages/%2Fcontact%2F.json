                  "blocks": [
                    {
                      "type": "text",
                      "text": "support@capgo.app"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ". Commercial, enterprise, and partnership questions go to\n        "
                },
                {
                  "type": "element",
                  "name": "a",
                  "props": {
                    "class": "",
                    "href": "mailto:sales@capgo.app"
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "text": "sales@capgo.app"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ". If you already have a Capgo organization, open the in-app chat from the console or use "
