    "title": "Android setup",
    "description": "Configure Android requirements for the Verisoul Capacitor plugin.",
    "sidebar": {
      "order": 4
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Native SDK"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "The plugin depends on Verisoul's Android SDK and adds the required Maven repository in its Gradle file:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "groovy",
      "meta": null,
      "text": "maven { url = uri(\"https://us-central1-maven.pkg.dev/verisoul/android\") }"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "If your app cannot resolve "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 10,
            "column": 28
          },
          "text": "ai.verisoul:android"
        },
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 49
          },
          "text": ", add that repository to your root Gradle repositories."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 12,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 4
          },
          "text": "Permissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 14,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 1
          },
          "text": "The plugin manifest declares the required network permissions:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 16,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\" />\n<uses-permission android:name=\"android.permission.INTERNET\" />"
    },
    {
      "type": "heading",
      "location": {
        "line": 21,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 21,
            "column": 4
          },
          "text": "Sync"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 23,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 1
          },
          "text": "After installing the plugin, sync Android:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx cap sync android"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "Touch signals"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 31,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 1
          },
          "text": "Android exposes Verisoul touch-signal collection through "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 58
          },
          "text": "recordTouchEvent()"
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 78
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 33,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Verisoul } from '@capgo/capacitor-verisoul';\n\nawait Verisoul.recordTouchEvent({\n  x: 120,\n  y: 240,\n  action: 'down',\n});"
    },
    {
