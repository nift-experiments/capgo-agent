      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-pay` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-pay\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Pay } from '@capgo/capacitor-pay';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "isPayAvailable"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Checks whether native pay is available on the current platform.\nOn iOS this evaluates Apple Pay, on Android it evaluates Google Pay."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Pay } from '@capgo/capacitor-pay';\n\nconst result = await Pay.isPayAvailable();\nconsole.log(result);"
    },
    {
      "type": "heading",
      "location": {
        "line": 43,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 43,
            "column": 5
          },
          "text": "requestPayment"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 45,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 1
          },
          "text": "Presents the native pay sheet for the current platform.\nProvide the Apple Pay configuration on iOS and the Google Pay configuration on Android."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 48,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 1
          },
          "text": "This promise is the completion path on both platforms."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 50,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Pay } from '@capgo/capacitor-pay';\n\nconst result = await Pay.requestPayment({\n  apple: {\n    merchantIdentifier: 'merchant-identifier-123',\n    countryCode: 'US',\n    currencyCode: 'USD',\n    paymentSummaryItems: [\n      {\n        label: 'Hello from Capacitor',\n        amount: 'amount',\n      },\n    ],\n    supportedNetworks: ['AmEx'],\n  },\n});\n// The result holds sensitive values: use it without logging it."
    },
    {
      "type": "heading",
      "location": {
        "line": 70,
        "column": 1
      },
      "depth": 2,
      "blocks": [
