        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface PayAvailabilityOptions {\n  apple?: ApplePayAvailabilityOptions;\n  google?: GooglePayAvailabilityOptions;\n}"
    },
    {
