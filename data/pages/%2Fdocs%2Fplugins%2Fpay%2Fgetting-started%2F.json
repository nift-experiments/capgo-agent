    "title": "Getting Started",
    "description": "Install @capgo/capacitor-pay and start using its current Capacitor API.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
