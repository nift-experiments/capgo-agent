        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface PayAvailabilityResult {\n  available: boolean;\n  platform: PayPlatform;\n  apple?: ApplePayAvailabilityResult;\n  google?: GooglePayAvailabilityResult;\n}"
    },
    {
      "type": "heading",
      "location": {
