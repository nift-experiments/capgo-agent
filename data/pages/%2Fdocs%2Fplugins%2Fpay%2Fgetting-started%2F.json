    {
      "type": "code",
      "location": {
        "line": 137,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface ApplePayAvailabilityResult {\n  /**\n   * Indicates whether the device can make Apple Pay payments in general.\n   */\n  canMakePayments: boolean;\n  /**\n   * Indicates whether the device can make Apple Pay payments with the supplied networks.\n   */\n  canMakePaymentsUsingNetworks: boolean;\n}"
    },
    {
