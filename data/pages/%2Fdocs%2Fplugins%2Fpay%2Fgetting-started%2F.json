    },
    {
      "type": "code",
      "location": {
        "line": 104,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface ApplePayAvailabilityOptions {\n  /**\n   * Optional list of payment networks you intend to use.\n   * Passing networks determines the return value of `canMakePaymentsUsingNetworks`.\n   */\n  supportedNetworks?: ApplePayNetwork[];\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 114,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
