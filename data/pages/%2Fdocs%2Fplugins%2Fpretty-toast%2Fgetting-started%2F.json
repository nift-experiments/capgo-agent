      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-pretty-toast` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-pretty-toast\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { toast } from '@capgo/capacitor-pretty-toast';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "Show A Toast"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 31,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "toast.success('Saved', {\n  message: 'Your changes are ready.',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 37,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 37,
            "column": 4
          },
          "text": "Update A Loading Toast"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 39,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const id = toast.loading('Uploading', {\n  message: 'Waiting for the server response.',\n});\n\nsetTimeout(() => {\n  toast.update(id, {\n    title: 'Upload complete',\n    message: 'The file was stored successfully.',\n    icon: 'checkmark.circle.fill',\n    autoDismiss: true,\n  });\n}, 1500);"
    },
    {
      "type": "heading",
      "location": {
        "line": 54,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 4
          },
          "text": "Track A Promise"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 56,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await toast.promise(uploadFile(), {\n  loading: {\n    title: 'Uploading',\n    message: 'Keep the app open while the file is sent.',\n  },\n  success: 'Uploaded',\n  error: 'Upload failed',\n});"
    },
    {
