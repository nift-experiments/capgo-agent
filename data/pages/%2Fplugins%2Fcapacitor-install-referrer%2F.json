              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 18,
                    "column": 3
                  },
                  "text": "Android returns the Play referrer string, click timestamp, install timestamp, and instant app flag."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 19,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 19,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 19,
                    "column": 3
                  },
                  "text": "iOS returns an AdServices attribution token and can optionally fetch Apple's attribution payload."
                }
              ]
            }
          ]
        }
      ]
