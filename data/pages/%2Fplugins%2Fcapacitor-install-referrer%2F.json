          },
          "text": "Example Usage"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 23,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { InstallReferrer } from '@capgo/capacitor-install-referrer';\n\nconst result = await InstallReferrer.getReferrer();\n\nif (result.platform === 'android') {\n  console.log(result.referrer);\n}\n\nif (result.platform === 'ios') {\n  console.log(result.attributionToken);\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 37,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 37,
            "column": 4
          },
          "text": "Apple Attribution Payload"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 39,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await InstallReferrer.getReferrer({\n  fetchAppleAttribution: true,\n  appleAttributionRetryCount: 3,\n  appleAttributionRetryDelayMs: 5000,\n});\n\nconsole.log(result.appleAttribution);"
    },
    {
      "type": "heading",
      "location": {
        "line": 49,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 4
          },
          "text": "Platform Notes"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "Android uses the Google Play Install Referrer service and requires a Play Store install for real referrer data. iOS uses Apple AdServices because Apple does not provide a generic App Store install referrer equivalent."
        }
      ]
    },
