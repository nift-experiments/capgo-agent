          },
          "text": "@capgo/capacitor-install-referrer"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 36
          },
          "text": " reads install attribution signals in Capacitor apps."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 5,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 1
          },
          "text": "Use it when you need Google Play Install Referrer data on Android and Apple AdServices attribution tokens on iOS through one API."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 7,
        "column": 1
      },
