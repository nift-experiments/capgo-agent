                {
                  "type": "text",
                  "location": {
                    "line": 92,
                    "column": 3
                  },
                  "text": "Always call "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 92,
                    "column": 15
                  },
                  "text": "notifyAppReady()"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 92,
                    "column": 33
                  },
                  "text": " early in the renderer so rollback protection works as intended."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 93,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 93,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 93,
                    "column": 3
                  },
                  "text": "Keep the built-in path stable and let the updater decide whether to load the shipped bundle or a downloaded one."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 94,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
