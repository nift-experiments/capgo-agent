          },
          "text": "Using @capgo/electron-updater"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "@capgo/electron-updater"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 26
          },
          "text": " gives Electron apps the same Capgo live-update model as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 83
          },
          "text": "@capgo/capacitor-updater"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 109
          },
          "text": ". You initialize it in the main process, expose the renderer bridge through preload, and call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 203
          },
          "text": "notifyAppReady()"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 221
          },
          "text": " on every launch so rollback protection knows the bundle is healthy."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "Installation"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/electron-updater"
    },
    {
      "type": "heading",
      "location": {
        "line": 12,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 4
          },
          "text": "Main process setup"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 14,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { app, BrowserWindow } from 'electron';\nimport path from 'node:path';\nimport { ElectronUpdater, setupEventForwarding, setupIPCHandlers } from '@capgo/electron-updater';\n\nconst updater = new ElectronUpdater({\n  appId: 'com.example.desktop',\n  autoUpdate: true,\n});\n\napp.whenReady().then(async () => {\n  const window = new BrowserWindow({\n    webPreferences: {\n      preload: path.join(__dirname, 'preload.js'),\n      contextIsolation: true,\n    },\n  });\n\n  const builtinPath = path.join(__dirname, 'www/index.html');\n  await updater.initialize(window, builtinPath);\n  setupIPCHandlers(updater);\n  setupEventForwarding(updater, window);\n\n  await window.loadFile(updater.getCurrentBundlePath());\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 41,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 41,
            "column": 4
          },
          "text": "Preload bridge"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 43,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { exposeUpdaterAPI } from '@capgo/electron-updater/preload';\n\nexposeUpdaterAPI();"
    },
    {
      "type": "heading",
      "location": {
        "line": 49,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 4
          },
          "text": "Renderer usage"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 51,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { requireUpdater } from '@capgo/electron-updater/renderer';\n\nconst updater = requireUpdater();\n\nawait updater.notifyAppReady();\n\nconst latest = await updater.getLatest();\n\nif (latest.url && !latest.error) {\n  const bundle = await updater.download({\n    url: latest.url,\n    version: latest.version,\n    checksum: latest.checksum,\n  });\n\n  await updater.next({ id: bundle.id });\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 71,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 71,
            "column": 4
          },
          "text": "Listen for update events"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 73,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "updater.addListener('download', ({ percent }) => {\n  console.log('Download progress', percent);\n});\n\nupdater.addListener('updateFailed', ({ bundle }) => {\n  console.error('Update failed', bundle.version);\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 83,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 83,
            "column": 4
          },
          "text": "Deploy a new bundle"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 85,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun run build\nbunx @capgo/cli@latest bundle upload --channel=production"
    },
    {
      "type": "heading",
      "location": {
