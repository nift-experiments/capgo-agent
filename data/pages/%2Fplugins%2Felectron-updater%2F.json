              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 94,
                    "column": 3
                  },
                  "text": "Reuse the same Capgo channel and rollout model you already use on mobile when your Electron app shares a backend release pipeline."
                }
              ]
            }
          ]
        }
      ]
