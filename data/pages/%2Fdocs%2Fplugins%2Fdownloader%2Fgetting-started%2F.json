        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-downloader` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-downloader\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorDownloader } from '@capgo/capacitor-downloader';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "download"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Start a new download task."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorDownloader } from '@capgo/capacitor-downloader';\n\nconst task = await CapacitorDownloader.download({\n  id: 'my-download',\n  url: 'https://example.com/file.pdf',\n  destination: 'downloads/file.pdf'\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 45,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 45,
            "column": 5
          },
          "text": "pause"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 47,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 1
          },
          "text": "Pause an active download.\nDownload can be resumed later from the same position."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 50,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorDownloader } from '@capgo/capacitor-downloader';\n\nawait CapacitorDownloader.pause({ id: 'id-123' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 56,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 56,
            "column": 5
          },
          "text": "resume"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 58,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 58,
            "column": 1
          },
          "text": "Resume a paused download.\nContinues from where it was paused."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 61,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorDownloader } from '@capgo/capacitor-downloader';\n\nawait CapacitorDownloader.resume({ id: 'id-123' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 67,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
