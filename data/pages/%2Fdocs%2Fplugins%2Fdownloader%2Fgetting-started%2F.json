    },
    {
      "type": "paragraph",
      "location": {
        "line": 103,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 103,
            "column": 1
          },
          "text": "Configuration options for starting a download."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 104,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface DownloadOptions {\n  /** Unique identifier for this download task */\n  id: string;\n  /** URL of the file to download */\n  url: string;\n  /** Local file path where the download will be saved */\n  destination: string;\n  /** Optional HTTP headers to include in the request */\n  headers?: { [key: string]: string };\n  /** Network type requirement for download */\n  network?: 'cellular' | 'wifi-only';\n  /** Download priority level */\n  priority?: 'high' | 'normal' | 'low';\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 121,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 121,
            "column": 5
          },
          "text": "DownloadTask"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 122,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 122,
            "column": 1
          },
          "text": "Represents the current state and progress of a download task."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 123,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface DownloadTask {\n  /** Unique identifier for the download task */\n  id: string;\n  /** Download progress from 0 to 100 */\n  progress: number;\n  /** Current state of the download */\n  state: 'PENDING' | 'RUNNING' | 'PAUSED' | 'DONE' | 'ERROR';\n}"
    },
