        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "Stop and cancel a download permanently.\nDownloaded data will be deleted."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 72,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorDownloader } from '@capgo/capacitor-downloader';\n\nawait CapacitorDownloader.stop({ id: 'id-123' });"
    },
