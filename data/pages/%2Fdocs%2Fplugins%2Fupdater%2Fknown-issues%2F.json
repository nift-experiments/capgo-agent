          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 14,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 14,
                    "column": 3
                  },
                  "text": "This usually happens when large updates (> 20mb) are pushed, a big percentage of users will not get the last version."
                },
                {
                  "type": "break",
                  "location": {
                    "line": 14,
                    "column": 120
                  }
                },
                {
                  "type": "text",
                  "location": {
                    "line": 15,
                    "column": 1
                  },
                  "text": "In the past, users needed to keep the app open until the download was done, now we use background download, but it's still limited to a few seconds."
                }
              ]
            }
          ]
        }
      ]
    },
