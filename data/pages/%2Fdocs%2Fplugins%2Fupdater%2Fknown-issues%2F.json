          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 6,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 6,
                    "column": 3
                  },
                  "text": "When you develop, if you use the Ionic live reload feature from the CLI, it will override the plugin, so you will never see your update."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 8,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 4
          },
          "text": "Quasar live reload"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 10,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
