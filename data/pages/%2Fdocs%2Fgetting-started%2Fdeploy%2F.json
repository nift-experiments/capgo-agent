                      "lang": "yml",
                      "meta": null,
                      "text": "// .gitlab-ci.yml\nstages:\n  - build\n\nbuild:\n  stage: build\n  image: node:18\n  cache:\n    - key:\n        files:\n          - package-lock.json\n      paths:\n        - .node_modules/\n  script:\n    - npm install\n    - npm run build\n    - npx @capgo/cli@latest bundle upload -a $CAPGO_TOKEN --channel $CAPGO_CHANNEL\n  artifacts:\n    paths:\n      - node_modules/\n      - dist/\n  only:\n    - master"
