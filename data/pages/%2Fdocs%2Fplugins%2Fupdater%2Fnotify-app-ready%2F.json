  "metadata": {
    "title": "Placing CapacitorUpdater.notifyAppReady() call correctly",
    "description": "How to properly place the CapacitorUpdater.notifyAppReady() call in your app to ensure correct auto-update flow.",
    "tableOfContents": false,
    "next": false,
    "prev": false,
    "sidebar": {
      "order": 1,
      "label": "Introduction"
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 7,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 1
          },
          "text": "The placement of the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 7,
            "column": 22
          },
          "text": "CapacitorUpdater.notifyAppReady()"
        },
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 57
          },
          "text": " call is crucial for the correct auto-update flow."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "If not done correctly, the app will not be able to update to the latest version. Each version that does not call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 10,
            "column": 114
          },
          "text": "notifyAppReady()"
        },
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 132
          },
          "text": " within 10 seconds will be marked as invalid and will be replaced by the previous valid version or the default (built-in) version."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 13,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 1
          },
          "text": "In this guide we will show you how to properly place the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 13,
            "column": 58
          },
          "text": "notifyAppReady()"
        },
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 76
          },
          "text": " call in your app to ensure correct auto-update flow."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 15,
        "column": 1
      },
      "depth": 3,
