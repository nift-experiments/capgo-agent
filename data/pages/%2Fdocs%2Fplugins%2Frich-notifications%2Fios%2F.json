  "version": 1,
  "route": "/docs/plugins/rich-notifications/ios/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/plugins/rich-notifications/ios.mdx",
  "sourceSha256": "2478f92a8dd9bf5dc73147dd40fefadeaf3a479a5158846b8c0b74c19cb5ae7d",
  "metadata": {
    "title": "iOS setup",
    "description": "Categories, interruption levels, and permissions for @capgo/capacitor-rich-notifications.",
    "sidebar": {
      "order": 3
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "No custom Info.plist keys are required for standard local notifications. Call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 2,
            "column": 79
          },
          "text": "RichNotifications.requestPermission()"
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 118
          },
          "text": " before showing notifications."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Register action categories with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 33
          },
          "text": "registerActions"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 50
          },
          "text": " and reference "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 65
          },
          "text": "categoryId"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 77
          },
          "text": " on each notification. Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 104
          },
          "text": "interruptionLevel"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 123
          },
          "text": " for delivery priority on iOS 15+."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "timeSensitive"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 16
          },
          "text": " can break through Focus when the user allows "
        },
        {
          "type": "strong",
          "location": {
            "line": 6,
            "column": 62
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 6,
                "column": 64
              },
              "text": "Time Sensitive Notifications"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 94
          },
          "text": " for your app in Settings. It is not enabled by the API alone."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 8,
            "column": 5
          },
          "text": "critical"
        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 15
          },
          "text": " interruption level requires Apple's Critical Alerts entitlement. Without it, use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 8,
            "column": 97
          },
          "text": "timeSensitive"
        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 112
          },
          "text": " or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 8,
            "column": 116
          },
          "text": "active"
        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 124
          },
          "text": "."
        }
      ]
    }
  ]
}
