              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 36,
                    "column": 3
                  },
                  "text": "Values must be either a string or a non-negative integer."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 37,
            "column": 1
