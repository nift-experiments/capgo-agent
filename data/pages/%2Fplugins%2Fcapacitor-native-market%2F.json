      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativeMarket } from '@capgo/capacitor-native-market';\n\n// Open app in store\nawait NativeMarket.openStoreListing({\n  appId: 'com.example.app'\n});\n\n// Open app in specific country store (iOS only)\nawait NativeMarket.openStoreListing({\n  appId: 'com.example.app',\n  country: 'IT'\n});"
