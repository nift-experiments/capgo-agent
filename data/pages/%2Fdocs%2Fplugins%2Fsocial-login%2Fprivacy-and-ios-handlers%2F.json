  "metadata": {
    "title": "Privacy Manifest and iOS URL Handlers",
    "description": "Add app-level privacy manifests and combine Facebook and Google URL callbacks for @capgo/capacitor-social-login.",
    "sidebar": {
      "order": 7
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Privacy manifest for app developers"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "If you use Google, Facebook, or Apple login, declare the data collected by those SDKs in your app's "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 101
          },
          "text": "PrivacyInfo.xcprivacy"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 124
          },
          "text": " file. Add the file in your app at "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 159
          },
          "text": "ios/App/PrivacyInfo.xcprivacy"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 190
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "Do not add this file to the plugin package. Adjust the data types to match your app's usage and the provider SDK documentation."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 8,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 5
          },
          "text": "Google Sign-In example"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 10,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"NSPrivacyCollectedDataTypes\": [\n    { \"NSPrivacyCollectedDataType\": \"EmailAddress\", \"NSPrivacyCollectedDataTypeLinked\": true, \"NSPrivacyCollectedDataTypeTracking\": false },\n    { \"NSPrivacyCollectedDataType\": \"Name\", \"NSPrivacyCollectedDataTypeLinked\": true, \"NSPrivacyCollectedDataTypeTracking\": false },\n    { \"NSPrivacyCollectedDataType\": \"UserID\", \"NSPrivacyCollectedDataTypeLinked\": true, \"NSPrivacyCollectedDataTypeTracking\": false }\n  ]\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 20,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 20,
            "column": 5
          },
          "text": "Facebook Login example"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 22,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"NSPrivacyCollectedDataTypes\": [\n    { \"NSPrivacyCollectedDataType\": \"EmailAddress\", \"NSPrivacyCollectedDataTypeLinked\": true, \"NSPrivacyCollectedDataTypeTracking\": false },\n    { \"NSPrivacyCollectedDataType\": \"Name\", \"NSPrivacyCollectedDataTypeLinked\": true, \"NSPrivacyCollectedDataTypeTracking\": false },\n    { \"NSPrivacyCollectedDataType\": \"UserID\", \"NSPrivacyCollectedDataTypeLinked\": true, \"NSPrivacyCollectedDataTypeTracking\": false },\n    { \"NSPrivacyCollectedDataType\": \"FriendsList\", \"NSPrivacyCollectedDataTypeLinked\": true, \"NSPrivacyCollectedDataTypeTracking\": false }\n  ]\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 33,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 5
          },
          "text": "Apple Sign-In example"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"NSPrivacyCollectedDataTypes\": [\n    { \"NSPrivacyCollectedDataType\": \"EmailAddress\", \"NSPrivacyCollectedDataTypeLinked\": true, \"NSPrivacyCollectedDataTypeTracking\": false },\n    { \"NSPrivacyCollectedDataType\": \"Name\", \"NSPrivacyCollectedDataTypeLinked\": true, \"NSPrivacyCollectedDataTypeTracking\": false }\n  ]\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Review "
        },
        {
          "type": "link",
          "location": {
            "line": 44,
            "column": 8
          },
          "url": "https://developer.apple.com/documentation/bundleresources/privacy_manifest_files/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 44,
                "column": 9
              },
              "text": "Apple's privacy manifest documentation"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 131
          },
          "text": " for all allowed keys and values."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 46,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 4
          },
          "text": "Combine Facebook and Google URL handlers"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 48,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 1
          },
          "text": "When an iOS app uses both Facebook and Google login, route the callback URL to both SDKs before passing it back to Capacitor."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 50,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 1
          },
          "text": "In "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 50,
            "column": 4
          },
          "text": "ios/App/App/AppDelegate.swift"
        },
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 35
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 52,
        "column": 1
      },
      "lang": "swift",
      "meta": null,
      "text": "func application(_ app: UIApplication, open url: URL, options: [UIApplication.OpenURLOptionsKey: Any] = [:]) -> Bool {\n    // Return true if the URL was handled by either Facebook or Google authentication.\n    if FBSDKCoreKit.ApplicationDelegate.shared.application(\n        app,\n        open: url,\n        sourceApplication: options[UIApplication.OpenURLOptionsKey.sourceApplication] as? String,\n        annotation: options[UIApplication.OpenURLOptionsKey.annotation]\n    ) || GIDSignIn.sharedInstance.handle(url) {\n        return true\n    }\n\n    return ApplicationDelegateProxy.shared.application(app, open: url, options: options)\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 68,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 68,
            "column": 1
          },
          "text": "Make sure "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 68,
            "column": 11
          },
          "text": "AppDelegate.swift"
        },
        {
          "type": "text",
          "location": {
            "line": 68,
            "column": 30
          },
          "text": " imports the SDKs used by your app:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 70,
        "column": 1
      },
      "lang": "swift",
      "meta": null,
      "text": "import Capacitor\nimport FBSDKCoreKit\nimport GoogleSignIn\nimport UIKit"
    },
