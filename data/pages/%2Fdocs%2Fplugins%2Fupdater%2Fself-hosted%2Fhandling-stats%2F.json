  "metadata": {
    "title": "Statistics API",
    "description": "How to use the statistics endpoint of Capgo with the auto-update plugin in self-hosted mode, what they are used for and what to expect",
    "sidebar": {
      "order": 7
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "Statistics API"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "Starting from version 1.3.0 the update system is able to send stats!"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "By default, all stats are sent to our server, to understand usage and research."
        }
      ]
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {},
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 11,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 11,
                "column": 1
              },
              "text": "No private data is sent for stats, only random UUID, version update, version native app, platform, action, and app ID."
            }
          ]
        }
      ],
      "location": {
        "line": 10,
        "column": 1
      }
    },
    {
      "type": "paragraph",
      "location": {
        "line": 14,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 1
          },
          "text": "If you want to send this data to your server instead, change the config below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 16,
        "column": 1
      },
      "lang": "tsx",
      "meta": null,
      "text": "// capacitor.config.json\n{\n\t\"appId\": \"**.***.**\",\n\t\"appName\": \"Name\",\n\t\"plugins\": {\n\t\t\"CapacitorUpdater\": {\n\t\t\t\"statsUrl\": \"YOUR_URL\"\n\t\t}\n\t}\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "Data Structure"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 31,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 1
          },
          "text": "What your server will receive is:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 33,
        "column": 1
      },
      "lang": "tsx",
      "meta": null,
      "text": "interface AppInfosStats {\n\t\"action\": \"set\", // can be set, delete, set_fail, reset, revert\n\t// Then it's the same info as update\n\t\"app_id\": \"**.***.**\", // app identifier in the store\n\t\"device_id\": \"*******\", // unique id per app install\n\t\"platform\": \"ios\", // or android, or electron\n\t\"custom_id\": \"user_1\", // represent your user\n        \"version_name\": \"1.2.3\", // version of the web build\n        \"version_build\": \"1.2.0\", // version of the native build\n        \"version_code\": \"120\", // build number of the native build\n\t\"version_os\": \"16\", // OS version of the device\n        \"plugin_version\": \"4.0.0\"// to make your api behave differently with different plugins\n        \"is_emulator\": false,\n    \t\"is_prod\": false,\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "You can also totally disable it, with an empty string. Keep in mind, statistics are made private friendly and help me to understand how people use the plugin, to resolve issues and improve it."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 53,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 4
          },
          "text": "Expected \"no update\" behavior"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "When your update endpoint has "
        },
        {
          "type": "strong",
          "location": {
            "line": 55,
            "column": 31
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 55,
                "column": 33
              },
              "text": "no new version"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 49
          },
          "text": ", it should respond with an error payload like:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 57,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{ \"error\": \"no_new_version_available\", \"message\": \"No new version available\" }"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 61,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 1
          },
          "text": "The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 5
          },
          "text": "error"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 12
          },
          "text": " code must be exactly "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 34
          },
          "text": "no_new_version_available"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 60
          },
          "text": ". The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 66
          },
          "text": "message"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 75
          },
          "text": " can be any string you want (it’s only for logging/debugging). This is the expected behavior and it is still returned with HTTP "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 203
          },
          "text": "200"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 208
          },
          "text": ". If your update endpoint instead returns a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 252
          },
          "text": "200"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 257
          },
          "text": " response without a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 277
          },
          "text": "url"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 282
          },
          "text": ", the plugin will treat it as a download failure and send a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 342
          },
          "text": "download_fail"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 357
          },
          "text": " stat."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 63,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 63,
            "column": 4
          },
          "text": "Implementation Example"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 65,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 1
          },
          "text": "Here is an example of code in JavaScript to save the stats of the plugin:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 67,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "interface AppInfos {\n  version_name: string\n  action: 'delete' |\n          'reset' |\n          'set' |\n          'get' |\n          'set_fail' |\n          'update_fail' |\n          'download_fail' |\n          'windows_path_fail' |\n          'canonical_path_fail' |\n          'directory_path_fail' |\n          'unzip_fail' |\n          'low_mem_fail' |\n          'download_10' |\n          'download_20' |\n          'download_30' |\n          'download_40' |\n          'download_50' |\n          'download_60' |\n          'download_70' |\n          'download_80' |\n          'download_90' |\n          'download_complete' |\n          'decrypt_fail' |\n          'app_moved_to_foreground' |\n          'app_moved_to_background' |\n          'uninstall' |\n          'needPlanUpgrade' |\n          'missingBundle' |\n          'noNew' |\n          'disablePlatformIos' |\n          'disablePlatformAndroid' |\n          'disableAutoUpdateToMajor' |\n          'cannotUpdateViaPrivateChannel' |\n          'disableAutoUpdateToMinor' |\n          'disableAutoUpdateToPatch' |\n          'channelMisconfigured' |\n          'disableAutoUpdateMetadata' |\n          'disableAutoUpdateUnderNative' |\n          'disableDevBuild' |\n          'disableEmulator' |\n          'disablePlatformElectron' |\n          'disableProdBuild' |\n          'disableDevice' |\n          'customIdBlocked' |\n          'cannotGetBundle' |\n          'checksum_fail' |\n          'checksum_required' |\n          'NoChannelOrOverride' |\n          'setChannel' |\n          'getChannel' |\n          'rateLimited' |\n          'disableAutoUpdate' |\n          'keyMismatch' |\n          'ping' |\n          'InvalidIp' |\n          'blocked_by_server_url' |\n          'download_manifest_start' |\n          'download_manifest_complete' |\n          'download_zip_start' |\n          'download_zip_complete' |\n          'download_manifest_file_fail' |\n          'download_manifest_checksum_fail' |\n          'download_manifest_brotli_fail' |\n          'backend_refusal' |\n          'app_crash' |\n          'app_crash_native' |\n          'app_anr' |\n          'app_killed_low_memory' |\n          'app_killed_excessive_resource_usage' |\n          'app_initialization_failure' |\n          'app_memory_warning' |\n          'webview_javascript_error' |\n          'webview_unhandled_rejection' |\n          'webview_resource_error' |\n          'webview_security_policy_violation' |\n          'webview_unclean_restart' |\n          'webview_render_process_gone' |\n          'webview_content_process_terminated' |\n          'os_version_changed' |\n          'native_app_version_changed' |\n          'download_0'\n  version_build: string\n  version_code: string\n  version_os: string\n  plugin_version: string\n  platform: string\n  app_id: string\n  device_id: string\n  custom_id?: string\n  is_prod?: boolean\n  is_emulator?: boolean\n}\n\nexport const handler: Handler = async (event) => {\n  const body = JSON.parse(event.body || '{}') as AppInfos\n  const {\n    platform,\n    app_id,\n    action,\n    version_code,\n    version_os,\n    device_id,\n    version_name,\n    version_build,\n    plugin_version,\n  } = body\n  console.log('update asked', platform,\n    app_id,\n    action,\n    version_os,\n    version_code,\n    device_id,\n    version_name,\n    version_build,\n    plugin_version)\n  // Save it in your database\n  return { status: 'ok' }\n}"
    },
