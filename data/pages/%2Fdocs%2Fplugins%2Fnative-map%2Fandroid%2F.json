{
  "version": 1,
  "route": "/docs/plugins/native-map/android/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/plugins/native-map/android.mdx",
  "sourceSha256": "5e1ffc94086a3d29b9db478622471e8606cffdebbb0651c3b91b1f21d329b7e3",
  "metadata": {
    "title": "Android setup",
    "description": "Google Maps SDK API key and compositing for @capgo/capacitor-native-map.",
    "sidebar": {
      "order": 4
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "Android uses the "
        },
        {
          "type": "strong",
          "location": {
            "line": 2,
            "column": 18
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 2,
                "column": 20
              },
              "text": "Google Maps SDK"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 37
          },
          "text": ". Add your API key as manifest metadata in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 2,
            "column": 80
          },
          "text": "android/app/src/main/AndroidManifest.xml"
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 122
          },
          "text": " inside "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 2,
            "column": 130
          },
          "text": "<application>"
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 145
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 4,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<meta-data\n    android:name=\"com.google.android.geo.API_KEY\"\n    android:value=\"${GOOGLE_MAPS_API_KEY}\" />"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Inside "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 10,
            "column": 8
          },
          "text": "android { defaultConfig { ... } }"
        },
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 43
          },
          "text": " in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 10,
            "column": 47
          },
          "text": "android/app/build.gradle"
        },
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 73
          },
          "text": ", map the placeholder to an environment variable or local secret:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "gradle",
      "meta": null,
      "text": "android {\n    defaultConfig {\n        manifestPlaceholders = [\n            GOOGLE_MAPS_API_KEY: System.getenv(\"GOOGLE_MAPS_API_KEY\") ?: \"REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY\"\n        ]\n    }\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 22,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 1
          },
          "text": "Export "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 22,
            "column": 8
          },
          "text": "GOOGLE_MAPS_API_KEY"
        },
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 29
          },
          "text": " before building, or Gradle injects the fallback string and the Maps SDK fails at runtime."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 24,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 1
          },
          "text": "Enable "
        },
        {
          "type": "strong",
          "location": {
            "line": 24,
            "column": 8
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 24,
                "column": 10
              },
              "text": "Maps SDK for Android"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 32
          },
          "text": " for the key in Google Cloud Console. Pass the same key to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 24,
            "column": 91
          },
          "text": "NativeMap.create({ apiKey })"
        },
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 121
          },
          "text": " for consistency with web builds."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 26,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 4
          },
          "text": "Map behind the WebView"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 28,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 1
          },
          "text": "During "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 28,
            "column": 8
          },
          "text": "create"
        },
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 16
          },
          "text": ", the plugin attaches a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 28,
            "column": 40
          },
          "text": "MapView"
        },
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 49
          },
          "text": " under the Capacitor WebView, calls "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 28,
            "column": 85
          },
          "text": "bringToFront()"
        },
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 101
          },
          "text": " on the WebView, and sets "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 28,
            "column": 127
          },
          "text": "webView.setBackgroundColor(Color.TRANSPARENT)"
        },
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 174
          },
          "text": " so your HTML UI can render above the map."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 30,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 1
          },
          "text": "For embedded maps, pass a container element to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 30,
            "column": 48
          },
          "text": "NativeMap.create({ element })"
        },
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 79
          },
          "text": ". The plugin measures that element and keeps the native map frame in sync on resize and scroll."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 32,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 1
          },
          "text": "For "
        },
        {
          "type": "strong",
          "location": {
            "line": 32,
            "column": 5
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 32,
                "column": 7
              },
              "text": "background mode"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 24
          },
          "text": ", pass "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 31
          },
          "text": "toBack: true"
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 45
          },
          "text": " and set "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 54
          },
          "text": "config.x"
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 64
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 66
          },
          "text": "config.y"
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 76
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 78
          },
          "text": "config.width"
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 92
          },
          "text": ", and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 98
          },
          "text": "config.height"
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 113
          },
          "text": " (viewport defaults apply when omitted). Call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 159
          },
          "text": "updateLayout"
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 173
          },
          "text": " when the window size or orientation changes so the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 225
          },
          "text": "MapView"
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 234
          },
          "text": " stays aligned with the WebView."
        }
      ]
    }
  ]
}
