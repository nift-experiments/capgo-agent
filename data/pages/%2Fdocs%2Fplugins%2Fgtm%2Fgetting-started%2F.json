    "title": "Getting Started",
    "description": "Install @capgo/capacitor-gtm and start using its current Capacitor API.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-gtm` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-gtm\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { GoogleTagManager } from '@capgo/capacitor-gtm';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "initialize"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Initializes Google Tag Manager with the specified container ID."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { GoogleTagManager } from '@capgo/capacitor-gtm';\n\nawait GoogleTagManager.initialize({ containerId: 'container-id-123' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 41,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 41,
            "column": 5
          },
          "text": "push"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 43,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 43,
            "column": 1
          },
          "text": "Pushes an event to the Google Tag Manager dataLayer."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 45,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { GoogleTagManager } from '@capgo/capacitor-gtm';\n\nawait GoogleTagManager.push({\n  event: 'purchase',\n  parameters: {\n    value: 99.99,\n    currency: 'USD'\n  }\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 57,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 57,
            "column": 5
          },
          "text": "setUserProperty"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 59,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 59,
            "column": 1
          },
          "text": "Sets a user property in the Google Tag Manager dataLayer."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 61,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { GoogleTagManager } from '@capgo/capacitor-gtm';\n\nawait GoogleTagManager.setUserProperty({\n  key: 'user_type',\n  value: 'premium'\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 70,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 70,
            "column": 5
          },
          "text": "getValue"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 72,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 1
          },
          "text": "Gets a value from the Google Tag Manager dataLayer.\nSearches through the dataLayer for the most recent value of the specified key."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 75,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { GoogleTagManager } from '@capgo/capacitor-gtm';\n\nconst result = await GoogleTagManager.getValue({ key: 'key-123' });\nconsole.log(result);"
    },
    {
      "type": "heading",
      "location": {
        "line": 82,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 82,
            "column": 5
          },
          "text": "reset"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 84,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 1
          },
          "text": "Resets the Google Tag Manager instance and clears all data.\nThis will remove all data from the dataLayer and require re-initialization."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 87,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { GoogleTagManager } from '@capgo/capacitor-gtm';\n\nawait GoogleTagManager.reset();"
    },
    {
