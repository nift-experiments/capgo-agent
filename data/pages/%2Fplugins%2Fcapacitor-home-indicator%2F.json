          "type": "text",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "Capacitor Home Indicator Plugin for controlling the iOS home indicator visibility. The home indicator is the horizontal bar at the bottom of iOS devices without a physical home button."
        }
      ]
    },
