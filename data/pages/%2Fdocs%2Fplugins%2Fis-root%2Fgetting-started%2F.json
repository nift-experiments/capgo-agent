      "text": "import { IsRoot } from '@capgo/capacitor-is-root';\n\nconst { result } = await IsRoot.isRooted();\nif (result) {\n  console.log('Device is rooted/jailbroken');\n} else {\n  console.log('Device is not rooted/jailbroken');\n}"
