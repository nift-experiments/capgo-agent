    },
    {
      "type": "code",
      "location": {
        "line": 54,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { IntentLauncher, IOSSettings } from '@capgo/capacitor-intent-launcher';\n\n// Open app settings (recommended - officially supported by Apple)\nawait IntentLauncher.openIOSSettings({ option: IOSSettings.App });\n\n// Open WiFi settings (may not work in all iOS versions)\nawait IntentLauncher.openIOSSettings({ option: IOSSettings.WiFi });"
    },
