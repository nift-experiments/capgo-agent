            "column": 5
          },
          "text": "Address"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 93,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface Address {\n  latitude: number;\n  longitude: number;\n  countryCode: string;\n  countryName: string;\n  postalCode: string;\n  administrativeArea: string;\n  subAdministrativeArea: string;\n  locality: string;\n  subLocality: string;\n  thoroughfare: string;\n  subThoroughfare: string;\n  areasOfInterest: string[];\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 110,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 110,
            "column": 5
          },
          "text": "ForwardOptions"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 111,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface ForwardOptions {\n  /**\n   * address is a string of the address to be geocoded.\n   */\n  addressString: string;\n  /**\n   * Localise the results to the given locale.\n   */\n  useLocale?: boolean;\n  /**\n   * locale is a string in the format of language_country, for example en_US.\n   */\n  defaultLocale?: string;\n  /**\n   * Max number of results to return.\n   */\n  maxResults?: number;\n  /**\n   * Only used for web platform to use google api\n   */\n  apiKey?: string;\n}"
    },
