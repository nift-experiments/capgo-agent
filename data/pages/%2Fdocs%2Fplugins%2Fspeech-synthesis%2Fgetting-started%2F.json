    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { SpeechSynthesis } from '@capgo/capacitor-speech-synthesis';\n\nconst result = await SpeechSynthesis.speak({\n  text: 'Hello, world!',\n  language: 'en-US',\n  rate: 1.0,\n  pitch: 1.0,\n  volume: 1.0,\n  queueStrategy: 'Add'\n});\nconsole.log('Utterance ID:', result.utteranceId);"
    },
