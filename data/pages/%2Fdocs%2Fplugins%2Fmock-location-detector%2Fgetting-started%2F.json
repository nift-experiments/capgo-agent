      "location": {
        "line": 11,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { MockLocationDetector } from '@capgo/capacitor-mock-location-detector';"
    },
    {
      "type": "heading",
      "location": {
        "line": 15,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 4
          },
          "text": "Recommended Flow"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 17,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await MockLocationDetector.analyze({\n  requestLocationSample: true,\n  minDetectedChecks: 1,\n});\n\nif (result.isSimulated) {\n  console.warn('Possible GPS spoofing detected', result.riskScore, result.checks);\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 28,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 4
          },
          "text": "Run One Check"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 30,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const mockFlag = await MockLocationDetector.runCheck({\n  check: 'system_mock_flag',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 36,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 4
          },
          "text": "Monitor Continuously"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 38,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await MockLocationDetector.addListener('locationIntegrityChanged', (event) => {\n  console.log('Integrity changed', event.confidence, event.checks);\n});\n\nawait MockLocationDetector.startMonitoring({ intervalMs: 30000 });"
    },
    {
      "type": "heading",
      "location": {
        "line": 46,
