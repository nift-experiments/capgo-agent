        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Cordova apps still need fast JavaScript delivery between store releases. "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 10,
            "column": 74
          },
          "text": "@capgo/cordova-updater"
        },
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 98
          },
          "text": " brings Capgo's rollback-safe OTA model to Cordova Android and iOS without migrating to Capacitor first."
        }
      ]
    },
