          "text": "Usage"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { RichNotifications } from '@capgo/capacitor-rich-notifications';\n\nawait RichNotifications.requestPermission();\n\nawait RichNotifications.createChannel({\n  id: 'messages',\n  name: 'Messages',\n  importance: 'high',\n});\n\nawait RichNotifications.display({\n  title: 'Hello',\n  body: 'Tap to open the app',\n  channelId: 'messages',\n});\n\nawait RichNotifications.addListener('press', (event) => {\n  console.log(event.id, event.actionId, event.input);\n});"
