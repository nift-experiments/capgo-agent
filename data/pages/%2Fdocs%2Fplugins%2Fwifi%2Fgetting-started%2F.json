            "line": 146,
            "column": 5
          },
          "text": "isEnabled"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 148,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 148,
            "column": 1
          },
          "text": "Check if Wi-Fi is enabled on the device.\nOnly available on Android."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 151,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWifi } from '@capgo/capacitor-wifi';\n\nconst { enabled } = await CapacitorWifi.isEnabled();\nconsole.log('WiFi is', enabled ? 'enabled' : 'disabled');"
    },
    {
      "type": "heading",
      "location": {
        "line": 158,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
