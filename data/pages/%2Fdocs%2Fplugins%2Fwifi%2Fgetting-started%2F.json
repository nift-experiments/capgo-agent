        "line": 160,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 160,
            "column": 1
          },
          "text": "Start scanning for Wi-Fi networks.\nOnly available on Android.\nResults are delivered via the 'networksScanned' event listener.\nNote: May fail due to system throttling or hardware issues."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 165,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWifi } from '@capgo/capacitor-wifi';\n\nawait CapacitorWifi.addListener('networksScanned', () => {\n  console.log('Scan completed');\n});\nawait CapacitorWifi.startScan();"
    },
