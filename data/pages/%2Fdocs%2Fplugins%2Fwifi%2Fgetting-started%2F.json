          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-wifi` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-wifi\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWifi } from '@capgo/capacitor-wifi';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "addNetwork"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Show a system dialog to add a Wi-Fi network to the device.\nOn Android SDK 30+, this opens the system Wi-Fi settings with the network pre-filled.\nOn iOS, this connects to the network directly."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 37,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWifi, NetworkSecurityType } from '@capgo/capacitor-wifi';\n\nawait CapacitorWifi.addNetwork({\n  ssid: 'MyNetwork',\n  password: 'mypassword',\n  isHiddenSsid: false,\n  securityType: NetworkSecurityType.WPA2_PSK\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 48,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 48,
            "column": 5
          },
          "text": "connect"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 50,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 1
          },
          "text": "Connect to a Wi-Fi network.\nOn Android, this creates a temporary connection that doesn't route traffic through the network by default.\nSet autoRouteTraffic to true to bind app traffic to the connected network (useful for local/device-hosted APs).\nFor a persistent connection on Android, use addNetwork() instead.\nOn iOS, this creates a persistent connection."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 56,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWifi } from '@capgo/capacitor-wifi';\n\nawait CapacitorWifi.connect({\n  ssid: 'MyNetwork',\n  password: 'mypassword',\n  autoRouteTraffic: true // Android only: route app traffic through this network\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 66,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 66,
            "column": 5
          },
          "text": "disconnect"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 68,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 68,
            "column": 1
          },
          "text": "Disconnect from the current Wi-Fi network.\nOn iOS, only disconnects from networks that were added via this plugin."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 71,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWifi } from '@capgo/capacitor-wifi';\n\nawait CapacitorWifi.disconnect();"
    },
    {
      "type": "heading",
      "location": {
        "line": 77,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 77,
            "column": 5
          },
          "text": "getAvailableNetworks"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 79,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 1
          },
          "text": "Get a list of available Wi-Fi networks from the last scan.\nOnly available on Android."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 82,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWifi } from '@capgo/capacitor-wifi';\n\nconst { networks } = await CapacitorWifi.getAvailableNetworks();\nnetworks.forEach(network => {\n  console.log(`SSID: ${network.ssid}, Signal: ${network.rssi} dBm`);\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 91,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 91,
            "column": 5
          },
