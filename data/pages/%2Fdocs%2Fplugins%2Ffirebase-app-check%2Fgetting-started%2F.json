      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 79,
            "column": 5
          },
          "text": "GetTokenResult"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 80,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface GetTokenResult {\n  /**\n   * The App Check token in JWT format.\n   *\n   * @since 1.3.0\n   */\n  token: string;\n  /**\n   * The timestamp after which the token will expire in milliseconds since epoch.\n   *\n   * Only available for Android and iOS.\n   *\n   * @since 1.3.0\n   */\n  expireTimeMillis?: number;\n}"
    },
    {
      "type": "heading",
