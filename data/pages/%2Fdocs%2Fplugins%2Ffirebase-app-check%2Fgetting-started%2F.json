        "line": 66,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface GetTokenOptions {\n  /**\n   * If `true`, will always try to fetch a fresh token.\n   * If `false`, will use a cached token if found in storage.\n   *\n   * @since 1.3.0\n   * @default false\n   */\n  forceRefresh?: boolean;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 79,
        "column": 1
