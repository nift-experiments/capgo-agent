        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 115
          },
          "text": ". Capgo split the community project into focused packages with docs, example apps, and CI for each Stripe surface."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
