        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Capgo tracks open issues and pull requests in the community repository, ports relevant fixes into our repos, and ships them on current Stripe SDKs. We aim to be more reactive than the community maintainers when bugs or platform updates land."
        }
      ]
    },
