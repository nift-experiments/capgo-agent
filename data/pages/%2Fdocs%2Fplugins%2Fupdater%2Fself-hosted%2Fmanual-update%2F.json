      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Configuration"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Add this to your "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 18
          },
          "text": "capacitor.config.json"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 43
          },
          "text": ", to disable auto-update."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 5,
        "column": 1
      },
      "lang": "tsx",
      "meta": null,
      "text": "// capacitor.config.json\n{\n\t\"appId\": \"**.***.**\",\n\t\"appName\": \"Name\",\n\t\"plugins\": {\n\t\t\"CapacitorUpdater\": {\n\t\t\t\"autoUpdate\": \"off\",\n\t\t}\n\t}\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 18,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 4
          },
          "text": "Usage"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 20,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 20,
            "column": 1
          },
          "text": "You can use this example or re-create the logic in your app."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 22,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 1
          },
          "text": ":::caution\nWe are forcing the user to update the app with a static version declared in the code. This is not recommended, you should use a dynamic version from your server.\n:::"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 26,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 1
          },
          "text": ":::danger\nWe are not doing any version checking, decryption or checksum validation in this example. You should do that on your own.\n:::"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 30,
        "column": 1
      },
      "lang": "tsx",
      "meta": null,
      "text": "import { CapacitorUpdater } from '@capgo/capacitor-updater'\nimport { SplashScreen } from '@capacitor/splash-screen'\nimport { App } from '@capacitor/app'\nlet data = {version: \"\"}\nCapacitorUpdater.notifyAppReady()\nApp.addListener('appStateChange', async(state) => {\n     if (state.isActive) {\n       // Do the download during user active app time to prevent failed download\n       data = await CapacitorUpdater.download({\n       version: '0.0.4',\n       url: 'https://github.com/Cap-go/demo-app/releases/download/0.0.4/dist.zip',\n       })\n     }\n     if (!state.isActive && data.version !== \"\") {\n       // Do the switch when user leave app\n       SplashScreen.show()\n       try {\n         await CapacitorUpdater.set(data)\n       } catch (err) {\n         console.log(err)\n         SplashScreen.hide() // in case the set fail, otherwise the new app will have to hide it\n       }\n     }\n })"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 59,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 59,
            "column": 1
          },
          "text": ":::note\nIf this seems like a lot of work consider trying "
