    {
      "type": "paragraph",
      "location": {
        "line": 50,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 1
          },
          "text": "The Electron Updater requires setup in three places: main process, preload script, and renderer process."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 52,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 5
          },
          "text": "Main Process"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 54,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "// main.ts\nimport { app, BrowserWindow } from 'electron';\nimport * as path from 'path';\nimport {\n  ElectronUpdater,\n  setupIPCHandlers,\n  setupEventForwarding,\n} from '@capgo/electron-updater';\n\n// Create updater instance with your Capgo App ID\nconst updater = new ElectronUpdater({\n  appId: 'YOUR_CAPGO_APP_ID', // e.g., 'com.example.myapp'\n  autoUpdate: true,\n});\n\napp.whenReady().then(async () => {\n  const mainWindow = new BrowserWindow({\n    width: 1200,\n    height: 800,\n    webPreferences: {\n      preload: path.join(__dirname, 'preload.js'),\n      contextIsolation: true,\n    },\n  });\n\n  // Initialize updater with window and builtin path\n  const builtinPath = path.join(__dirname, 'www/index.html');\n  await updater.initialize(mainWindow, builtinPath);\n\n  // Setup IPC communication between main and renderer\n  setupIPCHandlers(updater);\n  setupEventForwarding(updater, mainWindow);\n\n  // Load the current bundle (either builtin or downloaded update)\n  await mainWindow.loadFile(updater.getCurrentBundlePath());\n});\n\napp.on('window-all-closed', () => {\n  if (process.platform !== 'darwin') {\n    app.quit();\n  }\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 99,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 99,
            "column": 5
          },
          "text": "Preload Script"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 101,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "// preload.ts\nimport { exposeUpdaterAPI } from '@capgo/electron-updater/preload';\n\n// Expose the updater API to the renderer process\nexposeUpdaterAPI();"
    },
    {
      "type": "heading",
      "location": {
        "line": 109,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 109,
            "column": 5
          },
          "text": "Renderer Process"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 111,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "// renderer.ts (or in your app's entry point)\nimport { requireUpdater } from '@capgo/electron-updater/renderer';\n\nconst updater = requireUpdater();\n\n// CRITICAL: Call this on every app launch!\n// This confirms the bundle loaded successfully and prevents rollback\nawait updater.notifyAppReady();\n\nconsole.log('App ready, current bundle:', await updater.current());"
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {
        "type": "caution"
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 125,
            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 125,
                "column": 3
              },
              "text": "You "
            },
            {
              "type": "strong",
              "location": {
                "line": 125,
                "column": 7
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 125,
                    "column": 9
                  },
                  "text": "must"
                }
              ]
            },
            {
              "type": "text",
              "location": {
                "line": 125,
                "column": 15
              },
              "text": " call "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 125,
                "column": 21
              },
              "text": "notifyAppReady()"
            },
            {
              "type": "text",
              "location": {
                "line": 125,
                "column": 39
              },
              "text": " within 10 seconds of app launch (configurable via "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 125,
                "column": 90
              },
              "text": "appReadyTimeout"
            },
            {
              "type": "text",
              "location": {
                "line": 125,
                "column": 107
              },
              "text": "). If not called, the updater assumes the update failed and rolls back to the previous version."
            }
          ]
        }
      ],
      "location": {
        "line": 124,
        "column": 1
      }
    },
    {
      "type": "heading",
      "location": {
        "line": 128,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 128,
            "column": 4
          },
          "text": "Checking for Updates"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 130,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 130,
            "column": 1
          },
          "text": "With "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 130,
            "column": 6
          },
          "text": "autoUpdate: true"
        },
        {
          "type": "text",
          "location": {
            "line": 130,
            "column": 24
          },
          "text": ", the updater automatically checks for updates. You can also trigger manual checks:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 132,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "// Check for updates manually\nconst latest = await updater.getLatest();\n\nif (latest.url && !latest.error) {\n  console.log('Update available:', latest.version);\n\n  // Download the update\n  const bundle = await updater.download({\n    url: latest.url,\n    version: latest.version,\n    checksum: latest.checksum,\n  });\n\n  console.log('Downloaded bundle:', bundle.id);\n\n  // Option 1: Queue for next restart\n  await updater.next({ id: bundle.id });\n\n  // Option 2: Apply immediately and reload\n  // await updater.set({ id: bundle.id });\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 156,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 156,
            "column": 4
          },
          "text": "Listening to Events"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 158,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 158,
            "column": 1
          },
          "text": "Track update progress and status with events:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 160,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "// Download progress\nupdater.addListener('download', (event) => {\n  console.log(`Download progress: ${event.percent}%`);\n});\n\n// Update available\nupdater.addListener('updateAvailable', (event) => {\n  console.log('New version available:', event.bundle.version);\n});\n\n// Download completed\nupdater.addListener('downloadComplete', (event) => {\n  console.log('Download finished:', event.bundle.id);\n});\n\n// Update failed\nupdater.addListener('updateFailed', (event) => {\n  console.error('Update failed:', event.bundle.version);\n});"
    },
