    {
      "type": "code",
      "location": {
        "line": 24,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AndroidSmsRetriever } from '@capgo/capacitor-android-sms-retriever';\n\nconst { hash } = await AndroidSmsRetriever.getHashString();\nconsole.log('SMS hash:', hash);\n\nawait AndroidSmsRetriever.addListener('smsReceived', ({ message }) => {\n  console.log('Verification SMS:', message);\n});\n\nawait AndroidSmsRetriever.startWatch();"
    },
