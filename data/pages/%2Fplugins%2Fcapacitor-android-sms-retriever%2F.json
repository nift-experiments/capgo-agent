          },
          "text": "@capgo/capacitor-android-sms-retriever"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 41
          },
          "text": " provides Android SMS Retriever and Phone Number Hint APIs for Capacitor apps."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 5,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 1
          },
          "text": "Use it when you need passwordless phone verification without asking for SMS permissions. Android listens for one app-targeted verification SMS for up to five minutes and returns the message through Capacitor listeners."
        }
      ]
    },
    {
