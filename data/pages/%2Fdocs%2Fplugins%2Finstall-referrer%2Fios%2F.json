                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 38,
                    "column": 3
                  },
                  "text": "The attribution payload covers Apple Search Ads attribution, not arbitrary App Store referrer URLs."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 39,
            "column": 1
          },
