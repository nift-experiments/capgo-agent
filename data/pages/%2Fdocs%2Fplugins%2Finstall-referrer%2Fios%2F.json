    "title": "iOS Attribution",
    "description": "iOS behavior for @capgo/capacitor-install-referrer with Apple AdServices.",
    "sidebar": {
      "order": 4
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Apple AdServices"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Apple does not provide a generic App Store install referrer equivalent to Google Play Install Referrer. On iOS, this plugin uses Apple AdServices attribution."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "By default, "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 13
          },
          "text": "getReferrer()"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 28
          },
          "text": " returns an AdServices attribution token that you can send to your backend or mobile measurement partner."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await InstallReferrer.getReferrer();\nconsole.log(result.attributionToken);"
    },
    {
      "type": "heading",
      "location": {
        "line": 13,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 4
          },
          "text": "Native Apple Attribution Lookup"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 15,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 1
          },
          "text": "The plugin can also send the token to Apple's AdServices endpoint from native code."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 17,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await InstallReferrer.getReferrer({\n  fetchAppleAttribution: true,\n});\n\nconsole.log(result.appleAttribution);"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "Use this mode when the app itself should receive Apple's attribution payload. Keep "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 84
          },
          "text": "fetchAppleAttribution"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 107
          },
          "text": " false when your backend or attribution provider should exchange the token."
        }
      ]
    },
