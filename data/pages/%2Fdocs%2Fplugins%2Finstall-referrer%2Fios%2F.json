              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 39,
                    "column": 3
                  },
                  "text": "No App Tracking Transparency prompt is required just to request the AdServices attribution token."
                }
              ]
            }
          ]
        }
      ]
    },
