              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 37,
                    "column": 3
                  },
                  "text": "Apple AdServices attribution tokens are available on iOS 14.3 and later."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 38,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
