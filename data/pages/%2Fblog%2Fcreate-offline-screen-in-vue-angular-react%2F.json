      "lang": "html",
      "meta": null,
      "text": "<template>\n  <div id=\"app\">\n    <div id=\"offline-screen\">\n      <h1>You are offline</h1>\n      <p>Please check your internet connection and try again.</p>\n    </div>\n    <!-- Your application content -->\n  </div>\n</template>\n\n<style>\n#offline-screen {\n  display: none;\n  text-align: center;\n  padding: 20px;\n  background-color: #f2f2f2;\n}\n\n#offline-screen h1 {\n  font-size: 24px;\n}\n\n#offline-screen p {\n  font-size: 16px;\n}\n</style>"
