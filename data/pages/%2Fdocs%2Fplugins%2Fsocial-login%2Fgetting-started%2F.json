          "type": "text",
          "location": {
            "line": 73,
            "column": 5
          },
          "text": "Login"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 75,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await SocialLogin.login({\n  provider: 'google',\n  options: { scopes: ['profile', 'email'] },\n});\n\nawait SocialLogin.login({\n  provider: 'oauth2',\n  options: {\n    providerId: 'github',\n    scope: 'read:user user:email',\n  },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 90,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 90,
            "column": 5
          },
          "text": "Session checks"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 92,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const status = await SocialLogin.isLoggedIn({ provider: 'google' });\nawait SocialLogin.logout({ provider: 'google' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 97,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 97,
            "column": 5
          },
          "text": "Auth codes and refresh"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 99,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "// For providers that support this mode\nconst authCodeResult = await SocialLogin.getAuthorizationCode({ provider: 'google' });\nawait SocialLogin.refresh({ provider: 'google', options: {} as never });"
    },
    {
      "type": "heading",
      "location": {
        "line": 105,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 105,
            "column": 5
          },
          "text": "Advanced helpers"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 107,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const jwt = await SocialLogin.decodeIdToken({\n  idToken: 'eyJhbGciOi...',\n});\n\nconst { date } = await SocialLogin.getAccessTokenExpirationDate({\n  accessTokenExpirationDate: Date.now() + 3600 * 1000,\n});\n\nconst expired = await SocialLogin.isAccessTokenExpired({\n  accessTokenExpirationDate: Date.now() + 1000,\n});\n\nconst active = await SocialLogin.isRefreshTokenAvailable({ refreshToken: 'a-token' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 123,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 123,
            "column": 4
          },
          "text": "Provider-specific notes"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 125,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 125,
            "column": 5
          },
          "text": "Google offline mode"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 127,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 127,
            "column": 1
          },
          "text": "google.mode: 'offline'"
        },
        {
          "type": "text",
          "location": {
            "line": 127,
            "column": 25
          },
          "text": " returns "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 127,
            "column": 34
          },
          "text": "serverAuthCode"
        },
        {
          "type": "text",
          "location": {
            "line": 127,
            "column": 50
          },
          "text": " from login. In this mode logout, isLoggedIn, getAuthorizationCode, and refresh are not available."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 129,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 129,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 129,
            "column": 5
          },
          "text": "serverAuthCode"
        },
        {
          "type": "text",
          "location": {
            "line": 129,
            "column": 21
          },
          "text": " only as input to your backend token exchange. If you need to call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 129,
            "column": 88
          },
          "text": "SocialLogin.refresh()"
        },
        {
          "type": "text",
          "location": {
            "line": 129,
            "column": 111
          },
          "text": " in the app, use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 129,
            "column": 128
          },
          "text": "google.mode: 'online'"
        },
        {
          "type": "text",
          "location": {
            "line": 129,
            "column": 151
          },
          "text": " instead."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 131,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 131,
            "column": 5
          },
          "text": "Apple"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 133,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 133,
            "column": 1
          },
          "text": "Set "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 133,
            "column": 5
          },
          "text": "useProperTokenExchange: true"
        },
        {
          "type": "text",
          "location": {
            "line": 133,
            "column": 35
          },
          "text": " for strict token handling and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 133,
            "column": 66
          },
          "text": "useBroadcastChannel: true"
        },
        {
          "type": "text",
          "location": {
            "line": 133,
            "column": 93
          },
          "text": " for Android simplified setup."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 135,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 135,
            "column": 5
          },
          "text": "OAuth2 web redirect flow"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 137,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 137,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 137,
            "column": 5
          },
          "text": "OAuth2LoginOptions.flow: 'redirect'"
        },
        {
          "type": "text",
          "location": {
            "line": 137,
            "column": 42
          },
          "text": " for web flows that navigate away from the page."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 139,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 139,
            "column": 4
          },
          "text": "Dynamic provider dependencies"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 141,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 141,
            "column": 1
          },
          "text": "You can configure which providers to include to reduce native app size. This is most useful when your app only needs specific providers."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 143,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 143,
            "column": 1
          },
          "text": "Add provider configuration to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 143,
            "column": 31
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 143,
            "column": 52
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 145,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\n\nconst config: CapacitorConfig = {\n  appId: 'com.example.app',\n  appName: 'MyApp',\n  webDir: 'dist',\n  plugins: {\n    SocialLogin: {\n      providers: {\n        google: true,\n        facebook: true,\n        apple: true,\n        twitter: false,\n      },\n      logLevel: 1,\n    },\n  },\n};\n\nexport default config;"
    },
    {
