                  "type": "inlineCode",
                  "location": {
                    "line": 11,
                    "column": 3
                  },
                  "text": "exitKioskMode"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 11,
                    "column": 18
                  },
                  "text": " - Exits kiosk mode, restoring normal system UI and hardware button functionality. Also stops the foreground keep-alive service started in enterKioskMode()."
                }
              ]
            }
          ]
        }
      ]
