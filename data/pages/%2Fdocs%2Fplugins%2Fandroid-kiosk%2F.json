                  "location": {
                    "line": 20,
                    "column": 3
                  },
                  "text": "exitKioskMode"
                }
              ]
            },
            {
              "type": "tableCell",
              "location": {
                "line": 20,
                "column": 19
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 20,
                    "column": 21
                  },
                  "text": "Exits kiosk mode, restoring normal system UI and hardware button functionality. Also stops the foreground keep-alive service started in enterKioskMode()."
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "location": {
            "line": 21,
            "column": 1
          },
          "blocks": [
            {
              "type": "tableCell",
              "location": {
                "line": 21,
                "column": 1
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 21,
                    "column": 3
                  },
                  "text": "setAsLauncher"
                }
              ]
            },
            {
              "type": "tableCell",
              "location": {
                "line": 21,
                "column": 19
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 21,
                    "column": 21
                  },
                  "text": "Opens the device's home screen settings to allow user to set this app as the launcher. This is required for full kiosk mode functionality."
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "location": {
            "line": 22,
            "column": 1
          },
          "blocks": [
            {
              "type": "tableCell",
              "location": {
                "line": 22,
                "column": 1
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 22,
                    "column": 3
                  },
                  "text": "setAllowedKeys"
                }
              ]
            },
            {
              "type": "tableCell",
              "location": {
                "line": 22,
                "column": 20
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 22
                  },
                  "text": "Sets which hardware keys are allowed to function in kiosk mode. By default, all hardware keys are blocked in kiosk mode."
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "location": {
            "line": 23,
            "column": 1
          },
          "blocks": [
