              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 10,
                    "column": 3
                  },
                  "text": "enterKioskMode"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 10,
                    "column": 19
                  },
                  "text": " - Enters kiosk mode, hiding system UI and blocking hardware buttons. Also starts a foreground keep-alive service so the app is less likely to be killed by the system. The app must be set as the device launcher for this to work effectively."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 11,
