      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorShake } from '@capgo/capacitor-shake';\n\nconst listener = await CapacitorShake.addListener('shake', () => {\n  console.log('Shake detected!');\n});\n\n// To remove the listener:\nawait listener.remove();"
