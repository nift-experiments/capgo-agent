          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 7,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-shake\nbunx cap sync"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
