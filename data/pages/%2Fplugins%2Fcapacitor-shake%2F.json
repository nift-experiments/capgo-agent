          "type": "text",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "Capacitor Shake Plugin interface for detecting shake gestures on mobile devices. This plugin allows you to listen for shake events and get plugin version information."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 5,
        "column": 1
      },
