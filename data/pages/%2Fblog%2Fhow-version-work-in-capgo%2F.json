            "column": 3
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 75,
                "column": 5
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 75,
                    "column": 5
                  },
                  "text": "If native bundle version is higher than Capgo version, the "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 75,
                    "column": 64
                  },
                  "text": "Disable auto downgrade under native"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 75,
                    "column": 101
                  },
                  "text": " condition is applied."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 76,
            "column": 3
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 76,
                "column": 5
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 76,
                    "column": 5
                  },
                  "text": "If native bundle version is MAJOR lower than Capgo version, the "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 76,
                    "column": 69
                  },
                  "text": "Disable auto upgrade above major"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 76,
                    "column": 103
                  },
                  "text": " condition is applied."
                }
              ]
            }
          ]
        }
      ]
    },
