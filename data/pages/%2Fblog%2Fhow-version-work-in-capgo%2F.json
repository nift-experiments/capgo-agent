                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "html",
      "location": {
        "line": 7,
        "column": 1
      },
      "text": "<div class=\"mx-auto\" style=\"width:100%;\">\n  <img src=\"/graph_capgo.webp\" alt=\"Capacitor update system\">\n</div>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 11,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 1
          },
          "text": "All versions choices are decided server side by Capgo."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 13,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 4
          },
          "text": "Versioning system"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 15,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 1
          },
          "text": "To manage version Capgo use the SemVer system. Read the "
        },
        {
          "type": "link",
          "location": {
            "line": 15,
            "column": 57
          },
          "url": "https://semver.org/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 15,
                "column": 58
              },
              "text": "SemVer specification"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 100
          },
          "text": " or check Capgo update compatibility with the "
        },
        {
          "type": "link",
          "location": {
            "line": 15,
            "column": 146
          },
          "url": "/semver_tester/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 15,
                "column": 147
              },
              "text": "Semver Tester"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 178
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 16,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 5
          },
          "text": "Versions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "Where Capgo find the version to compare"
        }
      ]
    },
    {
      "type": "blockquote",
      "location": {
        "line": 20,
        "column": 3
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 20,
            "column": 5
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 20,
                "column": 5
              },
              "text": "You can override this behavior by setting version key in "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 20,
                "column": 62
              },
              "text": "capacitor.config.json"
            },
            {
              "type": "text",
              "location": {
                "line": 20,
                "column": 85
              },
              "text": " file "
            },
            {
              "type": "link",
              "location": {
                "line": 20,
                "column": 91
              },
              "url": "/docs/plugins/updater/settings/#version",
              "title": null,
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 20,
                    "column": 92
                  },
                  "text": "docs here"
                }
              ]
            },
            {
              "type": "text",
              "location": {
                "line": 20,
                "column": 143
              },
              "text": "\nThe native version will be ignored for all platforms."
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 6
          },
          "text": "IOS"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 2
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 2
          },
          "text": "In IOS the var is set on your project here "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 45
          },
          "text": "ios/App/App/Info.plist"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 69
          },
          "text": " under the key"
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 83
          },
          "text": "CFBundleShortVersionString"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 111
          },
          "text": " or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 115
          },
          "text": "ios/App/App.xcodeproj/project.pbxproj"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 154
          },
          "text": " under the key "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 169
          },
          "text": "MARKETING_VERSION"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 188
          },
          "text": " if "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 192
          },
          "text": "MARKETING_VERSION"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 211
          },
          "text": " was set in your "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 228
          },
          "text": "Info.plist"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 240
          },
          "text": " file."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 27,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 6
          },
          "text": "Android"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 29,
        "column": 3
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 3
          },
          "text": "In Android, the var is set on your project here "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 29,
            "column": 51
          },
          "text": "android/app/build.gradle"
        },
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 77
          },
          "text": " under the key "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 29,
            "column": 92
          },
          "text": "defaultConfig.versionName"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 6
          },
          "text": "JavaScript ( Capgo bundle version )"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 3
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 3
          },
          "text": "In JavaScript, the var can be set in your "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 33,
            "column": 45
          },
          "text": "package.json"
        },
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 59
          },
          "text": " under the key "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 33,
            "column": 74
          },
          "text": "version"
        },
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 83
          },
          "text": "\nOtherwise you need to provide it in the upload command."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 36,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 4
          },
          "text": "Default behavior"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 38,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 1
          },
          "text": "This is how Capgo channel will behave if you didn't change any settings."
        }
      ]
    },
    {
      "type": "blockquote",
      "location": {
        "line": 40,
        "column": 1
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 40,
            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 40,
                "column": 3
              },
              "text": "This behavior will be based on the unique channel you made default."
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 42,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 5
          },
          "text": "When Fresh installation of your Capacitor app"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 43,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 43,
            "column": 1
          },
          "text": "When user did download your Ionic app for the first time and opens the app it contacts Capgo server."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 45,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 1
          },
          "text": "Currently, 4 outputs can happen:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 46,
        "column": 3
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 46,
            "column": 3
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 46,
                "column": 5
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 46,
                    "column": 5
                  },
                  "text": "The native bundle version (1.2.3) is lower than Capgo bundle version (1.2.4), Capgo sends his bundle to the user."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 47,
            "column": 3
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 47,
                "column": 5
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 47,
                    "column": 5
                  },
                  "text": "The native bundle version (1.2.3) is equal to Capgo bundle version (1.2.3), Capgo send “no need to update”."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 48,
            "column": 3
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 48,
                "column": 5
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 48,
                    "column": 5
                  },
                  "text": "The native bundle version (1.2.4) is higher than Capgo bundle version (1.2.3), Capgo send “no need to update”."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 49,
            "column": 3
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 49,
                "column": 5
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 49,
                    "column": 5
                  },
                  "text": "The native bundle version (1.2.3) is MAJOR lower than Capgo bundle version (2.2.3), Capgo send “no need to update”."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 51,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 5
          },
          "text": "Other settings"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 53,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 6
          },
          "text": "Disable auto-downgrade under native"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "If you change this setting to false, Capgo will consider is always the trustable source of the version.\nThen the behavior become :"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 57,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 57,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 57,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 57,
                    "column": 3
                  },
                  "text": "The native version (1.2.4) is higher than Capgo version (1.2.3)"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "blockquote",
      "location": {
        "line": 59,
        "column": 1
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 59,
            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 59,
                "column": 3
              },
              "text": "Capgo sends his version to the user."
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 61,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 6
          },
          "text": "Disable auto-upgrade strategy"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 63,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 63,
            "column": 1
          },
          "text": "There are a couple of strategies you can chose from. You can learn more about it "
        },
        {
          "type": "link",
          "location": {
            "line": 63,
            "column": 82
          },
          "url": "/docs/cli/commands/#disable-updates-strategy",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 63,
                "column": 83
              },
              "text": "here"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 65,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 4
          },
          "text": "JavaScript bundle version"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 67,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 1
          },
          "text": "The JavaScript bundle version is the one you send when doing "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 67,
            "column": 62
          },
          "text": "npx @capgo/cli@latest bundle upload --channel production"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "If you didn't use the option "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 30
          },
          "text": "--bundle 1.2.3"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 46
          },
          "text": ", Capgo will get the bundle version from your "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 92
          },
          "text": "package.json"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 106
          },
          "text": " file (in the version key)."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 71,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 71,
            "column": 1
          },
          "text": "After Your Ionic app has installed one version from Capgo, this is this version who will be compared for:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 72,
        "column": 3
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 72,
            "column": 3
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 72,
                "column": 5
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 72,
                    "column": 5
                  },
                  "text": "Their JavaScript bundle version (1.2.3) is lower than Capgo bundle version (1.2.4), Capgo send his bundle to the user."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 74,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 74,
            "column": 1
          },
          "text": "With some guard conditions:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 75,
        "column": 3
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
