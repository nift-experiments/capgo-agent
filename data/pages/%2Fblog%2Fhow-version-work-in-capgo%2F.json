          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "Capgo uses 2 main variables to manage versions in your Capacitor app:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 3,
        "column": 3
      },
      "ordered": false,
      "start": null,
      "spread": false,
