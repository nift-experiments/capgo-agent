    },
    {
      "type": "paragraph",
      "location": {
        "line": 80,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 80,
            "column": 1
          },
          "text": "When you publish your Capacitor JS app on the App Store, what happens is simple."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 82,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 1
          },
          "text": "Your user will get the new version from the store and remove all local updates in their app by default."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 84,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 1
          },
          "text": "If you want to change that behavior, you need to set the setting "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 84,
            "column": 66
          },
          "text": "resetWhenUpdate"
        },
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 83
          },
          "text": " read more about it "
        },
        {
          "type": "link",
          "location": {
            "line": 84,
            "column": 103
          },
          "url": "/docs/plugins/updater/api/#settings",
          "title": null,
          "blocks": [
