    },
    {
      "type": "paragraph",
      "location": {
        "line": 19,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 1
          },
          "text": "You end up managing two products across store consoles, teams, and internal QA instructions."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 21,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 21,
            "column": 4
          },
          "text": "Why runtime-switching config is often messy"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 23,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 1
          },
          "text": "The “one app ID + runtime switch” pattern usually means your app reads environment variables or flags at startup and re-routes APIs, keys, and update behavior dynamically."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "This works until:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 27,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
