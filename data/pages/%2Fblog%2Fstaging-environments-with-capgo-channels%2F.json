        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 1
          },
          "text": "Your TestFlight/Play internal testing app can stay on "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 49,
            "column": 55
          },
          "text": "staging"
        },
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 64
          },
          "text": " forever.\nYou do JS/CSS/asset updates there repeatedly through Capgo without publishing a new native app."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 52,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 4
          },
          "text": "Recommended structure in practice"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 54,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 5
          },
          "text": "1) Native release baseline"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 56,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 56,
            "column": 1
          },
          "text": "Your last native binary stays the same for many JS iterations:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 58,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun run build\nbunx cap sync\n# generate Xcode/Android Studio archives as usual"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 64,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 1
          },
          "text": "You only rebuild the native binary when you actually changed native surface area."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 66,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 5
          },
          "text": "2) Use dedicated channels for environments"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 68,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 68,
            "column": 1
          },
          "text": "Publish updates with channels:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 70,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun run build\nbunx @capgo/cli deploy --channel staging"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 75,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 75,
            "column": 1
          },
          "text": "Test on QA, fix issues, then promote:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 77,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bunx @capgo/cli promote vX.Y.Z --channel production"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 81,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 81,
            "column": 1
          },
          "text": "If you prefer explicit versioning:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 83,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bunx @capgo/cli deploy vX.Y.Z --channel staging\nbunx @capgo/cli promote vX.Y.Z --channel production"
    },
    {
      "type": "heading",
      "location": {
        "line": 88,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 88,
            "column": 5
          },
          "text": "3) Keep TestFlight “always pre-prod”"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 90,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 90,
            "column": 1
          },
          "text": "In iOS workflows, this means your TestFlight build can stay associated with pre-production updates:"
        }
      ]
    },
    {
