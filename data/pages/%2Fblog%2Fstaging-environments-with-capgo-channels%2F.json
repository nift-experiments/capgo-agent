            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 27,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 27,
                    "column": 3
                  },
                  "text": "QA starts bypassing intended flows because config state is stale,"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 28,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
