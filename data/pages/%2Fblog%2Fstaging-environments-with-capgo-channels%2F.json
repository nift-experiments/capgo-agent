            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 38,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 38,
                    "column": 3
                  },
                  "text": "Keep one production app ID in App Store / Play."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 39,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 39,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 39,
                    "column": 3
                  },
                  "text": "Ship one native binary for the “shell” (until native changes require a true rebuild)."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 40,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 40,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 40,
                    "column": 3
                  },
                  "text": "Route behavior by channel, not by duplicated app identity."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 42,
        "column": 1
      },
      "blocks": [
