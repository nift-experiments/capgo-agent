                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 28,
                    "column": 3
                  },
                  "text": "someone uses the wrong endpoint in production,"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 29,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 29,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 29,
                    "column": 3
                  },
                  "text": "environment drift causes hard-to-repro bugs,"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 30,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 30,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 30,
                    "column": 3
                  },
                  "text": "you need to debug “what config version is this binary using?” on a user device."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 32,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 1
          },
          "text": "That complexity grows with each release and is where teams lose velocity."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 34,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 4
          },
          "text": "The Capgo way: one app ID, many channels"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 36,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 1
          },
          "text": "Capgo makes environment control explicit through channels:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 38,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
