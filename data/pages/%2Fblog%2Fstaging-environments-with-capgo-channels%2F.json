      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "The first two can work, but they create long-term friction. In real teams, the Capgo channel model is usually the cleanest."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 10,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
