          },
          "text": "@capgo/capacitor-android-sms-retriever"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 41
          },
          "text": " wraps Google Play services SMS Retriever and Phone Number Hint APIs for Android-only Capacitor verification flows."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "The plugin lets your app listen for a single verification SMS addressed to your app without requesting SMS permissions. It can also show Android's native Phone Number Hint UI so users can choose a SIM-based phone number without typing it manually."
        }
      ]
    },
