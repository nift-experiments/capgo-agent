      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Amazon Cognito is supported through the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 41
          },
          "text": "cognito"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 50
          },
          "text": " Auth Connect preset. You can also configure it manually with direct OAuth2 endpoints."
