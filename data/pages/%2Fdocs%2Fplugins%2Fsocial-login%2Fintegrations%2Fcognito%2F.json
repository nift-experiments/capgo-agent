      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "Auth Connect preset example"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { SocialLoginAuthConnect } from '@capgo/capacitor-social-login';\n\nawait SocialLoginAuthConnect.initialize({\n  authConnect: {\n    cognito: {\n      domain: 'https://your-domain.auth.region.amazoncognito.com',\n      clientId: 'your-cognito-client-id',\n      redirectUrl: 'myapp://oauth/cognito',\n    },\n  },\n});\n\nconst result = await SocialLoginAuthConnect.login({\n  provider: 'cognito',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 26,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 4
          },
          "text": "Direct OAuth2 example"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 28,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { SocialLogin } from '@capgo/capacitor-social-login';\n\nawait SocialLogin.initialize({\n  oauth2: {\n    cognito: {\n      appId: 'your-cognito-client-id',\n      authorizationBaseUrl: 'https://your-domain.auth.region.amazoncognito.com/oauth2/authorize',\n      accessTokenEndpoint: 'https://your-domain.auth.region.amazoncognito.com/oauth2/token',\n      redirectUrl: 'myapp://oauth/cognito',\n      scope: 'openid profile email',\n      pkceEnabled: true,\n      resourceUrl: 'https://your-domain.auth.region.amazoncognito.com/oauth2/userInfo',\n      logoutUrl: 'https://your-domain.auth.region.amazoncognito.com/logout',\n    },\n  },\n});\n\nconst result = await SocialLogin.login({\n  provider: 'oauth2',\n  options: {\n    providerId: 'cognito',\n  },\n});"
    },
