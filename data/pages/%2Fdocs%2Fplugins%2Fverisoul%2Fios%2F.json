        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Native SDK"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "The plugin depends on "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 23
          },
          "text": "VerisoulSDK"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 36
          },
          "text": " and supports both CocoaPods and Swift Package Manager through the plugin package metadata."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "After installing the plugin, sync the native project:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx cap sync ios"
    },
    {
      "type": "heading",
      "location": {
        "line": 12,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 4
          },
          "text": "App Attest"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 14,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 1
          },
          "text": "Verisoul recommends enabling App Attest for stronger device checks. In Xcode, add the App Attest capability and include the entitlement value that matches your environment:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 16,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>com.apple.developer.devicecheck.appattest-environment</key>\n<string>production</string>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 21,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 21,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 21,
            "column": 5
          },
          "text": "development"
        },
        {
          "type": "text",
          "location": {
            "line": 21,
            "column": 18
          },
          "text": " for test builds."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Usage"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "Initialize Verisoul early in your app lifecycle:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 27,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Verisoul } from '@capgo/capacitor-verisoul';\n\nawait Verisoul.configure({\n  environment: 'prod',\n  projectId: 'YOUR_PROJECT_ID',\n});"
    },
    {
