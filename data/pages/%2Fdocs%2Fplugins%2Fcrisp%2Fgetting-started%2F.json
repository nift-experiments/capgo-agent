  "metadata": {
    "title": "Getting Started",
    "description": "Install @capgo/capacitor-crisp and start using its current Capacitor API.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-crisp` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-crisp\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "configure"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Configure the Crisp SDK with your website ID.\nMust be called before using any other methods."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.configure({ websiteID: 'YOUR_WEBSITE_ID' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 42,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 42,
            "column": 5
          },
          "text": "openMessenger"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Open the Crisp messenger chat window.\nShows the chat interface to the user."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 47,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.openMessenger();"
    },
    {
      "type": "heading",
      "location": {
        "line": 53,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 53,
            "column": 5
          },
          "text": "setTokenID"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "Set a unique token ID for the current user session.\nUsed to identify and restore previous conversations."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 58,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.setTokenID({ tokenID: 'token-id-123' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 64,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 64,
            "column": 5
          },
          "text": "setUser"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 66,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 1
          },
          "text": "Set user information for the current session.\nUpdates the user profile visible to support agents."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 69,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.setUser({\n  nickname: 'John Doe',\n  email: 'john@example.com',\n  phone: '+1234567890'\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 79,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 79,
            "column": 5
          },
          "text": "pushEvent"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 81,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 81,
            "column": 1
          },
          "text": "Push a custom event to Crisp.\nUseful for tracking user actions and behavior."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 84,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.pushEvent({\n  name: 'completed_purchase',\n  color: 'green'\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 93,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 93,
            "column": 5
          },
          "text": "setCompany"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 95,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 95,
            "column": 1
          },
          "text": "Set company information for the current session.\nAssociates the user with a company in Crisp."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 98,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.setCompany({\n  name: 'Acme Corp',\n  url: 'https://acme.com',\n  employment: ['CEO', 'Executive'],\n  geolocation: ['USA', 'San Francisco']\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 109,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 109,
            "column": 5
          },
          "text": "setInt"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 111,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 111,
            "column": 1
          },
          "text": "Set a custom integer data field.\nStores numerical data associated with the user session."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 114,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.setInt({ key: 'user_level', value: 42 });"
    },
    {
      "type": "heading",
      "location": {
        "line": 120,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 120,
            "column": 5
          },
          "text": "setString"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 122,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 122,
            "column": 1
          },
          "text": "Set a custom string data field.\nStores text data associated with the user session."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 125,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.setString({ key: 'subscription_tier', value: 'premium' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 131,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 131,
            "column": 5
          },
          "text": "sendMessage"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 133,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 133,
            "column": 1
          },
          "text": "Send a message from the user to the chat.\nProgrammatically send a message as if the user typed it."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 136,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.sendMessage({ value: 'Hello, I need help!' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 142,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 142,
            "column": 5
          },
          "text": "setSegment"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 144,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 144,
            "column": 1
          },
          "text": "Set a user segment for targeting and organization.\nUsed to categorize users in the Crisp dashboard."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 147,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.setSegment({ segment: 'premium-users' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 153,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 153,
            "column": 5
          },
          "text": "reset"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 155,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 155,
            "column": 1
          },
          "text": "Reset the Crisp session.\nClears all user data and starts a fresh session.\nUseful when user logs out."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 159,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCrisp } from '@capgo/capacitor-crisp';\n\nawait CapacitorCrisp.reset();"
    },
