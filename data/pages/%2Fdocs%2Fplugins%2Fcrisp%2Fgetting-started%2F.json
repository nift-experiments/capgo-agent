          },
          "text": "Configuration for initializing Crisp."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 169,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface ConfigureOptions {\n  /**\n   * Your Crisp website ID from dashboard.\n   */\n  websiteID: string;\n  /**\n   * Optional - Locale to force in the Crisp chat widget (ISO 639-1), eg. `en`, `fr`, `es`.\n   * Web + Android: overrides the runtime locale. iOS follows the device/app locale.\n   */\n  locale?: string;\n  /**\n   * Optional - Unique token identifier for the user session continuity.\n   */\n  tokenID?: string;\n}"
    },
