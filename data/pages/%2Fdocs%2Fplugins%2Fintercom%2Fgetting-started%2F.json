        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Initialize Intercom with API keys at runtime.\nUse this if you prefer not to configure keys in capacitor.config."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoIntercom } from '@capgo/capacitor-intercom';\n\nawait CapgoIntercom.loadWithKeys({\n  appId: 'app-id-123',\n  apiKeyIOS: 'api-key-ios',\n  apiKeyAndroid: 'api-key-android',\n});"
    },
