    },
    {
      "type": "code",
      "location": {
        "line": 11,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { SocialLoginAuthConnect } from '@capgo/capacitor-social-login';\n\nawait SocialLoginAuthConnect.initialize({\n  authConnect: {\n    auth0: {\n      domain: 'https://your-tenant.auth0.com',\n      clientId: 'your-auth0-client-id',\n      redirectUrl: 'myapp://oauth/auth0',\n      audience: 'https://your-api.example.com',\n    },\n  },\n});\n\nconst result = await SocialLoginAuthConnect.login({\n  provider: 'auth0',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 30,
        "column": 1
      },
