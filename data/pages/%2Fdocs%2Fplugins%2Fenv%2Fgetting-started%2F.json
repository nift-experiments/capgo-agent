        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Retrieves the value of a specific environment variable by key."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "This method fetches environment variables that were set during the native\nbuild process. The variables must be configured in the native project\nbefore they can be accessed at runtime."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 39,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Env } from '@capgo/capacitor-env';\n\nconst result = await Env.getKey({ key: 'API_URL' });\nconsole.log(result.value); // 'https://api.example.com'"
    },
