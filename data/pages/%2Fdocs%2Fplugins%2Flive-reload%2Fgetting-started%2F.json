      ]
    },
    {
      "type": "code",
      "location": {
        "line": 68,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { LiveReload } from '@capgo/capacitor-live-reload';\n\nconst result = await LiveReload.getStatus();\nconsole.log(result);"
    },
