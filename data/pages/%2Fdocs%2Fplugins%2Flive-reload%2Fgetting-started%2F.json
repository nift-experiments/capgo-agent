        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "Close the current WebSocket connection and disable auto reconnect."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 57,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { LiveReload } from '@capgo/capacitor-live-reload';\n\nconst result = await LiveReload.disconnect();\nconsole.log(result);"
    },
    {
      "type": "heading",
      "location": {
        "line": 64,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
