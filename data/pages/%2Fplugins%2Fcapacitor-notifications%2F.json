        {
          "type": "text",
          "location": {
            "line": 1,
            "column": 3
          },
          "text": "Using @capgo/capacitor-notifications"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 3,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "Send native iOS and Android push notifications from Capgo with user lookup, badges, foreground/open tracking, background callbacks, and silent Capgo live-update checks."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 5,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 1
          },
          "text": "The plugin is built for the Capgo notification pipeline. Capgo stores platform credential metadata and campaign control data in Postgres, while active device state and delivery events are written to Cloudflare Analytics Engine."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 7,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 9,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 9,
            "column": 1
          },
          "text": "Use the Capgo CLI for a guided setup:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 11,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx @capgo/cli@latest notifications setup com.example.app"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 15,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 1
          },
          "text": "Manual install:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 17,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-notifications @capgo/capacitor-updater\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 22,
        "column": 1
      },
      "depth": 2,
      "blocks": [
