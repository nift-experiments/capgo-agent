            "line": 34,
            "column": 4
          },
          "text": "Register A Signed User"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 36,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 1
          },
          "text": "Mint "
        },
