          "type": "inlineCode",
          "location": {
            "line": 36,
            "column": 6
          },
          "text": "identityProof"
        },
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 21
          },
          "text": " from your backend with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 36,
            "column": 45
          },
          "text": "POST /notifications/recipients/proof"
        },
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 83
          },
          "text": ", then register the device after your own login succeeds."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 38,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await CapgoNotifications.register({\n  externalId: 'customer-user-123',\n  identityProof,\n  tags: ['paid'],\n  attributes: { plan: 'team' },\n  consent: true,\n})"
    },
    {
      "type": "heading",
      "location": {
        "line": 48,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 4
          },
          "text": "Listen For Events"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 50,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await CapgoNotifications.addListener('notificationReceived', (notification) => {\n  console.log('Received', notification)\n})\n\nawait CapgoNotifications.addListener('notificationOpened', (event) => {\n  console.log('Opened', event.notification.id)\n})\n\nawait CapgoNotifications.addListener('backgroundNotification', async (event) => {\n  try {\n    console.log('Background payload', event.notification.data)\n  } finally {\n    await event.finish()\n  }\n})"
    },
