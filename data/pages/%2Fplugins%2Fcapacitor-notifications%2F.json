        "column": 1
      },
      "lang": "swift",
      "meta": null,
      "text": "func application(_ application: UIApplication, didReceiveRemoteNotification userInfo: [AnyHashable: Any], fetchCompletionHandler completionHandler: @escaping (UIBackgroundFetchResult) -> Void) {\n    NotificationCenter.default.post(name: Notification.Name(\"CapgoNotificationsRemoteNotification\"), object: userInfo)\n    completionHandler(.newData)\n}"
