          },
          "text": "Configure"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 24,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoNotifications } from '@capgo/capacitor-notifications'\n\nawait CapgoNotifications.configure({\n  appId: 'com.example.app',\n  autoUpdater: true,\n  updateInstallMode: 'next',\n})"
    },
    {
      "type": "heading",
      "location": {
