    {
      "type": "component",
      "name": "Aside",
      "props": {
        "type": "note",
        "title": "Installing for older Capacitor versions"
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 65,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 65,
                "column": 1
              },
              "text": "The command above (step 3) installs the latest version (v8.x) for Capacitor 8. For older Capacitor versions, use the appropriate npm tag:"
            }
          ]
        },
        {
          "type": "code",
          "location": {
            "line": 67,
            "column": 1
          },
          "lang": "bash",
          "meta": null,
          "text": "# Capacitor 7\nnpm i @capgo/capacitor-updater@lts-v7\n\n# Capacitor 6\nnpm i @capgo/capacitor-updater@lts-v6\n\n# Capacitor 5\nnpm i @capgo/capacitor-updater@lts-v5\n\n# Capacitor 4\nnpm i @capgo/capacitor-updater@lts-v4"
        },
        {
          "type": "paragraph",
          "location": {
            "line": 81,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 81,
                "column": 1
              },
              "text": "Each plugin major version matches the Capacitor major version (v8 → Capacitor 8, v7 → Capacitor 7, v6 → Capacitor 6, v5 → Capacitor 5, v4 → Capacitor 4). When the latest line is "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 81,
                "column": 179
              },
              "text": "8.3.4"
            },
            {
              "type": "text",
              "location": {
                "line": 81,
                "column": 186
              },
              "text": ", the matching LTS line is "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 81,
                "column": 213
              },
              "text": "7.3.4"
            },
            {
              "type": "text",
              "location": {
                "line": 81,
                "column": 220
              },
              "text": " with the same features and bug fixes. The updater receives monthly mirrored LTS backports for "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 81,
                "column": 315
              },
              "text": "v7"
            },
            {
              "type": "text",
              "location": {
                "line": 81,
                "column": 319
              },
              "text": "/"
