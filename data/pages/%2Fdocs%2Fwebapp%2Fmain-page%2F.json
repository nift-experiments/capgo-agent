      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 1
          },
          "text": "Let's start at the beginning. The first thing you see is the "
        },
        {
          "type": "strong",
          "location": {
            "line": 7,
            "column": 62
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 64
              },
              "text": "stats"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 71
          },
          "text": ". It contains app-specific statistics. Those updates depend on the usage of the app"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 9,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 9,
            "column": 1
          },
          "text": "The second thing you see is the list of all available apps. This will change depending on how many apps have you created. You can click on each app to see more details about it."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 11,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 1
          },
          "text": "The third thing you see is the "
        },
        {
          "type": "strong",
          "location": {
            "line": 11,
            "column": 32
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 11,
                "column": 34
              },
              "text": "API keys"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 44
          },
          "text": " button. This button will take you to the "
        },
        {
          "type": "link",
          "location": {
            "line": 11,
            "column": 86
          },
          "url": "/docs/webapp/api-keys/",
          "title": null,
