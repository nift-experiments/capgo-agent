          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-android-kiosk` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-android-kiosk\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorAndroidKiosk } from '@capgo/capacitor-android-kiosk';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "isInKioskMode"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Checks if the app is currently running in kiosk mode."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorAndroidKiosk } from '@capgo/capacitor-android-kiosk';\n\nconst { isInKioskMode } = await CapacitorAndroidKiosk.isInKioskMode();\nconsole.log('Kiosk mode active:', isInKioskMode);"
    },
    {
      "type": "heading",
      "location": {
        "line": 42,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 42,
            "column": 5
          },
          "text": "isSetAsLauncher"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Checks if the app is set as the device launcher (home app)."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 46,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorAndroidKiosk } from '@capgo/capacitor-android-kiosk';\n\nconst { isLauncher } = await CapacitorAndroidKiosk.isSetAsLauncher();\nconsole.log('Is launcher:', isLauncher);"
    },
    {
      "type": "heading",
      "location": {
        "line": 53,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 53,
            "column": 5
          },
          "text": "enterKioskMode"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "Enters kiosk mode, hiding system UI and blocking hardware buttons.\nAlso starts a foreground keep-alive service so the app is less likely to be killed by the system.\nThe app must be set as the device launcher for this to work effectively."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 59,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorAndroidKiosk } from '@capgo/capacitor-android-kiosk';\n\nawait CapacitorAndroidKiosk.enterKioskMode();"
    },
    {
      "type": "heading",
      "location": {
        "line": 65,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 65,
            "column": 5
          },
          "text": "exitKioskMode"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 67,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 1
          },
          "text": "Exits kiosk mode, restoring normal system UI and hardware button functionality.\nAlso stops the foreground keep-alive service started in enterKioskMode()."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 70,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorAndroidKiosk } from '@capgo/capacitor-android-kiosk';\n\nawait CapacitorAndroidKiosk.exitKioskMode();\nconsole.log('Exited kiosk mode');"
    },
    {
      "type": "heading",
      "location": {
        "line": 77,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 77,
            "column": 5
          },
          "text": "setAsLauncher"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 79,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 1
          },
          "text": "Opens the device's home screen settings to allow user to set this app as the launcher.\nThis is required for full kiosk mode functionality."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 82,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorAndroidKiosk } from '@capgo/capacitor-android-kiosk';\n\nawait CapacitorAndroidKiosk.setAsLauncher();\n// User will be prompted to select this app as the home app"
    },
    {
      "type": "heading",
      "location": {
        "line": 89,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 89,
            "column": 5
          },
          "text": "setAllowedKeys"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 91,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 91,
            "column": 1
          },
          "text": "Sets which hardware keys are allowed to function in kiosk mode.\nBy default, all hardware keys are blocked in kiosk mode."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 94,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorAndroidKiosk } from '@capgo/capacitor-android-kiosk';\n\n// Allow volume keys only\nawait CapacitorAndroidKiosk.setAllowedKeys({\n  volumeUp: true,\n  volumeDown: true,\n  back: false,\n  home: false,\n  recent: false\n});"
    },
    {
