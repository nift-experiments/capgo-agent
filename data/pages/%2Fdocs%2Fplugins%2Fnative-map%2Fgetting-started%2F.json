          },
          "text": "toBack: true"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 19
          },
          "text": " so MapKit or Google Maps renders "
        },
        {
          "type": "strong",
          "location": {
            "line": 69,
            "column": 53
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 69,
                "column": 55
              },
              "text": "behind"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 63
          },
          "text": " a transparent Capacitor WebView. Touches on transparent areas pass through to the map (pinch, rotate, tilt, pan). Regions that must receive taps need "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 214
          },
          "text": "data-map-overlay"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 232
          },
          "text": " so the README CSS gives them "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 262
          },
          "text": "pointer-events: auto"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 284
          },
          "text": "."
        }
      ]
    },
