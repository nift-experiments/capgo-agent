    {
      "type": "code",
      "location": {
        "line": 73,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const map = await NativeMap.create({\n  id: 'overlay-map',\n  toBack: true,\n  apiKey: 'YOUR_GOOGLE_MAPS_API_KEY',\n  config: {\n    center: { lat: 37.7749, lng: -122.4194 },\n    zoom: 12,\n    x: 0,\n    y: 0,\n    width: window.innerWidth,\n    height: window.innerHeight,\n  },\n});\n\nawait map.updateLayout({ x: 0, y: 0, width: window.innerWidth, height: window.innerHeight });\nawait map.hide();\nawait map.show();"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 93,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 93,
            "column": 1
          },
          "text": "Use a root element with class "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 93,
            "column": 31
          },
          "text": "map-overlay-root"
        },
        {
          "type": "text",
          "location": {
            "line": 93,
            "column": 49
          },
          "text": " and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 93,
            "column": 54
          },
          "text": "data-native-map-overlay-root"
        },
        {
          "type": "text",
          "location": {
            "line": 93,
            "column": 84
          },
          "text": ". Put "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 93,
            "column": 90
          },
          "text": "data-map-overlay"
        },
        {
          "type": "text",
          "location": {
            "line": 93,
            "column": 108
          },
          "text": " on each HUD region that should receive taps (for example a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 93,
            "column": 168
          },
          "text": "header"
        },
        {
          "type": "text",
          "location": {
            "line": 93,
            "column": 176
          },
          "text": " or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 93,
            "column": 180
          },
          "text": "footer"
        },
        {
