{
  "version": 1,
  "route": "/docs/public-api/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/public-api/index.mdx",
  "sourceSha256": "54c5e42bfdda7728009d5f2037bf19b50a3e3661d73bf92933db925a4b66456c",
  "metadata": {
    "title": "API Overview",
    "description": "Explore Capgo's public API for managing resources such as organizations, devices, channels, and bundles using RESTful HTTP methods and authentication.",
    "sidebar": {
      "order": 1
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "This is the documentation of the public API of Capgo cloud. The API allows you to programmatically manage your Capgo resources, including organizations, devices, channels, and bundles. It's designed to be RESTful and uses standard HTTP methods."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "Authentication"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "All API endpoints require authentication. To authenticate your requests, add your API key in the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 8,
            "column": 98
          },
          "text": "x-api-key"
        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 109
          },
          "text": " header."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Example:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "curl -H \"x-api-key: YOUR_API_KEY\" https://api.capgo.app/organization/"
    },
    {
      "type": "component",
      "name": "LinkCard",
      "props": {
        "title": "Get API key",
        "description": "Generate your API key in the Capgo dashboard",
        "href": "https://console.capgo.app/settings/organization/api-keys"
      },
      "blocks": [],
      "location": {
        "line": 16,
        "column": 1
      }
    },
    {
      "type": "paragraph",
      "location": {
        "line": 22,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 1
          },
          "text": "The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 22,
            "column": 5
          },
          "text": "authorization"
        },
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 20
          },
          "text": " header is still accepted for legacy API keys, but "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 22,
            "column": 71
          },
          "text": "x-api-key"
        },
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 82
          },
          "text": " is the recommended header for all key types, including secure hashed keys."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 24,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 4
          },
          "text": "Rate Limiting"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 26,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 1
          },
          "text": "The API implements rate limiting to ensure fair usage. Current limits are:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 27,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 27,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 27,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 27,
                    "column": 3
                  },
                  "text": "100 requests per minute for standard accounts"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 28,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 28,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 28,
                    "column": 3
                  },
                  "text": "1000 requests per minute for enterprise accounts"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 30,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 1
          },
          "text": "If you exceed these limits, you'll receive a 429 (Too Many Requests) response."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 32,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 5
          },
          "text": "Device channel changes"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 34,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 1
          },
          "text": "Device channel changes use the plugin API and have separate abuse-prevention limits that apply to every plan, including trials:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 36,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 36,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 36,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 36,
                    "column": 3
                  },
                  "text": "A device can make up to 5 requests per second for each channel operation ("
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 36,
                    "column": 77
                  },
                  "text": "set"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 36,
                    "column": 82
                  },
                  "text": ", "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 36,
                    "column": 84
                  },
                  "text": "get"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 36,
                    "column": 89
                  },
                  "text": ", "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 36,
                    "column": 91
                  },
                  "text": "delete"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 36,
                    "column": 99
                  },
                  "text": ", or "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 36,
                    "column": 104
                  },
                  "text": "list"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 36,
                    "column": 110
                  },
                  "text": "). This limit is scoped to the app, device, and operation."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 37,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 37,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 37,
                    "column": 3
                  },
                  "text": "Setting the same device to the same channel more than once within 60 seconds returns a 429 response. Switching to a different channel is allowed after the per-second limit resets."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 38,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 38,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 38,
                    "column": 3
                  },
                  "text": "An additional limit of 1000 channel requests per minute applies to each app and IP address."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 40,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 1
          },
          "text": "These limits are not account-wide. If your channel switcher can return to a recently selected channel, wait for the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 40,
            "column": 117
          },
          "text": "retryAfterSeconds"
        },
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 136
          },
          "text": " duration in the 429 response before retrying."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 42,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 4
          },
          "text": "Response Format"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "All responses are in JSON format. Successful responses typically include either a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 44,
            "column": 83
          },
          "text": "data"
        },
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 89
          },
          "text": " object or a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 44,
            "column": 102
          },
          "text": "status"
        },
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 110
          },
          "text": " field. Error responses include an "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 44,
            "column": 145
          },
          "text": "error"
        },
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 152
          },
          "text": " field with a description of what went wrong."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 46,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 1
          },
          "text": "Example success response:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 47,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"status\": \"ok\",\n  \"data\": { ... }\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 54,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 1
          },
          "text": "Example error response:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 55,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"error\": \"Invalid API key\",\n  \"status\": \"KO\"\n}"
    },
