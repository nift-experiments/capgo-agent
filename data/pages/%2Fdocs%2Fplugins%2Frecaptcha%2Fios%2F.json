        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Create an iOS mobile application key in Google Cloud reCAPTCHA. Register the bundle identifier used by your Capacitor app, then set the key in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 144
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 165
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "iOS uses Google's "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 19
          },
          "text": "RecaptchaEnterprise"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 40
          },
          "text": " mobile SDK. Regular, non-Enterprise reCAPTCHA v3 is only available on Web in this plugin; "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 131
          },
          "text": "enterprise: false"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 150
          },
          "text": " is rejected on iOS."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\nimport '@capgo/capacitor-recaptcha';\n\nconst config: CapacitorConfig = {\n  plugins: {\n    Recaptcha: {\n      iosSiteKey: 'IOS_SITE_KEY',\n    },\n  },\n};\n\nexport default config;"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Dependency"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "The plugin ships CocoaPods and Swift Package Manager metadata for Google's "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 76
          },
          "text": "RecaptchaEnterprise"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 97
          },
          "text": " iOS SDK. Running "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 115
          },
          "text": "npx cap sync ios"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 133
          },
          "text": " installs the native dependency through your selected Capacitor iOS workflow."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 27,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 4
          },
          "text": "Execute"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 29,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { Recaptcha } from '@capgo/capacitor-recaptcha';\n\nconst { token } = await Recaptcha.execute({\n  action: 'password_reset',\n  timeout: 10000,\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 38,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 1
          },
          "text": "Send the token to your backend immediately and create a reCAPTCHA assessment before accepting the protected request."
        }
      ]
    },
    {
