              },
              "text": "Logs"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 69
          },
          "text": " tab. It summarizes the most important diagnostic and error signals so you can decide what to investigate before reading individual log rows."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Choose a 1, 3, 7, or 30 day period at the top of the page. The selected interval applies to the summary, categories, trend, version table, and device table."
        }
      ]
    },
