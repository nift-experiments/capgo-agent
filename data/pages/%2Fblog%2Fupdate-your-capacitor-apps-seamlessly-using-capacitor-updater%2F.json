    "head_image_alt": "Update your Capacitor apps seamlessly using Capacitor-updater Capgo blog illustration",
    "keywords": "Capacitor, mobile app development, live updates, OTA updates, continuous integration, mobile app updates",
    "tag": "Tutorial",
    "published": true,
