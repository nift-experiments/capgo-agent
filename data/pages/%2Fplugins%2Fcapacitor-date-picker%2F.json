          "text": "@capgo/capacitor-date-picker"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 31
          },
          "text": " adds native date, time, date-time, year-month, and range pickers to Capacitor apps on iOS and Android, with a matching Web fallback."
        }
      ]
