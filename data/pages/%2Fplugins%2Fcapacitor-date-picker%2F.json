    {
      "type": "code",
      "location": {
        "line": 28,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { DatePicker } from '@capgo/capacitor-date-picker';\n\nconst result = await DatePicker.present({\n  mode: 'date',\n  date: '2026-05-27',\n  min: '2026-01-01',\n  max: '2026-12-31',\n  format: 'yyyy-MM-dd',\n  title: 'Select date',\n});\n\nconsole.log(result.value);"
    },
    {
      "type": "heading",
      "location": {
        "line": 43,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 43,
            "column": 4
          },
          "text": "Pick A Time"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 45,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await DatePicker.present({\n  mode: 'time',\n  is24h: true,\n  minuteStep: 15,\n  format: 'HH:mm',\n  title: 'Select time',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 55,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 4
          },
          "text": "Pick A Range"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 57,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const range = await DatePicker.presentRange({\n  start: '2026-05-01',\n  end: '2026-05-27',\n  format: 'yyyy-MM-dd',\n  startTitle: 'Start date',\n  endTitle: 'End date',\n});\n\nconsole.log(range.start, range.end);"
    },
    {
      "type": "heading",
      "location": {
