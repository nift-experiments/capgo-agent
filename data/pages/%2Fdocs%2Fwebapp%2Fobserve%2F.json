        {
          "type": "link",
          "location": {
            "line": 32,
            "column": 318
          },
          "url": "/docs/live-updates/progressive-rollouts/#auto-pause-policy",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 32,
                "column": 319
              },
              "text": "auto-pause"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 390
          },
          "text": " when you want Capgo to enforce a failure threshold."
