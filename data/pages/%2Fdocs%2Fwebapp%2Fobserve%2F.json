        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Observe is in beta"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "strong",
          "location": {
            "line": 4,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 4,
                "column": 3
              },
              "text": "Observe"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 12
          },
          "text": " is Capgo's app-health view for native runtime signals. It helps you judge whether a release is healthy by combining launch timing, WebView timing, issue events, devices, versions, and deployment markers in one screen."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "Open an app in the Capgo console and choose "
        },
        {
          "type": "strong",
          "location": {
            "line": 6,
            "column": 45
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 6,
                "column": 47
              },
              "text": "Observe"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 56
          },
          "text": ". Select a period of 1, 3, 7, or 30 days; the view refreshes its cards, charts, and tables for that interval."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 8,
        "column": 1
      },
