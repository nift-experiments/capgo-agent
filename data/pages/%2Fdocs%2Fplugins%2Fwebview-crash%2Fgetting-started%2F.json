          },
          "text": "Platform notes"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 138,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
