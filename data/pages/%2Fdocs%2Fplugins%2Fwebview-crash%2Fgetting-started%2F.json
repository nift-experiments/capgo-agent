          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 138,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 138,
                    "column": 3
                  },
                  "text": "Android stores crash metadata from "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 138,
                    "column": 38
                  },
                  "text": "onRenderProcessGone"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 138,
                    "column": 59
                  },
                  "text": ", including "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 138,
                    "column": 71
                  },
                  "text": "didCrash"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 138,
                    "column": 81
                  },
                  "text": " and "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 138,
                    "column": 86
                  },
                  "text": "rendererPriorityAtExit"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 138,
                    "column": 110
                  },
                  "text": " when the platform provides them."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 139,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 139,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 139,
                    "column": 3
                  },
                  "text": "iOS stores crash metadata from "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 139,
                    "column": 34
                  },
                  "text": "webViewWebContentProcessDidTerminate"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 139,
                    "column": 72
                  },
                  "text": " and adds the current application state when available."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 140,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 140,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 140,
                    "column": 3
                  },
                  "text": "Manual and scheduled restarts create a fresh WebView. Android recreates the host activity; iOS rebuilds the Capacitor bridge view."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 141,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
