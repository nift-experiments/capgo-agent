          },
          "text": "getPendingCrashInfo"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 102,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 102,
            "column": 1
          },
          "text": "Returns the stored native crash or restart marker, or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 102,
            "column": 55
          },
          "text": "null"
        },
        {
          "type": "text",
          "location": {
            "line": 102,
            "column": 61
          },
          "text": " when nothing is pending."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 104,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const pending = await WebViewCrash.getPendingCrashInfo();\nif (pending.value) {\n  console.log(pending.value.platform, pending.value.reason);\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 111,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
