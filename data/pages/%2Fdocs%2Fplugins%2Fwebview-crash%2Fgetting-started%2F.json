          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-webview-crash` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-webview-crash\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { WebViewCrash } from '@capgo/capacitor-webview-crash';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "Recommended recovery flow"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 31,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 1
          },
          "text": "Attach listeners as early as possible in your app startup so the recovered runtime can react before users continue navigating:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 33,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { WebViewCrash } from '@capgo/capacitor-webview-crash';\n\nawait WebViewCrash.addListener('webViewRestoredAfterCrash', async (info) => {\n  console.log('Recovered after a WebView crash', info);\n\n  // Rehydrate critical state, reopen the correct screen, or prompt the user to retry.\n  await WebViewCrash.clearPendingCrashInfo();\n});\n\nawait WebViewCrash.addListener('webViewRestoredAfterRestart', async (info) => {\n  console.log('Recovered after a native WebView restart', info);\n  await WebViewCrash.clearPendingCrashInfo();\n});\n\nconst pending = await WebViewCrash.getPendingCrashInfo();\n// Note: the listener callback may have already cleared the pending marker.\nif (pending.value) {\n  console.log('Pending crash or restart marker', pending.value);\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 55,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 4
          },
          "text": "Native auto restart"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 57,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 1
          },
          "text": "Set restart options in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 57,
            "column": 24
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 45
          },
          "text": " so the decision stays in native code even when the JavaScript runtime has crashed or has not loaded yet:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 59,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\nimport type { WebViewCrashPluginConfig } from '@capgo/capacitor-webview-crash';\n\nconst webViewCrash: WebViewCrashPluginConfig = {\n  // Enabled by default. Keep this on for long-running apps.\n  restartOnCrash: true,\n\n  // Use a 5-field cron schedule in the device local timezone.\n  // Do not combine restartCron with an active restartIntervalMs.\n  restartCron: '0 3 * * *',\n\n  // Optional delay before restarting after a crash.\n  restartAfterCrashDelayMs: 0,\n};\n\nconst config: CapacitorConfig = {\n  plugins: {\n    WebViewCrash: webViewCrash,\n  },\n};\n\nexport default config;"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 84,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 84,
            "column": 5
          },
          "text": "restartIntervalMs"
        },
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 24
          },
          "text": " for always-on apps where users may keep the same WebView open for days: kiosk screens, control-room dashboards, warehouse scanners, POS terminals, fleet tablets, and digital signage. Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 84,
            "column": 212
          },
          "text": "restartCron"
        },
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 225
          },
          "text": " for wall-clock restarts such as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 84,
            "column": 258
          },
          "text": "0 3 * * *"
        },
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 269
          },
          "text": " for a daily 03:00 restart in the device local timezone. Scheduled restarts write a pending marker with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 84,
            "column": 373
          },
          "text": "reason: 'periodicRestart'"
        },
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 400
          },
          "text": ", then Android recreates the host activity and iOS rebuilds the Capacitor bridge view so a new "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 84,
            "column": 495
          },
          "text": "WKWebView"
        },
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 506
          },
          "text": " is created from native code."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 86,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 1
          },
          "text": "Choose an interval or cron schedule your product can tolerate. "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 86,
            "column": 64
          },
          "text": "restartCron"
        },
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 77
          },
          "text": " supports "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 86,
            "column": 87
          },
          "text": "*"
        },
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 90
          },
          "text": ", lists, ranges, and steps. Do not configure both schedules at once: native initialization throws a fatal config error when "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 86,
            "column": 214
          },
          "text": "restartCron"
        },
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 227
          },
          "text": " is set and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 86,
            "column": 239
          },
          "text": "restartIntervalMs"
        },
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 258
          },
          "text": " is greater than "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 86,
            "column": 275
          },
          "text": "0"
        },
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 278
          },
          "text": ". A restart creates a fresh JavaScript runtime, so persist queued events, unsaved form state, and current navigation state before using aggressive schedules."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 88,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 88,
            "column": 4
          },
          "text": "Manual native restart"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 90,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 90,
            "column": 1
          },
          "text": "Call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 90,
            "column": 6
          },
          "text": "restartWebView()"
        },
        {
          "type": "text",
          "location": {
            "line": 90,
            "column": 24
          },
          "text": " when the current JavaScript runtime decides the native WebView should be replaced proactively, for example after a memory-heavy workflow or before entering a long unattended session:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 92,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await WebViewCrash.restartWebView();"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 96,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 96,
            "column": 1
          },
          "text": "The method writes a pending marker with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 96,
            "column": 41
          },
          "text": "reason: 'manualRestart'"
        },
        {
          "type": "text",
          "location": {
            "line": 96,
            "column": 66
          },
          "text": ", resolves the current call, then asks native code to create a fresh WebView. Android recreates the host activity. iOS rebuilds the Capacitor bridge view so a new "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 96,
            "column": 229
          },
          "text": "WKWebView"
        },
        {
          "type": "text",
          "location": {
            "line": 96,
            "column": 240
          },
          "text": " is created instead of reloading the current page."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 98,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 98,
            "column": 4
          },
          "text": "API overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 100,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 100,
