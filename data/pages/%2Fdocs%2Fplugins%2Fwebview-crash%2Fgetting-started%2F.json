                "line": 141,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 141,
                    "column": 3
                  },
                  "text": "Scheduled restarts use "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 141,
                    "column": 26
                  },
                  "text": "reason: 'periodicRestart'"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 141,
                    "column": 53
                  },
                  "text": "; manual restarts use "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 141,
                    "column": 75
                  },
                  "text": "reason: 'manualRestart'"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 141,
                    "column": 100
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 142,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
