        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 113,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 113,
            "column": 1
          },
          "text": "Clears the stored marker after your recovery handling is finished."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 115,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await WebViewCrash.clearPendingCrashInfo();"
    },
    {
      "type": "heading",
      "location": {
        "line": 119,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 119,
            "column": 5
          },
          "text": "simulateCrashRecovery"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 121,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 121,
            "column": 1
          },
          "text": "Creates a fake crash marker so QA and local debugging can exercise the recovery path without crashing a real WebView."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 123,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const simulated = await WebViewCrash.simulateCrashRecovery();\nconsole.log(simulated.value);"
    },
