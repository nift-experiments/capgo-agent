                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 142,
                    "column": 3
                  },
                  "text": "Web does not detect real renderer crashes. The web implementation only simulates the behavior with local storage."
                }
              ]
            }
          ]
        }
      ]
    },
