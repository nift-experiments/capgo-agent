      "type": "component",
      "name": "Steps",
      "props": {},
      "blocks": [
        {
          "type": "list",
          "location": {
            "line": 83,
            "column": 1
          },
          "ordered": true,
          "start": 1,
          "spread": false,
          "blocks": [
            {
              "type": "listItem",
              "location": {
