{
  "version": 1,
  "route": "/docs/live-updates/testing-native-builds-without-live-updates/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/live-updates/testing-native-builds-without-live-updates.mdx",
  "sourceSha256": "8b4dbb49fa55a04d22033d65e451e676ee3d776c74e35b2eb0a4c6142e464bd4",
  "metadata": {
    "title": "Test Native Builds Without Live Updates",
    "description": "Verify the web assets bundled in a native build without receiving a previously deployed live update.",
    "sidebar": {
      "order": 5
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "When testing a new native binary, make sure it starts from the web assets bundled in that binary—not from a previously downloaded live update. Use one or combine the safeguards below."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "1. Bump the Native Baseline Version"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "Set "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 8,
            "column": 5
          },
          "text": "CapacitorUpdater.version"
        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 31
          },
          "text": " from the version used for your native release, and increase it for every native build. A newer native baseline makes the installed binary distinct from older bundles and, with the default "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 8,
            "column": 220
          },
          "text": "resetWhenUpdate: true"
        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 243
          },
          "text": ", removes downloaded bundles when the newer native app is installed."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 10,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\nimport pkg from './package.json';\n\nconst config: CapacitorConfig = {\n  plugins: {\n    CapacitorUpdater: {\n      // Keep this aligned with, and increase it for, every native build.\n      version: pkg.version,\n      autoUpdate: 'atBackground',\n    },\n  },\n};\n\nexport default config;"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 27,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 1
          },
          "text": "For example, a binary built with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 27,
            "column": 34
          },
          "text": "version: '1.4.1'"
        },
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 52
          },
          "text": " has a higher native baseline than an existing "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 27,
            "column": 99
          },
          "text": "1.4.0"
        },
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 106
          },
          "text": " bundle. Do not reuse a native version when you need to verify the bundled assets."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "2. Block Emulator and Development-Build Updates in the Console"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 31,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 1
          },
          "text": "Open your app in the Capgo console, go to "
        },
        {
          "type": "strong",
          "location": {
            "line": 31,
            "column": 43
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 31,
                "column": 45
              },
              "text": "Channels"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 55
          },
          "text": ", select the channel used by the build, and open the "
        },
        {
          "type": "strong",
          "location": {
            "line": 31,
            "column": 108
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 31,
                "column": 110
              },
              "text": "Information"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 123
          },
          "text": " tab. Turn "
        },
        {
          "type": "strong",
          "location": {
            "line": 31,
            "column": 134
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 31,
                "column": 136
              },
              "text": "off"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 141
          },
          "text": " both "
        },
        {
          "type": "strong",
          "location": {
            "line": 31,
            "column": 147
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 31,
                "column": 149
              },
              "text": "Allow development build"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 174
          },
          "text": " and "
        },
        {
          "type": "strong",
          "location": {
            "line": 31,
            "column": 179
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 31,
                "column": 181
              },
              "text": "Allow Emulators"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 198
          },
          "text": "."
        }
      ]
    },
    {
      "type": "element",
      "name": "figure",
      "props": {},
      "blocks": [
        {
          "type": "element",
          "name": "img",
          "props": {
            "src": "/native-build-live-updates-channel-settings.webp",
            "alt": "Capgo channel Information tab showing the Allow development build and Allow Emulators settings",
            "loading": "lazy",
            "width": "1536",
            "height": "1200"
          },
          "blocks": [],
          "location": {
            "line": 34,
            "column": 3
          }
        },
        {
          "type": "paragraph",
          "location": {
            "line": 35,
            "column": 3
          },
          "blocks": [
            {
              "type": "element",
              "name": "figcaption",
              "props": {},
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 35,
                    "column": 15
                  },
                  "text": "These controls are in the channel Information tab. Disable both highlighted settings to keep development builds and emulators on their bundled web assets."
                }
              ],
              "location": {
                "line": 35,
                "column": 3
              }
            }
          ]
        }
      ],
      "location": {
        "line": 33,
        "column": 1
      }
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {
        "type": "caution"
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 39,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 39,
                "column": 1
              },
              "text": "The screenshot shows where to find the settings; its highlighted toggles are enabled. Turn both toggles off for a channel that must not deliver live updates to development builds or emulators."
            }
          ]
        }
      ],
      "location": {
        "line": 38,
        "column": 1
      }
    },
    {
      "type": "paragraph",
      "location": {
        "line": 42,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 1
          },
          "text": "This channel policy blocks update delivery only for the selected build types. Production-signed physical devices can still receive updates according to the channel's other settings."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 44,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 4
          },
          "text": "3. Enable Live Updates Only in Native CI Builds"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 46,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 1
          },
          "text": "For teams that want local, emulator, and developer builds to be safe by default, make live updates opt-in through an environment variable. The config below disables update checks unless "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 46,
            "column": 187
          },
          "text": "CAPGO_LIVE_UPDATES"
        },
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 207
          },
          "text": " is exactly "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 46,
            "column": 219
          },
          "text": "true"
        },
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 225
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 48,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\nimport pkg from './package.json';\n\nconst liveUpdatesEnabled = process.env.CAPGO_LIVE_UPDATES === 'true';\n\nconst config: CapacitorConfig = {\n  appId: 'com.example.app',\n  appName: 'Example App',\n  plugins: {\n    CapacitorUpdater: {\n      // Bump package.json for every native build.\n      version: pkg.version,\n      // Local builds are off; native CI explicitly enables live updates.\n      autoUpdate: liveUpdatesEnabled ? 'atBackground' : false,\n    },\n  },\n};\n\nexport default config;"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 70,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 1
          },
          "text": "Set the variable only in the CI step that synchronizes and builds the native app:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 72,
        "column": 1
      },
      "lang": "yaml",
      "meta": null,
      "text": "- run: CAPGO_LIVE_UPDATES=true npx cap sync\n- run: ./build-native-app.sh"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 77,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 77,
            "column": 1
          },
          "text": "Run "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 77,
            "column": 5
          },
          "text": "npx cap sync"
        },
        {
          "type": "text",
          "location": {
            "line": 77,
            "column": 19
          },
          "text": " after setting the variable because Capacitor copies this configuration into the native projects during sync. Without the variable, local builds and emulator builds keep "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 77,
            "column": 189
          },
          "text": "autoUpdate: false"
        },
        {
          "type": "text",
          "location": {
            "line": 77,
            "column": 208
          },
          "text": " and do not check for live updates."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 79,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 4
          },
          "text": "Quick Checklist"
        }
      ]
    },
