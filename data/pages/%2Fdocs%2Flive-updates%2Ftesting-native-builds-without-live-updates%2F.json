                  "location": {
                    "line": 83,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 83,
                        "column": 4
                      },
                      "text": "Increase the version used by "
                    },
                    {
                      "type": "inlineCode",
                      "location": {
                        "line": 83,
                        "column": 33
                      },
                      "text": "CapacitorUpdater.version"
                    },
                    {
                      "type": "text",
                      "location": {
                        "line": 83,
                        "column": 59
                      },
                      "text": " for the native binary."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 84,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 84,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 84,
                        "column": 4
                      },
                      "text": "Disable "
                    },
                    {
                      "type": "strong",
                      "location": {
                        "line": 84,
                        "column": 12
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 84,
                            "column": 14
                          },
                          "text": "Allow development build"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "location": {
                        "line": 84,
                        "column": 39
                      },
                      "text": " and "
                    },
                    {
                      "type": "strong",
                      "location": {
                        "line": 84,
                        "column": 44
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 84,
                            "column": 46
                          },
                          "text": "Allow Emulators"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "location": {
                        "line": 84,
                        "column": 63
                      },
                      "text": " on the channel when testing those build types."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 85,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 85,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 85,
                        "column": 4
                      },
                      "text": "Build locally without "
                    },
                    {
                      "type": "inlineCode",
                      "location": {
                        "line": 85,
                        "column": 26
                      },
                      "text": "CAPGO_LIVE_UPDATES"
                    },
                    {
                      "type": "text",
                      "location": {
                        "line": 85,
                        "column": 46
                      },
                      "text": "."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 86,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 86,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 86,
                        "column": 4
                      },
                      "text": "Set "
                    },
                    {
                      "type": "inlineCode",
                      "location": {
                        "line": 86,
                        "column": 8
                      },
                      "text": "CAPGO_LIVE_UPDATES=true"
                    },
                    {
                      "type": "text",
                      "location": {
                        "line": 86,
                        "column": 33
                      },
                      "text": " only before "
                    },
                    {
                      "type": "inlineCode",
                      "location": {
                        "line": 86,
                        "column": 46
                      },
                      "text": "npx cap sync"
                    },
                    {
                      "type": "text",
                      "location": {
                        "line": 86,
                        "column": 60
                      },
                      "text": " in the native CI job that should receive live updates."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "location": {
        "line": 81,
        "column": 1
      }
    },
