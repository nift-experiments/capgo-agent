          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-keep-awake` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-keep-awake\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { KeepAwake } from '@capgo/capacitor-keep-awake';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "keepAwake"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Prevent the device from dimming the screen."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { KeepAwake } from '@capgo/capacitor-keep-awake';\n\nawait KeepAwake.keepAwake();\nconsole.log('Screen will stay awake');"
    },
    {
      "type": "heading",
      "location": {
        "line": 42,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 42,
            "column": 5
          },
          "text": "allowSleep"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Allow the device to dim the screen (disable keep awake)."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 46,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { KeepAwake } from '@capgo/capacitor-keep-awake';\n\nawait KeepAwake.allowSleep();\nconsole.log('Screen can now dim');"
    },
    {
