      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "Check if the keep awake feature is supported on the current platform."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 57,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { KeepAwake } from '@capgo/capacitor-keep-awake';\n\nconst { isSupported } = await KeepAwake.isSupported();\nif (isSupported) {\n  console.log('Keep awake is supported');\n}"
    },
