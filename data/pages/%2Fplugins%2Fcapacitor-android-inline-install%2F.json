    {
      "type": "code",
      "location": {
        "line": 32,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AndroidInlineInstall } from '@capgo/capacitor-android-inline-install';\n\nconst result = await AndroidInlineInstall.startInlineInstall({\n  id: 'com.example.app',\n  referrer: 'my-referrer',\n  overlay: true,\n  fallback: true\n});\n\nif (result.started) {\n  console.log('Install flow started');\n  if (result.fallbackUsed) {\n    console.log('Using fallback Play Store link');\n  }\n}"
    },
