  "metadata": {
    "title": "Android Setup",
    "description": "Android-specific setup for @capgo/capacitor-recaptcha.",
    "sidebar": {
      "order": 3
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Site Key"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Create an Android mobile application key in Google Cloud reCAPTCHA. Register the package name used by your Capacitor app, then set the key in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 143
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 164
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "Android uses Google's mobile reCAPTCHA SDK. Regular, non-Enterprise reCAPTCHA v3 is only available on Web in this plugin; "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 123
          },
          "text": "enterprise: false"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 142
          },
          "text": " is rejected on Android."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\nimport '@capgo/capacitor-recaptcha';\n\nconst config: CapacitorConfig = {\n  plugins: {\n    Recaptcha: {\n      androidSiteKey: 'ANDROID_SITE_KEY',\n    },\n  },\n};\n\nexport default config;"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Dependency"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "The plugin includes the Google Android reCAPTCHA dependency:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 27,
        "column": 1
      },
      "lang": "txt",
      "meta": null,
      "text": "com.google.android.recaptcha:recaptcha:18.8.0"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 31,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 1
          },
          "text": "Google's Android reCAPTCHA SDK requires core library desugaring in the consuming app. The plugin enables it automatically during "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 130
          },
          "text": "npx cap sync android"
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 152
          },
          "text": " and adds:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 33,
        "column": 1
      },
      "lang": "txt",
      "meta": null,
      "text": "com.android.tools:desugar_jdk_libs:2.1.5"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 37,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 37,
            "column": 1
          },
          "text": "You can override the dependency version from the app Gradle config with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 37,
            "column": 73
          },
          "text": "recaptchaVersion"
        },
        {
          "type": "text",
          "location": {
            "line": 37,
            "column": 91
          },
          "text": " when you need to pin a newer Google SDK release.\nYou can override the desugaring dependency with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 38,
            "column": 49
          },
          "text": "desugarJdkLibsVersion"
        },
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 72
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 40,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 4
          },
          "text": "Execute"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 42,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { Recaptcha } from '@capgo/capacitor-recaptcha';\n\nconst { token } = await Recaptcha.execute({\n  action: 'checkout',\n  timeout: 10000,\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "Send the token to your backend immediately and create a reCAPTCHA assessment before accepting the protected request."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 53,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 4
          },
          "text": "Keep going from Android Setup"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
