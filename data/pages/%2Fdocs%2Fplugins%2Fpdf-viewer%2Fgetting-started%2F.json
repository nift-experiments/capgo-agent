    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { PdfViewer } from '@capgo/capacitor-pdf-viewer';\n\nawait PdfViewer.addListener('pageChange', ({ page, pageCount }) => {\n  console.log(`Page ${page} of ${pageCount}`);\n});\n\nconst { pageCount } = await PdfViewer.open({\n  source: 'https://example.com/manual.pdf',\n  headers: { Authorization: 'Bearer YOUR_TOKEN' },\n  mode: 'fullscreen',\n  scrollMode: 'continuous',\n  page: 1,\n});\n\nconsole.log(`Opened ${pageCount} pages`);\n// Call PdfViewer.close() when the user dismisses the viewer or you navigate away."
