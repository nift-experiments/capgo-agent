        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-firebase-functions` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-firebase-functions\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { FirebaseFunctions } from '@capgo/capacitor-firebase-functions';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "callByName"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Call a callable function by name."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { FirebaseFunctions } from '@capgo/capacitor-firebase-functions';\n\nconst result = await FirebaseFunctions.callByName({ name: 'myFunction' });\nconsole.log(result);"
    },
    {
      "type": "heading",
      "location": {
        "line": 42,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 42,
            "column": 5
          },
          "text": "callByUrl"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Call a callable function by URL."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 46,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { FirebaseFunctions } from '@capgo/capacitor-firebase-functions';\n\nconst result = await FirebaseFunctions.callByUrl({\n  url: 'https://us-central1-my-project.cloudfunctions.net/myFunction',\n});\nconsole.log(result);"
    },
    {
      "type": "heading",
      "location": {
        "line": 55,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 55,
            "column": 5
          },
          "text": "useEmulator"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 57,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 1
          },
          "text": "Instrument your app to talk to the Cloud Functions emulator."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 59,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 59,
            "column": 1
          },
          "text": "On Android, the cleartext traffic must be allowed. On the Capacitor configuration:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 60,
        "column": 1
      },
      "lang": null,
      "meta": null,
      "text": "{\n  server: {\n    cleartext: true\n  }\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 67,
        "column": 1
      },
      "blocks": [
        {
          "type": "strong",
          "location": {
            "line": 67,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 67,
                "column": 3
              },
              "text": "The cleartext traffic is not intended for use in production."
            }
          ]
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 69,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { FirebaseFunctions } from '@capgo/capacitor-firebase-functions';\n\nawait FirebaseFunctions.useEmulator({ host: \"127.0.0.1\" });"
    },
