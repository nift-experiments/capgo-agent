      "text": "export interface CallByNameOptions<RequestData = unknown> extends CallOptions<RequestData> {\n  /**\n   * The name of the callable function.\n   *\n   * @example 'myFunction'\n   * @since 6.1.0\n   */\n  name: string;\n  /**\n   * The region of the callable function.\n   *\n   * @example 'us-central1'\n   * @since 6.1.0\n   */\n  region?: string;\n}"
    },
