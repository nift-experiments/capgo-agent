          },
          "text": "@capgo/capacitor-inappbrowser"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 32
          },
          "text": " opens external web content from a Capacitor app. Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 3,
            "column": 86
          },
          "text": "open()"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 94
          },
          "text": " for the platform browser surface, or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 3,
            "column": 132
          },
          "text": "openWebView()"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 147
          },
          "text": " when your app needs a managed native WebView with custom size, toolbar, messages, scripts, downloads, proxying, popup control, private storage, or Ionic UI layered above the page."
        }
      ]
    },
