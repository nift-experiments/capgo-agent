          "location": {
            "line": 24,
            "column": 5
          },
          "text": "Put App UI Above a Live Browser"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 26,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { InAppBrowser } from '@capgo/capacitor-inappbrowser';\n\nconst { id } = await InAppBrowser.openWebView({\n  url: 'https://example.com/checkout',\n  toBack: true,\n  transparentBackground: true,\n});\n\nawait InAppBrowser.dispatchInputEvent({\n  id,\n  type: 'click',\n  x: 160,\n  y: 420,\n});\n\nawait InAppBrowser.bringToFront({ id });"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 45,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 1
          },
          "text": "Use this for checkout overlays, browser-backed payment flows, guided support flows, or any feature where Ionic controls need to stay above live web content."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 47,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 5
          },
          "text": "Keep the App Clickable Around a Browser Sheet"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 49,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { id } = await InAppBrowser.openWebView({\n  url: 'https://example.com/offers',\n  height: window.innerHeight - 200,\n  y: 0,\n});\n\nawait InAppBrowser.updateDimensions({ id, height: window.innerHeight });"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 59,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 59,
            "column": 1
          },
          "text": "A custom-sized browser only captures touches inside its frame. The remaining visible app area stays tappable on Android and iOS."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 61,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 5
          },
          "text": "Avoid Persistent Web Sessions"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 63,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { id } = await InAppBrowser.openWebView({\n  url: 'https://example.com/login',\n  persistWebViewData: false,\n});\n\nawait InAppBrowser.clearAllBrowsingData();\nawait InAppBrowser.close({ id });"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 73,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 1
          },
          "text": "Use this for account switching, checkout testing, support impersonation, or auth flows where cookies, cache, local storage, and IndexedDB should not survive longer than needed."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 75,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 75,
            "column": 5
          },
          "text": "Preload and Swap Multiple WebViews"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 77,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const first = await InAppBrowser.openWebView({ url: 'https://example.com/a', hidden: true });\nconst second = await InAppBrowser.openWebView({ url: 'https://example.com/b', hidden: true });\n\nawait InAppBrowser.show({ id: first.id });\nawait InAppBrowser.hide({ id: first.id });\nawait InAppBrowser.show({ id: second.id });"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 86,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 1
          },
          "text": "Hidden instances keep their state available while avoiding native overlays that block app touches."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 88,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 88,
            "column": 5
          },
          "text": "Embed an Advanced Web App"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 90,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { id } = await InAppBrowser.openWebView({\n  url: 'https://example.com/portal',\n  handleDownloads: true,\n  openBlankTargetInWebView: true,\n  hiddenPopupWindow: true,\n  outboundProxyRules: [\n    {\n      urlRegex: '^https://example\\\\.com/api/',\n      action: 'delegateToJs',\n    },\n  ],\n});\n\nawait InAppBrowser.postMessage({\n  id,\n  detail: { source: 'app', action: 'refresh' },\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 110,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 110,
            "column": 1
          },
          "text": "Use this pattern for document portals, upload flows, support desks, video calls, Google Pay pages, or interactive web apps that need native app control without leaving the app shell."
        }
      ]
    },
