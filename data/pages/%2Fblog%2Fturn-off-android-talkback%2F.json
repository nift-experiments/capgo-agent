              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 11,
                    "column": 4
                  },
                  "text": "Press and hold both volume keys simultaneously for 3 seconds."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 12,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
