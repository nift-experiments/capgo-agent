                "line": 12,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 12,
                    "column": 4
                  },
                  "text": "You'll hear a spoken prompt to confirm the action. Press and hold the volume keys for another 3 seconds to confirm."
                }
              ]
            }
          ]
        }
      ]
