                {
                  "type": "text",
                  "location": {
                    "line": 10,
                    "column": 4
                  },
                  "text": "Locate the volume keys on the side of your device."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 11,
            "column": 1
