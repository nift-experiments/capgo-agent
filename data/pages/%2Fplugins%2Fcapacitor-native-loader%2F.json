  "sourceSha256": "112fe862fbac8058dd1cc60fd8ac56bbe158da52b15a966f033df2e918e6755d",
  "metadata": {
    "title": "Using @capgo/capacitor-native-loader",
    "description": "Show native animated loaders, transparent overlays, Lottie assets, and WebView-resizing loading states in Capacitor apps."
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 1,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 3
          },
          "text": "Using @capgo/capacitor-native-loader"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "@capgo/capacitor-native-loader"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 33
          },
          "text": " renders loading states through native iOS and Android views. Use it when a loader needs to stay smooth while the WebView is busy, when transparent fullscreen effects are expensive in CSS, or when another native plugin needs to show loading UI before JavaScript is ready."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-native-loader\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 13,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 4
          },
          "text": "Fullscreen Native Loader"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 15,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { NativeLoader } from '@capgo/capacitor-native-loader';\n\nconst { id } = await NativeLoader.show({\n  style: 'siri',\n  placement: 'fullscreen',\n  message: 'Preparing your session',\n  colors: ['#71f6ff', '#8b5cf6', '#ff4ecd', '#fff7ad'],\n  scrimColor: 'rgba(3, 7, 18, 0.42)',\n  interactionMode: 'block',\n});\n\nawait initializeAppData();\nawait NativeLoader.hide({ id });"
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 4
          },
          "text": "Edge Loader With WebView Resize"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 33,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeLoader.setWebViewLayout({\n  mode: 'inset',\n  insets: { top: 96 },\n  animated: true,\n});\n\nawait NativeLoader.show({\n  style: 'wave',\n  placement: 'top',\n  message: 'Syncing changes',\n  interactionMode: 'passThrough',\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 48,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 1
          },
          "text": "When loading finishes, restore the WebView:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 50,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeLoader.hideAll({ restoreWebView: true });"
    },
    {
      "type": "heading",
      "location": {
        "line": 54,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 4
          },
          "text": "Chrome-Style Top Progress"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 56,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 56,
            "column": 1
          },
          "text": "Use the native top progress loader when you want a browser-like loading bar above the WebView without asking CSS to animate during heavy work."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 58,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const { id } = await NativeLoader.show({\n  style: 'chrome',\n  placement: 'top',\n  colors: ['#4285f4', '#34a853', '#fbbc05', '#ea4335'],\n  thickness: 4,\n  interactionMode: 'passThrough',\n  webView: {\n    mode: 'resize',\n    insets: { top: 12 },\n    restoreOnHide: true,\n  },\n});\n\nawait NativeLoader.hide({ id, restoreWebView: true });"
    },
    {
      "type": "heading",
      "location": {
        "line": 75,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 75,
            "column": 4
          },
          "text": "Siri V2 Edge Loader"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 77,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 77,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 77,
            "column": 5
          },
          "text": "siri-v2"
        },
        {
          "type": "text",
          "location": {
            "line": 77,
            "column": 14
          },
          "text": " for a native full-screen loader that moves color around the screen edge while the WebView remains visible."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 79,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const { id } = await NativeLoader.show({\n  style: 'siri-v2',\n  placement: 'fullscreen',\n  colors: ['#71f6ff', '#8b5cf6', '#ff4ecd', '#fff7ad'],\n  thickness: 10,\n  scrimColor: 'rgba(3, 7, 18, 0.10)',\n  interactionMode: 'passThrough',\n});\n\nawait NativeLoader.hide({ id });"
    },
    {
      "type": "heading",
      "location": {
        "line": 92,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 92,
            "column": 4
          },
          "text": "Lottie Loader"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 94,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeLoader.show({\n  style: 'lottie',\n  placement: 'center',\n  asset: {\n    type: 'lottie',\n    source: 'loader.json',\n    loop: true,\n  },\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 106,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 106,
            "column": 1
          },
          "text": "Bundled assets are best for startup loaders because they are available before network requests and JavaScript initialization."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 108,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 108,
            "column": 4
          },
          "text": "Native Plugin Calls"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 110,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 110,
            "column": 1
          },
          "text": "The plugin exposes public native APIs so another plugin can show or hide loaders directly."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 112,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 112,
            "column": 1
          },
          "text": "Swift:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 114,
        "column": 1
      },
      "lang": "swift",
      "meta": null,
      "text": "import CapgoCapacitorNativeLoader\n\nlet id = NativeLoader.shared.show(options: [\n  \"style\": \"orbit\",\n  \"placement\": \"fullscreen\",\n  \"message\": \"Opening secure session\"\n])\n\nNativeLoader.shared.hide(id: id)"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 126,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 126,
            "column": 1
          },
          "text": "Kotlin:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 128,
        "column": 1
      },
      "lang": "kotlin",
      "meta": null,
      "text": "import app.capgo.nativeloader.NativeLoader\n\nval id = NativeLoader.show(\n  activity = activity,\n  options = mapOf(\n    \"style\" to \"orbit\",\n    \"placement\" to \"fullscreen\",\n    \"message\" to \"Loading profile\",\n  ),\n  webView = bridge.webView,\n)\n\nNativeLoader.hide(id)"
    },
