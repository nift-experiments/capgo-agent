        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-shake` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-shake\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorShake } from '@capgo/capacitor-shake';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "addListener"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Listen for shake event on the device."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "Registers a listener that will be called whenever a shake gesture is detected.\nThe shake detection uses the device's accelerometer to identify shake patterns."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 38,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorShake } from '@capgo/capacitor-shake';\n\nconst listener = await CapacitorShake.addListener('shake', () => {\n  console.log('Shake detected!');\n});\n\n// To remove the listener:\nawait listener.remove();"
    },
    {
      "type": "heading",
      "location": {
        "line": 49,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 49,
            "column": 5
          },
          "text": "getPluginVersion"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "Get the native Capacitor plugin version."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 53,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 1
          },
          "text": "Returns the current version of the native plugin implementation."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 55,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorShake } from '@capgo/capacitor-shake';\n\nconst { version } = await CapacitorShake.getPluginVersion();\nconsole.log('Plugin version:', version);"
    },
