          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 79,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 1
          },
          "text": "To use the capacitor updater with self-hosted capgo edit the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 79,
            "column": 62
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 83
          },
          "text": " from your app directory and set it like this:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 81,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const config: CapacitorConfig = {\n  appId: 'com.demo.app',\n  appName: 'demoApp',\n  webDir: 'dist',\n  bundledWebRuntime: false,\n  plugins: {\n    CapacitorUpdater : {\n      statsUrl: \"https://localhost:54321/functions/v1/stats\",\n      channelUrl: \"https://localhost:54321/functions/v1/channel_self\",\n      updateUrl: \"https://localhost:54321/functions/v1/updates\"\n    },\n  },\n};"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 97,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 97,
            "column": 1
          },
          "text": "This will enable you to use local capgo in development. However, by default, this is not enough."
        }
      ]
    },
    {
      "type": "blockquote",
      "location": {
        "line": 99,
        "column": 1
      },
      "blocks": [
        {
          "type": "paragraph",
