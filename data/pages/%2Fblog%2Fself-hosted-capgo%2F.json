            "column": 3
          },
          "text": "Using the CLI with self-hosted capgo"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 52,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 1
          },
          "text": "To use the CLI with self-hosted capgo edit the capacitor.config.ts from your app directory and set it like this:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 54,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const config: CapacitorConfig = {\n  appId: 'com.demo.app',\n  appName: 'demoApp',\n  webDir: 'dist',\n  bundledWebRuntime: false,\n  plugins: {\n    CapacitorUpdater : {\n      localHost: \"http://localhost:5173\",\n      localWebHost: \"http://localhost:5173\",\n      localSupa: \"http://localhost:54321\",\n      localSupaAnon: \"see_notes\",\n    },\n  },\n};"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 71,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 71,
            "column": 1
          },
          "text": "Note: To get localSupaAnon please follow this "
        },
        {
          "type": "link",
          "location": {
            "line": 71,
            "column": 47
          },
          "url": "https://capgo.app/docs/plugins/updater/local-dev/getting-started/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 71,
                "column": 48
              },
              "text": "tutorial"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 71,
            "column": 124
          },
          "text": " and copy the anon key into localSupaAnon"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 73,
        "column": 1
      },
      "depth": 1,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 3
          },
          "text": "Using the capacitor updater with self-hosted capgo"
        }
      ]
    },
