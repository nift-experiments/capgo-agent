    },
    {
      "type": "code",
      "location": {
        "line": 99,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorUpdater } from '@capgo/capacitor-updater'\n\n// Assign device to channel\nconst assignToChannel = async (channel: string) => {\n  await CapacitorUpdater.setChannel(channel)\n}\n\n// Get current channel\nconst getCurrentChannel = async () => {\n  const { channel } = await CapacitorUpdater.getChannel()\n  return channel\n}"
    },
