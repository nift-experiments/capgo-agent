        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const assignToABTest = async (userId: string) => {\n  // Use consistent hashing to assign users\n  const hash = await hashUserId(userId)\n  const variant = hash % 2 === 0 ? 'variant-a' : 'variant-b'\n  \n  await assignToChannel(variant)\n  return variant\n}"
