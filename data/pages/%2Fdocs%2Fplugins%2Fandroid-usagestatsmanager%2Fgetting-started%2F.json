          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-android-usagestatsmanager` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-android-usagestatsmanager\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorUsageStatsManager } from '@capgo/capacitor-android-usagestatsmanager';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "queryAndAggregateUsageStats"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Queries and aggregates usage stats for the given time range."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorUsageStatsManager } from '@capgo/capacitor-android-usagestatsmanager';\n\nconst oneDayAgo = Date.now() - 24 * 60 * 60 * 1000;\nconst now = Date.now();\nconst stats = await CapacitorUsageStatsManager.queryAndAggregateUsageStats({\n  beginTime: oneDayAgo,\n  endTime: now\n});\n\nfor (const [packageName, usageData] of Object.entries(stats)) {\n  console.log(`${packageName}: ${usageData.totalTimeInForeground}ms`);\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 50,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 50,
            "column": 5
          },
          "text": "isUsageStatsPermissionGranted"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 52,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 1
          },
          "text": "Checks if the usage stats permission is granted."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 54,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorUsageStatsManager } from '@capgo/capacitor-android-usagestatsmanager';\n\nconst { granted } = await CapacitorUsageStatsManager.isUsageStatsPermissionGranted();\nif (!granted) {\n  await CapacitorUsageStatsManager.openUsageStatsSettings();\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 63,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 63,
            "column": 5
          },
          "text": "openUsageStatsSettings"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 65,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 1
          },
          "text": "Open the usage stats settings screen.\nThis will open the usage stats settings screen, which allows the user to grant the usage stats permission.\nThis will always open the settings screen, even if the permission is already granted."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 69,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorUsageStatsManager } from '@capgo/capacitor-android-usagestatsmanager';\n\nawait CapacitorUsageStatsManager.openUsageStatsSettings();"
    },
    {
      "type": "heading",
      "location": {
        "line": 75,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 75,
            "column": 5
          },
          "text": "queryAllPackages"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 77,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 77,
            "column": 1
          },
          "text": "Queries all installed packages on the device.\nRequires the QUERY_ALL_PACKAGES permission."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 80,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorUsageStatsManager } from '@capgo/capacitor-android-usagestatsmanager';\n\nconst { packages } = await CapacitorUsageStatsManager.queryAllPackages();\npackages.forEach(pkg => {\n  console.log(`${pkg.appName} (${pkg.packageName}): v${pkg.versionName}`);\n});"
    },
