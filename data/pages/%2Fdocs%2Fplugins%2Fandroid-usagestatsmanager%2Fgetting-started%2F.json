    },
    {
      "type": "code",
      "location": {
        "line": 93,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface UsageStatsOptions {\n  /**\n   * The inclusive beginning of the range of stats to include in the results.\n   * Defined in terms of \"Unix time\"\n   */\n  beginTime: number;\n\n  /**\n   * The exclusive end of the range of stats to include in the results.\n   * Defined in terms of \"Unix time\"\n   */\n  endTime: number;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 109,
        "column": 1
      },
