    },
    {
      "type": "paragraph",
      "location": {
        "line": 22,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 1
          },
          "text": "Configure a CDN once, then bind elements by relative path:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 24,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AssetCache } from '@capgo/capacitor-asset-cache';\n\nAssetCache.configure({\n  cdnUrl: 'https://cdn.example.com/assets/',\n  revalidate: {\n    strategy: 'ttl',\n    maxAgeSeconds: 86400,\n  },\n});\n\nconst hero = document.querySelector<HTMLImageElement>('#hero');\n\nif (hero) {\n  AssetCache.bind(hero, 'images/hero.jpg');\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 42,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 1
          },
          "text": "The element gets "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 42,
            "column": 18
          },
          "text": "data-asset-cache-state=\"loading\""
        },
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 52
          },
          "text": " while the native fetch runs, then receives the local source URL and moves to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 42,
            "column": 130
          },
          "text": "ready"
        },
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 137
          },
          "text": "."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 44,
        "column": 1
      },
      "lang": "css",
      "meta": null,
      "text": "img[data-asset-cache-state='loading'],\nvideo[data-asset-cache-state='loading'] {\n  opacity: 0.45;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 51,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 4
          },
          "text": "Protected Assets"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 53,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 1
          },
          "text": "Headers are sent by the plugin while it fetches or revalidates the remote file. The web element still receives only the local source URL."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 55,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const src = await AssetCache.src('private/videos/intro.mp4', {\n  cdnUrl: 'https://cdn.example.com/assets/',\n  headers: {\n    Authorization: `Bearer ${token}`,\n  },\n});"
    },
