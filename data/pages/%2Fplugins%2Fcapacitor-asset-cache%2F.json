      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 1
          },
          "text": "Relative paths require either a configured "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 72,
            "column": 44
          },
          "text": "cdnUrl"
        },
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 52
          },
          "text": " or a per-call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 72,
            "column": 67
          },
          "text": "cdnUrl"
        },
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 75
          },
