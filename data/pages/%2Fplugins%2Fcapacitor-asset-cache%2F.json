          "type": "text",
          "location": {
            "line": 74,
            "column": 4
          },
          "text": "Storage Notes"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 76,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 76,
            "column": 1
          },
          "text": "On iOS, files live under Application Support and are excluded from iCloud backup. On Android, files live under the app internal files directory. The system does not treat these files as disposable cache files, but uninstall, app data clear, "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 76,
            "column": 242
          },
          "text": "clear()"
        },
        {
          "type": "text",
          "location": {
            "line": 76,
            "column": 251
          },
          "text": ", and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 76,
            "column": 257
          },
          "text": "remove()"
        },
        {
          "type": "text",
          "location": {
            "line": 76,
            "column": 267
          },
          "text": " still delete them."
        }
      ]
    },
