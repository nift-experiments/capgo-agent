          },
          "text": "@capgo/capacitor-asset-cache"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 31
          },
          "text": " stores large CDN images and videos in app-owned persistent storage, then returns local source URLs for Capacitor webviews."
        }
      ]
    },
