  "metadata": {
    "title": "Getting Started",
    "description": "Install @capgo/capacitor-file-sharer and share or save files from base64 data and local paths.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-file-sharer` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-file-sharer\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { FileSharer } from '@capgo/capacitor-file-sharer';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "Share A Base64 File"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 31,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { FileSharer } from '@capgo/capacitor-file-sharer';\n\nawait FileSharer.share({\n  filename: 'report.pdf',\n  contentType: 'application/pdf',\n  base64Data: reportBase64,\n  title: 'Quarterly report',\n  text: 'Attached report',\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 43,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 43,
            "column": 1
          },
          "text": "base64Data"
        },
        {
          "type": "text",
          "location": {
            "line": 43,
            "column": 13
          },
          "text": " can be a raw base64 string or a data URL such as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 43,
            "column": 63
          },
          "text": "data:application/pdf;base64,..."
        },
        {
          "type": "text",
          "location": {
            "line": 43,
            "column": 96
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 45,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 4
          },
          "text": "Share A Local File"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 47,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await FileSharer.share({\n  filename: 'export.zip',\n  contentType: 'application/zip',\n  path: fileUri,\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "The native implementations accept local paths, "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 55,
            "column": 48
          },
          "text": "file://"
        },
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 57
          },
          "text": " URLs, Android "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 55,
            "column": 72
          },
          "text": "content://"
        },
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 84
          },
          "text": " URIs, and Capacitor "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 55,
            "column": 105
          },
          "text": "_capacitor_file_"
        },
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 123
          },
          "text": " URLs."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 57,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 4
          },
          "text": "Save A File"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 59,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await FileSharer.save({\n  filename: 'backup.zip',\n  contentType: 'application/zip',\n  base64Data: zipBase64,\n  android: {\n    saveDirectory: 'downloads',\n    relativePath: 'Download/My App',\n  },\n});\n\nconsole.log(result.uri);"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 73,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 1
          },
          "text": "Android save directories are "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 73,
            "column": 30
          },
          "text": "downloads"
        },
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 41
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 73,
            "column": 43
          },
          "text": "pictures"
        },
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 53
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 73,
            "column": 55
          },
          "text": "movies"
        },
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 63
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 73,
            "column": 65
          },
          "text": "music"
        },
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 72
          },
          "text": ", and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 73,
            "column": 78
          },
          "text": "documents"
        },
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 89
          },
          "text": ". On Android 10 and newer, the plugin writes through MediaStore. On Android 9 and below, public saves use the manifest "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 73,
            "column": 208
          },
          "text": "WRITE_EXTERNAL_STORAGE"
        },
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 232
          },
          "text": " permission with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 73,
            "column": 249
          },
          "text": "maxSdkVersion=28"
        },
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 267
          },
          "text": "."
        }
      ]
    },
    {
