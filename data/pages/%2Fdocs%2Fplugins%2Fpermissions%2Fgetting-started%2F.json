          },
          "text": "Usage"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Permissions } from '@capgo/capacitor-permissions';\n\nexport async function ensureCamera(): Promise<boolean> {\n  const { status } = await Permissions.check({ permission: 'camera' });\n  if (status === 'granted') return true;\n  const { status: afterRequest } = await Permissions.request({ permission: 'camera' });\n  return afterRequest === 'granted';\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 47,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 1
          },
          "text": "When status is "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 47,
            "column": 16
          },
          "text": "blocked"
        },
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 25
          },
          "text": ", send the user to settings:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 49,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await Permissions.openSettings({ type: 'application' });"
