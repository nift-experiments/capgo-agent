      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 178,
            "column": 1
          },
          "text": "Remove a device's channel override. The device will use its normal channel selection again; this endpoint does not delete its metadata record."
        }
      ]
    },
    {
