        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 62,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 1
          },
          "text": "Retrieve device metadata. Results are cursor-paginated when you omit "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 62,
            "column": 70
          },
          "text": "device_id"
        },
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 81
          },
          "text": "."
        }
      ]
    },
    {
