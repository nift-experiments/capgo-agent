{
  "version": 1,
  "route": "/docs/public-api/devices/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/public-api/devices.mdx",
  "sourceSha256": "6e1d7f64190c3390c0e7d89ba5a2955ebff1741752c95d317adad45c8e4f326f",
  "metadata": {
    "title": "Devices",
    "description": "Retrieve device metadata and manage private channel overrides through the Capgo API.",
    "sidebar": {
      "order": 7
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "Devices are individual app installations that report updater metadata to Capgo. Use this API to retrieve that metadata or set and remove a device-specific private-channel override."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": ":::note[Two 90-day policies]\n"
        },
        {
          "type": "strong",
          "location": {
            "line": 5,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 5,
                "column": 3
              },
              "text": "Device inventory:"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 22
          },
          "text": " device records are retained for "
        },
        {
          "type": "strong",
          "location": {
            "line": 5,
            "column": 55
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 5,
                "column": 57
              },
              "text": "90 days"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 66
          },
          "text": " from the last device activity. A device does not need to install an update to appear: updater and stats check-ins can refresh its metadata."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 7,
        "column": 1
      },
      "blocks": [
        {
          "type": "strong",
          "location": {
            "line": 7,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 3
              },
              "text": "Channel overrides:"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 23
          },
          "text": " a POST override is removed "
        },
        {
          "type": "strong",
          "location": {
            "line": 7,
            "column": 51
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 53
              },
              "text": "90 days after the last override write"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 92
          },
          "text": ", even if the device still checks in. Checking in does not reset that clock. To avoid that cleanup, set "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 7,
            "column": 196
          },
          "text": "defaultChannel"
        },
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 212
          },
          "text": " in Capacitor config (survives reinstall) or call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 7,
            "column": 262
          },
          "text": "setChannel()"
        },
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 276
          },
          "text": " from the app. On plugin 5.34.0 / 6.34.0 / 7.34.0 / 8.0.0 and later, "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 7,
            "column": 345
          },
          "text": "setChannel()"
        },
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 359
          },
          "text": " is local and is cleared on reinstall, so the app must call it again. Older plugins write a backend override that survives reinstall and is removed by this cleanup. See "
        },
        {
          "type": "link",
          "location": {
            "line": 7,
            "column": 528
          },
          "url": "/docs/live-updates/channels/#console-and-api-overrides-expire-after-90-days",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 529
              },
              "text": "Console and API overrides expire after 90 days"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 653
          },
          "text": ".\n:::"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 10,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 4
          },
          "text": "Device metadata"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "Each record can include the device ID, platform, updater and OS versions, native build, installed bundle, production and emulator state, custom ID, and channel override."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 14,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 1
          },
          "text": "When available, "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 14,
            "column": 17
          },
          "text": "country_code"
        },
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 31
          },
          "text": " is the latest valid two-letter ISO 3166-1 country code received from a Cloudflare-handled request for the device. It is not GPS or a location value supplied by your app. It can be "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 14,
            "column": 212
          },
          "text": "null"
        },
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 218
          },
          "text": " when unavailable; use a single-device lookup when you need this field."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 16,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 4
          },
          "text": "Endpoints"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 18,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 5
          },
          "text": "POST"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 20,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 20,
            "column": 1
          },
          "text": "https://api.capgo.app/device/"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 22,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 1
          },
          "text": "Set a device-specific override to a "
        },
        {
          "type": "strong",
          "location": {
            "line": 22,
            "column": 37
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 22,
                "column": 39
              },
              "text": "private"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 48
          },
          "text": " channel. To choose a bundle for a device, assign that bundle to the channel; direct per-device bundle overrides are not supported. The override expires 90 days after the last write unless you POST it again."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 24,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 6
          },
          "text": "Request body"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 26,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "interface DeviceChannelOverride {\n  app_id: string; // reverse-domain app ID, for example com.example.app\n  device_id: string;\n  channel: string; // existing non-public channel name\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 34,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 6
          },
          "text": "Example request"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "curl -X POST \\\n  -H \"authorization: your-api-key\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"app_id\": \"com.example.app\",\n    \"device_id\": \"device_456\",\n    \"channel\": \"beta\"\n  }' \\\n  https://api.capgo.app/device/"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 48,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 1
          },
          "text": "Public channels cannot be used as device overrides."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 50,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 6
          },
          "text": "Success response"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 52,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"status\": \"ok\"\n}"
    },
    {
