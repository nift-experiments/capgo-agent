      "type": "code",
      "location": {
        "line": 191,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "curl -X DELETE \\\n  -H \"authorization: your-api-key\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"app_id\": \"com.example.app\",\n    \"device_id\": \"device_456\"\n  }' \\\n  https://api.capgo.app/device/"
