    {
      "type": "code",
      "location": {
        "line": 74,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "# Get the first page\ncurl -H \"authorization: your-api-key\" \\\n  \"https://api.capgo.app/device/?app_id=com.example.app\"\n\n# Get one device, including its request-derived country when available\ncurl -H \"authorization: your-api-key\" \\\n  \"https://api.capgo.app/device/?app_id=com.example.app&device_id=device_456\"\n\n# Get only devices with a custom ID\ncurl -H \"authorization: your-api-key\" \\\n  \"https://api.capgo.app/device/?app_id=com.example.app&customIdMode=true\"\n\n# Get the next page\ncurl -H \"authorization: your-api-key\" \\\n  \"https://api.capgo.app/device/?app_id=com.example.app&cursor=2024-01-01T00:00:00Z%7Cdevice_456\""
    },
    {
      "type": "heading",
      "location": {
        "line": 92,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 92,
            "column": 6
          },
          "text": "Response types"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 94,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "interface DeviceListResponse {\n  data: Device[];\n  nextCursor?: string;\n  hasMore: boolean;\n}\n\ninterface Device {\n  updated_at: string;\n  device_id: string;\n  custom_id: string;\n  version?: number;\n  version_name: string | null;\n  channel?: string;\n  app_id: string;\n  platform: \"ios\" | \"android\" | \"electron\";\n  plugin_version: string;\n  os_version: string;\n  version_build: string;\n  is_prod: boolean;\n  is_emulator: boolean;\n  key_id: string | null;\n  install_source: string | null;\n  country_code: string | null;\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 121,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 121,
            "column": 1
          },
          "text": "country_code"
        },
        {
          "type": "text",
          "location": {
            "line": 121,
            "column": 15
          },
          "text": " is populated by a device-specific lookup when Capgo has stored a valid Cloudflare-derived country code. Requests without a valid country do not clear the last valid value; list responses may return "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 121,
            "column": 214
          },
          "text": "null"
        },
        {
          "type": "text",
          "location": {
            "line": 121,
            "column": 220
          },
          "text": " for this field."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 123,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 123,
            "column": 6
          },
          "text": "Example response (list)"
        }
      ]
    },
