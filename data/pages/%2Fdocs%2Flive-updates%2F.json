                          },
                          "text": "Capgo Quickstart"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "location": {
                        "line": 40,
                        "column": 70
                      },
                      "text": " to set up your app in Capgo and install the Capgo SDK."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 42,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 42,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 42,
                        "column": 4
                      },
                      "text": "In your app code, call "
                    },
                    {
                      "type": "inlineCode",
                      "location": {
                        "line": 42,
                        "column": 27
                      },
                      "text": "CapacitorUpdater.notifyAppReady()"
                    },
                    {
                      "type": "text",
                      "location": {
                        "line": 42,
                        "column": 62
                      },
                      "text": " after your app has finished initializing. This tells the Capgo SDK that your app is ready to receive updates."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 44,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 44,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 44,
                        "column": 4
                      },
                      "text": "Build your JS bundle and upload it to Capgo:"
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 45,
                    "column": 4
                  },
                  "lang": "shell",
                  "meta": null,
                  "text": "npm run build\nnpx @capgo/cli@latest bundle upload --channel=production "
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 50,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 50,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 50,
                        "column": 4
                      },
                      "text": "Open your app and wait for the update to download. You can check the status with:"
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 51,
                    "column": 4
                  },
                  "lang": "shell",
                  "meta": null,
                  "text": "npx @capgo/cli@latest app debug"
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 55,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 55,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 55,
                        "column": 4
                      },
                      "text": "Once the update is downloaded, close and reopen your app to load the new bundle."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
