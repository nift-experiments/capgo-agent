  "source": "corpus/source/apps/docs/src/content/docs/docs/live-updates/index.mdx",
  "sourceSha256": "a36d12ee642d42cec67e4a3bddc596e72edb46e72e58a659ade608d103e08805",
  "metadata": {
    "title": "Overview",
    "description": "Discover how Capgo's Live Updates enable seamless JavaScript bundle updates, allowing you to push changes directly to users without app store delays.",
    "sidebar": {
      "order": 1
    },
    "prev": false,
    "next": false
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Use Capgo's Live Updates feature to update the JavaScript bundles of your app remotely, in real-time. Push JS updates directly to your users on iOS, Android, and Electron without going through store-level review cycles to fix bugs and ship new features faster."
        }
      ]
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {},
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 8,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 8,
                "column": 1
              },
              "text": "Live Updates are limited to JavaScript bundle changes. If you need to update native code, such as adding or removing a plugin or changing native project configuration, you'll need to submit a new binary build through the usual platform distribution process."
            }
          ]
        }
      ],
      "location": {
        "line": 6,
        "column": 1
      }
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {
        "type": "caution",
        "title": "Public Asset Model"
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 13,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 13,
                "column": 1
              },
              "text": "Unencrypted bundles uploaded to Capgo should be treated as public delivery assets. Channels determine which devices are offered an update, but channel privacy does not make the underlying bundle confidential. Encryption adds protection in storage and transit and stops third parties from producing valid encrypted updates, but it does not make shipped web assets impossible to inspect because the app contains the public key needed for decryption. See "
            },
            {
              "type": "link",
              "location": {
                "line": 13,
                "column": 453
              },
              "url": "/docs/live-updates/encryption/",
              "title": null,
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 13,
                    "column": 454
                  },
                  "text": "end-to-end encryption"
                }
              ]
            },
            {
              "type": "text",
              "location": {
                "line": 13,
                "column": 508
              },
              "text": " for the exact threat model."
            }
          ]
        }
      ],
      "location": {
        "line": 12,
        "column": 1
      }
    },
    {
      "type": "heading",
      "location": {
        "line": 16,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 4
          },
          "text": "How Live Updates Work"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "Capgo's Live Update system has two key components:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 20,
        "column": 1
      },
      "ordered": true,
      "start": 1,
      "spread": true,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 20,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 20,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 20,
                    "column": 4
                  },
                  "text": "The Capgo SDK, which you install in your app. The SDK checks for available updates and downloads them in the background."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 22,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 22,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 4
                  },
                  "text": "Channels, which let you target updates to specific groups of users. You can use channels to manage different release tracks, such as "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 22,
                    "column": 137
                  },
                  "text": "Production"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 149
                  },
                  "text": ", "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 22,
                    "column": 151
                  },
                  "text": "Staging"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 160
                  },
                  "text": ", and "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 22,
                    "column": 166
                  },
                  "text": "Dev"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 171
                  },
                  "text": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 24,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 1
          },
          "text": "When you upload a new JS bundle to Capgo and assign it to a channel, the Capgo SDK in apps configured for that channel will detect the update and download it. The next time the app restarts, the new bundle will be loaded."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 26,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 4
          },
          "text": "Why Capgo Logs Matter (marketing view)"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 28,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 28,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 28,
                "column": 3
              },
              "blocks": [
                {
                  "type": "strong",
                  "location": {
                    "line": 28,
                    "column": 3
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 28,
                        "column": 5
                      },
                      "text": "Instant x-ray of every rollout"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 28,
                    "column": 37
                  },
                  "text": ": Per-device timelines show checks, downloads, installs, policy blocks, and rollbacks, so you know exactly what happened—no guesswork or “it works on my phone” debates."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 29,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 29,
                "column": 3
              },
              "blocks": [
                {
                  "type": "strong",
                  "location": {
                    "line": 29,
                    "column": 3
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 29,
                        "column": 5
                      },
                      "text": "Faster incident response"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 29,
                    "column": 31
                  },
                  "text": ": Alert-like codes (e.g., rate limits, checksum fails, notifyAppReady misses) surface before users start flooding support, letting you ship a fix or rollback in minutes."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 30,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 30,
                "column": 3
              },
              "blocks": [
                {
                  "type": "strong",
                  "location": {
                    "line": 30,
                    "column": 3
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 30,
                        "column": 5
                      },
                      "text": "Channel policy proof"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 30,
                    "column": 27
                  },
                  "text": ": Logs verify that guardrails (block majors, disable emulators/dev builds, platform limits) are actively protecting production."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 31,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 31,
                "column": 3
              },
              "blocks": [
                {
                  "type": "strong",
                  "location": {
                    "line": 31,
                    "column": 3
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 31,
                        "column": 5
                      },
                      "text": "Revenue & reputation protection"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 31,
                    "column": 38
                  },
                  "text": ": See when updates stall on poor networks or hit plan limits, so you can intervene before conversions, sessions, or reviews drop."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 32,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 32,
                "column": 3
              },
              "blocks": [
                {
                  "type": "strong",
                  "location": {
                    "line": 32,
                    "column": 3
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 32,
                        "column": 5
                      },
                      "text": "Single source of truth"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 32,
                    "column": 29
                  },
                  "text": ": Product, QA, and Support share the same cloud log stream—no digging through Xcode/Android Studio or DM’ing engineers for native logs."
                }
              ]
            }
          ]
        }
      ]
    },
