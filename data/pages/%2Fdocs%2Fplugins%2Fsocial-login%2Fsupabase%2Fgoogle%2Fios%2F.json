      "location": {
        "line": 16,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { authenticateWithGoogleSupabase } from './supabaseAuthUtils';\n\nconst result = await authenticateWithGoogleSupabase();\nif (result.success) {\n  console.log('Signed in:', result.user);\n  // Navigate to your authenticated area\n} else {\n  console.error('Error:', result.error);\n}"
    },
