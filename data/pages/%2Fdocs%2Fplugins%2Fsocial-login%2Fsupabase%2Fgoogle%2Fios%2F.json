    },
    {
      "type": "heading",
      "location": {
        "line": 34,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 5
          },
          "text": "iOS Token Caching and Nonce Issues"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 36,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 1
          },
          "text": ":::warning[iOS Nonce Caching Issue]\nOn iOS, Google Sign-In can cache tokens, which may cause the nonce validation to fail. The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 37,
            "column": 92
          },
          "text": "validateJWTToken"
        },
        {
          "type": "text",
          "location": {
            "line": 37,
            "column": 110
          },
          "text": " function detects this and automatically handles it:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 39,
        "column": 1
      },
      "ordered": true,
      "start": 1,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 39,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 39,
                "column": 4
              },
              "blocks": [
                {
                  "type": "strong",
                  "location": {
                    "line": 39,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 39,
                        "column": 6
                      },
                      "text": "Automatic Detection"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 39,
                    "column": 27
                  },
                  "text": ": The function checks if the nonce in the token matches the expected "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 39,
                    "column": 96
                  },
                  "text": "nonceDigest"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 40,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 40,
                "column": 4
              },
              "blocks": [
                {
                  "type": "strong",
                  "location": {
                    "line": 40,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 40,
                        "column": 6
                      },
                      "text": "Automatic Retry"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 40,
                    "column": 23
                  },
                  "text": ": If validation fails, it automatically logs out from Google and retries once"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 41,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 41,
                "column": 4
              },
              "blocks": [
                {
                  "type": "strong",
                  "location": {
                    "line": 41,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 41,
                        "column": 6
                      },
                      "text": "Error Handling"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 41,
                    "column": 22
                  },
                  "text": ": If the retry also fails, an error is returned"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 43,
        "column": 1
      },
      "blocks": [
        {
          "type": "strong",
          "location": {
            "line": 43,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 43,
                "column": 3
              },
              "text": "Why this happens"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 43,
            "column": 21
          },
          "text": ": iOS Google Sign-In SDK caches tokens for performance. When a cached token is returned, it may have been generated with a different nonce (or no nonce), causing a mismatch."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 45,
        "column": 1
      },
      "blocks": [
        {
          "type": "strong",
          "location": {
            "line": 45,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 45,
                "column": 3
              },
              "text": "The solution"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 17
          },
          "text": ": The implementation automatically handles this by logging out and retrying, which forces Google to generate a fresh token with the correct nonce.\n:::"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 48,
        "column": 1
      },
      "blocks": [
        {
          "type": "strong",
          "location": {
            "line": 48,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 48,
                "column": 3
              },
              "text": "Manual Workaround"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 22
          },
          "text": " (if automatic retry doesn't work):"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 50,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "// Logout first to clear cached tokens\nawait SocialLogin.logout({ provider: 'google' });\n\n// Then authenticate\nconst result = await authenticateWithGoogleSupabase();"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 58,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 58,
            "column": 1
          },
          "text": "This ensures a fresh token is obtained with the correct nonce."
        }
      ]
    },
