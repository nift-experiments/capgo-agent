    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Navigate to a location using latitude and longitude"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { LaunchNavigator } from '@capgo/capacitor-launch-navigator';\n\nawait LaunchNavigator.navigate({ destination: [48.8566, 2.3522] });"
    },
