      "text": "import { LaunchNavigator, IOSNavigationApp } from '@capgo/capacitor-launch-navigator';\n\nconst result = await LaunchNavigator.isAppAvailable({ app: IOSNavigationApp.APPLE_MAPS });\nconsole.log(result);"
    },
