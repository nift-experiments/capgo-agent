          },
          "text": "cdnUrl"
        },
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 22
          },
          "text": " if you pass absolute URLs to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 45,
            "column": 52
          },
          "text": "bind"
        },
        {
          "type": "text",
          "location": {
