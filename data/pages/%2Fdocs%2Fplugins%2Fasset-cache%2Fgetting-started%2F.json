      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 14,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-asset-cache` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 20,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-asset-cache\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 25,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 27,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AssetCache } from '@capgo/capacitor-asset-cache';"
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 4
          },
          "text": "Configure A CDN"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Configure a CDN base URL once when your app starts. Relative asset paths will be resolved against this URL."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "AssetCache.configure({\n  cdnUrl: 'https://cdn.example.com/assets/',\n  revalidate: {\n    strategy: 'ttl',\n    maxAgeSeconds: 86400,\n  },\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 45,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 1
          },
          "text": "You can skip "
        },
