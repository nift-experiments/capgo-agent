    },
    {
      "type": "code",
      "location": {
        "line": 86,
        "column": 1
      },
      "lang": "tsx",
      "meta": null,
      "text": "import { useEffect, useRef } from 'react';\nimport { AssetCache } from '@capgo/capacitor-asset-cache';\n\nAssetCache.configure({ cdnUrl: 'https://cdn.example.com/assets/' });\n\nexport function HeroImage() {\n  const imageRef = useRef<HTMLImageElement>(null);\n\n  useEffect(() => {\n    if (!imageRef.current) return;\n\n    const binding = AssetCache.bind(imageRef.current, 'images/hero.jpg');\n    return () => binding.cancel();\n  }, []);\n\n  return <img ref={imageRef} alt=\"Product preview\" />;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 106,
        "column": 1
      },
