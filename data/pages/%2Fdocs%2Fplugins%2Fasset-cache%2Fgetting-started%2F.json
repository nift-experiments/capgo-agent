          },
          "text": "Bind An Image Or Video"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 53,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 53,
            "column": 1
          },
          "text": "bind"
        },
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 7
          },
          "text": " is the most transparent display path. It marks the element as loading, fetches or revalidates the asset natively, then assigns the local source URL when the local file is ready."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 55,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const image = document.querySelector<HTMLImageElement>('#hero');\n\nif (image) {\n  const binding = AssetCache.bind(image, 'images/hero.jpg');\n  await binding.promise;\n}"
    },
    {
      "type": "code",
      "location": {
        "line": 64,
        "column": 1
      },
      "lang": "html",
      "meta": null,
      "text": "<img id=\"hero\" alt=\"Product preview\" />"
    },
    {
      "type": "code",
      "location": {
        "line": 68,
        "column": 1
      },
      "lang": "css",
      "meta": null,
      "text": "img[data-asset-cache-state='loading'],\nvideo[data-asset-cache-state='loading'] {\n  opacity: 0.45;\n}\n\nimg[data-asset-cache-state='ready'],\nvideo[data-asset-cache-state='ready'] {\n  opacity: 1;\n}"
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {
        "type": "note"
      },
      "blocks": [
        {
          "type": "paragraph",
