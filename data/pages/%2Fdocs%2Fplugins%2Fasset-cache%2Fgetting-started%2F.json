            "column": 58
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 45,
            "column": 60
          },
          "text": "src"
        },
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 65
          },
          "text": ", or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 45,
            "column": 70
          },
          "text": "resolve"
        },
        {
          "type": "text",
          "location": {
            "line": 45,
