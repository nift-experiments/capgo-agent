{
  "version": 1,
  "route": "/docs/cli/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/cli/index.mdx",
  "sourceSha256": "bfea4f2d8a84ad444a7d0b076389a431fa0a07f70b93cb850d210ea28e9878fd",
  "metadata": {
    "title": "Overview",
    "description": "This document provides a comprehensive overview of the Capgo CLI, how it can be utilized to enhance your app development process by enabling seamless live updates",
    "sidebar": {
      "label": "Overview",
      "order": 1
    },
    "prev": false,
    "next": false
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Use Capgo's Live Updates feature to update the JavaScript bundles of your app remotely, in real-time. Push JS updates directly to your users without going through the app store review process to instantly fix bugs and ship new features."
        }
      ]
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {
        "type": "tip",
        "title": "Always use the latest CLI"
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 7,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 1
              },
              "text": "Always run Capgo CLI with "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 7,
                "column": 27
              },
              "text": "@latest"
            },
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 36
              },
              "text": " (for example "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 7,
                "column": 50
              },
              "text": "npx @capgo/cli@latest"
            },
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 73
              },
              "text": "). The CLI follows its own versioning and does "
            },
            {
              "type": "strong",
              "location": {
                "line": 7,
                "column": 120
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 7,
                    "column": 122
                  },
                  "text": "not"
                }
              ]
            },
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 127
              },
              "text": " need to match your plugin major or Capacitor major. The latest CLI stays compatible with any supported updater plugin version. See "
            },
            {
              "type": "link",
              "location": {
                "line": 7,
                "column": 259
              },
              "url": "/docs/versioning/",
              "title": null,
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 7,
                    "column": 260
                  },
                  "text": "Capgo versioning"
                }
              ]
            },
            {
              "type": "text",
              "location": {
                "line": 7,
                "column": 296
              },
              "text": "."
            }
          ]
        }
      ],
      "location": {
        "line": 6,
        "column": 1
      }
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {},
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 12,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 12,
                "column": 1
              },
              "text": "Live Updates are limited to JavaScript bundle changes. If you need to update native code, such as adding or removing a plugin or changing native project configuration, you'll need to submit a new native binary build to the app stores."
            }
          ]
        }
      ],
      "location": {
        "line": 10,
        "column": 1
      }
    },
    {
      "type": "heading",
      "location": {
        "line": 16,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 4
          },
          "text": "How Live Updates Work"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "Capgo's Live Update system has two key components:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 20,
        "column": 1
      },
      "ordered": true,
      "start": 1,
      "spread": true,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 20,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 20,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 20,
                    "column": 4
                  },
                  "text": "The Capgo SDK, which you install in your app. The SDK checks for available updates and downloads them in the background."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 22,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 22,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 4
                  },
                  "text": "Channels, which let you target updates to specific groups of users. You can use channels to manage different release tracks, such as "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 22,
                    "column": 137
                  },
                  "text": "Production"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 149
                  },
                  "text": ", "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 22,
                    "column": 151
                  },
                  "text": "Staging"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 160
                  },
                  "text": ", and "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 22,
                    "column": 166
                  },
                  "text": "Dev"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 22,
                    "column": 171
                  },
                  "text": "."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 24,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 1
          },
          "text": "When you upload a new JS bundle to Capgo and assign it to a channel, the Capgo SDK in apps configured for that channel will detect the update and download it. The next time the app restarts, the new bundle will be loaded."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 26,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 4
          },
          "text": "Getting Started"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 28,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 1
          },
          "text": "To start using Live Updates, follow these steps:"
        }
      ]
    },
    {
      "type": "component",
      "name": "Steps",
      "props": {},
      "blocks": [
        {
          "type": "list",
          "location": {
            "line": 32,
            "column": 1
          },
          "ordered": true,
          "start": 1,
          "spread": true,
          "blocks": [
            {
              "type": "listItem",
              "location": {
                "line": 32,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 32,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 32,
                        "column": 4
                      },
                      "text": "Complete the "
                    },
                    {
                      "type": "link",
                      "location": {
                        "line": 32,
                        "column": 17
                      },
                      "url": "/docs/getting-started/quickstart/",
                      "title": null,
                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 32,
                            "column": 18
                          },
                          "text": "Capgo Quickstart"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "location": {
                        "line": 32,
                        "column": 70
                      },
                      "text": " to set up your app in Capgo and install the Capgo SDK."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 34,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 34,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 34,
                        "column": 4
                      },
                      "text": "In your app code, call "
                    },
                    {
                      "type": "inlineCode",
                      "location": {
                        "line": 34,
                        "column": 27
                      },
                      "text": "CapacitorUpdater.notifyAppReady()"
                    },
                    {
                      "type": "text",
                      "location": {
                        "line": 34,
                        "column": 62
                      },
                      "text": " after your app has finished initializing. This tells the Capgo SDK that your app is ready to receive updates."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 36,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 36,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 36,
                        "column": 4
                      },
                      "text": "Build your JS bundle and upload it to Capgo:"
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 37,
                    "column": 4
                  },
                  "lang": "shell",
                  "meta": null,
                  "text": "npm run build\nnpx @capgo/cli@latest bundle upload --channel=production "
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 42,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 42,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 42,
                        "column": 4
                      },
                      "text": "Open your app and wait for the update to download. You can check the status with:"
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 43,
                    "column": 4
                  },
                  "lang": "shell",
                  "meta": null,
                  "text": "npx @capgo/cli@latest app debug"
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 47,
                "column": 1
              },
              "spread": false,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 47,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 47,
                        "column": 4
                      },
                      "text": "Once the update is downloaded, close and reopen your app to load the new bundle."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "location": {
        "line": 30,
        "column": 1
      }
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "See the "
        },
        {
          "type": "link",
          "location": {
            "line": 51,
            "column": 9
          },
          "url": "/docs/getting-started/deploy/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 51,
                "column": 10
              },
              "text": "Deploying Live Updates"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 64
          },
          "text": " guide for more details."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 53,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 4
          },
          "text": "The Capgo CLI"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "The Capgo CLI is a powerful tool that allows developers to interact with Capgo's services from their own CI/CD pipelines. With the CLI, you have granular control over when builds are produced and deployed, enabling you to integrate Capgo into your existing enterprise workflows."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 57,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 5
          },
          "text": "What is the Capgo CLI for?"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 59,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 59,
            "column": 1
          },
          "text": "The Capgo CLI is designed for developers and teams who need more control and flexibility in their live update workflows. By using the CLI in your CI/CD pipelines, you can:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 61,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 61,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 61,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 61,
                    "column": 3
                  },
                  "text": "Decide exactly when to build and deploy updates, rather than relying on Capgo's built-in automation"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 62,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 62,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 62,
                    "column": 3
                  },
                  "text": "Insert your own processes, such as code signing, QA testing, or manager approvals, between the build and deploy steps"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 63,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 63,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 63,
                    "column": 3
                  },
                  "text": "Integrate Capgo into your existing DevOps tooling and workflows"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 65,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 5
          },
          "text": "Authentication"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 67,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 1
          },
          "text": "To use the Capgo CLI, you'll need to authenticate with your API key. You can generate an API key in your Capgo account settings."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "To log in and securely store your API key, run:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 71,
        "column": 1
      },
      "lang": "shell",
      "meta": null,
      "text": "npx @capgo/cli@latest login [API_KEY]"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 75,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 75,
            "column": 1
          },
          "text": "This command will then be saved for future use. You won't need to provide your API key with each command after logging in."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 77,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 77,
            "column": 5
          },
          "text": "Key Differences from Other CLI Tools"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 79,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 1
          },
          "text": "If you're familiar with other live update CLI tools, there are a few key things to note about Capgo's CLI:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 81,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": true,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 81,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 81,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 81,
                    "column": 3
                  },
                  "text": "Capgo uses a single CLI for both development and CI/CD use cases, as Capgo is focused solely on the live update feature set."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 83,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 83,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 83,
                    "column": 3
                  },
                  "text": "The Capgo CLI doesn't require a separate installation step. It's bundled with the "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 83,
                    "column": 85
                  },
                  "text": "@capgo/cli"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 83,
                    "column": 97
                  },
                  "text": " package and can be run directly using "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 83,
                    "column": 136
                  },
                  "text": "npx"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 83,
                    "column": 141
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 85,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 85,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 85,
                    "column": 3
                  },
                  "text": "Capgo's CLI is designed specifically for the live update workflow, so it may not include some features or commands found in more general-purpose CLI tools."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 87,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 87,
            "column": 4
          },
          "text": "Next Steps"
        }
      ]
    },
