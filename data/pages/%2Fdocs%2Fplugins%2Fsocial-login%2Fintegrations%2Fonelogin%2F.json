          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "Auth Connect preset example"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { SocialLoginAuthConnect } from '@capgo/capacitor-social-login';\n\nawait SocialLoginAuthConnect.initialize({\n  authConnect: {\n    onelogin: {\n      issuer: 'https://your-tenant.onelogin.com/oidc/2',\n      clientId: 'your-onelogin-client-id',\n      redirectUrl: 'myapp://oauth/onelogin',\n    },\n  },\n});\n\nconst result = await SocialLoginAuthConnect.login({\n  provider: 'onelogin',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 26,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 4
          },
          "text": "Direct OAuth2 example"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 28,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { SocialLogin } from '@capgo/capacitor-social-login';\n\nawait SocialLogin.initialize({\n  oauth2: {\n    onelogin: {\n      appId: 'your-onelogin-client-id',\n      authorizationBaseUrl: 'https://your-tenant.onelogin.com/oidc/2/auth',\n      accessTokenEndpoint: 'https://your-tenant.onelogin.com/oidc/2/token',\n      redirectUrl: 'myapp://oauth/onelogin',\n      scope: 'openid profile email',\n      pkceEnabled: true,\n      resourceUrl: 'https://your-tenant.onelogin.com/oidc/2/me',\n      logoutUrl: 'https://your-tenant.onelogin.com/oidc/2/logout',\n    },\n  },\n});\n\nconst result = await SocialLogin.login({\n  provider: 'oauth2',\n  options: {\n    providerId: 'onelogin',\n  },\n});"
    },
