        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "OneLogin is supported through the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 35
          },
          "text": "onelogin"
        },
        {
          "type": "text",
