                          "name": "p",
                          "props": {
                            "class": ""
                          },
                          "blocks": [
                            {
                              "type": "text",
                              "text": "Capgo keeps live updates and native builds while you retain GitHub Actions or GitLab CI. See the full comparison and migration guide for timelines and feature mapping."
