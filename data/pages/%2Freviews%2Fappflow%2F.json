                      "text": "\n"
                    },
                    {
                      "type": "element",
                      "name": "h2",
                      "props": {
                        "class": ""
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "text": "What Appflow was"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "\n"
                    },
                    {
                      "type": "element",
                      "name": "div",
                      "props": {
                        "class": ""
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "text": "\n"
                        },
                        {
                          "type": "element",
                          "name": "p",
                          "props": {
                            "class": ""
                          },
                          "blocks": [
                            {
                              "type": "text",
                              "text": "Appflow connected git repos to cloud builds, channel-based live updates, and store submission helpers. It worked well if your stack stayed inside Ionic\u2019s toolchain."
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "\n"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "\n"
                    }
                  ]
                },
                {
                  "type": "element",
                  "name": "div",
                  "props": {
                    "class": ""
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "text": "\n"
                    },
                    {
                      "type": "element",
                      "name": "h2",
                      "props": {
                        "class": ""
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "text": "What changed"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "\n"
                    },
                    {
                      "type": "element",
                      "name": "div",
                      "props": {
                        "class": ""
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "text": "\n"
                        },
                        {
                          "type": "element",
                          "name": "p",
                          "props": {
                            "class": ""
                          },
                          "blocks": [
                            {
                              "type": "text",
                              "text": "Ionic announced Appflow shutdown with a multi-year wind-down. Live updates and native builds need a new home before access ends."
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "text": "\n"
                        }
                      ]
                    },
                    {
                      "type": "text",
