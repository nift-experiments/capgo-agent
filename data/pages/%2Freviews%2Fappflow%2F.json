                      "text": "\n"
                    },
                    {
                      "type": "element",
                      "name": "h2",
                      "props": {
                        "class": ""
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "text": "How Capgo compares"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "\n"
                    },
                    {
                      "type": "element",
                      "name": "div",
                      "props": {
