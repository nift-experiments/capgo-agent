                  },
                  "blocks": [
                    {
                      "type": "text",
                      "text": "Ionic Appflow \u2014 what it is today"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "\n"
                },
                {
                  "type": "element",
                  "name": "p",
                  "props": {
                    "class": "container"
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "text": "Appflow bundled CI, live updates, and store publishing for Ionic apps. Ionic is winding the product down \u2014 teams need a migration plan."
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "\n"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
