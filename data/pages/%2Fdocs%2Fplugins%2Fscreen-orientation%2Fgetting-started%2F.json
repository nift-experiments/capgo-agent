          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "orientation"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Get the current screen orientation."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "Returns the current orientation of the device screen."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 37,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { ScreenOrientation } from '@capgo/capacitor-screen-orientation';\n\nconst result = await ScreenOrientation.orientation();\nconsole.log('Current orientation:', result.type);"
    },
    {
      "type": "heading",
      "location": {
        "line": 44,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 44,
            "column": 5
          },
          "text": "lock"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 46,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 1
          },
          "text": "Lock the screen orientation to a specific type."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 48,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 1
          },
          "text": "Locks the screen to the specified orientation.\nOn iOS, if bypassOrientationLock is true, it will also start\ntracking physical device orientation using motion sensors."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 52,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 1
          },
          "text": "Note: The UI will still respect the user's orientation lock setting.\nMotion tracking allows you to detect how the device is physically held\neven when the UI doesn't rotate."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 56,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { ScreenOrientation } from '@capgo/capacitor-screen-orientation';\n\n// Standard lock\nawait ScreenOrientation.lock({ orientation: 'landscape' });\n\n// Lock with motion tracking on iOS\nawait ScreenOrientation.lock({\n  orientation: 'portrait',\n  bypassOrientationLock: true\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 69,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 5
          },
          "text": "unlock"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 71,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 71,
            "column": 1
          },
          "text": "Unlock the screen orientation."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 73,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 73,
            "column": 1
          },
          "text": "Allows the screen to rotate freely based on device position.\nAlso stops any motion-based orientation tracking if it was enabled."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 76,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { ScreenOrientation } from '@capgo/capacitor-screen-orientation';\n\nawait ScreenOrientation.unlock();"
    },
    {
      "type": "heading",
      "location": {
        "line": 82,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 82,
            "column": 5
          },
          "text": "startOrientationTracking"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 84,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 1
          },
          "text": "Start tracking device orientation using motion sensors."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 86,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 1
          },
          "text": "This method is useful when you want to track the device's physical\norientation independently from the screen orientation lock.\nIt uses Core Motion on iOS to detect orientation changes."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 90,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { ScreenOrientation } from '@capgo/capacitor-screen-orientation';\n\nawait ScreenOrientation.startOrientationTracking({\n  bypassOrientationLock: true\n});\n\n// Listen for changes\nScreenOrientation.addListener('screenOrientationChange', (result) => {\n  console.log('Orientation changed:', result.type);\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 103,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 103,
            "column": 5
          },
          "text": "stopOrientationTracking"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 105,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 105,
            "column": 1
          },
          "text": "Stop tracking device orientation using motion sensors."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 107,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 107,
            "column": 1
          },
          "text": "Stops the motion-based orientation tracking if it was started."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 109,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { ScreenOrientation } from '@capgo/capacitor-screen-orientation';\n\nawait ScreenOrientation.stopOrientationTracking();"
    },
    {
      "type": "heading",
      "location": {
        "line": 115,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 115,
            "column": 5
          },
          "text": "isOrientationLocked"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 117,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 117,
            "column": 1
          },
          "text": "Check if device orientation lock is currently enabled."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 119,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 119,
            "column": 1
          },
          "text": "This method compares the physical device orientation (from motion sensors)\nwith the UI orientation. If they differ, orientation lock is enabled."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 122,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 122,
            "column": 1
          },
          "text": "Note: This requires motion tracking to be active via\nstartOrientationTracking() or lock() with bypassOrientationLock: true.\nWorks on both iOS (Core Motion) and Android (Accelerometer)."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 126,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { ScreenOrientation } from '@capgo/capacitor-screen-orientation';\n\n// Start motion tracking first\nawait ScreenOrientation.startOrientationTracking({\n  bypassOrientationLock: true\n});\n\n// Check lock status\nconst status = await ScreenOrientation.isOrientationLocked();\nif (status.locked) {\n  console.log('Orientation lock is ON');\n  console.log('Physical:', status.physicalOrientation);\n  console.log('UI:', status.uiOrientation);\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 143,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
