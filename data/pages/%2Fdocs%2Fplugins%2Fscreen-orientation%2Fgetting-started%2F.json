            "column": 5
          },
          "text": "StartOrientationTrackingOptions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 190,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 190,
            "column": 1
          },
          "text": "Options for starting orientation tracking using motion sensors."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 191,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface StartOrientationTrackingOptions {\n  /**\n   * Whether to track physical device orientation using motion sensors.\n   * When true, uses device motion sensors to detect the true physical\n   * orientation of the device, even when the device orientation lock is enabled.\n   *\n   * **Important:** This does NOT bypass the UI orientation lock.\n   * This only enables detection of the physical orientation.\n   *\n   * Supported on iOS (Core Motion) and Android (Accelerometer).\n   *\n   * @default false\n   * @since 1.0.0\n   */\n  bypassOrientationLock?: boolean;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 210,
        "column": 1
      },
