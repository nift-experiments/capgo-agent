        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 147,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface ScreenOrientationResult {\n  /**\n   * The current orientation type.\n   *\n   * @since 1.0.0\n   */\n  type: OrientationType;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 158,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 158,
            "column": 5
          },
          "text": "OrientationLockOptions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 159,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 159,
            "column": 1
          },
          "text": "Options for locking the screen orientation."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 160,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface OrientationLockOptions {\n  /**\n   * The orientation type to lock to.\n   *\n   * @since 1.0.0\n   */\n  orientation: OrientationLockType;\n\n  /**\n   * Whether to track physical device orientation using motion sensors.\n   * When true, uses device motion sensors to detect the true physical\n   * orientation of the device, even when the device orientation lock is enabled.\n   *\n   * **Important:** This does NOT bypass the UI orientation lock.\n   * The screen will still respect the user's orientation lock setting.\n   * This option only affects orientation detection/tracking - you'll receive\n   * orientation change events based on how the device is physically held,\n   * but the UI will not rotate if orientation lock is enabled.\n   *\n   * Supported on iOS (Core Motion) and Android (Accelerometer).\n   *\n   * @default false\n   * @since 1.0.0\n   */\n  bypassOrientationLock?: boolean;\n}"
    },
    {
      "type": "heading",
