                {
                  "type": "code",
                  "location": {
                    "line": 30,
                    "column": 4
                  },
                  "lang": "ts",
                  "meta": null,
                  "text": "import type { CapacitorConfig } from '@capacitor/cli';\n\nconst config: CapacitorConfig = {\n  appId: 'app.capgo.passkey.example',\n  appName: 'My App',\n  webDir: 'dist',\n  plugins: {\n    CapacitorPasskey: {\n      origin: 'https://signin.example.com',\n      autoShim: true,\n      domains: ['signin.example.com'],\n    },\n  },\n};\n\nexport default config;"
                }
