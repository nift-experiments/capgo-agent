            "column": 14
          },
          "text": " returns a handle. Call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 118,
            "column": 38
          },
          "text": "handle.remove()"
        },
        {
          "type": "text",
          "location": {
            "line": 118,
            "column": 55
          },
          "text": " when the screen unmounts, or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 118,
