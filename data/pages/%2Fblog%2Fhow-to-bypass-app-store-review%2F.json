      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 15,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 1
          },
          "text": "You can treat Apple and Google as sharing a similar boundary:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 17,
        "column": 1
      },
      "ordered": true,
      "start": 1,
      "spread": false,
      "blocks": [
        {
