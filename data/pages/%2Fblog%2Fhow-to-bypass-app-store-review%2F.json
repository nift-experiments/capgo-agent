            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 17,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 17,
                    "column": 4
                  },
                  "text": "You can deliver code interpreted by the embedded web layer (HTML/CSS/JS) without resubmitting."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 18,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 18,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 18,
                    "column": 4
                  },
                  "text": "You should not use that channel for major feature additions that change app purpose."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 19,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 19,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 19,
                    "column": 4
                  },
                  "text": "You should not alter critical security or distribution controls through JS alone."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 21,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 21,
            "column": 1
          },
          "text": "Apple’s official guidance around WebKit/JavaScript updates is the core of this model. Google is typically less restrictive for web-based updates, but the same principle applies: keep native changes in a native release."
        }
      ]
    },
