  "metadata": {
    "title": "Getting Started",
    "description": "Install @capgo/capacitor-calendar and start managing native calendar events from a Capacitor app.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-calendar` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-calendar\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "iOS Setup"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "Add the usage descriptions your app needs to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 46
          },
          "text": "ios/App/App/Info.plist"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 70
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 27,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>NSCalendarsUsageDescription</key>\n<string>This app needs calendar access.</string>\n<key>NSCalendarsWriteOnlyAccessUsageDescription</key>\n<string>This app needs permission to add calendar events.</string>\n<key>NSCalendarsFullAccessUsageDescription</key>\n<string>This app needs permission to read and manage calendar events.</string>\n<key>NSRemindersUsageDescription</key>\n<string>This app needs reminders access.</string>\n<key>NSRemindersFullAccessUsageDescription</key>\n<string>This app needs permission to read and manage reminders.</string>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 40,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 1
          },
          "text": "iOS 17 and newer distinguish between write-only and full calendar access. Only include reminder usage descriptions if your app calls the Reminders APIs."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 42,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 1
          },
          "text": "Apple reference: "
        },
        {
          "type": "link",
          "location": {
            "line": 42,
            "column": 18
          },
          "url": "https://developer.apple.com/documentation/technotes/tn3152-migrating-to-the-latest-calendar-access-levels",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 42,
                "column": 19
              },
              "text": "Migrating to the latest Calendar access levels"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 173
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 44,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 4
          },
          "text": "Android Setup"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 46,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 1
          },
          "text": "Add the calendar permissions your app needs to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 46,
            "column": 48
          },
          "text": "android/app/src/main/AndroidManifest.xml"
        },
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 90
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 48,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<uses-permission android:name=\"android.permission.READ_CALENDAR\" />\n<uses-permission android:name=\"android.permission.WRITE_CALENDAR\" />"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 53,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 1
          },
          "text": "Android reference: "
        },
        {
          "type": "link",
          "location": {
            "line": 53,
            "column": 20
          },
          "url": "https://developer.android.com/identity/providers/calendar-provider#manifest",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 53,
                "column": 21
              },
              "text": "Calendar Provider user permissions"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 133
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 55,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 4
          },
          "text": "Request Calendar Access"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 57,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCalendar } from '@capgo/capacitor-calendar';\n\nconst permission = await CapacitorCalendar.requestFullCalendarAccess();\n\nif (permission.result !== 'granted') {\n  throw new Error('Calendar permission was not granted');\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 67,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 1
          },
          "text": "For apps that only add events, use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 67,
            "column": 36
          },
          "text": "requestWriteOnlyCalendarAccess()"
        },
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 70
          },
          "text": ". For Android-only read flows, use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 67,
            "column": 105
          },
          "text": "requestReadOnlyCalendarAccess()"
        },
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 138
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 69,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 4
          },
          "text": "Create An Event"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 71,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 71,
            "column": 1
          },
          "text": "Dates are Unix timestamps in milliseconds."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 73,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCalendar } from '@capgo/capacitor-calendar';\n\nconst startDate = Date.now() + 60 * 60 * 1000;\nconst endDate = startDate + 60 * 60 * 1000;\n\nconst { id } = await CapacitorCalendar.createEvent({\n  title: 'Product review',\n  location: 'Capgo',\n  startDate,\n  endDate,\n  description: 'Created with @capgo/capacitor-calendar',\n});\n\nconsole.log('Created event', id);"
    },
    {
      "type": "heading",
      "location": {
        "line": 90,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 90,
            "column": 4
          },
          "text": "Open The Native Event Editor"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 92,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await CapacitorCalendar.createEventWithPrompt({\n  title: 'Planning session',\n  location: 'Office',\n  startDate: Date.now() + 24 * 60 * 60 * 1000,\n  endDate: Date.now() + 25 * 60 * 60 * 1000,\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 101,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 101,
            "column": 1
          },
          "text": "On Android, prompt-based create and modify calls return "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 101,
            "column": 57
          },
          "text": "null"
        },
        {
          "type": "text",
          "location": {
            "line": 101,
            "column": 63
          },
          "text": ". List events afterward if you need to find the created event ID."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 103,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 103,
            "column": 4
          },
          "text": "List Upcoming Events"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 105,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const now = Date.now();\nconst oneWeekFromNow = now + 7 * 24 * 60 * 60 * 1000;\n\nconst { result: events } = await CapacitorCalendar.listEventsInRange({\n  from: now,\n  to: oneWeekFromNow,\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 115,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 115,
            "column": 4
          },
          "text": "Choose A Calendar"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 117,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { result: calendars } = await CapacitorCalendar.listCalendars();\nconst { result: defaultCalendar } = await CapacitorCalendar.getDefaultCalendar();\n\nconst calendarId = defaultCalendar?.id ?? calendars[0]?.id;"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 124,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 124,
            "column": 1
          },
          "text": "selectCalendarsWithPrompt()"
        },
        {
          "type": "text",
          "location": {
            "line": 124,
            "column": 30
          },
          "text": " is available on iOS when you want to show the system calendar picker."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 126,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 126,
            "column": 4
          },
          "text": "Create An iOS Reminder"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 128,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const permission = await CapacitorCalendar.requestFullRemindersAccess();\n\nif (permission.result === 'granted') {\n  await CapacitorCalendar.createReminder({\n    title: 'Send launch notes',\n    dueDate: Date.now() + 2 * 24 * 60 * 60 * 1000,\n    notes: 'Created with @capgo/capacitor-calendar',\n  });\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 140,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 140,
            "column": 1
          },
          "text": "Reminder APIs are iOS-only."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 142,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 142,
            "column": 4
          },
          "text": "Example App"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 144,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 144,
            "column": 1
          },
          "text": "The repository includes a Capacitor example app with permission checks, event creation, native event prompts, calendar listing, and event range listing."
        }
      ]
    },
