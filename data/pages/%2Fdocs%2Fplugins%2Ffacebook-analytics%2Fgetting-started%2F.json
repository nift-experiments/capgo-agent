  "sourceSha256": "0dfaa36e97e2360b55f793bf56d10b321f4291b4c6fd7539f31954de9f5abe0a",
  "metadata": {
    "title": "Getting Started",
    "description": "Install @capgo/capacitor-facebook-analytics and log Meta/Facebook App Events from Capacitor.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-facebook-analytics` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-facebook-analytics\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import {\n  FacebookAnalytics,\n  FacebookEventName,\n  FacebookEventParameterName,\n} from '@capgo/capacitor-facebook-analytics';"
    },
    {
      "type": "heading",
      "location": {
        "line": 33,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 4
          },
          "text": "Native Setup"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "Configure your Meta app id and client token in the native app. The plugin does not create these values for you."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 37,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 37,
            "column": 5
          },
          "text": "iOS"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 39,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 39,
            "column": 1
          },
          "text": "Add your Meta values to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 39,
            "column": 25
          },
          "text": "Info.plist"
        },
        {
          "type": "text",
          "location": {
            "line": 39,
            "column": 37
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 41,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>FacebookAppID</key>\n<string>YOUR_FACEBOOK_APP_ID</string>\n<key>FacebookClientToken</key>\n<string>YOUR_FACEBOOK_CLIENT_TOKEN</string>\n<key>FacebookDisplayName</key>\n<string>YOUR_APP_NAME</string>"
    },
    {
      "type": "heading",
      "location": {
        "line": 50,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 5
          },
          "text": "Android"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 52,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 1
          },
          "text": "Add your Meta values to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 52,
            "column": 25
          },
          "text": "AndroidManifest.xml"
        },
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 46
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 54,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<meta-data android:name=\"com.facebook.sdk.ApplicationId\" android:value=\"@string/facebook_app_id\" />\n<meta-data android:name=\"com.facebook.sdk.ClientToken\" android:value=\"@string/facebook_client_token\" />"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 59,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 59,
            "column": 1
          },
          "text": "Add the string resources in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 59,
            "column": 29
          },
          "text": "android/app/src/main/res/values/strings.xml"
        },
        {
          "type": "text",
          "location": {
            "line": 59,
            "column": 74
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 61,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<string name=\"facebook_app_id\">YOUR_FACEBOOK_APP_ID</string>\n<string name=\"facebook_client_token\">YOUR_FACEBOOK_CLIENT_TOKEN</string>"
    },
    {
      "type": "heading",
      "location": {
        "line": 66,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 4
          },
          "text": "Enable Advertiser Tracking"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 68,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 68,
            "column": 1
          },
          "text": "Call this after your consent flow allows tracking."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 70,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await FacebookAnalytics.enableAdvertiserTracking();"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 74,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 74,
            "column": 1
          },
          "text": "On iOS 17 and above, FBSDK v17+ reads App Tracking Transparency directly. Use your app's ATT flow before logging tracking-dependent events."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 76,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 76,
            "column": 4
          },
          "text": "Log A Standard Event"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 78,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await FacebookAnalytics.logEvent({\n  event: FacebookEventName.CompletedRegistration,\n  params: {\n    [FacebookEventParameterName.RegistrationMethod]: 'email',\n  },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 87,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 87,
            "column": 4
          },
          "text": "Log A Value Event With Currency"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 89,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await FacebookAnalytics.logEvent({\n  event: FacebookEventName.AddedToCart,\n  valueToSum: 19.99,\n  currency: 'USD',\n  params: {\n    [FacebookEventParameterName.ContentType]: 'product',\n    [FacebookEventParameterName.ContentId]: 'sku-123',\n  },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 101,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 101,
            "column": 4
          },
          "text": "Log A Purchase"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 103,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await FacebookAnalytics.logPurchase({\n  amount: 9.99,\n  currency: 'USD',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 110,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 110,
            "column": 4
          },
          "text": "Read Tracking Status"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 112,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { status } = await FacebookAnalytics.getAdvertiserTrackingStatus();\nconsole.log('Advertiser tracking enabled:', status);"
    },
    {
      "type": "heading",
      "location": {
        "line": 117,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 117,
            "column": 4
          },
          "text": "Source Of Truth"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 119,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 119,
            "column": 1
          },
          "text": "This page is generated from the plugin's "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 119,
            "column": 42
          },
          "text": "src/definitions.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 119,
            "column": 62
          },
          "text": ". Re-run the sync when the public API changes upstream."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 121,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 121,
            "column": 4
          },
          "text": "Keep going from Getting Started"
        }
      ]
    },
