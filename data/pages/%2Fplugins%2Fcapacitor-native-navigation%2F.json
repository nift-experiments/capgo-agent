        {
          "type": "text",
          "location": {
            "line": 1,
            "column": 3
          },
          "text": "Using @capgo/capacitor-native-navigation"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 3,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "@capgo/capacitor-native-navigation"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 37
          },
          "text": " renders native top navigation, bottom tab chrome, and route transition shells over a single full-screen Capacitor WebView. Your web framework still owns routes and content, while native owns the app frame."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 5,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 4
          },
          "text": "Install and sync"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 7,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-native-navigation\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 12,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 4
          },
          "text": "Configure the native frame"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 14,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { NativeNavigation } from '@capgo/capacitor-native-navigation';\n\nawait NativeNavigation.configure({\n  contentInsetMode: 'css',\n  animationDuration: 360,\n  colors: {\n    tint: '#0f172a',\n    inactiveTint: '#64748b',\n  },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 27,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 4
          },
          "text": "Render a native navbar"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 29,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeNavigation.setNavbar({\n  title: 'Inbox',\n  subtitle: 'Native chrome',\n  transparent: true,\n  backButton: { visible: false },\n  rightItems: [\n    {\n      id: 'compose',\n      title: 'Compose',\n      icon: {\n        svg: '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z\"/></svg>',\n      },\n    },\n  ],\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 47,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 4
          },
          "text": "Render a native tabbar"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 49,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeNavigation.setTabbar({\n  selectedId: 'inbox',\n  labelVisibilityMode: 'selected',\n  icons: true,\n  colors: {\n    dynamic: true,\n    tint: '#0f172a',\n    inactiveTint: '#64748b',\n  },\n  tabs: [\n    {\n      id: 'inbox',\n      title: 'Inbox',\n      icon: {\n        svg: '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 4h16v16H4z\"/><path d=\"m4 13 4 4h8l4-4\"/></svg>',\n      },\n    },\n    {\n      id: 'search',\n      title: 'Search',\n      icon: {\n        svg: '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3-3\"/></svg>',\n      },\n    },\n  ],\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 78,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 78,
            "column": 4
          },
          "text": "Connect native events to your router"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 80,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 80,
            "column": 1
          },
          "text": "Native bars emit intent. Your router still performs the route change:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 82,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeNavigation.addListener('navbarBack', () => {\n  router.back();\n});\n\nawait NativeNavigation.addListener('navbarItemTap', ({ id }) => {\n  if (id === 'compose') router.push('/compose');\n});\n\nawait NativeNavigation.addListener('tabSelect', ({ id }) => {\n  router.push(`/${id}`);\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 96,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 96,
            "column": 4
          },
          "text": "Animate route changes"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 98,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 98,
            "column": 1
          },
          "text": "Use a transition transaction around your normal web route update:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 100,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const transition = await NativeNavigation.beginTransition({\n  direction: 'forward',\n});\n\nrouter.push('/message/42');\nawait router.ready?.();\n\nawait NativeNavigation.setNavbar({\n  title: 'Message',\n  backButton: { visible: true, title: 'Inbox' },\n});\n\nawait NativeNavigation.finishTransition({\n  id: transition.id,\n  direction: 'forward',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 119,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 119,
            "column": 4
          },
          "text": "Add a zoom transition"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 121,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 121,
            "column": 1
          },
          "text": "Use the zoom helpers for routes that open from a card, grid item, or media preview."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 123,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { beginZoomTransition, finishZoomTransition } from '@capgo/capacitor-native-navigation';\n\nconst card = document.querySelector('[data-message-card]');\nif (card) {\n  const transition = await beginZoomTransition(card, { cornerRadius: 18 });\n\n  router.push('/message/42');\n  await router.ready?.();\n\n  await NativeNavigation.setNavbar({\n    title: 'Message',\n    backButton: { visible: true, title: 'Inbox' },\n  });\n\n  await finishZoomTransition(undefined, {\n    id: transition.id,\n    cornerRadius: 18,\n  });\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 145,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 145,
            "column": 4
          },
          "text": "Pad content with native insets"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 147,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 147,
            "column": 1
          },
          "text": "When "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 147,
            "column": 6
          },
          "text": "contentInsetMode"
        },
        {
          "type": "text",
          "location": {
            "line": 147,
            "column": 24
          },
          "text": " is "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 147,
            "column": 28
          },
          "text": "css"
        },
        {
          "type": "text",
          "location": {
            "line": 147,
            "column": 33
          },
          "text": ", the plugin writes CSS variables for the native bars:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 149,
        "column": 1
      },
      "lang": "css",
      "meta": null,
      "text": ".page {\n  padding-top: var(--cap-native-navigation-top);\n  padding-bottom: var(--cap-native-navigation-bottom);\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 156,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 156,
            "column": 4
          },
          "text": "Icon choices"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 158,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 158,
            "column": 1
          },
          "text": "Icons are native descriptors, not React or Vue nodes. Use SVG when you do not want to bundle native assets:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 160,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const icon = {\n  svg: '<svg viewBox=\"0 0 24 24\"><path d=\"M3 10.5 12 3l9 7.5\"/></svg>',\n  template: true,\n  ios: { sfSymbol: 'house.fill' },\n  android: { resource: 'ic_menu_view' },\n};"
    },
