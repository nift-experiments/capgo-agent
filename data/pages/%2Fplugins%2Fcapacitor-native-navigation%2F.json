    {
      "type": "heading",
      "location": {
        "line": 171,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 171,
            "column": 4
          },
          "text": "Combine with @capgo/capacitor-transitions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 173,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 173,
            "column": 1
          },
          "text": "Use Native Navigation for the native navbar, tabbar, safe-area insets, and native intent events. Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 173,
            "column": 102
          },
          "text": "@capgo/capacitor-transitions"
        },
        {
          "type": "text",
          "location": {
            "line": 173,
            "column": 132
          },
          "text": " for the WebView page stack underneath that native chrome."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 175,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-native-navigation @capgo/capacitor-transitions\nnpx cap sync"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 180,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 180,
            "column": 1
          },
          "text": "Initialize both packages once:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 182,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { NativeNavigation } from '@capgo/capacitor-native-navigation';\nimport '@capgo/capacitor-transitions';\nimport { initTransitions, setupRouterOutlet, setDirection } from '@capgo/capacitor-transitions/react';\n\ninitTransitions({ platform: 'auto' });\n\nconst outlet = document.querySelector('cap-router-outlet');\nif (outlet) {\n  setupRouterOutlet(outlet, { platform: 'auto', swipeGesture: 'auto' });\n}\n\nawait NativeNavigation.configure({\n  contentInsetMode: 'css',\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 199,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 199,
            "column": 1
          },
          "text": "Keep the transition outlet focused on pages, not duplicate web bars:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 201,
        "column": 1
      },
      "lang": "html",
      "meta": null,
      "text": "<cap-router-outlet platform=\"auto\" swipe-gesture=\"auto\">\n  <cap-page>\n    <cap-content slot=\"content\" fullscreen>\n      <main class=\"page\">Inbox content</main>\n    </cap-content>\n  </cap-page>\n</cap-router-outlet>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 211,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 211,
            "column": 1
          },
          "text": "Drive both packages from the same router actions:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 213,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "async function openMessage(id: string) {\n  setDirection('forward');\n  await router.push(`/messages/${id}`);\n  await NativeNavigation.setNavbar({\n    title: 'Message',\n    backButton: { visible: true, title: 'Inbox' },\n  });\n}\n\nawait NativeNavigation.addListener('navbarBack', () => {\n  setDirection('back');\n  router.back();\n});\n\nawait NativeNavigation.addListener('tabSelect', ({ id }) => {\n  setDirection('root');\n  router.push(`/${id}`);\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 234,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 234,
            "column": 1
          },
          "text": "Pick one animation layer per route change. Let "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 234,
            "column": 48
          },
          "text": "@capgo/capacitor-transitions"
        },
        {
          "type": "text",
          "location": {
            "line": 234,
            "column": 78
          },
          "text": " animate normal page pushes, and use Native Navigation's zoom helpers only for shared-element or zoom routes."
        }
      ]
    },
