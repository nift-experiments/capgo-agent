        "line": 54,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 5
          },
          "text": "Benefits of Capgo Live Updates"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 56,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
