      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 1
          },
          "text": "Request permission for high sampling rate sensors.\nOn Android 12+, this requests the HIGH_SAMPLING_RATE_SENSORS permission."
