      "lang": "typescript",
      "meta": null,
      "text": "export interface IsAvailableResult {\n  /**\n   * Whether the light sensor is available on this device.\n   * Always false on iOS as the light sensor API is not available.\n   *\n   * @since 0.0.1\n   */\n  available: boolean;\n}"
    },
