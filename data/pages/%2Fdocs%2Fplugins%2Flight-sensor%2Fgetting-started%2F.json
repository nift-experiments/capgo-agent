          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-light-sensor` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-light-sensor\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { LightSensor } from '@capgo/capacitor-light-sensor';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "isAvailable"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Check if the light sensor is available on the current device.\nYou should always check sensor availability before attempting to use it."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { LightSensor } from '@capgo/capacitor-light-sensor';\n\nconst { available } = await LightSensor.isAvailable();"
    },
    {
      "type": "heading",
      "location": {
        "line": 42,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 42,
            "column": 5
          },
          "text": "start"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Start listening to light sensor updates.\nThis will begin sensor measurements at the specified interval.\nUse "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 46,
            "column": 5
          },
          "text": "addListener"
        },
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 18
          },
          "text": " to receive the sensor data."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 48,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { LightSensor } from '@capgo/capacitor-light-sensor';\n\nawait LightSensor.start({ updateInterval: 500 });"
    },
    {
      "type": "heading",
      "location": {
        "line": 54,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 54,
            "column": 5
          },
          "text": "stop"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 56,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 56,
            "column": 1
          },
          "text": "Stop listening to light sensor updates.\nThis will stop the sensor and conserve battery."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 59,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { LightSensor } from '@capgo/capacitor-light-sensor';\n\nawait LightSensor.stop();"
    },
    {
      "type": "heading",
      "location": {
        "line": 65,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 65,
            "column": 5
          },
          "text": "checkPermissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 67,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 1
          },
          "text": "Check the current permission status for high sampling rate sensors.\nOn Android 12+, the HIGH_SAMPLING_RATE_SENSORS permission is required\nfor sensor update intervals below 200ms."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 71,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { LightSensor } from '@capgo/capacitor-light-sensor';\n\nconst status = await LightSensor.checkPermissions();"
    },
    {
