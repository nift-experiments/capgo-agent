{
  "version": 1,
  "route": "/docs/plugins/auto/ios/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/plugins/auto/ios.mdx",
  "sourceSha256": "4496972d143900d05e247c3b590235de878b7330c9837aef96d19081e409b920",
  "metadata": {
    "title": "iOS setup",
    "description": "Configure CarPlay for @capgo/capacitor-auto.",
    "sidebar": {
      "order": 3
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "iOS car support uses CarPlay templates. Apple must approve the CarPlay entitlement for your app category before the app can ship with CarPlay support."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "Info.plist scene"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "Add a CarPlay scene configuration to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 38
          },
          "text": "ios/App/App/Info.plist"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 62
          },
          "text": " and point it to the plugin scene delegate."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "For Swift Package Manager, use:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 10,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>UIApplicationSceneManifest</key>\n<dict>\n  <key>UIApplicationSupportsMultipleScenes</key>\n  <true/>\n  <key>UISceneConfigurations</key>\n  <dict>\n    <key>CPTemplateApplicationSceneSessionRoleApplication</key>\n    <array>\n      <dict>\n        <key>UISceneClassName</key>\n        <string>CPTemplateApplicationScene</string>\n        <key>UISceneDelegateClassName</key>\n        <string>AutoPlugin.AutoCarPlaySceneDelegate</string>\n      </dict>\n    </array>\n  </dict>\n</dict>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 30,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 1
          },
          "text": "For CocoaPods, the delegate module is commonly:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 32,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<string>CapgoCapacitorAuto.AutoCarPlaySceneDelegate</string>"
    },
    {
      "type": "heading",
      "location": {
        "line": 36,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 4
          },
          "text": "Entitlement"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 38,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 1
          },
          "text": "Request the CarPlay entitlement for the app category that matches your use case. The plugin renders a simple "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 38,
            "column": 110
          },
          "text": "CPListTemplate"
        },
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 126
          },
          "text": ", but Apple still decides which templates and categories are allowed for production distribution."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 40,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 4
          },
          "text": "Sync"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 42,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx cap sync ios"
    },
    {
      "type": "heading",
      "location": {
        "line": 46,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 4
          },
          "text": "Behavior"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 48,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 48,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 48,
                "column": 3
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 48,
                    "column": 3
                  },
                  "text": "setRootTemplate"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 48,
                    "column": 20
                  },
                  "text": " updates the CarPlay list template when the car display is connected."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 49,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 49,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 49,
                    "column": 3
                  },
                  "text": "CarPlay row selection emits "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 49,
                    "column": 31
                  },
                  "text": "carAction"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 49,
                    "column": 42
                  },
                  "text": " to JavaScript."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 50,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 50,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 50,
                    "column": 3
                  },
                  "text": "If CarPlay connects before the WebView listener is ready, retained events are delivered when the plugin attaches."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 52,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 4
          },
          "text": "Limits"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 54,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 1
          },
          "text": "CarPlay does not render your Capacitor WebView. Keep car rows short and use them as native intent triggers for phone app logic."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 56,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 56,
            "column": 4
          },
          "text": "Keep going from iOS setup"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 58,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
