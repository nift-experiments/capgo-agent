    {
      "type": "code",
      "location": {
        "line": 50,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface TextInteractionOptions {\n  /**\n   * Whether text interaction should be enabled or disabled. Disabling hides the\n   * magnifier lens reintroduced with iOS 15.\n   */\n  enabled: boolean;\n}"
    },
    {
      "type": "heading",
