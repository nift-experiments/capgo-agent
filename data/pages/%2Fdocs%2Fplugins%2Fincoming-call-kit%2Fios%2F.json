  "metadata": {
    "title": "iOS",
    "description": "Configure CallKit behavior and understand production limits on iOS.",
    "sidebar": {
      "order": 3
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "How iOS behavior works"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "On iOS, the plugin reports the incoming call to CallKit. That gives you the system incoming-call sheet and standardized call actions without building your own native incoming-call UI."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "requestPermissions()"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 23
          },
          "text": " resolves immediately on iOS because CallKit itself does not require a runtime permission dialog."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 8,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 4
          },
          "text": "Basic example"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 10,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { IncomingCallKit } from '@capgo/capacitor-incoming-call-kit';\n\nawait IncomingCallKit.showIncomingCall({\n  callId: 'call-42',\n  callerName: 'Ada Lovelace',\n  handle: '+1 555 010 020',\n  ios: {\n    handleType: 'phoneNumber',\n    supportsHolding: true,\n    supportsDTMF: false,\n  },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 25,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 4
          },
          "text": "Handle types"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 27,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 27,
            "column": 5
          },
          "text": "ios.handleType"
        },
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 21
          },
          "text": " to control how CallKit formats the handle:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 29,
        "column": 1
      },
      "ordered": false,
