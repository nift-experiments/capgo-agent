        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 33,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 4
          },
          "text": "Background incoming calls"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "This plugin does not register PushKit or APNs for you."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 37,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 37,
            "column": 1
          },
          "text": "For true background or terminated-state ringing on iOS, your host app still needs the native Apple push setup that matches your transport strategy:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 39,
        "column": 1
      },
      "ordered": true,
      "start": 1,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 39,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 39,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 39,
                    "column": 4
                  },
                  "text": "Enable Push Notifications when your transport uses Apple push delivery."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 40,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 40,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 40,
                    "column": 4
                  },
                  "text": "Enable the Voice over IP background mode when your app uses a VoIP push flow."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 41,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 41,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 41,
                    "column": 4
                  },
                  "text": "Deliver the incoming-call event to your app and invoke this plugin as soon as the Capacitor bridge is available."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 43,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 43,
            "column": 1
          },
          "text": "If your ring event exists only in JavaScript, you will get the best experience while the app is already running in the foreground."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 45,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 4
          },
          "text": "Microphone and camera permissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 47,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 1
          },
          "text": "CallKit does not replace your media SDK. If the real call session uses microphone or camera access, those usage descriptions still belong in your app:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 49,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>NSMicrophoneUsageDescription</key>\n<string>This app uses the microphone for calls.</string>\n<key>NSCameraUsageDescription</key>\n<string>This app uses the camera for video calls.</string>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 56,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 56,
            "column": 1
          },
          "text": "Add only the keys your real calling flow needs."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 58,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 58,
            "column": 4
          },
          "text": "Keep these responsibilities in your app layer"
        }
      ]
    },
