  "metadata": {
    "title": "Getting Started",
    "description": "Install @capgo/capacitor-patch and apply selected Capacitor patch IDs during sync and update.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 14,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-patch` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 20,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-patch\nnpx cap sync"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "The package is a no-op until you select patches in your Capacitor config."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 27,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 4
          },
          "text": "Select patch IDs"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 29,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 1
          },
          "text": "List all shipped patches:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 31,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx capgo-capacitor-patch list --all"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "Then add the patch IDs your app needs to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 35,
            "column": 42
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 63
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 37,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\n\nconst config: CapacitorConfig = {\n  appId: 'com.example.app',\n  appName: 'Example',\n  webDir: 'dist',\n  plugins: {\n    CapacitorPatch: {\n      patches: ['upstream-pr-8418-android'],\n      strict: true,\n    },\n  },\n};\n\nexport default config;"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "Run sync again:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 57,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx cap sync"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 61,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 1
          },
          "text": "Package patches run before "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 28
          },
          "text": "sync"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 34
          },
          "text": " and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 39
          },
          "text": "update"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 47
          },
          "text": ". Native project patches run after "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 82
          },
          "text": "sync"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 88
          },
          "text": " and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 93
          },
          "text": "update"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 101
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 63,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 63,
            "column": 4
          },
          "text": "Dry-run before applying"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 65,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 65,
            "column": 5
          },
          "text": "doctor"
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 13
          },
          "text": " to check whether selected patches match your installed package versions:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 67,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx capgo-capacitor-patch doctor --phase package --strict"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 71,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 71,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 71,
            "column": 5
          },
          "text": "apply"
        },
        {
          "type": "text",
          "location": {
            "line": 71,
            "column": 12
          },
          "text": " when you want to run the selected patches manually:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 73,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx capgo-capacitor-patch apply --phase package"
    },
