        {
          "type": "text",
          "location": {
            "line": 1,
            "column": 3
          },
          "text": "Using @capgo/capacitor-widget-kit"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 3,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "@capgo/capacitor-widget-kit"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 30
          },
          "text": " lets a Capacitor app drive WidgetKit and Live Activity experiences in two ways:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 5,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 5,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 5,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 5,
                    "column": 3
                  },
                  "text": "Render resolved SVG template surfaces with frame switching, tap hotspots, and pause/play timers."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 6,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 6,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 6,
                    "column": 3
                  },
                  "text": "Keep the widget fully native while the app and widget share JSON session state and async messages."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 8,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 10,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-widget-kit\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 15,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 4
          },
          "text": "When To Use SVG Templates"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 17,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 1
          },
          "text": "Use SVG templates when the widget surface can be described as SVG. The app stores a template definition, the native bridge resolves placeholders, and widget taps can mutate state later."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 19,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 1
          },
          "text": "Good fits include workout timers, delivery status cards, sports scores, or any compact UI where switching between named frames is enough."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 21,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoWidgetKit } from '@capgo/capacitor-widget-kit';\n\nconst { activity } = await CapgoWidgetKit.startTemplateActivity({\n  activityId: 'session-1',\n  state: {\n    title: 'Chest Day',\n    frame: 'summary',\n    restDurationMs: 90000,\n  },\n  definition: {\n    id: 'workout-card',\n    timers: [{ id: 'rest', durationPath: 'state.restDurationMs' }],\n    actions: [\n      {\n        id: 'next-frame',\n        frameMutations: [{ op: 'next', path: 'frame', surface: 'lockScreen' }],\n      },\n      {\n        id: 'toggle-rest',\n        timerMutations: [{ op: 'toggle', timerId: 'rest' }],\n      },\n    ],\n    layouts: {\n      lockScreen: {\n        width: 100,\n        height: 40,\n        frameIdPath: 'state.frame',\n        frames: [\n          {\n            id: 'summary',\n            hotspots: [{ id: 'switch', actionId: 'next-frame', x: 0, y: 0, width: 100, height: 40 }],\n            svg: `<svg viewBox=\"0 0 100 40\"><text x=\"6\" y=\"22\">{{state.title}}</text></svg>`,\n          },\n          {\n            id: 'timer',\n            hotspots: [{ id: 'pause-play', actionId: 'toggle-rest', x: 0, y: 0, width: 100, height: 40 }],\n            svg: `<svg viewBox=\"0 0 100 40\"><text x=\"6\" y=\"22\">{{timers.rest.remainingText}}</text></svg>`,\n          },\n        ],\n      },\n    },\n  },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 67,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 4
          },
          "text": "Handle Widget Actions In The App"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "Widget actions are persisted as events. Read and acknowledge them when the app resumes or after a background sync step."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 71,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { events } = await CapgoWidgetKit.listTemplateEvents({\n  activityId: activity.activityId,\n  unacknowledgedOnly: true,\n});\n\nfor (const event of events) {\n  console.log(event.actionId, event.state, event.timers);\n}\n\nawait CapgoWidgetKit.acknowledgeTemplateEvents({ activityId: activity.activityId });"
    },
    {
      "type": "heading",
      "location": {
        "line": 84,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 4
          },
          "text": "When To Use Full-Native Sessions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 86,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 1
          },
          "text": "Use full-native sessions when the widget UI is better built directly in Swift, Kotlin, or Java. Capacitor still starts and stops the session, keeps shared state current, and queues work between app and widget code."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 88,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { session } = await CapgoWidgetKit.startWidgetSession({\n  widgetId: 'native-session-1',\n  kind: 'workout-controls',\n  state: { isRunning: true, selectedSetId: 'set-1' },\n  metadata: { accent: '#00d69c' },\n});\n\nawait CapgoWidgetKit.updateWidgetSession({\n  widgetId: session.widgetId,\n  merge: true,\n  state: { isRunning: false },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 103,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 103,
            "column": 4
          },
          "text": "Queue Async Work Between Widget And App"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 105,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 105,
            "column": 1
          },
          "text": "Messages can flow from app to widget or widget to app. They stay pending until acknowledged and completed."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 107,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { message } = await CapgoWidgetKit.sendWidgetMessage({\n  widgetId: session.widgetId,\n  direction: 'widgetToApp',\n  name: 'syncWorkoutSet',\n  payload: { setId: 'set-1' },\n  expectsResponse: true,\n});\n\nawait CapgoWidgetKit.acknowledgeWidgetMessages({ messageIds: [message.messageId] });\n\nawait CapgoWidgetKit.completeWidgetMessage({\n  messageId: message.messageId,\n  response: { synced: true },\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 124,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 124,
            "column": 1
          },
          "text": "If the job fails, complete the message with an error:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 126,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await CapgoWidgetKit.completeWidgetMessage({\n  messageId: message.messageId,\n  error: 'Sync failed',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 133,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 133,
            "column": 4
          },
          "text": "Stop Sessions Cleanly"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 135,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await CapgoWidgetKit.endTemplateActivity({\n  activityId: activity.activityId,\n  state: { title: 'Workout complete', frame: 'summary' },\n});\n\nawait CapgoWidgetKit.stopWidgetSession({\n  widgetId: session.widgetId,\n  state: { isRunning: false },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 147,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 147,
            "column": 4
          },
          "text": "Native Setup Notes"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 149,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 149,
            "column": 1
          },
          "text": "For iOS WidgetKit and Live Activities, configure an App Group on the app and widget extension targets and set "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 149,
            "column": 111
          },
          "text": "CapgoWidgetKitAppGroup"
        },
        {
          "type": "text",
          "location": {
            "line": 149,
            "column": 135
          },
          "text": " in both "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 149,
            "column": 144
          },
          "text": "Info.plist"
        },
        {
          "type": "text",
          "location": {
            "line": 149,
            "column": 156
          },
          "text": " files. Interactive buttons require a widget extension that wires the plugin-provided native bridge and action intent."
        }
      ]
    },
