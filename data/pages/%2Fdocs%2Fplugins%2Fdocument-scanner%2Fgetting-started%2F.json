        "line": 176,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export enum ScanDocumentResponseStatus {\n  /**\n   * The scan completed successfully.\n   */\n  Success = 'success',\n\n  /**\n   * The user cancelled the scan flow.\n   */\n  Cancel = 'cancel',\n}"
    },
