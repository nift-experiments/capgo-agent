    "title": "Getting Started",
    "description": "Install @capgo/capacitor-uwb and start UWB ranging on iOS and Android.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
