                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 57,
                    "column": 4
                  },
                  "text": "The controller calls "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 57,
                    "column": 25
                  },
                  "text": "startControllerSession()"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 57,
                    "column": 51
                  },
                  "text": " and shares the returned "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 57,
                    "column": 76
                  },
                  "text": "rangingParameters"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 57,
                    "column": 95
                  },
                  "text": " and "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 57,
                    "column": 100
                  },
                  "text": "localAddress"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 57,
                    "column": 114
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 58,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 58,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 58,
                    "column": 4
                  },
                  "text": "The controlee builds its own "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 58,
                    "column": 33
                  },
                  "text": "rangingParameters"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 58,
                    "column": 52
                  },
                  "text": ", using the controller "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 58,
                    "column": 75
                  },
                  "text": "localAddress"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 58,
                    "column": 89
                  },
                  "text": " as "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 58,
                    "column": 93
                  },
                  "text": "peerAddress"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 58,
                    "column": 106
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 59,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 59,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 59,
                    "column": 4
                  },
                  "text": "The controlee calls "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 59,
                    "column": 24
                  },
                  "text": "startControleeSession({ rangingParameters })"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 59,
                    "column": 70
                  },
                  "text": "."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 60,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 60,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 60,
                    "column": 4
                  },
                  "text": "Optionally pass "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 60,
                    "column": 20
                  },
                  "text": "peerAddress"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 60,
                    "column": 33
                  },
                  "text": " to the controller once the controlee address is known."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 62,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const controller = await CapacitorUwb.startControllerSession();\n\nawait CapacitorUwb.startControleeSession({\n  rangingParameters: {\n    ...controller.rangingParameters,\n    peerAddress: controller.localAddress,\n  },\n});"
    },
