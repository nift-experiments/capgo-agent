      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-uwb` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-uwb\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorUwb } from '@capgo/capacitor-uwb';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "Check Availability"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 31,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const availability = await CapacitorUwb.isAvailable();\n\nif (!availability.supported) {\n  console.log('This device does not support UWB.');\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 39,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 39,
            "column": 4
          },
          "text": "iOS Peer Session"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 41,
        "column": 1
      },
      "ordered": true,
      "start": 1,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 41,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 41,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 41,
                    "column": 4
                  },
                  "text": "Call "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 41,
                    "column": 9
                  },
                  "text": "getDiscoveryToken()"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 41,
                    "column": 30
                  },
                  "text": " on both devices."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 42,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 42,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 42,
                    "column": 4
                  },
                  "text": "Exchange the returned base64 tokens out-of-band."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 43,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 43,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 43,
                    "column": 4
                  },
                  "text": "Start ranging with the peer token."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 45,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { discoveryToken } = await CapacitorUwb.getDiscoveryToken();\n\nawait CapacitorUwb.startPeerSession({\n  peerDiscoveryToken: '<peer-token-base64>',\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 53,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 1
          },
          "text": "See "
        },
        {
          "type": "link",
          "location": {
            "line": 53,
