    },
    {
      "type": "code",
      "location": {
        "line": 77,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await CapacitorUwb.addListener('rangingUpdate', (event) => {\n  console.log(event.distanceMeters, event.direction);\n});\n\nawait CapacitorUwb.addListener('sessionStateChanged', (event) => {\n  console.log(event.state, event.reason);\n});"
    },
