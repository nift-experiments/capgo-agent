        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Acquire a token from the MSAL cache for a previously signed-in user."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 46,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { IntuneMAM } from '@capgo/capacitor-intune';\n\nconst result = await IntuneMAM.acquireTokenSilent({\n  scopes: ['openid'],\n  accountId: 'acquireToken',\n});\n// The result holds sensitive values: use it without logging it."
    },
