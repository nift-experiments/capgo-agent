      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 58,
            "column": 1
          },
          "text": "Register a previously authenticated account with Intune and start enrollment."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 60,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { IntuneMAM } from '@capgo/capacitor-intune';\n\nawait IntuneMAM.registerAndEnrollAccount({ accountId: 'account-id-123' });"
    },
    {
