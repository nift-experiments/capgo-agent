    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Present the Microsoft sign-in flow and return an access token plus the account metadata."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { IntuneMAM } from '@capgo/capacitor-intune';\n\nconst result = await IntuneMAM.acquireToken({ scopes: ['openid'] });\n// The result holds sensitive values: use it without logging it."
    },
    {
      "type": "heading",
      "location": {
        "line": 42,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
