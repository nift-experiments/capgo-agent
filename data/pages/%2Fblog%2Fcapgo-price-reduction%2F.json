              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 17,
                    "column": 4
                  },
                  "text": "We believe over-the-air updates shouldn't be a luxury. They're essential for modern app development, helping you ship faster and keep users happy. 🚀"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 19,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 19,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 19,
                    "column": 4
                  },
                  "text": "We're committed to making our pricing more accessible over time. As technology improves and our user base grows, we want to pass those benefits directly to you. 💖"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 21,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 21,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 21,
                    "column": 4
                  },
                  "text": "Optimization benefits: Last year's hard work paid off! We've cut our operating costs, and we're passing those savings directly to you. 📉➡️📈"
                }
              ]
            }
          ]
        }
      ]
    },
