                    "line": 42,
                    "column": 3
                  },
                  "text": "Delta (manifest) updates"
                }
              ]
            },
            {
              "type": "tableCell",
              "location": {
                "line": 42,
                "column": 28
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 42,
                    "column": 30
                  },
                  "text": "✅"
                }
              ]
            },
            {
              "type": "tableCell",
              "location": {
                "line": 42,
                "column": 36
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 42,
                    "column": 38
                  },
                  "text": "❌"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": ":::danger\nIf you send a bad update to your users you can and will break their app.\n:::"
        }
      ]
    },
    {
      "type": "blockquote",
      "location": {
        "line": 48,
        "column": 1
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 48,
            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 48,
                "column": 3
              },
              "text": "Be mindful that you can't use the Capgo cloud and your server at the same time."
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 52,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 1
          },
          "text": ":::danger\nThe Over-the-Air (OTA) update feature is applicable only for modifications made to HTML, CSS, and JavaScript files."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "If you make any changes to the native code, such as updates to Capacitor plugins, it is mandatory to resubmit the application to the app store for approval.\n:::"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 58,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 58,
            "column": 4
          },
          "text": "Choose between Auto and Manual"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 59,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 59,
            "column": 1
          },
          "text": "In auto mode, part of the logic is handled by the Native code, updates are decided server side, this is more secure and allows fine grain updates, partial deployment to one device or group and more."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 61,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 1
          },
          "text": "In manual mode, all the logic is handled by the JS."
        }
      ]
    },
    {
      "type": "component",
      "name": "LinkCard",
      "props": {
        "title": "Auto Update",
        "href": "/docs/plugins/updater/self-hosted/auto-update/"
