        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 113,
            "column": 1
          },
          "text": "If the API key does not have "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 113,
            "column": 30
          },
          "text": "org.create"
        },
        {
          "type": "text",
          "location": {
            "line": 113,
            "column": 42
          },
          "text": ", the API returns:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 115,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"error\": \"permission_denied\"\n}"
    },
