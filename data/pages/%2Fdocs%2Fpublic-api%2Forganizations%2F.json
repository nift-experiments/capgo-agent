        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 68,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 68,
            "column": 1
          },
          "text": "Create a new organization."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 70,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 1
          },
          "text": "When using an API key, the key must have the global "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 70,
            "column": 53
          },
          "text": "org.create"
        },
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 65
          },
          "text": " permission and a current organization-scoped "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 70,
            "column": 111
          },
          "text": "org_admin"
        },
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 122
          },
          "text": " or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 70,
            "column": 126
          },
          "text": "org_super_admin"
        },
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 143
          },
          "text": " binding. This is required because the target organization does not exist yet, so normal org-scoped RBAC cannot be checked against it."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 72,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 1
          },
          "text": "When the request succeeds, Capgo automatically assigns the same API key as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 72,
            "column": 76
          },
          "text": "org_super_admin"
        },
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 93
          },
          "text": " on the new organization."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 74,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 74,
            "column": 1
          },
          "text": ":::note\n"
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 75,
            "column": 1
          },
          "text": "org.create"
        },
        {
          "type": "text",
          "location": {
            "line": 75,
            "column": 13
          },
          "text": " is not granted to new API keys by default. Enable "
        },
        {
          "type": "strong",
          "location": {
            "line": 75,
            "column": 64
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 75,
                "column": 66
              },
              "text": "Allow creating organizations"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 75,
            "column": 96
          },
          "text": " in the API key form, or include "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 75,
            "column": 129
          },
          "text": "\"global_permissions\": [\"org.create\"]"
        },
        {
          "type": "text",
          "location": {
            "line": 75,
            "column": 167
          },
          "text": " when creating the key through the API.\n:::"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 78,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 78,
            "column": 6
          },
          "text": "Request Body"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 80,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "interface OrganizationCreate {\n  name: string\n  email?: string\n  estimatedMau?: number\n  website?: string\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 89,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
