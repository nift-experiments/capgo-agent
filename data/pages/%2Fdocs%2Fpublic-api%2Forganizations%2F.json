    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "interface Organization {\n  id: string\n  created_by: string\n  created_at: string\n  updated_at: string\n  logo: string | null\n  name: string\n  management_email: string\n  customer_id: string | null\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 38,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 6
          },
          "text": "Example Request"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 40,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "# Get all organizations\ncurl -H \"x-api-key: YOUR_API_KEY\" https://api.capgo.app/organization/\n\n# Get specific organization\ncurl -H \"x-api-key: YOUR_API_KEY\" https://api.capgo.app/organization/?orgId=org_123"
    },
    {
      "type": "heading",
      "location": {
        "line": 48,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 6
          },
          "text": "Example Response"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 50,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"data\": {\n    \"id\": \"org_123\",\n    \"name\": \"My Company\",\n    \"created_at\": \"2024-01-01T00:00:00Z\",\n    \"updated_at\": \"2024-01-01T00:00:00Z\",\n    \"logo\": \"https://example.com/logo.png\",\n    \"management_email\": \"admin@example.com\",\n    \"customer_id\": \"cus_123\"\n  }\n}"
    },
    {
      "type": "heading",
      "location": {
