        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 169,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 169,
            "column": 1
          },
          "text": "Delete an existing organization. Requires delete permission on the target organization, typically through the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 169,
            "column": 111
          },
          "text": "org_super_admin"
        },
        {
          "type": "text",
          "location": {
            "line": 169,
            "column": 128
          },
          "text": " role. This action is irreversible and will remove all associated apps, bundles (versions), and resources."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 171,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 171,
            "column": 1
          },
          "text": "The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 171,
            "column": 5
          },
          "text": "org.create"
        },
        {
          "type": "text",
          "location": {
            "line": 171,
            "column": 17
          },
          "text": " global permission does not allow deleting organizations."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 173,
        "column": 1
      },
      "depth": 4,
      "blocks": [
