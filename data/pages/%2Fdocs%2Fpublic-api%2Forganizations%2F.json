        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 125,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 125,
            "column": 1
          },
          "text": "Update an existing organization. Requires admin role on the target organization."
        }
      ]
    },
    {
