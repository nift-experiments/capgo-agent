        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 129,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "interface OrganizationUpdate {\n  orgId: string\n  logo?: string\n  name?: string\n  management_email?: string\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 138,
        "column": 1
      },
      "depth": 4,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 138,
            "column": 6
          },
          "text": "Example Request"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 140,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "curl -X PUT \\\n  -H \"x-api-key: YOUR_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"orgId\": \"org_123\",\n    \"name\": \"New Company Name\",\n    \"management_email\": \"newemail@example.com\"\n  }' \\\n  https://api.capgo.app/organization/"
    },
