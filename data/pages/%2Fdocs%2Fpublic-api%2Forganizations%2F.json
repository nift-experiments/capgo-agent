      "location": {
        "line": 91,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "curl -X POST \\\n  -H \"x-api-key: YOUR_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"name\": \"New Organization\",\n    \"email\": \"admin@example.com\",\n    \"website\": \"https://example.com\"\n  }' \\\n  https://api.capgo.app/organization/"
    },
