          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 60,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 60,
                    "column": 3
                  },
                  "text": "Full-screen presentation is best-effort. If the device or user settings block it, Android still shows the incoming-call notification."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 61,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 61,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 61,
                    "column": 3
                  },
                  "text": "Timeout handling is best-effort. The plugin tracks "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 61,
                    "column": 54
                  },
                  "text": "timeoutMs"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 61,
                    "column": 65
                  },
                  "text": " and emits "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 61,
                    "column": 76
                  },
                  "text": "callTimedOut"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 61,
                    "column": 90
                  },
                  "text": ", but your backend should still reconcile missed calls on its side."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 62,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 62,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 62,
                    "column": 3
                  },
                  "text": "Accept, decline, and end actions are emitted back through Capacitor listeners so your app can join or clean up the real call session."
                }
              ]
            }
          ]
        }
      ]
    },
    {
