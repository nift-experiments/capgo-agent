      "text": "import { IncomingCallKit } from '@capgo/capacitor-incoming-call-kit';\n\nawait IncomingCallKit.showIncomingCall({\n  callId: 'call-42',\n  callerName: 'Ada Lovelace',\n  appName: 'Capgo Phone',\n  timeoutMs: 45_000,\n  android: {\n    channelId: 'calls',\n    channelName: 'Incoming Calls',\n    showFullScreen: true,\n    isHighPriority: true,\n    accentColor: '#0F766E',\n  },\n});"
