                  "type": "text",
                  "location": {
                    "line": 26,
                    "column": 25
                  },
                  "text": " requests notification permission on Android 13 and later."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 27,
            "column": 1
          },
          "spread": false,
