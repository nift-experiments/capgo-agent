          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "How Android behavior works"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "On Android, the plugin posts a high-priority incoming-call notification and can raise a full-screen activity when the platform and user settings allow it."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "The plugin manifest already includes:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<uses-permission android:name=\"android.permission.POST_NOTIFICATIONS\" />\n<uses-permission android:name=\"android.permission.USE_FULL_SCREEN_INTENT\" />"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 13,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 1
          },
          "text": "After installation, "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 13,
            "column": 21
          },
          "text": "cap sync"
        },
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 31
          },
          "text": " is enough to merge that configuration into your host app."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 15,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 4
          },
          "text": "Runtime permissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 17,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 1
          },
          "text": "Call these methods during onboarding or before you rely on incoming-call presentation:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 19,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { IncomingCallKit } from '@capgo/capacitor-incoming-call-kit';\n\nawait IncomingCallKit.requestPermissions();\nawait IncomingCallKit.requestFullScreenIntentPermission();"
    },
    {
      "type": "list",
      "location": {
