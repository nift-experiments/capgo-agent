    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Listen for presses on the hardware volume buttons."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { VolumeButtons } from '@capgo/capacitor-volume-buttons';\n\nconst listener = await VolumeButtons.addListener(\n  'volumeButtonPressed',\n  (event) => {\n    console.log(`Volume ${event.direction} button pressed`);\n  }\n);\n\n// Remove listener when done\nawait listener.remove();"
    },
    {
      "type": "heading",
      "location": {
        "line": 49,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
