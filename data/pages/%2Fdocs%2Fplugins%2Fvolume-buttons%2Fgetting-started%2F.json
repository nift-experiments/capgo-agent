            "line": 49,
            "column": 5
          },
          "text": "removeAllListeners"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "Removes all listeners for this plugin."
        }
      ]
    },
    {
      "type": "code",
