      },
      "lang": "typescript",
      "meta": null,
      "text": "export enum TrackingAuthorizationStatus {\n  /** User has not yet received an authorization request */\n  notDetermined = 0,\n  /** User restricted, device is unable to provide authorization */\n  restricted = 1,\n  /** User denied authorization */\n  denied = 2,\n  /** User authorized access */\n  authorized = 3,\n}"
