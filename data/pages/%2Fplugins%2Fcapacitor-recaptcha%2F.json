      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 4
          },
          "text": "Generate A Token"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Recaptcha } from '@capgo/capacitor-recaptcha';\n\nconst { token } = await Recaptcha.execute({\n  action: 'login',\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Send the token to your backend and create a reCAPTCHA assessment before accepting the protected request."
        }
      ]
