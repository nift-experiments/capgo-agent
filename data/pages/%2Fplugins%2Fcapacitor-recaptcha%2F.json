          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 7,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-recaptcha\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 12,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 4
          },
          "text": "Configure"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 14,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\nimport '@capgo/capacitor-recaptcha';\n\nconst config: CapacitorConfig = {\n  plugins: {\n    Recaptcha: {\n      androidSiteKey: 'ANDROID_SITE_KEY',\n      iosSiteKey: 'IOS_SITE_KEY',\n      webSiteKey: 'WEB_SITE_KEY',\n      enterprise: true,\n    },\n  },\n};\n\nexport default config;"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 32,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 5
          },
          "text": "enterprise: false"
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 24
          },
          "text": " only when the Web implementation should load standard reCAPTCHA v3 instead of reCAPTCHA Enterprise. Android and iOS use Google's Enterprise/mobile SDK path and reject "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 192
          },
          "text": "enterprise: false"
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 211
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 34,
