{
  "version": 1,
  "route": "/docs/plugins/updater/self-hosted/auto-update/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/plugins/updater/self-hosted/auto-update.mdx",
  "sourceSha256": "2f1aa6fbb06ec89f4e01fbbff73394c67cdda9f06986844693f149ad6e5907d8",
  "metadata": {
    "title": "Auto Update",
    "description": "How to use the update endpoint of Capgo with the auto-update plugin in self-hosted mode, what they are used for and what to expect",
    "sidebar": {
      "order": 4
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "This documentation will explain how to run your auto-update server."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "Serve your bundle"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 7,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 1
          },
          "text": "Make sure your bundle is served over HTTPS, and the server has the right CORS headers to allow the app to download the update.\ne.g. "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 8,
            "column": 6
          },
          "text": "https://myserver.com/app/updates/updates.json"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 11,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 1
          },
          "text": "If you're unfamiliar with serving a bundle, we recommend you try Capgo Cloud or see an example here:"
        }
      ]
    },
    {
      "type": "component",
      "name": "LinkCard",
      "props": {
        "title": "Serving a Bundle",
        "href": "/docs/plugins/updater/self-hosted/handling-updates/"
      },
      "blocks": [],
      "location": {
        "line": 12,
        "column": 1
      }
    },
    {
      "type": "heading",
      "location": {
        "line": 17,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 4
          },
          "text": "Configuration"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "Add an "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 18,
            "column": 8
          },
          "text": "updateUrl"
        },
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 21
          },
          "text": " to your "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 18,
            "column": 30
          },
          "text": "capacitor.config.json"
        },
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 55
          },
          "text": "."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 20,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n\t\"plugins\": {\n\t\t\"CapacitorUpdater\": {\n\t\t\t\"updateUrl\": \"https://myserver.com/app/updates/updates.json\",\n\t\t}\n\t}\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 29,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 1
          },
          "text": ":::caution\nWhen you are pushing a self-hosted update, be mindful you cannot use \"HTTP\" endpoint as it's against the security policies of Android apps, for testing purposes you can "
        },
        {
          "type": "link",
          "location": {
            "line": 30,
            "column": 170
          },
          "url": "https://stackoverflow.com/questions/45940861/android-8-cleartext-http-traffic-not-permitted",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 30,
                "column": 171
              },
              "text": "allow it"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 273
          },
          "text": ".\n:::"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 33,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 4
          },
          "text": "Update API"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "The plugin will do a POST call to your API each time the app is open, with this body:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 37,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "interface AppInfos {\n    \"platform\": \"ios\" | \"android\" | \"electron\",\n    \"device_id\": \"UUID_of_device_unique_by_install\",\n    \"app_id\": \"APPID_FROM_CAPACITOR_CONFIG\",\n    \"custom_id\": \"your_custom_id_set_on_runtime\",\n    \"plugin_version\": \"PLUGIN_VERSION\",\n    \"version_build\": \"VERSION_NUMBER_FROM_NATIVE_CODE\",\n    \"version_code\": \"VERSION_CODE_FROM_NATIVE_CODE\",\n    \"version_name\": \"LAST_DOWNLOADER_VERSION\" | \"builtin\"\n    \"version_os\": \"VERSION_OF_SYSTEM_OS\",\n    \"is_emulator\": boolean,\n    \"is_prod\": boolean,\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 53,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 1
          },
          "text": "The server API should respond, in JSON, to the capacitor-updater plugin. With this data if an update is necessary:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 55,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n\"version\": \"1.2.3\",\n\"url\": \"https://myserver.com/app/updates/my-new-app-2.0.0.zip\",\n\"checksum\": \"sha256_checksum_of_bundle\"\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 63,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 63,
            "column": 1
          },
          "text": "In Auto-update mode the server should compare the versions and return the right one, if the URL key is present, the plugin starts the download process."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 65,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 1
          },
          "text": "If you add \"message\" and \"error\" key, the version will not be set, and the message will be displayed in logs instead."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 67,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 67,
            "column": 1
          },
          "text": "version"
        },
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 10
          },
          "text": " key should be in "
        },
        {
          "type": "link",
          "location": {
            "line": 67,
            "column": 28
          },
          "url": "/semver_tester/",
          "title": null,
          "blocks": [
            {
              "type": "inlineCode",
              "location": {
                "line": 67,
                "column": 29
              },
              "text": "semver"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 55
          },
          "text": " format."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "The zip should have "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 21
          },
          "text": "index.html"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 33
          },
          "text": " as a file at the root, or only one folder at the root with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 93
          },
          "text": "index.html"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 105
          },
          "text": " inside."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 72,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 1
          },
          "text": "You can use the command of the CLI to zip your bundle:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 74,
        "column": 1
      },
      "lang": "bash",
      "meta": "title=\"Create a bundle with your files to serve from your server\"",
      "text": "npx @capgo/cli bundle zip --path [/path/to/my/bundle]"
    },
    {
      "type": "heading",
      "location": {
        "line": 78,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 78,
            "column": 4
          },
          "text": "Generating Bundle Checksum"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 80,
        "column": 1
      },
      "blocks": [
        {
          "type": "strong",
          "location": {
            "line": 80,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 80,
                "column": 3
              },
              "text": "Important:"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 80,
            "column": 15
          },
          "text": " You must use the Capgo CLI to create your bundle zip file. The Capgo plugin requires a specific zip format and structure that is only guaranteed when using the official CLI tool. Standard zip utilities may create incompatible archives."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 82,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 1
          },
          "text": "To generate the checksum for your bundle, use the Capgo CLI zip command with the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 82,
            "column": 82
          },
          "text": "--json"
        },
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 90
          },
          "text": " flag:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 84,
        "column": 1
      },
      "lang": "bash",
      "meta": "title=\"Create bundle with checksum information\"",
      "text": "npx @capgo/cli bundle zip [appId] --json"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 88,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 88,
            "column": 1
          },
          "text": "This command will:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 89,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 89,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 89,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 89,
                    "column": 3
                  },
                  "text": "Create a properly formatted zip file compatible with the Capgo plugin"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 90,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 90,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 90,
                    "column": 3
                  },
                  "text": "Generate the SHA256 checksum for integrity verification"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 91,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 91,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 91,
                    "column": 3
                  },
                  "text": "Output bundle information in JSON format"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 93,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 93,
            "column": 1
          },
          "text": "Example output:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 94,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"version\": \"1.2.3\",\n  \"checksum\": \"a1b2c3d4e5f6789...\",\n  \"size\": 1234567\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 102,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 102,
            "column": 1
          },
          "text": "Use the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 102,
            "column": 9
          },
          "text": "checksum"
        },
        {
          "type": "text",
          "location": {
            "line": 102,
            "column": 19
          },
          "text": " value from this output in your API response to ensure the plugin can verify the bundle integrity before installation."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 104,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 104,
            "column": 4
          },
          "text": "Keep going from Auto Update"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 106,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 106,
            "column": 1
          },
          "text": "If you are using "
        },
        {
