      "lang": "typescript",
      "meta": null,
      "text": "import { ZebraDataWedge } from '@capgo/capacitor-zebra-datawedge';\n\nawait ZebraDataWedge.addListener('scan', (event) => {\n  console.log(event.data);\n  console.log(event.labelType);\n  console.log(event.source);\n});"
