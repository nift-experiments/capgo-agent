      "text": "import {\n  DataWedgeNotificationType,\n  ZebraNotification,\n} from '@capgo/capacitor-zebra-datawedge';\n\nawait ZebraNotification.registerForNotification({\n  notificationType: DataWedgeNotificationType.SCANNER_STATUS,\n  callback: (event) => {\n    console.log(event.scannerStatus);\n  },\n});"
