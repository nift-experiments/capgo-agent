        {
          "type": "inlineCode",
          "location": {
            "line": 13,
            "column": 45
          },
          "text": "Google Authenticator"
        },
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 67
          },
          "text": ". Other apps exist to serve a similar purpose, however I cannot cover the entire topic of 2FA in this guide."
        }
      ]
    },
