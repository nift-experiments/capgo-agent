  "metadata": {
    "title": "Two-factor authentication",
    "description": "Managing two-factor authentication to better protect your capgo account. This doc will help you to make your account the most secure possible, and prevent bad actor sending unwanted bundle to your user",
    "sidebar": {
      "order": 11
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "What is 2FA?"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "2FA is a security measure designed to prevent a bad actor from taking over your capgo account."
        },
        {
          "type": "break",
          "location": {
            "line": 4,
            "column": 95
          }
        },
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 1
          },
          "text": "It achieves it by requiring an additional code. This code is stored on your mobile phone or a hardware 2FA key. It changes every 30 seconds, making it impossible to guess"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 7,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 4
          },
          "text": "Requirements for this guide"
        }
      ]
    },
    {
