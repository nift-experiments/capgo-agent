      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-age-range` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-age-range\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AgeRange } from '@capgo/capacitor-age-range';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "requestAgeRange"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Request the user's age range."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "On Android: queries Google Play Age Signals API (no user prompt).\nOn iOS: presents the system DeclaredAgeRange dialog (requires iOS 26.2+)."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 38,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AgeRange } from '@capgo/capacitor-age-range';\n\nconst result = await AgeRange.requestAgeRange({ ageGates: [13, 16, 18] });\nif (result.status === 'SHARING') {\n  console.log('Age range:', result.ageLower, '-', result.ageUpper);\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 47,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 4
          },
          "text": "Type Reference"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 49,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 49,
            "column": 5
          },
          "text": "RequestAgeRangeOptions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 50,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 1
          },
          "text": "Options for the age range request."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 51,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface RequestAgeRangeOptions {\n  /**\n   * Age thresholds for the request.\n   *\n   * On iOS: these are passed to `requestAgeRange(ageGates:)` as the\n   * age boundaries presented in the system dialog. Common values: [13, 16, 18].\n   *\n   * On Android: this parameter is ignored (Play Age Signals returns\n   * predefined ranges: 0-12, 13-15, 16-17, 18+).\n   *\n   * @default [13, 16, 18]\n   * @since 8.0.0\n   */\n  ageGates?: number[];\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 69,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 5
          },
          "text": "AgeRangeResult"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 70,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 1
          },
          "text": "Result of the age range request."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 71,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface AgeRangeResult {\n  /**\n   * The outcome status of the age range request.\n   *\n   * @since 8.0.0\n   */\n  status: AgeRangeStatus;\n\n  /**\n   * Inclusive lower bound of the user's age range.\n   *\n   * Present when age data is available.\n   *\n   * @since 8.0.0\n   */\n  ageLower?: number;\n\n  /**\n   * Inclusive upper bound of the user's age range.\n   *\n   * May be absent if the user is in the highest age bracket (e.g. 18+).\n   *\n   * @since 8.0.0\n   */\n  ageUpper?: number;\n\n  /**\n   * How the age was declared/determined.\n   *\n   * On iOS: 'SELF_DECLARED' or 'GUARDIAN_DECLARED'.\n   * On Android: 'SUPERVISED' (guardian-managed) or 'VERIFIED' (Google-verified 18+).\n   *\n   * @since 8.0.0\n   */\n  declarationSource?: DeclarationSource;\n\n  /**\n   * Android-only. The user's Google Play verification status.\n   *\n   * @since 8.0.0\n   */\n  androidUserStatus?: AndroidUserStatus;\n\n  /**\n   * Android-only. Effective date for the most recent guardian-approved change.\n   *\n   * @since 8.0.0\n   */\n  mostRecentApprovalDate?: string;\n\n  /**\n   * Android-only. Install identifier for supervised installs in Google Play.\n   *\n   * @since 8.0.0\n   */\n  installId?: string;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 131,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 131,
            "column": 5
          },
          "text": "AgeRangeStatus"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 132,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 132,
            "column": 1
          },
          "text": "Top-level status of the age range request."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 133,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export type AgeRangeStatus =\n  /**\n   * The user shared their age range (iOS) or age signals are available (Android).\n   */\n  | 'SHARING'\n  /**\n   * The user declined to share their age range.\n   */\n  | 'DECLINED_SHARING'\n  /**\n   * The age range API is not available on this device/OS version.\n   */\n  | 'NOT_AVAILABLE'\n  /**\n   * An error occurred while requesting the age range.\n   */\n  | 'ERROR';"
    },
    {
      "type": "heading",
      "location": {
        "line": 153,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 153,
            "column": 5
          },
          "text": "DeclarationSource"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 154,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 154,
            "column": 1
          },
          "text": "How the age range was declared or determined."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 155,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export type DeclarationSource =\n  /** The user self-declared their age (iOS). */\n  | 'SELF_DECLARED'\n  /** A guardian declared the user's age (iOS Family Sharing or Android supervised). */\n  | 'GUARDIAN_DECLARED'\n  /** Google has verified the user is 18+ (Android only). */\n  | 'VERIFIED'\n  /** Source is unknown or not provided by the platform. */\n  | 'UNKNOWN';"
    },
    {
      "type": "heading",
      "location": {
        "line": 167,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 167,
            "column": 5
          },
          "text": "AndroidUserStatus"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 168,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 168,
            "column": 1
          },
          "text": "Android-specific Google Play user status values."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 169,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export type AndroidUserStatus =\n  | 'VERIFIED'\n  | 'SUPERVISED'\n  | 'SUPERVISED_APPROVAL_PENDING'\n  | 'SUPERVISED_APPROVAL_DENIED'\n  | 'UNKNOWN'\n  | 'EMPTY';"
    },
