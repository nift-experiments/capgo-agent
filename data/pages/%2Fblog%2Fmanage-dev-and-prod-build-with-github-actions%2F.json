          "type": "link",
          "location": {
            "line": 65,
            "column": 41
          },
          "url": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/creating-a-personal-access-token/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 65,
                "column": 42
              },
              "text": "PERSONAL ACCESS TOKEN"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 178
          },
          "text": " and add it to your GitHub "
        },
        {
          "type": "link",
          "location": {
            "line": 65,
            "column": 205
          },
          "url": "https://docs.github.com/en/actions/security-guides/encrypted-secrets",
          "title": "GitHub secrets",
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 65,
                "column": 206
              },
              "text": "secrets"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 301
          },
          "text": " as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 65,
            "column": 305
          },
          "text": "PERSONAL_ACCESS_TOKEN"
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 328
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 67,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 1
          },
          "text": "This is necessary to let the CI commit the changelog and the version bump."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "When you create the token, choose expiration as "
