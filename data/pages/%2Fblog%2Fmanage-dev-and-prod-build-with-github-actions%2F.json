    },
    {
      "type": "paragraph",
      "location": {
        "line": 83,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 83,
            "column": 1
          },
          "text": "Create a file at this path: "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 83,
            "column": 29
          },
          "text": ".github/workflows/build.yml"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 85,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 85,
            "column": 1
          },
          "text": "with this content:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 87,
        "column": 1
      },
      "lang": "toml",
      "meta": null,
      "text": "name: Build source code and send to Capgo\n\non:\n  push:\n    tags:\n      - '*'\n      \njobs:\n  deploy:\n    runs-on: ubuntu-latest\n    name: \"Build code and release\"\n    steps:\n      - name: Check out\n        uses: actions/checkout@v6\n      - name: Install dependencies\n        id: install_code\n        run: npm i\n      - name: Build\n        id: build_code\n        run: npm build\n        env:\n          MY_ENV_VAR: ${{ secrets.MY_ENV_VAR }}\n      - name: Create Release Alpha\n        if: \"contains(github.ref, '-alpha.')\"\n        id: create_release_prepro\n        run: npx @capgo/cli@latest bundle upload -a ${{ secrets.CAPGO_TOKEN }} -c development\n      - name: Create Release Production\n        if: \"!contains(github.ref, '-alpha.')\"\n        id: create_release_prod\n        run: npx @capgo/cli@latest bundle upload -a ${{ secrets.CAPGO_TOKEN }} -c production"
    },
