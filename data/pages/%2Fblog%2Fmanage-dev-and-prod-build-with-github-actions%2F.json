          "location": {
            "line": 69,
            "column": 49
          },
          "text": "never"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 56
          },
          "text": " and the scope as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 74
          },
          "text": "repo"
        },
        {
          "type": "text",
          "location": {
