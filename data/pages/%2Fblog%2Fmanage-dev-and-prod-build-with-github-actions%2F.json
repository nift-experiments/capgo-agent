            "column": 4
          },
          "text": "Preface"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 5,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 1
          },
          "text": "Be sure you have added your Capacitor app first to Capgo, this tutorial just focuses on the upload phase"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 7,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 4
          },
          "text": "Commit convention"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 9,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 9,
            "column": 1
          },
          "text": "First you need to start following the commit convention "
        },
        {
          "type": "link",
          "location": {
            "line": 9,
            "column": 57
          },
          "url": "https://www.conventionalcommits.org/en/v1.0.0/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 9,
                "column": 58
              },
              "text": "conventional commits"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 9,
            "column": 127
          },
          "text": "` this will help the tooling understand how to upgrade the version number, it's 5 min to learn it."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 11,
        "column": 1
      },
      "blocks": [
        {
          "type": "image",
          "location": {
            "line": 11,
            "column": 1
          },
          "url": "/conventional_commits.webp",
          "title": null,
          "alt": "Conventional commits"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 13,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 4
          },
          "text": "GitHub actions for tag"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 15,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 1
          },
          "text": "Then you need to create your first GitHub action to automatically build and create tags."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 17,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 1
          },
          "text": "Create a file at this path: "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 17,
            "column": 29
          },
          "text": ".github/workflows/bump_version.yml"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 19,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 1
          },
          "text": "with this content:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 21,
        "column": 1
      },
      "lang": "toml",
      "meta": null,
      "text": "name: Bump version\n\non:\n  push:\n    branches:\n      - main\n      - development\n\njobs:\n  bump-version:\n    if: \"!startsWith(github.event.head_commit.message, 'chore(release):')\"\n    runs-on: ubuntu-latest\n    name: \"Bump version and create changelog with standard version\"\n    steps:\n      - name: Check out\n        uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n          filter: blob:none\n          token: '${{ secrets.PERSONAL_ACCESS_TOKEN }}'\n      - name: Git config\n        run: |\n          git config --local user.name \"github-actions[bot]\"\n          git config --local user.email \"github-actions[bot]@users.noreply.github.com\"\n      - name: Create bump and changelog\n        if: github.ref == 'refs/heads/main'\n        run: npx capacitor-standard-version\n      - name: Create bump and changelog\n        if: github.ref != 'refs/heads/main'\n        run: npx capacitor-standard-version --prerelease alpha\n      - name: Push to origin\n        run: |\n          CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)\n          remote_repo=\"https://${GITHUB_ACTOR}:${{ secrets.PERSONAL_ACCESS_TOKEN }}@github.com/${GITHUB_REPOSITORY}.git\"\n          git pull $remote_repo $CURRENT_BRANCH\n          git push $remote_repo HEAD:$CURRENT_BRANCH --follow-tags --tags\n"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 61,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 1
          },
          "text": "This will release a tag for every commit in your main branch. And a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 69
          },
          "text": "alpha"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 76
          },
          "text": " release for "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 89
          },
          "text": "development"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 102
          },
          "text": ", and lastly a changelog entry for each commit in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 152
          },
          "text": "CHANGELOG.md"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 166
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 63,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 63,
            "column": 1
          },
          "text": "Don't worry if you don't have this file, it will be created for you."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 65,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 1
          },
          "text": "To make this work, you need to create a "
