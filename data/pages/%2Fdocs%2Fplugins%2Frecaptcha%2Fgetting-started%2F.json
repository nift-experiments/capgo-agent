  "sourceSha256": "099e41fd20e647842d6a0c3f359408cd302093fd0a865408ad70a70f6f20048f",
  "metadata": {
    "title": "Getting Started",
    "description": "Install @capgo/capacitor-recaptcha and generate reCAPTCHA tokens in a Capacitor app.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-recaptcha` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-recaptcha\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Configure Site Keys"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "Create platform keys in Google Cloud reCAPTCHA, then add them to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 66
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 87
          },
          "text": "."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 27,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\nimport '@capgo/capacitor-recaptcha';\n\nconst config: CapacitorConfig = {\n  appId: 'com.example.app',\n  appName: 'Example',\n  webDir: 'dist',\n  plugins: {\n    Recaptcha: {\n      androidSiteKey: 'ANDROID_SITE_KEY',\n      iosSiteKey: 'IOS_SITE_KEY',\n      webSiteKey: 'WEB_SITE_KEY',\n      enterprise: true,\n    },\n  },\n};\n\nexport default config;"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 48,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 48,
            "column": 1
          },
          "text": "androidSiteKey"
        },
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 17
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 48,
            "column": 19
          },
          "text": "iosSiteKey"
        },
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 31
          },
          "text": ", and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 48,
            "column": 37
          },
          "text": "webSiteKey"
        },
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 49
          },
          "text": " override the shared "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 48,
            "column": 70
          },
          "text": "siteKey"
        },
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 79
          },
          "text": ". You can also pass a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 48,
            "column": 101
          },
          "text": "siteKey"
        },
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 110
          },
          "text": " directly to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 48,
            "column": 123
          },
          "text": "load()"
        },
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 131
          },
          "text": " or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 48,
            "column": 135
          },
          "text": "execute()"
        },
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 146
          },
          "text": " when the key depends on your environment."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 50,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 4
          },
          "text": "Generate A Token"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 52,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { Recaptcha } from '@capgo/capacitor-recaptcha';\n\nconst { token } = await Recaptcha.execute({\n  action: 'login',\n});\n\nawait fetch('/api/recaptcha-assessment', {\n  method: 'POST',\n  headers: { 'content-type': 'application/json' },\n  body: JSON.stringify({ token, action: 'login' }),\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 66,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 66,
            "column": 1
          },
          "text": "execute()"
        },
        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 12
          },
          "text": " calls "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 66,
            "column": 19
          },
          "text": "load()"
        },
        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 27
          },
          "text": " automatically when the client is not ready, so an explicit preload step is optional."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 68,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 68,
            "column": 4
          },
          "text": "Web Standard reCAPTCHA v3"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 70,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 1
          },
          "text": "Set "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 70,
            "column": 5
          },
          "text": "enterprise: false"
        },
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 24
          },
          "text": " to load Google's standard Web reCAPTCHA v3 script."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 72,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const { token } = await Recaptcha.execute({\n  siteKey: 'WEB_V3_SITE_KEY',\n  enterprise: false,\n  action: 'signup',\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 80,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 80,
            "column": 1
          },
          "text": "On Android and iOS, Google's native mobile SDK path is Enterprise/mobile only. Passing "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 80,
            "column": 88
          },
          "text": "enterprise: false"
        },
        {
          "type": "text",
          "location": {
            "line": 80,
            "column": 107
          },
          "text": " on native platforms is rejected so a standard Web v3 key is not used accidentally."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 82,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 4
          },
          "text": "Migration Notes"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 84,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 1
          },
          "text": "The plugin accepts the old Cordova option aliases "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 84,
            "column": 51
          },
          "text": "sitekeyAndroid"
        },
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 67
          },
          "text": " and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 84,
            "column": 72
          },
          "text": "sitekeyWeb"
        },
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 84
          },
          "text": " in call options and Capacitor config. It also accepts "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 84,
            "column": 139
          },
          "text": "sitekeyIos"
        },
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 151
          },
          "text": " and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 84,
            "column": 156
          },
          "text": "sitekeyIOS"
        },
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 168
          },
          "text": " as iOS migration aliases. Prefer the Capacitor config names for new code."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 86,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 4
          },
          "text": "Keep going from Getting Started"
        }
      ]
    },
