        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "The plugin enables privacy protection automatically when the native implementation loads."
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 37,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 37,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 37,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 37,
                    "column": 3
                  },
                  "text": "On Android, secure mode blocks screenshots, screen recording capture, and the recent apps preview."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 38,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 38,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 38,
                    "column": 3
                  },
                  "text": "On iOS, the plugin hides your app during app switcher snapshot generation."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 39,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 39,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 39,
                    "column": 3
                  },
                  "text": "On Web, the plugin keeps an in-memory enabled flag only for API parity."
                }
              ]
            }
          ]
        }
      ]
    },
    {
