    {
      "type": "code",
      "location": {
        "line": 43,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { PrivacyScreen } from '@capgo/capacitor-privacy-screen';\n\nawait PrivacyScreen.disable();\n\n// Run a flow where screenshots or previews are temporarily allowed.\n\nawait PrivacyScreen.enable();\n\nconst { enabled } = await PrivacyScreen.isEnabled();\nconsole.log('Privacy screen enabled:', enabled);"
    },
    {
      "type": "heading",
