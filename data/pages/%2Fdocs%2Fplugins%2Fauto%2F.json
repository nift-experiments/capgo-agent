    "hero": {
      "tagline": "Send template-safe actions from your Capacitor app to the car display and receive driver intent events back in JavaScript.",
      "actions": [
        {
          "text": "Get started",
          "link": "/docs/plugins/auto/getting-started/",
          "icon": "right-arrow",
          "variant": "primary"
        },
