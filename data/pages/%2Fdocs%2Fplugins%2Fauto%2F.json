            "line": 4,
            "column": 1
          },
          "text": "@capgo/capacitor-auto"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 24
          },
          "text": " provides a small bridge for apps that need approved, template-based car surfaces on iOS and Android."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "It does not mirror a WebView to the car screen. The phone app sends a limited car template, the car host renders it with CarPlay or Android Auto UI, and row selections come back to the Capacitor app as events."
        }
      ]
    },
