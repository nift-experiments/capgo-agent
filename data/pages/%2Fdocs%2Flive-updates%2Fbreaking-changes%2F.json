                      "type": "text",
                      "location": {
                        "line": 84,
                        "column": 5
                      },
                      "text": "main branch"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 84,
                    "column": 18
                  },
                  "text": ": For updates to 2.x apps (v2 channel)\n:::"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 87,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 87,
            "column": 4
          },
          "text": "4. Upload Bundles to Respective Channels"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 89,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "# For 1.x updates: Build from v1-maintenance branch\ngit checkout v1-maintenance\n# Make your 1.x compatible changes here\nnpx @capgo/cli bundle upload --channel production\n\n# For 2.x updates: Build from main branch  \ngit checkout main\n# Make your 2.x changes here\nnpx @capgo/cli bundle upload --channel v2"
    },
    {
      "type": "heading",
      "location": {
        "line": 101,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 101,
            "column": 4
          },
          "text": "5. Enable Self-Assignment"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 103,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "# Allow apps to self-assign to v2 channel\nnpx @capgo/cli channel set v2 --self-assign"
    },
    {
      "type": "heading",
      "location": {
        "line": 108,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 108,
            "column": 4
          },
          "text": "6. Deploy to App Store"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 110,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 110,
            "column": 1
          },
          "text": "Build and deploy version 2.0.0 to the app store. All users who download this version (whether new users or existing users upgrading) will automatically use the v2 channel because it's configured in the app bundle."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 112,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 112,
            "column": 1
          },
          "text": ":::note\n"
        },
        {
          "type": "strong",
          "location": {
            "line": 113,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 113,
                "column": 3
              },
              "text": "No code changes needed!"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 113,
            "column": 28
          },
          "text": " Since "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 113,
            "column": 35
          },
          "text": "defaultChannel: 'v2'"
        },
        {
          "type": "text",
          "location": {
            "line": 113,
            "column": 57
          },
          "text": " is bundled with the app store version, all users downloading version 2.0.0 will automatically use the correct channel.\n:::"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 116,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 116,
            "column": 4
          },
          "text": "Scaling to Future Versions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 118,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 118,
            "column": 1
          },
          "text": "When you release version 3.0.0 with more breaking changes:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 120,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "# Create channel for version 3.x\nnpx @capgo/cli channel add v3"
    },
