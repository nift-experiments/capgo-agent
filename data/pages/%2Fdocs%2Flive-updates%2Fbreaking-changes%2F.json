        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 4
          },
          "text": "Strategy: Always Use defaultChannel for Major Versions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 14,
        "column": 1
      },
      "blocks": [
        {
          "type": "strong",
          "location": {
            "line": 14,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 14,
                "column": 3
              },
              "text": "Recommended approach:"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 26
          },
          "text": " Set a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 14,
            "column": 33
          },
          "text": "defaultChannel"
        },
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 49
          },
          "text": " for every major version. This ensures you can always push updates to specific user groups without relying on dynamic channel assignment."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 16,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "// Version 1.x releases\ndefaultChannel: 'v1'\n\n// Version 2.x releases  \ndefaultChannel: 'v2'\n\n// Version 3.x releases (future)\ndefaultChannel: 'v3'"
    },
    {
      "type": "paragraph",
