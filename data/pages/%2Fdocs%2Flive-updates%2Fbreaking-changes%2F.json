      "location": {
        "line": 125,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "// capacitor.config.ts for version 3.0.0\nconst config: CapacitorConfig = {\n  // ...\n  plugins: {\n    CapacitorUpdater: {\n      defaultChannel: 'v3' // Version 3.x users\n    }\n  }\n};"
    },
