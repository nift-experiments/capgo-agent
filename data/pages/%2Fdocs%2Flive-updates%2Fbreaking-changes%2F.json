              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 153,
                    "column": 4
                  },
                  "text": "Delete the v1-maintenance branch:"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 155,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "git branch -d v1-maintenance\ngit push origin --delete v1-maintenance"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 160,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 160,
            "column": 1
          },
          "text": ":::tip\nThis approach ensures users only receive updates compatible with their app version\n:::"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 164,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 164,
            "column": 1
          },
          "text": ":::warning\nAlways test updates thoroughly in each channel before deployment\n:::"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 168,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 168,
            "column": 1
          },
          "text": ":::note\nYou can safely delete the v2 channel in Capgo even if some users still have the channel override. They will automatically receive updates from the production channel instead.\n:::"
        }
      ]
    },
