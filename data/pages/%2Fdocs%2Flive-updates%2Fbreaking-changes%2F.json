        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 1
          },
          "text": ":::tip\n"
        },
        {
          "type": "strong",
          "location": {
            "line": 28,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 28,
                "column": 3
              },
              "text": "Benefits of this approach:"
            }
          ]
        }
      ]
    },
