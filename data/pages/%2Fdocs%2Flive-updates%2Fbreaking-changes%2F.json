          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 83,
                "column": 3
              },
              "blocks": [
                {
                  "type": "strong",
                  "location": {
                    "line": 83,
                    "column": 3
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "location": {
                        "line": 83,
                        "column": 5
                      },
                      "text": "v1-maintenance branch"
                    }
                  ]
                },
                {
                  "type": "text",
                  "location": {
                    "line": 83,
                    "column": 28
                  },
                  "text": ": For updates to 1.x apps (production channel)"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 84,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
