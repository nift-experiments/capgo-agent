        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 4
          },
          "text": "1. Create Channel for New Version"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 37,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "# Create channel for version 2.x\nnpx @capgo/cli channel add v2"
    },
    {
      "type": "heading",
      "location": {
        "line": 42,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 4
          },
          "text": "2. Update Capacitor Config for Version 2.0.0"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Update your Capacitor config before building version 2.0.0 for the app store:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 46,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "// capacitor.config.ts\nimport { CapacitorConfig } from '@capacitor/cli';\n\nconst config: CapacitorConfig = {\n  appId: 'com.example.app',\n  appName: 'Example App',\n  plugins: {\n    CapacitorUpdater: {\n      // ... other options\n      defaultChannel: 'v2' // All 2.0.0 users will use v2 channel\n    }\n  }\n};\n\nexport default config;"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 64,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 1
          },
          "text": ":::note\n"
        },
        {
          "type": "strong",
          "location": {
            "line": 65,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 65,
                "column": 3
              },
              "text": "For version 1.x:"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 21
          },
          "text": " If you didn't set a "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 65,
            "column": 42
          },
          "text": "defaultChannel"
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 58
          },
          "text": " initially, version 1.x users are on the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 65,
            "column": 99
          },
          "text": "production"
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 111
          },
          "text": " channel. For future major versions, always set a specific channel like "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 65,
            "column": 183
          },
          "text": "v3"
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 187
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 65,
            "column": 189
          },
          "text": "v4"
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 193
          },
          "text": ", etc.\n:::"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 68,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 68,
            "column": 4
          },
          "text": "3. Manage Separate Code Branches"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 70,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 1
          },
          "text": "Create separate git branches to maintain compatibility between app versions:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 72,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "# Create and maintain a branch for version 1.x updates\ngit checkout -b v1-maintenance\ngit push origin v1-maintenance\n\n# Your main branch continues with version 2.x development\ngit checkout main"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 81,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 81,
            "column": 1
          },
          "text": ":::warning\n"
        },
        {
          "type": "strong",
          "location": {
            "line": 82,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 82,
                "column": 3
              },
              "text": "Critical:"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 14
          },
          "text": " Never push JavaScript bundles to older apps that expect native code/APIs they don't have. Always build updates from the appropriate branch:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 83,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
