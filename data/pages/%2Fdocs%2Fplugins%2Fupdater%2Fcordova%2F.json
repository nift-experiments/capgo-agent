{
  "version": 1,
  "route": "/docs/plugins/updater/cordova/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/plugins/updater/cordova.md",
  "sourceSha256": "914f07de5a1ee7fd8f6bcc60fb5caccb428e097025d4df27e83d510ac95d06b1",
  "metadata": {
    "title": "Cordova / Electron",
    "description": "Capgo live updates for Cordova and Electron apps with dedicated client plugins and the same cloud backend as Capacitor.",
    "sidebar": {
      "order": 8,
      "label": "Cordova / Electron"
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "import { LinkCard, CardGrid, Aside } from '@astrojs/starlight/components';"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Capacitor is the primary path documented in this updater section, but Capgo also ships dedicated clients for "
        },
        {
          "type": "strong",
          "location": {
            "line": 4,
            "column": 110
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 4,
                "column": 112
              },
              "text": "Cordova"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 121
          },
          "text": " and "
        },
        {
          "type": "strong",
          "location": {
            "line": 4,
            "column": 126
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 4,
                "column": 128
              },
              "text": "Electron"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 138
          },
          "text": ". Each plugin uses the same Capgo Cloud backend, channels, bundle signing, and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 217
          },
          "text": "@capgo/cli"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 229
          },
          "text": " upload flow."
        }
      ]
    },
    {
      "type": "html",
      "location": {
        "line": 6,
        "column": 1
      },
      "text": "<Aside type=\"tip\">\n  You can keep the same Capgo app ID and channels when you support multiple runtimes. Only the client plugin package changes per stack.\n</Aside>"
    },
    {
      "type": "heading",
      "location": {
        "line": 10,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 4
          },
          "text": "Cordova"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "@capgo/cordova-updater"
        },
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 25
          },
          "text": " mirrors the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 12,
            "column": 38
          },
          "text": "@capgo/capacitor-updater"
        },
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 64
          },
          "text": " JavaScript API for Cordova iOS 7+ and Android 13+. Install it with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 12,
            "column": 132
          },
          "text": "cordova plugin add"
        },
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 152
          },
          "text": ", call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 12,
            "column": 159
          },
          "text": "cordova.plugins.Updater.notifyAppReady()"
        },
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 201
          },
          "text": " after "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 12,
            "column": 208
          },
          "text": "deviceready"
        },
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 221
          },
          "text": ", and upload bundles the same way you would for Capacitor."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 14,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 1
          },
          "text": "Do not combine the plugin with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 14,
            "column": 32
          },
          "text": "cordova-plugin-ionic-webview"
        },
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 62
          },
          "text": " — it bypasses Cordova scheme handlers and downloaded bundles will not apply."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "html",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "<LinkCard\ntitle=\"Cordova updater docs\"\nhref=\"/docs/plugins/cordova-updater/getting-started/\"\ndescription=\"Install plugin variables, configure iOS/Android WebView requirements, and ship your first bundle.\"\n/>"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 22,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 4
          },
          "text": "Electron"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 24,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 24,
            "column": 1
          },
          "text": "@capgo/electron-updater"
        },
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 26
          },
          "text": " brings the same live-update model to desktop apps. Initialize the updater in the Electron main process, expose the preload bridge, call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 24,
            "column": 163
          },
          "text": "notifyAppReady()"
        },
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 181
          },
          "text": " from the renderer, and manage releases from the same Capgo dashboard you use for mobile."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 26,
        "column": 1
      },
      "blocks": [
        {
          "type": "html",
          "location": {
            "line": 26,
            "column": 1
          },
          "text": "<LinkCard\ntitle=\"Electron updater docs\"\nhref=\"/docs/plugins/electron-updater/getting-started/\"\ndescription=\"Wire main process, preload, and renderer setup for OTA on desktop.\"\n/>"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 32,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 32,
