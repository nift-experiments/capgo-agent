      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "startActivityAsync"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Starts an Android activity for the given action."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { IntentLauncher, ActivityAction } from '@capgo/capacitor-intent-launcher';\n\n// Open location settings\nconst result = await IntentLauncher.startActivityAsync({\n  action: ActivityAction.LOCATION_SOURCE_SETTINGS\n});\n\n// Open a specific app settings\nconst result = await IntentLauncher.startActivityAsync({\n  action: ActivityAction.APPLICATION_DETAILS_SETTINGS,\n  data: 'package:com.example.app'\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 50,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 50,
            "column": 5
          },
          "text": "openIOSSettings"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 52,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 1
          },
          "text": "Opens iOS settings screen."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 54,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 1
          },
          "text": "Note: The only officially supported option by Apple is "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 54,
            "column": 56
          },
          "text": "App"
        },
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 61
          },
          "text": " which opens your app's settings page.\nOther options may work but are not guaranteed and could break in future iOS versions or cause App Store rejection."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 57,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 1
          },
          "text": "Also note that the iOS Simulator will sometimes only open the Settings app,\ninstead of the specified option."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 60,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { IntentLauncher, IOSSettings } from '@capgo/capacitor-intent-launcher';\n\n// Open app settings (recommended - officially supported by Apple)\nawait IntentLauncher.openIOSSettings({ option: IOSSettings.App });\n\n// Open WiFi settings (may not work in all iOS versions)\nawait IntentLauncher.openIOSSettings({ option: IOSSettings.WiFi });"
    },
    {
      "type": "heading",
      "location": {
        "line": 70,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 70,
            "column": 5
          },
          "text": "openApplication"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 72,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 1
          },
          "text": "Opens an application by its package name."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 74,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { IntentLauncher } from '@capgo/capacitor-intent-launcher';\n\n// Open Gmail app\nawait IntentLauncher.openApplication({ packageName: 'com.google.android.gm' });"
    },
