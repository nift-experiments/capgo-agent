        "line": 85,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { IntentLauncher } from '@capgo/capacitor-intent-launcher';\n\nconst { icon } = await IntentLauncher.getApplicationIconAsync({\n  packageName: 'com.google.android.gm'\n});\nif (icon) {\n  const img = document.createElement('img');\n  img.src = icon;\n}"
