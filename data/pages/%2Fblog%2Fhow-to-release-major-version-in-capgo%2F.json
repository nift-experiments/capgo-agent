            "column": 5
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 42,
                "column": 5
              },
              "text": "Will be used by Capgo to compare to Native version and find Major upgrade"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 3
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 3
          },
          "text": "in JavaScript, the var is set on your project here "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 44,
            "column": 54
          },
          "text": "package.json"
        },
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 68
          },
          "text": " under the key "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 44,
            "column": 83
          },
          "text": "version"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 45,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 4
          },
          "text": "Example"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 47,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 1
          },
          "text": "Your Ionic app is currently released with the version "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 47,
            "column": 55
          },
          "text": "1.2.3"
        },
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 62
          },
          "text": " with Capacitor 3"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 49,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 1
          },
          "text": "You are doing the upgrade to capacitor 4."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "You need to upgrade your version number to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 51,
            "column": 44
          },
          "text": "2.2.3"
        },
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 51
          },
          "text": ", then all your packages include Capgo with notice this big change."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 53,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 1
          },
          "text": "When you release this version to Capgo and the App Store."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 55,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 1
          },
          "text": "All next live update in Capgo "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 55,
            "column": 31
          },
          "text": "2.2.4"
        },
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 38
          },
          "text": " will never be sent to user with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 55,
            "column": 71
          },
          "text": "1.2.3"
        },
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 78
          },
          "text": " version. Only with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 55,
            "column": 98
          },
          "text": "2.2.3"
        },
        {
          "type": "text",
          "location": {
            "line": 55,
            "column": 105
          },
          "text": " version."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 57,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 57,
            "column": 1
          },
          "text": "If you follow this pattern, no need to worry more, all is well handled."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 60,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 60,
            "column": 4
          },
          "text": "If I don't follow this"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 62,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 1
          },
          "text": "In this case, that means you have to send your new app with Capacitor 4 to Apple and Google, but don't to Capgo."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 64,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 1
          },
          "text": "Then you have to wait 100% of your users, have the app or at least 90%, it will take months, probably."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 66,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 1
          },
          "text": "While during this time you cannot send any update with Capgo, since old user cannot get the new version.\nYou don't have a way to select only some users to receive the update."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 69,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 4
          },
          "text": "Keep going from How to release major version in capgo"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 71,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 71,
            "column": 1
          },
          "text": "If you are using "
