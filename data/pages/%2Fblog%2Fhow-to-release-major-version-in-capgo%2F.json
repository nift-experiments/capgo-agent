          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 36,
                "column": 5
              },
              "text": "Will be uses by Capgo to compare to JavaScript version and find Major upgrade"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 38,
        "column": 3
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 3
          },
          "text": "in Android, the var is set on your project here "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 38,
            "column": 51
          },
          "text": "android/app/build.gradle"
        },
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 77
          },
          "text": " under the key "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 38,
            "column": 92
          },
          "text": "defaultConfig.versionName"
        }
      ]
    },
    {
      "type": "blockquote",
      "location": {
        "line": 39,
        "column": 3
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 39,
