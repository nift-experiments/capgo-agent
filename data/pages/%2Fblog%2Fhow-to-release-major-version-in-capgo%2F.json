              },
              "text": "capacitor.config.json"
            },
            {
              "type": "text",
              "location": {
                "line": 33,
                "column": 85
              },
              "text": " file "
            },
            {
              "type": "link",
              "location": {
                "line": 33,
                "column": 91
              },
