                        "column": 4
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 61,
                            "column": 6
                          },
                          "text": "Track connection state"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 63,
                    "column": 4
                  },
                  "lang": "ts",
                  "meta": null,
                  "text": "const status = await Auto.isAvailable();\nconsole.log(status.available, status.connected, status.platform);\n\nawait Auto.addListener('connectionChanged', (event) => {\n  console.log('Car connected:', event.connected, event.platform);\n});"
                }
              ]
            }
