                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 28,
                            "column": 6
                          },
                          "text": "Set the root car template"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 30,
                    "column": 4
                  },
                  "lang": "ts",
                  "meta": null,
                  "text": "import { Auto } from '@capgo/capacitor-auto';\n\nawait Auto.setRootTemplate({\n  title: 'Garage',\n  sections: [\n    {\n      header: 'Doors',\n      items: [\n        {\n          id: 'open-main-door',\n          title: 'Open main door',\n          subtitle: 'Tap to send the action to the phone app',\n          payload: { doorId: 'main' },\n        },\n      ],\n    },\n  ],\n});"
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 51,
                "column": 1
              },
              "spread": true,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 51,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "strong",
                      "location": {
                        "line": 51,
                        "column": 4
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 51,
                            "column": 6
                          },
                          "text": "Handle car actions"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 53,
                    "column": 4
                  },
                  "lang": "ts",
                  "meta": null,
                  "text": "await Auto.addListener('carAction', async (event) => {\n  if (event.id === 'open-main-door') {\n    await openGarageDoor(event.payload?.doorId);\n  }\n});"
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 61,
                "column": 1
              },
              "spread": true,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 61,
                    "column": 4
                  },
                  "blocks": [
