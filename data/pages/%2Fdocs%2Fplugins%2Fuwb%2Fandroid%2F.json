    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorUwb } from '@capgo/capacitor-uwb';\n\nconst controller = await CapacitorUwb.startControllerSession();\n\n// Share controller.rangingParameters and controller.localAddress out-of-band"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "If you already know the controlee address, pass it when starting the controller session:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await CapacitorUwb.startControllerSession({\n  peerAddress: '<controlee-address-base64>',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 41,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 41,
            "column": 4
          },
          "text": "Controlee flow"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 43,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await CapacitorUwb.startControleeSession({\n  rangingParameters: {\n    sessionId: 12345,\n    sessionKeyInfo: '<base64>',\n    complexChannel: { channel: 9, preambleIndex: 10 },\n    peerAddress: '<controller-address-base64>',\n  },\n});"
    },
