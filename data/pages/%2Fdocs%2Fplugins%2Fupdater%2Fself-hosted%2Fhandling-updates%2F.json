            {
              "type": "text",
              "location": {
                "line": 72,
                "column": 7
              },
              "text": "encrypted bundles"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 72,
            "column": 26
          },
          "text": ", you also need to include the session key:"
        }
