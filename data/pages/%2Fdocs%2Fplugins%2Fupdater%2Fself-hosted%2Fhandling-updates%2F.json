      "lang": "json",
      "meta": null,
      "text": "{\n  \"version\": \"1.0.2\",\n  \"url\": \"https://apiurl.com/mybuild_102.zip\",\n  \"checksum\": \"sha256_checksum_of_bundle\"\n}"
    },
