{
  "version": 1,
  "route": "/docs/plugins/social-login/integrations/keycloak/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/plugins/social-login/integrations/keycloak.mdx",
  "sourceSha256": "100da53d2c3af8e12e8c04011fe44e19a20dcc59db809ac59945dae79d189673",
  "metadata": {
    "title": "Keycloak",
    "description": "Integrate Keycloak with @capgo/capacitor-social-login using OIDC discovery or direct OAuth2 endpoint configuration.",
    "sidebar": {
      "order": 6
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Overview"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Keycloak works through the built-in generic OAuth2 provider. You do not need a new native provider for Keycloak. Configure your Keycloak client as an OpenID Connect client and use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 181
          },
          "text": "provider: 'oauth2'"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 201
          },
          "text": " with a stable "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 216
          },
          "text": "providerId"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 228
          },
          "text": ", such as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 238
          },
          "text": "keycloak"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 248
          },
          "text": "."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "Keycloak client settings"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "In your Keycloak realm, create or open the client used by your Capacitor app:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 10,
        "column": 1
      },
      "ordered": true,
      "start": 1,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 10,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 10,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 10,
                    "column": 4
                  },
                  "text": "Use the authorization code flow."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 11,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 11,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 11,
                    "column": 4
                  },
                  "text": "Keep PKCE enabled in the app config."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 12,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 12,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 12,
                    "column": 4
                  },
                  "text": "Register every redirect URI that your app uses, for example "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 12,
                    "column": 64
                  },
                  "text": "myapp://oauth/keycloak"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 12,
                    "column": 88
                  },
                  "text": " for mobile and an HTTPS callback URL for production web."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 13,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 13,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 13,
                    "column": 4
                  },
                  "text": "Use scopes such as "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 13,
                    "column": 23
                  },
                  "text": "openid profile email"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 13,
                    "column": 45
                  },
                  "text": ". Add "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 13,
                    "column": 51
                  },
                  "text": "offline_access"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 13,
                    "column": 67
                  },
                  "text": " only when your realm and client are configured to issue refresh tokens."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 15,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 1
          },
          "text": "The exact issuer URL is deployment-specific. Current Keycloak deployments commonly publish realm metadata at "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 15,
            "column": 110
          },
          "text": "https://keycloak.example.com/realms/my-realm/.well-known/openid-configuration"
        },
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 189
          },
          "text": ", but some deployments include an extra base path. Use the issuer URL shown by your realm's OpenID Endpoint Configuration."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 17,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 4
          },
          "text": "OIDC discovery example"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 19,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 1
          },
          "text": "Prefer "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 19,
            "column": 8
          },
          "text": "issuerUrl"
        },
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 19
          },
          "text": " so the plugin can discover the authorization, token, and logout endpoints from the realm metadata:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 21,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { SocialLogin } from '@capgo/capacitor-social-login';\n\nconst keycloakIssuer = 'https://keycloak.example.com/realms/my-realm';\n\nawait SocialLogin.initialize({\n  oauth2: {\n    keycloak: {\n      appId: 'your-keycloak-client-id',\n      issuerUrl: keycloakIssuer,\n      redirectUrl: 'myapp://oauth/keycloak',\n      scope: 'openid profile email',\n      pkceEnabled: true,\n      resourceUrl: `${keycloakIssuer}/protocol/openid-connect/userinfo`,\n    },\n  },\n});\n\nconst result = await SocialLogin.login({\n  provider: 'oauth2',\n  options: {\n    providerId: 'keycloak',\n  },\n});\n\nconsole.log(result.result.idToken);\nconsole.log(result.result.accessToken?.token);\nconsole.log(result.result.resourceData);"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "For refresh tokens, request "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 51,
            "column": 29
          },
          "text": "offline_access"
        },
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 45
          },
          "text": " only if your Keycloak realm and client allow refresh tokens for this app:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 53,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await SocialLogin.initialize({\n  oauth2: {\n    keycloak: {\n      appId: 'your-keycloak-client-id',\n      issuerUrl: keycloakIssuer,\n      redirectUrl: 'myapp://oauth/keycloak',\n      scope: 'openid profile email offline_access',\n      pkceEnabled: true,\n    },\n  },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 67,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 4
          },
          "text": "Manual endpoint fallback"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "If OIDC discovery is blocked or your deployment does not expose metadata to the app, configure the endpoints directly. Keep the base URL exactly as your Keycloak deployment publishes it:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 71,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const keycloakRealmUrl = 'https://keycloak.example.com/realms/my-realm';\n\nawait SocialLogin.initialize({\n  oauth2: {\n    keycloak: {\n      appId: 'your-keycloak-client-id',\n      authorizationBaseUrl: `${keycloakRealmUrl}/protocol/openid-connect/auth`,\n      accessTokenEndpoint: `${keycloakRealmUrl}/protocol/openid-connect/token`,\n      redirectUrl: 'myapp://oauth/keycloak',\n      scope: 'openid profile email',\n      pkceEnabled: true,\n      resourceUrl: `${keycloakRealmUrl}/protocol/openid-connect/userinfo`,\n      logoutUrl: `${keycloakRealmUrl}/protocol/openid-connect/logout`,\n    },\n  },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 90,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 90,
            "column": 4
          },
          "text": "Auth Connect compatibility"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 92,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 92,
            "column": 1
          },
          "text": "Keycloak is not one of the Auth Connect preset provider IDs. If you already use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 92,
            "column": 81
          },
          "text": "SocialLoginAuthConnect"
        },
        {
          "type": "text",
          "location": {
            "line": 92,
            "column": 105
          },
          "text": ", you can still initialize the generic "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 92,
            "column": 144
          },
          "text": "oauth2"
        },
        {
          "type": "text",
          "location": {
            "line": 92,
            "column": 152
          },
          "text": " provider and log in with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 92,
            "column": 178
          },
          "text": "provider: 'oauth2'"
        },
        {
          "type": "text",
          "location": {
            "line": 92,
            "column": 198
          },
          "text": " plus "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 92,
            "column": 204
          },
          "text": "providerId: 'keycloak'"
        },
        {
          "type": "text",
          "location": {
            "line": 92,
            "column": 228
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 94,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 94,
            "column": 1
          },
          "text": "See the "
        },
        {
          "type": "link",
          "location": {
            "line": 94,
            "column": 9
          },
          "url": "https://www.keycloak.org/securing-apps/oidc-layers",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 94,
                "column": 10
              },
              "text": "Keycloak OpenID Connect endpoint reference"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 94,
            "column": 105
          },
          "text": " for discovery and endpoint paths."
        }
      ]
    },
