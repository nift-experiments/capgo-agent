    "title": "Getting Started",
    "description": "Install @capgo/capacitor-audio-session and start using its current Capacitor API.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
