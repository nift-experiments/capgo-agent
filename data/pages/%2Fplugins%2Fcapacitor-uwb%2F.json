        "line": 43,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const controller = await CapacitorUwb.startControllerSession();\n\nawait CapacitorUwb.startControleeSession({\n  rangingParameters: controller.rangingParameters,\n});"
