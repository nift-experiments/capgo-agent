      "location": {
        "line": 33,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { discoveryToken } = await CapacitorUwb.getDiscoveryToken();\n\nawait CapacitorUwb.startPeerSession({\n  peerDiscoveryToken: '<peer-token-base64>',\n});"
    },
