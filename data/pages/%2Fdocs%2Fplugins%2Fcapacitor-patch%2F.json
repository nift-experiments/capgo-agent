            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 9,
                "column": 3
              },
              "text": "This package has no native runtime API. It works through Capacitor hooks, npm package files, and generated native project files."
            }
          ]
        }
      ],
      "location": {
        "line": 8,
        "column": 1
