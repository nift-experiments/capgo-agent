          },
          "text": "@capgo/capacitor-patch"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 25
          },
          "text": " is a hook-only Capacitor package that applies selected patch files whenever Capacitor runs "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 117
          },
          "text": "sync"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 123
          },
          "text": " or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 127
          },
          "text": "update"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 135
          },
          "text": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "It is built for fixes that are useful before they land in an official Capacitor release. The bundled catalog tracks external upstream Capacitor PRs mirrored by Capacitor+ "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 6,
            "column": 172
          },
          "text": "sync/upstream-pr-*"
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 192
          },
          "text": " branches."
        }
      ]
    },
    {
      "type": "component",
