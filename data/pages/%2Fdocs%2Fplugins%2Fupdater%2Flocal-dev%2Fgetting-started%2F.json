        "line": 17,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 1
          },
          "text": "Next should see something like this:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "js",
      "meta": null,
      "text": "Started supabase local development setup.\n\n         API URL: http://localhost:54321\n     GraphQL URL: http://localhost:54321/graphql/v1\n          DB URL: postgresql://postgres:postgres@localhost:54322/postgres\n      Studio URL: http://localhost:54323\n    Inbucket URL: http://localhost:54324\n      JWT secret: [truncated]\n        anon key: supa_key_anon\nservice_role key: supa_key_admin"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 31,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 1
          },
          "text": "Next open "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 11
          },
          "text": "configs.json"
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 25
          },
          "text": " and set the following values:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 32,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"base_domain\": {\n    \"prod\": \"console.capgo.app\",\n    \"development\": \"development.console.capgo.app\",\n    \"local\": \"localhost:3332\"\n  },\n  \"supa_anon\": {\n    \"prod\": \"supa_key_anon\",\n    \"development\": \"supa_key_anon\",\n    \"local\": \"supa_key_anon\"\n  },\n  \"supa_url\": {\n    \"prod\": \"http://localhost:54321\",\n    \"development\": \"http://localhost:54321\",\n    \"local\": \"http://localhost:54321\"\n  }\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 52,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 1
          },
          "text": "where "
        },
