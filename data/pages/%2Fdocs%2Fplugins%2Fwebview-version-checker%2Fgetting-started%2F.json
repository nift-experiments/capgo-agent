      "text": "import type { CapacitorConfig } from '@capacitor/cli';\n\nconst config: CapacitorConfig = {\n  plugins: {\n    WebviewVersionChecker: {\n      minimumDeviceSharePercent: 3,\n      versionShareByMajor: {\n        '137': 58.2,\n        '136': 21.3,\n        '135': 4.6,\n        '134': 2.1,\n      },\n      autoPromptOnOutdated: true,\n    },\n  },\n};\n\nexport default config;"
