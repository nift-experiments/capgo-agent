      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 60,
            "column": 1
          },
          "text": "Use the built-in masking helpers to keep sensitive content out of Session Replay:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 62,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await ContentsquarePlugin.excludeURLForReplay('/checkout/');\n\nawait ContentsquarePlugin.setCapturedElementsSelector('[data-cs-capture]');\n\nawait ContentsquarePlugin.setPIISelectors({\n  PIISelectors: ['input[type=\"email\"]', '.credit-card'],\n  Attributes: [{ selector: 'input[name=\"email\"]', attrName: 'value' }],\n});"
    },
