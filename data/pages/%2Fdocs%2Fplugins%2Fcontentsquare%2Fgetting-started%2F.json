              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 54,
                    "column": 3
                  },
                  "text": "Use stable names instead of user-specific values."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 55,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 55,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 55,
                    "column": 3
                  },
                  "text": "Keep the same naming conventions across iOS and Android navigation stacks."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 56,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 56,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 56,
                    "column": 3
                  },
                  "text": "When the app returns to foreground, resend the screen name and any critical dynamic variables."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
