        "line": 33,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { ContentsquarePlugin, CurrencyCode } from '@capgo/capacitor-contentsquare';\n\nawait ContentsquarePlugin.optIn();\n\nawait ContentsquarePlugin.sendScreenName('Home');\n\nawait ContentsquarePlugin.sendTransaction({\n  transactionValue: 29.99,\n  transactionCurrency: CurrencyCode.EUR,\n  transactionId: 'order-123',\n});\n\nawait ContentsquarePlugin.sendDynamicVar({\n  dynVarKey: 'store',\n  dynVarValue: 'rome',\n});"
    },
