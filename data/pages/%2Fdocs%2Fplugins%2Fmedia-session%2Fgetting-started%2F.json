        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 1
          },
          "text": "Registers a handler for a media session action."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 55,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { MediaSession } from '@capgo/capacitor-media-session';\n\nawait MediaSession.setActionHandler({ action: 'play' }, (details) => {\n  console.log(details);\n});"
    },
    {
      "type": "heading",
