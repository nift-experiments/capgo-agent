    },
    {
      "type": "paragraph",
      "location": {
        "line": 43,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 43,
            "column": 1
          },
          "text": "Updates the playback state of the media session."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 45,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { MediaSession } from '@capgo/capacitor-media-session';\n\nawait MediaSession.setPlaybackState({ playbackState: 'none' });"
    },
    {
      "type": "heading",
      "location": {
        "line": 51,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
