      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 1
          },
          "text": "Adding the target alone is not sufficient. The native app or plugin must call ActivityKit's request, update, and end APIs. The Widget Extension must contain SwiftUI code that can decode and render the same "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 28,
            "column": 207
          },
          "text": "ActivityAttributes"
        },
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 227
          },
          "text": " and content state used by those calls. Include shared ActivityKit models in both the main app and Widget Extension targets. The Xcode-generated Live Activity template does not automatically render the JSON layouts passed to this plugin; the extension also needs a compatible native layout renderer."
        }
      ]
    },
