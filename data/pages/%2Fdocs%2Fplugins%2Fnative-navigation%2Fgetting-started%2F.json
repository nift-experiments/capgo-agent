                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 28,
                            "column": 6
                          },
                          "text": "Configure native chrome"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 30,
                    "column": 4
                  },
                  "lang": "ts",
                  "meta": null,
                  "text": "import { NativeNavigation } from '@capgo/capacitor-native-navigation';\n\nawait NativeNavigation.configure({\n  contentInsetMode: 'css',\n  animationDuration: 360,\n  colors: {\n    tint: '#0f172a',\n    inactiveTint: '#64748b',\n  },\n});"
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 43,
                "column": 1
              },
              "spread": true,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 43,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "strong",
                      "location": {
                        "line": 43,
                        "column": 4
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 43,
                            "column": 6
                          },
                          "text": "Render the native navbar"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 45,
                    "column": 4
                  },
                  "lang": "ts",
                  "meta": null,
                  "text": "await NativeNavigation.setNavbar({\n  title: 'Home',\n  subtitle: 'Native chrome',\n  transparent: true,\n  backButton: { visible: false },\n  rightItems: [\n    {\n      id: 'compose',\n      title: 'Compose',\n      icon: {\n        svg: '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z\"/></svg>',\n      },\n    },\n  ],\n});"
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 63,
                "column": 1
              },
              "spread": true,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 63,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "strong",
                      "location": {
                        "line": 63,
                        "column": 4
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 63,
                            "column": 6
                          },
                          "text": "Render the native tabbar"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 65,
                    "column": 4
                  },
                  "lang": "ts",
                  "meta": null,
                  "text": "await NativeNavigation.setTabbar({\n  selectedId: 'home',\n  labelVisibilityMode: 'selected',\n  icons: true,\n  colors: {\n    dynamic: true,\n    tint: '#0f172a',\n    inactiveTint: '#64748b',\n  },\n  tabs: [\n    {\n      id: 'home',\n      title: 'Home',\n      icon: {\n        svg: '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 10.5 12 3l9 7.5\"/><path d=\"M5 10v10h14V10\"/></svg>',\n      },\n    },\n    {\n      id: 'settings',\n      title: 'Settings',\n      badge: '2',\n      icon: {\n        svg: '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3\"/></svg>',\n      },\n    },\n  ],\n});"
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 95,
                "column": 1
              },
              "spread": true,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 95,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "strong",
                      "location": {
                        "line": 95,
                        "column": 4
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 95,
                            "column": 6
                          },
                          "text": "Handle native intent events"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 97,
                    "column": 4
                  },
                  "lang": "ts",
                  "meta": null,
                  "text": "await NativeNavigation.addListener('navbarBack', () => {\n  router.back();\n});\n\nawait NativeNavigation.addListener('navbarItemTap', ({ id }) => {\n  if (id === 'compose') router.push('/compose');\n});\n\nawait NativeNavigation.addListener('tabSelect', ({ id }) => {\n  router.push(`/${id}`);\n});"
                }
              ]
            }
          ]
        }
      ],
      "location": {
