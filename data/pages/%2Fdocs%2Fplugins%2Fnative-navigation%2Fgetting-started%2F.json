                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 303,
                    "column": 3
                  },
                  "text": "iOS renders "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 303,
                    "column": 15
                  },
                  "text": "UINavigationBar"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 303,
                    "column": 32
                  },
                  "text": " and "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 303,
                    "column": 37
                  },
                  "text": "UITabBar"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 303,
                    "column": 47
                  },
                  "text": "; iOS 26+ uses the system Liquid Glass bar behavior."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 304,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 304,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 304,
                    "column": 3
                  },
                  "text": "Android renders an AppCompat toolbar and Material bottom navigation."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 305,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 305,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 305,
                    "column": 3
                  },
                  "text": "Web fallback does not draw native bars. It mirrors events and inset variables for browser development."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 306,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 306,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 306,
                    "column": 3
                  },
                  "text": "The plugin keeps one full-screen Capacitor WebView. Native owns the frame, bars, safe-area reporting, and transition shell."
                }
              ]
            }
          ]
        }
      ]
    },
