        "column": 1
      }
    },
    {
      "type": "heading",
      "location": {
        "line": 112,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 112,
            "column": 4
          },
          "text": "Transition flow"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 114,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 114,
            "column": 1
          },
          "text": "Native transitions are a transaction around your normal JavaScript route change:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 116,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const transition = await NativeNavigation.beginTransition({\n  direction: 'forward',\n});\n\nrouter.push('/detail');\nawait router.ready?.();\n\nawait NativeNavigation.setNavbar({\n  title: 'Detail',\n  backButton: { visible: true, title: 'Back' },\n});\n\nawait NativeNavigation.finishTransition({\n  id: transition.id,\n  direction: 'forward',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 135,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 135,
            "column": 4
          },
          "text": "Zoom transition"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 137,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 137,
            "column": 1
          },
          "text": "Use the zoom helpers for card-to-detail or media-preview flows. Pass the tapped element before your router changes content, then finish after the detail page is ready."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 139,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { beginZoomTransition, finishZoomTransition } from '@capgo/capacitor-native-navigation';\n\nconst card = document.querySelector('[data-message-card]');\nif (card) {\n  const transition = await beginZoomTransition(card, { cornerRadius: 18 });\n\n  router.push('/message/42');\n  await router.ready?.();\n\n  await NativeNavigation.setNavbar({\n    title: 'Message',\n    backButton: { visible: true, title: 'Inbox' },\n  });\n\n  await finishZoomTransition(undefined, {\n    id: transition.id,\n    cornerRadius: 18,\n  });\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 161,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 161,
            "column": 4
          },
          "text": "Use with @capgo/capacitor-transitions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 163,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 163,
            "column": 1
          },
          "text": "Use Native Navigation for the native navbar, tabbar, safe-area insets, and native intent events. Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 163,
            "column": 102
          },
          "text": "@capgo/capacitor-transitions"
        },
        {
          "type": "text",
          "location": {
            "line": 163,
            "column": 132
          },
          "text": " for the WebView page stack underneath the native chrome."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 165,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-native-navigation @capgo/capacitor-transitions\nnpx cap sync"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 170,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 170,
            "column": 1
          },
          "text": "Initialize both packages once:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 172,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { NativeNavigation } from '@capgo/capacitor-native-navigation';\nimport '@capgo/capacitor-transitions';\nimport { initTransitions, setupRouterOutlet, setDirection } from '@capgo/capacitor-transitions/react';\n\ninitTransitions({ platform: 'auto' });\n\nconst outlet = document.querySelector('cap-router-outlet');\nif (outlet) {\n  setupRouterOutlet(outlet, { platform: 'auto', swipeGesture: 'auto' });\n}\n\nawait NativeNavigation.configure({\n  contentInsetMode: 'css',\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 189,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 189,
            "column": 1
          },
          "text": "Keep "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 189,
            "column": 6
          },
          "text": "cap-router-outlet"
        },
        {
          "type": "text",
          "location": {
            "line": 189,
            "column": 25
          },
          "text": " focused on pages, not duplicate web bars:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 191,
        "column": 1
      },
      "lang": "html",
      "meta": null,
      "text": "<cap-router-outlet platform=\"auto\" swipe-gesture=\"auto\">\n  <cap-page>\n    <cap-content slot=\"content\" fullscreen>\n      <main class=\"page\">Inbox content</main>\n    </cap-content>\n  </cap-page>\n</cap-router-outlet>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 201,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 201,
            "column": 1
          },
          "text": "Drive both packages from the same router actions:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 203,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "async function openMessage(id: string) {\n  setDirection('forward');\n  await router.push(`/messages/${id}`);\n  await NativeNavigation.setNavbar({\n    title: 'Message',\n    backButton: { visible: true, title: 'Inbox' },\n  });\n}\n\nawait NativeNavigation.addListener('navbarBack', () => {\n  setDirection('back');\n  router.back();\n});\n\nawait NativeNavigation.addListener('tabSelect', ({ id }) => {\n  setDirection('root');\n  router.push(`/${id}`);\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 224,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 224,
            "column": 1
          },
          "text": "Pick one animation layer per route change. Let "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 224,
            "column": 48
          },
          "text": "@capgo/capacitor-transitions"
        },
        {
          "type": "text",
          "location": {
            "line": 224,
            "column": 78
          },
          "text": " animate normal page pushes, and use Native Navigation's zoom helpers only for shared-element or zoom routes."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 226,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 226,
            "column": 4
          },
          "text": "CSS insets"
        }
      ]
    },
    {
      "type": "paragraph",
