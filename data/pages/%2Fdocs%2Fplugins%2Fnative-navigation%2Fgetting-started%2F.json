          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 298,
                "column": 3
              },
              "text": "The web components are optional. React, Vue, Angular, Svelte, Solid, and vanilla apps can all use the imperative API directly."
            }
          ]
        }
      ],
      "location": {
        "line": 297,
        "column": 1
