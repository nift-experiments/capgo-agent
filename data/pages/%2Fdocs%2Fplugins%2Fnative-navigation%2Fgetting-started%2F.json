          },
          "text": "contentInsetMode: 'css'"
        },
        {
          "type": "text",
          "location": {
            "line": 228,
            "column": 31
          },
          "text": ", the plugin writes native bar dimensions to "
        },
        {
          "type": "inlineCode",
