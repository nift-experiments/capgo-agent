          },
          "text": "Icon descriptors"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 248,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 248,
            "column": 1
          },
          "text": "Icons must be serializable because native UI renders them. You can use cross-platform SVG, platform-specific SVG, SF Symbols, bundled iOS images, Android drawable resources, or bundled Android images."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 250,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const icon = {\n  svg: '<svg viewBox=\"0 0 24 24\"><path d=\"M3 10.5 12 3l9 7.5\"/></svg>',\n  width: 24,\n  height: 24,\n  template: true,\n  src: 'fallback_asset_name',\n  ios: {\n    svg: '<svg viewBox=\"0 0 24 24\"><path d=\"M3 10.5 12 3l9 7.5\"/></svg>',\n    sfSymbol: 'house.fill',\n    image: 'BundledAssetName',\n  },\n  android: {\n    svg: '<svg viewBox=\"0 0 24 24\"><path d=\"M3 10.5 12 3l9 7.5\"/></svg>',\n    resource: 'ic_menu_view',\n    image: 'bundled_drawable_name',\n  },\n};"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 270,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 270,
            "column": 1
          },
          "text": "Inline SVG supports the icon-focused subset used by common icon sets such as Lucide and Feather: "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 270,
            "column": 98
          },
          "text": "path"
        },
        {
          "type": "text",
          "location": {
            "line": 270,
            "column": 104
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 270,
            "column": 106
          },
          "text": "line"
        },
        {
          "type": "text",
          "location": {
            "line": 270,
            "column": 112
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 270,
            "column": 114
          },
          "text": "polyline"
        },
        {
          "type": "text",
          "location": {
            "line": 270,
            "column": 124
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 270,
            "column": 126
          },
          "text": "polygon"
        },
        {
          "type": "text",
          "location": {
            "line": 270,
            "column": 135
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 270,
            "column": 137
          },
          "text": "circle"
        },
        {
          "type": "text",
          "location": {
            "line": 270,
            "column": 145
          },
          "text": ", and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 270,
            "column": 151
          },
          "text": "rect"
        },
        {
          "type": "text",
          "location": {
            "line": 270,
            "column": 157
          },
          "text": ". SVG icons are rendered as template images by default, so native tint colors can recolor them."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 272,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 272,
            "column": 4
          },
          "text": "Optional web components"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 274,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 274,
            "column": 1
          },
          "text": "The package can register custom elements for framework-agnostic declarative setup:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 276,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { defineNativeNavigationElements } from '@capgo/capacitor-native-navigation';\n\ndefineNativeNavigationElements();"
    },
    {
      "type": "code",
      "location": {
        "line": 282,
        "column": 1
      },
      "lang": "html",
      "meta": null,
      "text": "<cap-native-navigation-provider enabled=\"true\" content-inset-mode=\"css\"></cap-native-navigation-provider>\n\n<cap-native-navbar\n  title=\"Home\"\n  transparent\n  right-items='[{\"id\":\"compose\",\"title\":\"Compose\",\"icon\":{\"svg\":\"<svg viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 20h9\\\"/></svg>\"}}]'\n></cap-native-navbar>\n\n<cap-native-tabbar\n  selected-id=\"home\"\n  tabs='[{\"id\":\"home\",\"title\":\"Home\",\"icon\":{\"ios\":{\"sfSymbol\":\"house.fill\"}}}]'\n></cap-native-tabbar>"
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {
        "type": "note"
      },
      "blocks": [
        {
          "type": "paragraph",
