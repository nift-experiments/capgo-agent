  "metadata": {
    "title": "Getting Started",
    "description": "Install @capgo/capacitor-android-sms-retriever and use Android SMS Retriever in a Capacitor app.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-android-sms-retriever` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-android-sms-retriever\nbunx cap sync android"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AndroidSmsRetriever } from '@capgo/capacitor-android-sms-retriever';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "Android Requirements"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 31,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 1
          },
          "text": "SMS Retriever requires Google Play services on the Android device. The plugin does not request "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 96
          },
          "text": "READ_SMS"
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 106
          },
          "text": " or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 110
          },
          "text": "RECEIVE_SMS"
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 123
          },
          "text": " permissions."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Your verification SMS must include the app hash returned by "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 33,
            "column": 61
          },
          "text": "getHashString()"
        },
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 78
          },
          "text": ". Generate the hash for the signing key used to distribute the app. Debug, release, and Play App Signing builds can have different hashes."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 35,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 4
          },
          "text": "Listen For A Verification SMS"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 37,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { AndroidSmsRetriever } from '@capgo/capacitor-android-sms-retriever';\n\nconst received = await AndroidSmsRetriever.addListener('smsReceived', ({ message }) => {\n  const code = message.match(/\\b\\d{6}\\b/)?.[0];\n  console.log('Verification code:', code);\n});\n\nconst timeout = await AndroidSmsRetriever.addListener('smsRetrieverTimeout', () => {\n  console.log('SMS Retriever timed out');\n});\n\nconst errors = await AndroidSmsRetriever.addListener('smsRetrieverError', ({ message }) => {\n  console.error('SMS Retriever error:', message);\n});\n\nawait AndroidSmsRetriever.startWatch();\n\n// Remove listeners when the verification flow is done.\nawait received.remove();\nawait timeout.remove();\nawait errors.remove();"
    },
    {
      "type": "heading",
      "location": {
        "line": 61,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 4
          },
          "text": "Stop Watching"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 63,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await AndroidSmsRetriever.stopWatch();"
    },
    {
      "type": "heading",
      "location": {
        "line": 67,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 4
          },
          "text": "Get The App Hash"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 69,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { hash } = await AndroidSmsRetriever.getHashString();\nconsole.log(hash);"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 74,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 74,
            "column": 1
          },
          "text": "Use this hash at the end of the verification SMS sent by your backend."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 76,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 76,
            "column": 4
          },
          "text": "Request A Phone Number Hint"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 78,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { phoneNumber } = await AndroidSmsRetriever.getPhoneNumber();\nconsole.log(phoneNumber);"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 83,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 83,
            "column": 1
          },
          "text": "Android shows the native Phone Number Hint UI and returns the phone number selected by the user."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 85,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 85,
            "column": 4
          },
          "text": "Example SMS"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 87,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "<#> 123456 is your verification code.\nFA+9qCX9VSu"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 92,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 92,
            "column": 1
          },
          "text": "Replace the final line with the hash for your app signing key."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 94,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 94,
            "column": 4
          },
          "text": "Keep going from Getting Started"
        }
      ]
    },
