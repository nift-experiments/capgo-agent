      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-home-indicator` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-home-indicator\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { HomeIndicator } from '@capgo/capacitor-home-indicator';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "hide"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Hide the home indicator at the bottom of the screen."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "This visually hides the iOS home indicator bar, providing a more immersive\nfull-screen experience. Users can still swipe up to access home, but the\nindicator will not be visible until they start the gesture."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 39,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 39,
            "column": 1
          },
          "text": "iOS only. Has no effect on Android or web."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 41,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { HomeIndicator } from '@capgo/capacitor-home-indicator';\n\nawait HomeIndicator.hide();"
    },
    {
      "type": "heading",
      "location": {
        "line": 47,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 47,
            "column": 5
          },
          "text": "show"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 49,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 1
          },
          "text": "Show the home indicator at the bottom of the screen."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "This restores the default iOS home indicator visibility, making it\nalways visible to the user. This is the default behavior."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 54,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 54,
            "column": 1
          },
          "text": "iOS only. Has no effect on Android or web."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 56,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { HomeIndicator } from '@capgo/capacitor-home-indicator';\n\nawait HomeIndicator.show();"
    },
    {
      "type": "heading",
      "location": {
        "line": 62,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 62,
            "column": 5
          },
          "text": "isHidden"
        }
      ]
    },
