        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 1
          },
          "text": "Check whether the home indicator is currently hidden."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 66,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 66,
            "column": 1
          },
          "text": "Returns the current visibility state of the iOS home indicator."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 68,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { HomeIndicator } from '@capgo/capacitor-home-indicator';\n\nconst { hidden } = await HomeIndicator.isHidden();\nif (hidden) {\n  console.log('Home indicator is hidden');\n} else {\n  console.log('Home indicator is visible');\n}"
