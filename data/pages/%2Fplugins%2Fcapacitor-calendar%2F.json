      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 1,
            "column": 3
          },
          "text": "Using @capgo/capacitor-calendar"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 3,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 3,
            "column": 5
          },
          "text": "@capgo/capacitor-calendar"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 32
          },
          "text": " package lets a Capacitor app manage native calendar events on iOS and Android. It can request calendar permissions, create and edit events, open native calendar UI, list calendars and events, and manage Reminders on iOS."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 5,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 7,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-calendar\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 12,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 4
          },
          "text": "Configure Native Permissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 14,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 1
          },
          "text": "On iOS, add the usage descriptions your app needs to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 14,
            "column": 54
          },
          "text": "ios/App/App/Info.plist"
        },
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 78
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 16,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>NSCalendarsUsageDescription</key>\n<string>This app needs calendar access.</string>\n<key>NSCalendarsWriteOnlyAccessUsageDescription</key>\n<string>This app needs permission to add calendar events.</string>\n<key>NSCalendarsFullAccessUsageDescription</key>\n<string>This app needs permission to read and manage calendar events.</string>\n<key>NSRemindersFullAccessUsageDescription</key>\n<string>This app needs permission to read and manage reminders.</string>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 27,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 1
          },
          "text": "On Android, add the calendar permissions your app needs to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 27,
            "column": 60
          },
          "text": "android/app/src/main/AndroidManifest.xml"
        },
        {
          "type": "text",
          "location": {
            "line": 27,
            "column": 102
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 29,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<uses-permission android:name=\"android.permission.READ_CALENDAR\" />\n<uses-permission android:name=\"android.permission.WRITE_CALENDAR\" />"
    },
    {
      "type": "heading",
      "location": {
        "line": 34,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 4
          },
          "text": "Request Permission"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorCalendar } from '@capgo/capacitor-calendar';\n\nconst permission = await CapacitorCalendar.requestFullCalendarAccess();\n\nif (permission.result !== 'granted') {\n  throw new Error('Calendar permission was not granted');\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 46,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 4
          },
          "text": "Create An Event"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 48,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const startDate = Date.now() + 60 * 60 * 1000;\nconst endDate = startDate + 60 * 60 * 1000;\n\nconst { id } = await CapacitorCalendar.createEvent({\n  title: 'Product review',\n  location: 'Capgo',\n  startDate,\n  endDate,\n  description: 'Created with @capgo/capacitor-calendar',\n});\n\nconsole.log('Created event', id);"
    },
    {
      "type": "heading",
      "location": {
        "line": 63,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 63,
            "column": 4
          },
          "text": "Open The Native Event UI"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 65,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await CapacitorCalendar.createEventWithPrompt({\n  title: 'Planning session',\n  location: 'Office',\n  startDate: Date.now() + 24 * 60 * 60 * 1000,\n  endDate: Date.now() + 25 * 60 * 60 * 1000,\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 74,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 74,
            "column": 4
          },
          "text": "List Events"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 76,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const now = Date.now();\n\nconst { result: events } = await CapacitorCalendar.listEventsInRange({\n  from: now,\n  to: now + 7 * 24 * 60 * 60 * 1000,\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 85,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 85,
            "column": 4
          },
          "text": "iOS Reminders"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 87,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const permission = await CapacitorCalendar.requestFullRemindersAccess();\n\nif (permission.result === 'granted') {\n  await CapacitorCalendar.createReminder({\n    title: 'Send launch notes',\n    dueDate: Date.now() + 2 * 24 * 60 * 60 * 1000,\n  });\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 98,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 98,
            "column": 1
          },
          "text": "Reminders are only available on iOS."
        }
      ]
