                  "type": "text",
                  "location": {
                    "line": 28,
                    "column": 26
                  },
                  "text": "Request permission to access compass data. On iOS, this requests location permission (required for heading data). On Android, this resolves immediately as no permissions are required."
                }
              ]
            }
