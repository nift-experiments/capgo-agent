              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 24,
                    "column": 25
                  },
                  "text": "Get the current compass heading in degrees. On iOS, the heading is updated in the background, and the latest value is returned. On Android, the heading is calculated when the method is called using accelerometer and magnetometer sensors. Not implemented on Web."
                }
              ]
            }
          ]
        },
        {
