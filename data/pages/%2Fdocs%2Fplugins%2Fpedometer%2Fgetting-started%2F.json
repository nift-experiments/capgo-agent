      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface GetMeasurementOptions {\n  /**\n   * The start time for the measurement query (milliseconds since epoch).\n   *\n   * Required on **iOS**.\n   *\n   * @since 0.0.1\n   */\n  start?: number;\n\n  /**\n   * The end time for the measurement query (milliseconds since epoch).\n   *\n   * Required on **iOS**.\n   *\n   * @since 0.0.1\n   */\n  end?: number;\n}"
    },
