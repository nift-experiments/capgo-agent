        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 4
          },
          "text": "Main WebView Referer Patch"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 21,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 21,
            "column": 1
          },
          "text": "Enable "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 21,
            "column": 8
          },
          "text": "patchRefererHeader"
        },
        {
          "type": "text",
          "location": {
            "line": 21,
            "column": 28
          },
          "text": " when YouTube content works in the plugin but fails from Capacitor's main WebView because YouTube expects a browser-like "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 21,
            "column": 149
          },
          "text": "Referer"
        },
        {
          "type": "text",
          "location": {
            "line": 21,
            "column": 158
          },
          "text": " header."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 23,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"plugins\": {\n    \"YoutubePlayer\": {\n      \"patchRefererHeader\": true,\n      \"refererHeader\": \"https://www.youtube.com\"\n    }\n  }\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 34,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 1
          },
          "text": "The patch only applies to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 34,
            "column": 27
          },
          "text": "youtube.com"
        },
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 40
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 34,
            "column": 42
          },
          "text": "youtube-nocookie.com"
        },
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 64
          },
          "text": ", and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 34,
            "column": 70
          },
          "text": "youtu.be"
        },
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 80
          },
          "text": " requests. Existing request-level "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 34,
            "column": 114
          },
          "text": "Referer"
        },
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 123
          },
          "text": " headers are preserved, and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 34,
            "column": 151
          },
          "text": "refererHeader"
        },
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 166
          },
          "text": " defaults to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 34,
            "column": 179
          },
          "text": "https://www.youtube.com"
        },
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 204
          },
          "text": " when omitted."
        }
      ]
    },
