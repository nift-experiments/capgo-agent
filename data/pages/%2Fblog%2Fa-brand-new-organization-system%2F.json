              },
              "text": "WcaleNieWolny"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 74
          },
          "text": " - Capgo's lead software engineer."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "Over the past 8 months, I have been developing the "
        },
        {
          "type": "link",
          "location": {
            "line": 6,
            "column": 52
          },
          "url": "/docs/webapp/organization-system/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 6,
                "column": 53
              },
              "text": "organization system"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 108
          },
          "text": ", and as of April 14, I am happy to announce that the system has been completed 🎉 🎊"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "Finally, after 8 months, every single part of Capgo is accessible to org members. This includes:"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 9,
        "column": 2
      },
      "ordered": false,
      "start": null,
      "spread": false,
