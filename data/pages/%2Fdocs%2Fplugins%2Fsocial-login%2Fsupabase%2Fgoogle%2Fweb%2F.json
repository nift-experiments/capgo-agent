      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 4
          },
          "text": "Critical: Redirect Handling"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 30,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 1
          },
          "text": ":::warning[Critical: Redirect Handling]\nWhen using Google login on web, you "
        },
        {
          "type": "strong",
          "location": {
            "line": 31,
            "column": 37
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 31,
                "column": 39
              },
              "text": "MUST"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 45
          },
          "text": " call any function from the plugin when the redirect happens to initialize the plugin so it can handle the redirect and close the popup window. You can call either "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 209
          },
          "text": "isLoggedIn()"
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 223
          },
          "text": " OR "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 227
          },
          "text": "initialize()"
        },
        {
          "type": "text",
          "location": {
            "line": 31,
            "column": 241
          },
          "text": " - both will trigger the redirect handling."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "This is essential for the OAuth popup flow to work correctly.\n:::"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 36,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 5
          },
          "text": "Implementation Example"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 38,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 1
          },
          "text": "Add this to your component that handles Google Sign-In:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 40,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { useEffect } from 'react';\nimport { SocialLogin } from '@capgo/capacitor-social-login';\n\nfunction SupabasePage() {\n  // Check Google login status on mount to invoke redirect handling\n  // This doesn't serve any functional purpose in the UI but ensures\n  // that any pending OAuth redirects are properly processed\n  useEffect(() => {\n    const checkGoogleLoginStatus = async () => {\n      try {\n        await SocialLogin.isLoggedIn({ provider: 'google' });\n        // We don't use the result, this is just to trigger redirect handling\n      } catch (error) {\n        // Ignore errors - this is just for redirect handling\n        console.log('Google login status check completed (redirect handling)');\n      }\n    };\n    \n    checkGoogleLoginStatus();\n  }, []);\n\n  // ... rest of your component\n}"
    },
