              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 90,
                    "column": 3
                  },
                  "text": "rawNonce"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 90,
                    "column": 13
                  },
                  "text": " goes to Supabase's "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 90,
                    "column": 33
                  },
                  "text": "signInWithIdToken()"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 91,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 91,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 91,
                    "column": 3
                  },
                  "text": "Supabase makes a hash of "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 91,
                    "column": 28
                  },
                  "text": "rawNonce"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 91,
                    "column": 38
                  },
                  "text": " and compares it with the "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 91,
                    "column": 64
                  },
                  "text": "nonceDigest"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 91,
                    "column": 77
                  },
                  "text": " which is included in the ID token from Google Sign-In"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 92,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 92,
                "column": 3
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 92,
                    "column": 3
                  },
                  "text": "nonceDigest"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 92,
                    "column": 16
                  },
                  "text": " (SHA-256 hash, hex-encoded) goes to the "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 92,
                    "column": 57
                  },
                  "text": "nonce"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 92,
                    "column": 64
                  },
                  "text": " parameter in Google Sign-In APIs"
                }
