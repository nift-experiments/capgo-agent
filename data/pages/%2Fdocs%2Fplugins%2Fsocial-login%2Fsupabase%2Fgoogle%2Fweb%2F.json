      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 1
          },
          "text": "When using Google login on web, you "
        },
        {
          "type": "strong",
          "location": {
            "line": 82,
            "column": 37
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 82,
                "column": 39
              },
              "text": "MUST"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 45
          },
          "text": " call any function from the plugin when the redirect happens to initialize the plugin so it can handle the redirect and close the popup window. You can call either "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 82,
            "column": 209
          },
          "text": "isLoggedIn()"
        },
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 223
          },
          "text": " OR "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 82,
            "column": 227
          },
          "text": "initialize()"
        },
        {
          "type": "text",
          "location": {
            "line": 82,
            "column": 241
          },
          "text": " - both will trigger the redirect handling."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 84,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 1
          },
          "text": "This is essential for the OAuth popup flow to work correctly. Without this, the popup window won't close after authentication."
        }
      ]
    },
