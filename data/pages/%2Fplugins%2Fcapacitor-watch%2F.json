                  },
                  "text": "updateApplicationContext"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 15,
                    "column": 29
                  },
                  "text": " - Update the application context shared with the watch. Only the latest context is kept - this overwrites any previous context. Use this for syncing app state that the watch needs to display."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
