        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "Apple Watch communication plugin for Capacitor. Provides bidirectional messaging between iPhone and Apple Watch using WatchConnectivity."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 5,
        "column": 1
      },
