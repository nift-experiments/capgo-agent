      "lang": "typescript",
      "meta": null,
      "text": "import { RichNotifications } from '@capgo/capacitor-rich-notifications';\n\nawait RichNotifications.schedule({\n  notification: {\n    id: 'reminder-1',\n    title: 'Reminder',\n    body: 'Your appointment starts soon',\n    channelId: 'messages',\n  },\n  trigger: { type: 'timestamp', timestamp: Date.now() + 60_000 },\n});"
