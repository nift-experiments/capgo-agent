                  "location": {
                    "line": 5,
                    "column": 5
                  },
                  "text": "Why Capacitor+?"
                }
              ]
            },
            {
              "type": "text",
              "location": {
                "line": 5,
                "column": 22
              },
              "text": " Great PRs sit unmerged in the official Capacitor repository for months. Capacitor+ actively merges these community contributions so you don't have to wait."
            }
          ]
        }
      ],
      "location": {
        "line": 4,
        "column": 1
