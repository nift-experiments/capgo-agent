          },
          "text": "Limits"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 30,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 1
          },
          "text": "WorkManager is designed for deferrable work. It does not guarantee exact timing and should not be used for alarms, countdowns, or user-visible deadlines."
        }
      ]
    },
