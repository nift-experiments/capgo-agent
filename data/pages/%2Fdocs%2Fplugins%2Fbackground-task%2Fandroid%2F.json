      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 22,
            "column": 1
          },
          "text": "Use the test trigger to execute registered callbacks immediately during development:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 24,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await BackgroundTask.triggerTaskWorkerForTestingAsync();"
    },
    {
      "type": "heading",
      "location": {
