        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "Android scheduling is backed by WorkManager. No extra app manifest entry is required for normal periodic background fetch work."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "Scheduling"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await BackgroundTask.registerTaskAsync('sync-offline-data', {\n  minimumInterval: 30,\n  requiresNetwork: true,\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 13,
