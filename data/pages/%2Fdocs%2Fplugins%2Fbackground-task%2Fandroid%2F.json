          "type": "text",
          "location": {
            "line": 13,
            "column": 4
          },
          "text": "Behavior"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 15,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 15,
