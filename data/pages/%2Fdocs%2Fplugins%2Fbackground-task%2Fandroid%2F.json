          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 15,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 15,
                    "column": 3
                  },
                  "text": "Android enforces a 15 minute minimum interval for periodic work."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 16,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 16,
                "column": 3
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 16,
                    "column": 3
                  },
                  "text": "requiresNetwork: true"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 16,
                    "column": 26
                  },
                  "text": " maps to WorkManager's connected network constraint."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 17,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 17,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 17,
                    "column": 3
                  },
                  "text": "Each task name is scheduled as unique periodic work, so registering the same task name updates the existing schedule."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 18,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 18,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 18,
                    "column": 3
                  },
                  "text": "Task runs are recorded natively before being delivered to JavaScript, so pending events can be drained when the WebView is ready."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 20,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 20,
            "column": 4
          },
          "text": "Testing"
