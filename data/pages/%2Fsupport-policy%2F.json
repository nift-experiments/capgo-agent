  "sourceSha256": "cc7bf1095d5eb6fd8a1ef4546b4563bc0a8759557af14e5baa46fea1fe7772d7",
  "metadata": {
    "title": "Capgo | Capgo Customer Support",
    "description": "Capgo customer support policy and response times. Learn about our support channels, SLA, and how we help you succeed with live updates."
  },
  "blocks": [
    {
      "type": "text",
      "text": "\n"
    },
    {
      "type": "element",
      "name": "div",
      "props": {
        "class": ""
      },
      "blocks": [
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "h1",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Capgo Customer Support"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n      Capgo is committed to delivering an outstanding customer experience. As part of this commitment, we offer limited technical support for all paid projects using our Capgo platform. Our technical support is defined by the following scope, hours, contacts, and channels.\n    "
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "h2",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Scope"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Capgo's support offering is available only for technologies supported by the Capgo Platform and is limited to:"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "h3",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Configuration Issues"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "ul",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "Setup of live updates"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "Best practices for app configuration"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "General questions about the Capgo stack"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "h3",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Troubleshooting"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "ul",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "Providing workarounds or solutions for known issues"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "Answering general how-to questions and directing to documentation"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "Troubleshooting supported features (Live Updates, App Management, Analytics) showing unexpected behavior on Capgo, independent of the user's application code"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "h3",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Not Covered"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Capgo technical support services do not include:"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "ul",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "General debugging of user applications"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "Rewriting application code for compatibility with Capgo"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "Modifying and/or patching third-party or Open Source software for Capgo compatibility"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Billing and account management support is available to all customers."
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Limited technical support is available for Capgo customers using paid Capgo resources and/or paid Capgo Add-Ons. Support requests will only be processed if:"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "ul",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "The request is made through one of our official support channels"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "The request comes from a registered Capgo account email address"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "The requester has Developer or higher access to any specific Capgo projects related to the request"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "h2",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Official Support Channels"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "ul",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "Web and Dashboard: Support is available exclusively through the Capgo help feature in the dashboard or our website"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "Email: If you can't access the dashboard or ticket system, contact support by emailing support@capgo.app from a registered Capgo account email address"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n      Capgo support staff will only address requests received through these official channels. Community channels may exist for peer-to-peer support and discussions, provided by volunteers contributing to the Capgo community.\n    "
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n      For code debugging questions, we recommend reaching out on GitHub Issues or Discord. The community includes experienced developers who may offer guidance on code-related issues.\n    "
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n      To get the most helpful community response, provide precise and detailed information about your problem and any error messages. Include relevant code snippets explaining how to reproduce the issue in your message.\n    "
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Note that Capgo team members may participate in community channels at their discretion, but there's no guarantee of response unless submitted through official channels."
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "h2",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Service Level Agreement"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n      Service Level Agreements are only available to Enterprise customers. You can find SLA details, including support response times, on our dedicated SLA page:\n      "
            },
            {
              "type": "element",
              "name": "a",
              "props": {
                "href": "https://capgo.app/sla/",
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "https://capgo.app/sla/"
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "h2",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Proactive Monitoring"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n      In case of a platform issue, we'll post a notice on our status site at status.capgo.app to quickly communicate the impact and status. You don't need to submit a support ticket for ongoing platform issues. Instead, monitor the status page for the latest updates and information.\n    "
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "h2",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Premium Support"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "To learn about our Premium Support options for Team Plan and Enterprise customers, please contact us using the form below:"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "h2",
          "props": {
            "id": "service-disruption-and-ending",
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "Service disruption and plan ending"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "The update system is designed to fail safe. If Capgo is unavailable, the app keeps running and no user-facing freeze is introduced by the update check."
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "In every update mode, if the plugin cannot get an answer from the update service within 3 seconds, it cancels the request and opens the app normally."
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "ul",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "element",
                  "name": "strong",
                  "props": {
                    "class": ""
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "text": "If Capgo is down:"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " in background mode, this is usually invisible to users. In direct mode, the service may return a 5xx response when reachable; if the server is simply too slow, the plugin waits up to 3 seconds, cancels the query, and continues normal app startup."
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "element",
                  "name": "strong",
                  "props": {
                    "class": ""
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "text": "If payment is stopped or billing is canceled:"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " the last successfully installed update remains on each device, but no new updates are downloaded."
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            },
            {
              "type": "element",
              "name": "li",
              "props": {
                "class": ""
              },
              "blocks": [
                {
                  "type": "element",
                  "name": "strong",
                  "props": {
                    "class": ""
                  },
                  "blocks": [
                    {
                      "type": "text",
                      "text": "If traffic goes beyond your plan:"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " no devices (new or old) will receive additional updates until the plan is back in scope."
                }
              ]
            },
            {
              "type": "text",
              "text": "\n"
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "text",
              "text": "In every scenario above, your app remains usable with the last installed version, and updates are simply skipped until service resumes."
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "name": "p",
          "props": {
            "class": ""
          },
          "blocks": [
            {
              "type": "element",
              "name": "a",
              "props": {
                "href": "mailto:martin@capgo.app",
                "class": ""
              },
              "blocks": [
                {
                  "type": "text",
                  "text": "martin@capgo.app"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        }
      ]
    },
    {
      "type": "text",
      "text": "\n"
    }
  ]
}
