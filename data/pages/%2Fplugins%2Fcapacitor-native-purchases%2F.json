    },
    {
      "type": "code",
      "location": {
        "line": 26,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativePurchases } from '@capgo/native-purchases';\n\nawait NativePurchases.restorePurchases();"
    },
    {
      "type": "heading",
      "location": {
        "line": 32,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 32,
            "column": 5
          },
          "text": "getAppTransaction"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 34,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 1
          },
          "text": "Gets the App Transaction information, which provides details about when the user originally downloaded or purchased the app."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativePurchases } from '@capgo/native-purchases';\n\nconst { appTransaction } = await NativePurchases.getAppTransaction();\n\n// Check if user downloaded before version 2.0.0 (when subscription was added)\nif (compareVersions(appTransaction.originalAppVersion, '2.0.0') < 0) {\n  // User gets free access - they downloaded before subscriptions\n  grantFreeAccess();\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 48,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 48,
            "column": 5
          },
          "text": "isEntitledToOldBusinessModel"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 50,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 1
          },
          "text": "Compares the original app version from the App Transaction against a target version to determine if the user is entitled to features from an earlier business model."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 52,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativePurchases } from '@capgo/native-purchases';\n\n// Check if user downloaded before version 2.0.0/build 42 (when subscription was added)\nconst result = await NativePurchases.isEntitledToOldBusinessModel({\n  targetVersion: '2.0.0',\n  targetBuildNumber: '42'\n});\n\nif (result.isOlderVersion) {\n  console.log(`User downloaded v${result.originalAppVersion}, granting free access`);\n  grantFreeAccess();\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 67,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 67,
            "column": 5
          },
          "text": "purchaseProduct"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "Start the purchase process for the given product. For Android subscriptions, pass the Google Play base plan ID as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 115
          },
          "text": "planIdentifier"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 131
          },
          "text": ". For supported iOS subscriptions that offer monthly billing with a 12-month commitment, pass "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 225
          },
          "text": "billingPlanType: 'monthly'"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 253
          },
          "text": "."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 71,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativePurchases, PURCHASE_TYPE } from '@capgo/native-purchases';\n\nawait NativePurchases.purchaseProduct({\n  productIdentifier: 'com.example.premium.monthly',\n  planIdentifier: 'monthly-plan',\n  productType: PURCHASE_TYPE.SUBS,\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 81,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 81,
            "column": 5
          },
          "text": "iOS monthly commitment subscriptions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 83,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 83,
            "column": 1
          },
          "text": "On supported iOS versions, StoreKit can expose a monthly billing plan with a 12-month commitment through "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 83,
            "column": 106
          },
          "text": "pricingTerms"
        },
        {
          "type": "text",
          "location": {
            "line": 83,
            "column": 120
          },
          "text": ". Show these terms on your paywall before purchase:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 85,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { NativePurchases, PURCHASE_TYPE } from '@capgo/native-purchases';\n\nconst { products } = await NativePurchases.getProducts({\n  productIdentifiers: ['com.example.premium.yearly'],\n  productType: PURCHASE_TYPE.SUBS,\n});\n\nconst yearlyProduct = products.find(\n  (product) => product.identifier === 'com.example.premium.yearly',\n);\nconst monthlyCommitment = yearlyProduct?.pricingTerms?.find(\n  (term) => term.billingPlanType === 'monthly',\n);\n\nif (yearlyProduct && monthlyCommitment) {\n  console.log('Monthly price:', monthlyCommitment.billingDisplayPrice);\n  console.log('Total commitment:', monthlyCommitment.commitmentInfo?.priceString);\n\n  const transaction = await NativePurchases.purchaseProduct({\n    productIdentifier: yearlyProduct.identifier,\n    productType: PURCHASE_TYPE.SUBS,\n    billingPlanType: 'monthly',\n  });\n\n  console.log('Billing plan:', transaction.billingPlanType);\n  console.log('Commitment ends:', transaction.commitmentInfo?.expirationDate);\n}"
    },
