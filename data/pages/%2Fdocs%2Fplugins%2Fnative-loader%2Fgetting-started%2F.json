    "title": "Getting Started",
    "description": "Install @capgo/capacitor-native-loader and show native loaders from JavaScript, Swift, Kotlin, or another plugin.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 4,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 4
          },
          "text": "Installation"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 14,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-native-loader` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "component",
      "name": "Steps",
      "props": {},
      "blocks": [
        {
          "type": "list",
          "location": {
            "line": 21,
            "column": 1
          },
          "ordered": true,
          "start": 1,
          "spread": true,
          "blocks": [
            {
              "type": "listItem",
              "location": {
                "line": 21,
                "column": 1
              },
              "spread": true,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 21,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "strong",
                      "location": {
                        "line": 21,
                        "column": 4
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 21,
                            "column": 6
                          },
                          "text": "Install the package"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 23,
                    "column": 4
                  },
                  "lang": "bash",
                  "meta": null,
                  "text": "bun add @capgo/capacitor-native-loader\nbunx cap sync"
                }
              ]
            },
            {
              "type": "listItem",
              "location": {
                "line": 28,
                "column": 1
              },
              "spread": true,
              "checked": null,
              "blocks": [
                {
                  "type": "paragraph",
                  "location": {
                    "line": 28,
                    "column": 4
                  },
                  "blocks": [
                    {
                      "type": "strong",
                      "location": {
                        "line": 28,
                        "column": 4
                      },
                      "blocks": [
                        {
                          "type": "text",
                          "location": {
                            "line": 28,
                            "column": 6
                          },
                          "text": "Show a native loader from JavaScript"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "code",
                  "location": {
                    "line": 30,
                    "column": 4
                  },
                  "lang": "ts",
                  "meta": null,
                  "text": "import { NativeLoader } from '@capgo/capacitor-native-loader';\n\nconst { id } = await NativeLoader.show({\n  style: 'siri',\n  placement: 'fullscreen',\n  message: 'Preparing workspace',\n  colors: ['#71f6ff', '#8b5cf6', '#ff4ecd', '#fff7ad'],\n  scrimColor: 'rgba(3, 7, 18, 0.42)',\n  interactionMode: 'block',\n});\n\nawait doExpensiveWork();\n\nawait NativeLoader.hide({ id });"
                }
              ]
            }
          ]
        }
      ],
      "location": {
        "line": 20,
        "column": 1
      }
    },
    {
      "type": "heading",
      "location": {
        "line": 48,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 4
          },
          "text": "Configure Defaults"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 50,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeLoader.configure({\n  defaults: {\n    style: 'orbit',\n    placement: 'center',\n    size: 96,\n    colors: ['#38bdf8', '#a78bfa'],\n    reducedMotion: 'system',\n    interactionMode: 'passThrough',\n  },\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 63,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 63,
            "column": 4
          },
          "text": "Chrome-Style Top Loader"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 65,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 65,
            "column": 5
          },
          "text": "style: 'chrome'"
        },
        {
          "type": "text",
          "location": {
            "line": 65,
            "column": 22
          },
          "text": " when you want the familiar browser top progress bar and the WebView should stay usable below it."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 67,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const { id } = await NativeLoader.show({\n  style: 'chrome',\n  placement: 'top',\n  colors: ['#4285f4', '#34a853', '#fbbc05', '#ea4335'],\n  thickness: 4,\n  interactionMode: 'passThrough',\n  webView: {\n    mode: 'resize',\n    insets: { top: 12 },\n    restoreOnHide: true,\n  },\n});\n\nawait NativeLoader.hide({ id, restoreWebView: true });"
    },
    {
      "type": "heading",
      "location": {
        "line": 84,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 84,
            "column": 4
          },
          "text": "Siri V2 Edge Loader"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 86,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 86,
            "column": 5
          },
          "text": "style: 'siri-v2'"
        },
        {
          "type": "text",
          "location": {
            "line": 86,
            "column": 23
          },
          "text": " when the loading state should be a native full-screen color motion around the app edge instead of a centered card."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 88,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const { id } = await NativeLoader.show({\n  style: 'siri-v2',\n  placement: 'fullscreen',\n  colors: ['#71f6ff', '#8b5cf6', '#ff4ecd', '#fff7ad'],\n  thickness: 10,\n  scrimColor: 'rgba(3, 7, 18, 0.10)',\n  interactionMode: 'passThrough',\n});\n\nawait NativeLoader.hide({ id });"
    },
    {
      "type": "heading",
      "location": {
        "line": 101,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 101,
            "column": 4
          },
          "text": "Update Progress"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 103,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const { id } = await NativeLoader.show({\n  style: 'ring',\n  message: 'Uploading',\n  progress: 0,\n});\n\nfor await (const progress of uploadFile(file)) {\n  await NativeLoader.setProgress({ id, progress });\n}\n\nawait NativeLoader.hide({ id });"
    },
    {
      "type": "heading",
      "location": {
        "line": 117,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 117,
            "column": 4
          },
          "text": "Resize The WebView"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 119,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 119,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 119,
            "column": 5
          },
          "text": "setWebViewLayout"
        },
        {
          "type": "text",
          "location": {
            "line": 119,
            "column": 23
          },
          "text": " when a native loader should own part of the screen while web content remains visible and usable."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 121,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeLoader.setWebViewLayout({\n  mode: 'inset',\n  insets: { top: 96, bottom: 24 },\n  animated: true,\n});\n\nawait NativeLoader.show({\n  style: 'wave',\n  placement: 'top',\n  size: 72,\n  message: 'Syncing',\n  interactionMode: 'passThrough',\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 137,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 137,
            "column": 1
          },
          "text": "Restore the original layout when the native surface is gone:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 139,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeLoader.hideAll({ restoreWebView: true });"
    },
    {
      "type": "heading",
      "location": {
        "line": 143,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 143,
            "column": 4
          },
          "text": "Lottie And Image Loaders"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 145,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 145,
            "column": 1
          },
          "text": "Bundle Lottie JSON or image assets in the native app and reference them from JavaScript."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 147,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeLoader.show({\n  style: 'lottie',\n  placement: 'center',\n  asset: {\n    type: 'lottie',\n    source: 'rocket-loader.json',\n    loop: true,\n  },\n});"
    },
    {
      "type": "code",
      "location": {
        "line": 159,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await NativeLoader.show({\n  style: 'image',\n  placement: 'bottom',\n  asset: {\n    type: 'image',\n    source: 'loader-frame',\n  },\n});"
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {
        "type": "note"
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 171,
            "column": 3
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 171,
                "column": 3
              },
              "text": "Remote assets are supported, but bundled native assets are better for startup loaders because they are available before networking and JavaScript initialization finish."
            }
          ]
        }
      ],
      "location": {
        "line": 170,
        "column": 1
      }
    },
    {
      "type": "heading",
      "location": {
        "line": 174,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 174,
            "column": 4
          },
          "text": "Native Swift Calls"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 176,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 176,
            "column": 1
          },
          "text": "Other iOS plugins can call the shared loader directly."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 178,
        "column": 1
      },
      "lang": "swift",
      "meta": null,
      "text": "import CapgoCapacitorNativeLoader\n\nlet id = NativeLoader.shared.show(options: [\n  \"style\": \"siri\",\n  \"placement\": \"fullscreen\",\n  \"message\": \"Opening secure session\",\n  \"interactionMode\": \"block\"\n])\n\nNativeLoader.shared.setProgress(id: id, progress: 0.6)\nNativeLoader.shared.hide(id: id)"
    },
    {
      "type": "heading",
      "location": {
        "line": 192,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 192,
            "column": 4
          },
          "text": "Native Kotlin Calls"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 194,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 194,
            "column": 1
          },
          "text": "Other Android plugins can call the public object from Kotlin or Java."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 196,
        "column": 1
      },
      "lang": "kotlin",
      "meta": null,
      "text": "import app.capgo.nativeloader.NativeLoader\n\nval id = NativeLoader.show(\n  activity = activity,\n  options = mapOf(\n    \"style\" to \"orbit\",\n    \"placement\" to \"fullscreen\",\n    \"message\" to \"Loading profile\",\n    \"interactionMode\" to \"block\",\n  ),\n  webView = bridge.webView,\n)\n\nNativeLoader.setProgress(id, 0.6)\nNativeLoader.hide(id)"
    },
