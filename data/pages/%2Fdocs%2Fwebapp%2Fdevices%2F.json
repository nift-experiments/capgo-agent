    {
      "type": "heading",
      "location": {
        "line": 30,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 5
          },
          "text": "Request country"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 32,
        "column": 1
      },
      "blocks": [
        {
          "type": "strong",
          "location": {
            "line": 32,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 32,
                "column": 3
              },
              "text": "Country"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 32,
            "column": 12
          },
          "text": " is the latest valid two-letter ISO 3166-1 code received from a Cloudflare-handled request for that device. It is not GPS or a location value sent by your app. Requests without a valid country do not clear the last valid value, and the field is absent when Capgo has no valid country for the device."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 34,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 5
          },
          "text": "How device information is updated"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 36,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 1
          },
          "text": "The updater and stats endpoints report device metadata when the app checks in. A device does not need to install an update to appear or refresh its details: an updater check that returns "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 36,
            "column": 188
          },
          "text": "no_new_version_available"
        },
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 214
          },
          "text": " can still record the reported metadata. Capgo skips redundant writes when that metadata has not changed, so "
        },
        {
          "type": "strong",
          "location": {
            "line": 36,
            "column": 323
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 36,
                "column": 325
              },
              "text": "Last update"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 338
          },
          "text": " does not necessarily change after every check-in."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 38,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 1
          },
          "text": "Device metadata and MAU are different signals. See "
        },
        {
          "type": "link",
          "location": {
            "line": 38,
            "column": 52
          },
          "url": "/docs/faq/#why-my-device-number-is-different-than-my-mau",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 38,
                "column": 53
              },
              "text": "Why my device number is different than my MAU?"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 158
          },
          "text": " for the billing distinction."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 40,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 5
          },
          "text": "Custom ID"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 42,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 1
          },
          "text": "The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 42,
            "column": 5
          },
          "text": "Custom ID"
        },
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 16
          },
          "text": " helps you associate a device with an identifier you recognize for your users. Set it from the device with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 42,
            "column": 123
          },
          "text": "CapacitorUpdater.setCustomId({ customId: user })"
        },
        {
          "type": "text",
          "location": {
            "line": 42,
            "column": 173
          },
          "text": "."
        }
      ]
    },
