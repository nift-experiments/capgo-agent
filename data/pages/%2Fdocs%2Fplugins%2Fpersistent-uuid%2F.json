        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "The Persistent UUID plugin creates a random RFC 4122 UUID once and stores it with native persistence. Use it when your app needs a stable, app-scoped identifier that can survive app reinstall flows, Android Studio reinstall cycles, app updates, and device OS updates."
        }
      ]
    },
