    },
    {
      "type": "code",
      "location": {
        "line": 60,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface StartMeetingOptions {\n  /**\n   * Authentication token for the participant.\n   * This token is required to join the Cloudflare Calls meeting.\n   *\n   * @since 7.0.0\n   */\n  authToken: string;\n\n  /**\n   * Whether to join with audio enabled.\n   * Default is true.\n   *\n   * @default true\n   * @since 7.0.0\n   */\n  enableAudio?: boolean;\n\n  /**\n   * Whether to join with video enabled.\n   * Default is true.\n   *\n   * @default true\n   * @since 7.0.0\n   */\n  enableVideo?: boolean;\n}"
    },
