        "line": 46,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorRealtimekit } from '@capgo/capacitor-realtimekit';\n\nawait CapacitorRealtimekit.startMeeting({\n  authToken: 'your-auth-token',\n  enableAudio: true,\n  enableVideo: true,\n});"
