      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorRealtimekit } from '@capgo/capacitor-realtimekit';\n\nawait CapacitorRealtimekit.initialize();"
