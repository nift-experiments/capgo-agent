            "column": 4
          },
          "text": "iOS Minimum Version Requirement"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "The iOS minimum deployment target has been bumped to "
        },
        {
          "type": "strong",
          "location": {
            "line": 12,
            "column": 54
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 12,
                "column": 56
              },
              "text": "15"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 60
          },
          "text": " to ensure that iOS devices with "
        },
        {
          "type": "link",
          "location": {
            "line": 12,
            "column": 93
          },
          "url": "https://nvd.nist.gov/vuln/detail/CVE-2022-36943",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 12,
                "column": 94
              },
              "text": "CVE-2022-36943"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 158
          },
          "text": " are excluded. This is the minimum version of the iOS zip library that has the security fix implemented."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 14,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "npm i @capgo/capacitor-updater@8"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 18,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 1
          },
          "text": "Then sync the native code update:"
