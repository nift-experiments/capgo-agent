    },
    {
      "type": "paragraph",
      "location": {
        "line": 20,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 20,
            "column": 1
          },
          "text": "npx cap sync"
        }
      ]
    },
    {
