  "metadata": {
    "title": "Ionic Auth Connect Migration to @capgo/capacitor-social-login",
    "description": "Migrate from Ionic Auth Connect to Capgo Social Login with OAuth2 and provider-native sign-in.",
    "sidebar": {
      "order": 5
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 3,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 4
          },
          "text": "Overview"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 5,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 1
          },
          "text": "Capgo Social Login replaces Ionic Auth Connect with a provider-native OAuth2 flow for Google, Apple, Facebook, and other identity providers. It supports multiple providers in one plugin and works across iOS, Android, and Web."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 7,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 4
          },
          "text": "Why this works"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 9,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 9,
            "column": 1
          },
          "text": "The plugin includes an Auth Connect compatibility wrapper named "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 9,
            "column": 65
          },
          "text": "SocialLoginAuthConnect"
        },
        {
          "type": "text",
          "location": {
            "line": 9,
            "column": 89
          },
          "text": ". It maps familiar Ionic Auth Connect provider IDs onto the built-in OAuth2 engine, so you can keep using names such as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 9,
            "column": 209
          },
          "text": "auth0"
        },
        {
          "type": "text",
          "location": {
            "line": 9,
            "column": 216
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 9,
            "column": 218
          },
          "text": "azure"
        },
        {
          "type": "text",
          "location": {
            "line": 9,
            "column": 225
          },
          "text": ", and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 9,
            "column": 231
          },
          "text": "okta"
        },
        {
          "type": "text",
          "location": {
            "line": 9,
            "column": 237
          },
          "text": "."
        }
      ]
    },
    {
