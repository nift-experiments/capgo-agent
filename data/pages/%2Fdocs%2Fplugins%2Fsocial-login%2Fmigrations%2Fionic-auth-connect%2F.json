        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await SocialLoginAuthConnect.login({\n  provider: 'auth0',\n});\n\nconst status = await SocialLoginAuthConnect.isLoggedIn({\n  provider: 'auth0',\n});\n\nconst code = await SocialLoginAuthConnect.getAuthorizationCode({\n  provider: 'auth0',\n});\n\nawait SocialLoginAuthConnect.logout({\n  provider: 'auth0',\n});"
