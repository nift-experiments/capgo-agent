      "location": {
        "line": 20,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "// Before\nimport { AuthConnect } from '@ionic-enterprise/auth-connect';\n\n// After\nimport { SocialLoginAuthConnect } from '@capgo/capacitor-social-login';"
    },
