{
  "version": 1,
  "route": "/docs/plugins/updater/self-hosted/encrypted-bundles/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/plugins/updater/self-hosted/encrypted-bundles.mdx",
  "sourceSha256": "de244ac180ffaa1d8ab922c4b66617dedc3e3dfc0531c49fedf3aa93508e5208",
  "metadata": {
    "title": "Encrypted Bundles",
    "description": "A comprehensive guide on utilizing the manual update plugin in a self-hosted environment, detailing the steps and processes involved in managing encrypted bundles for secure and efficient updates.",
    "sidebar": {
      "order": 5
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 3,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 4
          },
          "text": "End-to-end Encryption"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 5,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 1
          },
          "text": "Starting with version 4.15.0 the plugin allows you to send encrypted updates."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 7,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 5
          },
          "text": "Step 1: Create a private key"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 8,
        "column": 1
      },
      "lang": "bash",
      "meta": "title='Create a private key'",
      "text": "npx @capgo/cli key create"
    },
    {
      "type": "heading",
      "location": {
        "line": 12,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 5
          },
          "text": "Step 2: Create and zip your bundle"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 13,
        "column": 1
      },
      "lang": "bash",
      "meta": "title=\"Create bundle zip with checksum\"",
      "text": "npx @capgo/cli bundle zip [appId] --key-v2 --json"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 17,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 1
          },
          "text": "The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 17,
            "column": 5
          },
          "text": "--key-v2"
        },
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 15
          },
          "text": " flag uses the new encryption system with better checksums, and the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 17,
            "column": 83
          },
          "text": "--json"
        },
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 91
          },
          "text": " flag will output the bundle information including the checksum that you'll need for encryption."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 19,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 5
          },
          "text": "Step 3: Encrypt your bundle"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 20,
        "column": 1
      },
      "lang": "bash",
      "meta": "title=\"Encrypt bundled zip with checksum\"",
      "text": "npx @capgo/cli encrypt [path/to/zip] [checksum]"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 24,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 1
          },
          "text": "The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 24,
            "column": 5
          },
          "text": "checksum"
        },
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 15
          },
          "text": " parameter is the SHA256 checksum generated by the zip command in step 2. The encrypt command will return an "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 24,
            "column": 124
          },
          "text": "ivSessionKey"
        },
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 138
          },
          "text": " and generate an encrypted checksum.Remember to rename "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 24,
            "column": 193
          },
          "text": "ivSessionKey"
        },
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 207
          },
          "text": " key as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 24,
            "column": 215
          },
          "text": "session_key"
        },
        {
          "type": "text",
          "location": {
            "line": 24,
            "column": 228
          },
          "text": " in the update payload."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 26,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 5
          },
          "text": "Step 4: Use in your update payload"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 27,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n\"version\": \"1.2.3\",\n\"url\": \"https://myserver.com/app/updates/my-new-app-2.0.0.zip\",\n\"session_key\": \"encrypted_session_key\",\n\"checksum\": \"encrypted_checksum_from_encrypt_command\"\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 36,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 1
          },
          "text": "The "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 36,
            "column": 5
          },
          "text": "session_key"
        },
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 18
          },
          "text": " is the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 36,
            "column": 26
          },
          "text": "ivSessionKey"
        },
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 40
          },
          "text": " returned by the encrypt command, and the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 36,
            "column": 82
          },
          "text": "checksum"
        },
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 92
          },
          "text": " is the encrypted checksum generated during encryption (not the original checksum from the zip command)."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 38,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 1
          },
          "text": "Then your app will be able to use the private key to decrypt the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 38,
            "column": 66
          },
          "text": "session_key"
        },
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 79
          },
          "text": " and use the decrypted "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 38,
            "column": 102
          },
          "text": "session_key"
        },
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 115
          },
          "text": " to decrypt the update. The encrypted checksum ensures bundle integrity verification."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 40,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 4
          },
          "text": "Learn More"
        }
      ]
    },
