          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 14,
                "column": 3
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 14,
                    "column": 3
                  },
                  "text": "addNetwork"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 14,
                    "column": 15
                  },
                  "text": " - Show a system dialog to add a Wi-Fi network to the device. On Android SDK 30+, this opens the system Wi-Fi settings with the network pre-filled. On iOS, this connects to the network directly."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 15,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 15,
                "column": 3
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 15,
                    "column": 3
                  },
                  "text": "connect"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 15,
                    "column": 12
                  },
                  "text": " - Connect to a Wi-Fi network. On Android, this creates a temporary connection that doesn't route traffic through the network by default. Set autoRouteTraffic to true to bind app traffic to the connected network (useful for local/device-hosted APs). For a persistent connection on Android, use addNetwork() instead. On iOS, this creates a persistent connection."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 16,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 16,
                "column": 3
              },
              "blocks": [
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 16,
                    "column": 3
                  },
                  "text": "disconnect"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 16,
                    "column": 15
                  },
                  "text": " - Disconnect from the current Wi-Fi network. On iOS, only disconnects from networks that were added via this plugin."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 17,
            "column": 1
          },
          "spread": false,
