                    "line": 17,
                    "column": 3
                  },
                  "text": "getAvailableNetworks"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 17,
                    "column": 25
                  },
                  "text": " - Get a list of available Wi-Fi networks from the last scan. Only available on Android."
                }
              ]
            }
          ]
        }
      ]
