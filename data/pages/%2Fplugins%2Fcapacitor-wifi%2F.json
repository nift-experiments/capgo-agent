          },
          "text": "Show a system dialog to add a Wi-Fi network to the device. On Android SDK 30+, this opens the system Wi-Fi settings with the network pre-filled. On iOS, this connects to the network directly."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorWifi, NetworkSecurityType } from '@capgo/capacitor-wifi';\n\nawait CapacitorWifi.addNetwork({\n  ssid: 'MyNetwork',\n  password: 'mypassword',\n  isHiddenSsid: false,\n  securityType: NetworkSecurityType.WPA2_PSK\n});"
    },
