              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 43,
                    "column": 3
                  },
                  "text": "This plugin detects recovery after a WebView crash. It does not prevent the underlying crash."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 44,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 44,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 44,
                    "column": 3
                  },
                  "text": "The recovered JavaScript runtime is new, so any in-memory state from the previous WebView is already gone when this API fires."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 45,
            "column": 1
          },
          "spread": false,
