      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "This plugin stores a native marker when the previous Capacitor WebView process dies or is recycled, then exposes that marker to the next JavaScript runtime after the app recovers. It can also restart the WebView from native code after a crash, on a fixed interval, on a cron schedule, or when JavaScript explicitly requests "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 325
          },
          "text": "restartWebView()"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 343
          },
          "text": ", which helps kiosk, POS, dashboard, scanner, and signage apps avoid memory buildup during long sessions."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
