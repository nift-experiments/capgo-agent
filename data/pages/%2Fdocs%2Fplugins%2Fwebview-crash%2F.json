                {
                  "type": "text",
                  "location": {
                    "line": 45,
                    "column": 55
                  },
                  "text": "; manual restarts write "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 45,
                    "column": 79
                  },
                  "text": "reason: 'manualRestart'"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 45,
                    "column": 104
                  },
                  "text": ". Persist unsaved state before enabling short restart intervals, cron schedules, or calling "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 45,
                    "column": 196
                  },
                  "text": "restartWebView()"
