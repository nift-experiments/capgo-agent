    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Generate a thumbnail image from a video file at a specific time position."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoVideoThumbnails } from '@capgo/capacitor-video-thumbnails';\n\nconst result = await CapgoVideoThumbnails.getThumbnail({\n  sourceUri: 'file:///path/to/video.mp4',\n  time: 5000,\n  quality: 0.8\n});\nconsole.log('Thumbnail URI:', result.uri);\nconsole.log('Dimensions:', result.width, 'x', result.height);"
    },
