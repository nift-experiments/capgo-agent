          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 32,
                "column": 3
              },
              "text": "Real-Time Analytics:"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 34,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 34,
            "column": 1
          },
          "text": "Capgo integrates with live update CapacitorJS and Ionic to provide real-time data analytics. Custom dashboards display vital business metrics, enabling proactive decision-making and insights into customer behavior."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 36,
