          "location": {
            "line": 1,
            "column": 3
          },
          "text": "Using @capgo/capacitor-auto"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 3,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "@capgo/capacitor-auto"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 24
          },
          "text": " connects a Capacitor app to approved CarPlay and Android Auto template surfaces. Your app sends a small list template to the car display, and the car display sends selected actions back to JavaScript."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 5,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 1
          },
          "text": "It is built for driver-safe, policy-controlled workflows. It does not mirror your WebView into the car."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 7,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 7,
            "column": 4
          },
          "text": "Install and sync"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 9,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-auto\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 14,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 4
          },
          "text": "Send a template to the car"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 16,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { Auto } from '@capgo/capacitor-auto';\n\nawait Auto.setRootTemplate({\n  title: 'Garage',\n  sections: [\n    {\n      header: 'Doors',\n      items: [\n        {\n          id: 'open-main-door',\n          title: 'Open main door',\n          subtitle: 'Tap to send the action to the phone app',\n          payload: { doorId: 'main' },\n        },\n      ],\n    },\n  ],\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 37,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 37,
            "column": 4
          },
          "text": "Listen for driver actions"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 39,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "await Auto.addListener('carAction', async (event) => {\n  if (event.id === 'open-main-door') {\n    await openGarageDoor(event.payload?.doorId);\n  }\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 47,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 4
          },
          "text": "Watch connection state"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 49,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const status = await Auto.isAvailable();\nconsole.log(status.available, status.connected, status.platform);\n\nawait Auto.addListener('connectionChanged', (event) => {\n  console.log('Car connected:', event.connected, event.platform);\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 58,
