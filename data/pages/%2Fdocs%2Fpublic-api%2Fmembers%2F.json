        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "interface MemberCreate {\n  orgId: string\n  email: string\n  role: \"read\" | \"upload\" | \"write\" | \"admin\" | \"super_admin\"\n}"
    },
