    },
    {
      "type": "code",
      "location": {
        "line": 48,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const handle = await DeviceInfo.addListener('deviceInfoUpdate', (sample) => {\n  console.log(sample.sequence, sample.elapsedMs);\n  console.log(sample.cpu.usagePercent);\n  console.log(sample.sensors?.readings);\n});\n\nconst session = await DeviceInfo.startMonitoring({\n  intervalMs: 1000,\n  emitImmediately: true,\n});\n\nconsole.log(session.intervalMs, session.startedAt);"
    },
