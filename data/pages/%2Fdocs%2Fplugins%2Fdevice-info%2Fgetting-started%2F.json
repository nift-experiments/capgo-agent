    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 10,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 14,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 14,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 16,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-device-info` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 20,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 20,
            "column": 1
          },
          "text": "For a manual setup, install the package and sync the native projects:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 22,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-device-info\nnpx cap sync"
    },
    {
