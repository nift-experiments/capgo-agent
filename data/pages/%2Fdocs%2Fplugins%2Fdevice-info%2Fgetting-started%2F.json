    {
      "type": "code",
      "location": {
        "line": 131,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "interface CpuInfo {\n  cores: number;\n  activeCores?: number;\n  architecture?: string;\n  model?: string;\n  usagePercent?: number | null;\n  maxFrequencyHz?: number;\n  temperatureCelsius?: number;\n}\n\ninterface MemoryInfo {\n  totalBytes?: number;\n  freeBytes?: number;\n  usedBytes?: number;\n  usedPercent?: number;\n  appUsedBytes?: number;\n  appLimitBytes?: number;\n  lowMemory?: boolean;\n  pressure?: 'normal' | 'warning' | 'critical' | 'unknown';\n}\n\ninterface StorageInfo {\n  totalBytes?: number;\n  freeBytes?: number;\n  usedBytes?: number;\n  usedPercent?: number;\n}\n\ninterface GpuInfo {\n  api?: 'metal' | 'opengl' | 'webgl' | 'unknown';\n  vendor?: string;\n  renderer?: string;\n  version?: string;\n  maxTextureSize?: number;\n  temperatureCelsius?: number;\n}\n\ntype ThermalState = 'nominal' | 'fair' | 'serious' | 'critical' | 'unknown';\n\ninterface DeviceInfoSnapshot {\n  timestamp: number;\n  platform: 'ios' | 'android' | 'web';\n  cpu: CpuInfo;\n  memory: MemoryInfo;\n  storage: StorageInfo;\n  gpu?: GpuInfo;\n  thermalState?: ThermalState;\n  lowPowerMode?: boolean;\n  sensors?: OnboardSensorsInfo;\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 184,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 184,
            "column": 1
          },
          "text": "Sizes are bytes, "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 184,
            "column": 18
          },
          "text": "maxFrequencyHz"
        },
        {
          "type": "text",
          "location": {
            "line": 184,
            "column": 34
          },
          "text": " is hertz, and temperature values are Celsius. "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 184,
            "column": 81
          },
          "text": "usagePercent"
        },
        {
          "type": "text",
          "location": {
            "line": 184,
            "column": 95
          },
          "text": " can be "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 184,
            "column": 103
          },
          "text": "null"
        },
        {
          "type": "text",
          "location": {
            "line": 184,
            "column": 109
          },
          "text": " until the platform has enough samples to calculate it."
        }
      ]
