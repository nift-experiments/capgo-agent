    {
      "type": "code",
      "location": {
        "line": 93,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { sensors, cpu, gpu } = await DeviceInfo.getInfo();\n\nconsole.log(cpu.temperatureCelsius);\nconsole.log(gpu?.temperatureCelsius);\nconsole.log(sensors?.batteryTemperatureCelsius);\nconsole.log(sensors?.ambientTemperatureCelsius);\nconsole.log(sensors?.relativeHumidityPercent);\nconsole.log(sensors?.pressureHpa);\nconsole.log(sensors?.illuminanceLux);\nconsole.log(sensors?.proximityDistanceCm);\nconsole.log(sensors?.availableSensors);"
    },
    {
      "type": "paragraph",
