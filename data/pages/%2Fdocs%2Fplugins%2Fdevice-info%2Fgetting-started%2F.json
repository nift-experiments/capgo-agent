        "line": 33,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 4
          },
          "text": "Read one snapshot"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const snapshot = await DeviceInfo.getInfo();\n\nconsole.log(snapshot.cpu.cores);\nconsole.log(snapshot.memory.usedPercent);\nconsole.log(snapshot.storage.freeBytes);\nconsole.log(snapshot.sensors?.pressureHpa);"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 44,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "cpu.usagePercent"
        },
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 19
          },
          "text": " is delta-based. The first native sample can omit it; call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 44,
            "column": 78
          },
          "text": "getInfo()"
        },
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 89
          },
          "text": " again later or use monitoring to receive populated CPU usage after the second sample."
        }
      ]
    },
    {
