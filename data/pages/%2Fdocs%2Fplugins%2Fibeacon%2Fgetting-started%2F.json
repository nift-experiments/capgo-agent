        "line": 181,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 181,
            "column": 1
          },
          "text": "Enable or disable background beacon scanning mode (Android only).\nThis enables a foreground service for reliable background beacon detection.\nMust be called after requesting \"Always\" location authorization."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 185,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorIbeacon } from '@capgo/capacitor-ibeacon';\n\n// Enable background mode for beacon scanning\nawait CapacitorIbeacon.enableBackgroundMode({ enabled: true });\n\n// Disable background mode\nawait CapacitorIbeacon.enableBackgroundMode({ enabled: false });"
    },
