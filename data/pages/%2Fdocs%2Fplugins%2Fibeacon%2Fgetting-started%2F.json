        "line": 250,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 250,
            "column": 1
          },
          "text": "Beacon advertising options for transmitting as an iBeacon (iOS only)."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 251,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface BeaconAdvertisingOptions {\n  /**\n   * UUID to advertise.\n   */\n  uuid: string;\n\n  /**\n   * Major value (0-65535).\n   */\n  major: number;\n\n  /**\n   * Minor value (0-65535).\n   */\n  minor: number;\n\n  /**\n   * Identifier for the advertising beacon.\n   */\n  identifier: string;\n\n  /**\n   * Measured power (RSSI at 1 meter). Optional, defaults to -59.\n   */\n  measuredPower?: number;\n}"
    },
