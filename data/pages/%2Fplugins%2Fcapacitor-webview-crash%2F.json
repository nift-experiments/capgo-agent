    },
    {
      "type": "code",
      "location": {
        "line": 50,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\nimport type { WebViewCrashPluginConfig } from '@capgo/capacitor-webview-crash';\n\nconst webViewCrash: WebViewCrashPluginConfig = {\n  restartOnCrash: true,\n  restartCron: '0 3 * * *',\n  restartAfterCrashDelayMs: 0,\n};\n\nconst config: CapacitorConfig = {\n  plugins: {\n    WebViewCrash: webViewCrash,\n  },\n};\n\nexport default config;"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "Scheduled restarts write "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 26
          },
          "text": "reason: 'periodicRestart'"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 53
          },
          "text": ". Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 59
          },
          "text": "restartIntervalMs"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 78
          },
          "text": " for fixed intervals or "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 102
          },
          "text": "restartCron"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 115
          },
          "text": " for a 5-field cron schedule in the device local timezone, such as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 182
          },
          "text": "0 3 * * *"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 193
          },
          "text": " for a daily 03:00 restart. Do not configure both schedules at once: native initialization throws a fatal config error when "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 317
          },
          "text": "restartCron"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 330
          },
          "text": " is set and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 342
          },
          "text": "restartIntervalMs"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 361
          },
          "text": " is greater than "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 69,
            "column": 378
          },
          "text": "0"
        },
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 381
          },
          "text": ". Persist critical app state before using short schedules."
        }
      ]
    },
