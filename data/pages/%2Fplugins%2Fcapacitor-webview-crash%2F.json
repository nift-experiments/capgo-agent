      "text": "await WebViewCrash.restartWebView();"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 79,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 1
          },
          "text": "The method writes "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 79,
            "column": 19
          },
          "text": "reason: 'manualRestart'"
        },
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 44
          },
          "text": " and asks native code to create a fresh WebView. Android recreates the host activity. iOS rebuilds the Capacitor bridge view so a new "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 79,
            "column": 178
          },
          "text": "WKWebView"
        },
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 189
          },
          "text": " is created instead of reloading the current page."
        }
      ]
