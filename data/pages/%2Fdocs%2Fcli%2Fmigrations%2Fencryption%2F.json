      "location": {
        "line": 67,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 4
          },
          "text": "6. Cleanup (After 3-4 Months)"
        }
      ]
    },
