                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 72,
                    "column": 4
                  },
                  "text": "Delete the old channel:"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 74,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx @capgo/cli channel delete encryption_v2"
    },
