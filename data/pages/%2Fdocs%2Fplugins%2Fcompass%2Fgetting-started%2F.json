          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-compass` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-compass\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoCompass } from '@capgo/capacitor-compass';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "getCurrentHeading"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Get the current compass heading in degrees.\nOn iOS, the heading is updated in the background, and the latest value is returned.\nOn Android, the heading is calculated when the method is called using accelerometer and magnetometer sensors.\nNot implemented on Web."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 38,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoCompass } from '@capgo/capacitor-compass';\n\nconst { value } = await CapgoCompass.getCurrentHeading();\nconsole.log('Compass heading:', value, 'degrees');"
    },
    {
      "type": "heading",
      "location": {
        "line": 45,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 45,
            "column": 5
          },
          "text": "startListening"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 47,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 1
          },
          "text": "Start listening for compass heading changes via events.\nThis starts the compass sensors and emits 'headingChange' events."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 50,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoCompass } from '@capgo/capacitor-compass';\n\n// With default throttling (100ms interval, 2° minimum change)\nawait CapgoCompass.startListening();\n\n// With custom throttling for high-frequency updates\nawait CapgoCompass.startListening({\n  minInterval: 50,      // 50ms between events\n  minHeadingChange: 1.0 // 1° minimum change\n});\n\nCapgoCompass.addListener('headingChange', (event) => {\n  console.log('Heading:', event.value);\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 67,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 67,
            "column": 5
          },
          "text": "stopListening"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 69,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 69,
            "column": 1
          },
          "text": "Stop listening for compass heading changes.\nThis stops the compass sensors and stops emitting events."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 72,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoCompass } from '@capgo/capacitor-compass';\n\nawait CapgoCompass.stopListening();"
    },
    {
      "type": "heading",
      "location": {
        "line": 78,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 78,
            "column": 5
          },
          "text": "checkPermissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 80,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 80,
            "column": 1
          },
          "text": "Check the current permission status for accessing compass data.\nOn iOS, this checks location permission status.\nOn Android, this always returns 'granted' as no permissions are required."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 84,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoCompass } from '@capgo/capacitor-compass';\n\nconst status = await CapgoCompass.checkPermissions();\nconsole.log('Compass permission:', status.compass);"
    },
    {
      "type": "heading",
      "location": {
        "line": 91,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 91,
            "column": 5
          },
          "text": "requestPermissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 93,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 93,
            "column": 1
          },
          "text": "Request permission to access compass data.\nOn iOS, this requests location permission (required for heading data).\nOn Android, this resolves immediately as no permissions are required."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 97,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoCompass } from '@capgo/capacitor-compass';\n\nconst status = await CapgoCompass.requestPermissions();\nif (status.compass === 'granted') {\n  // Can now use compass\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 106,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 106,
            "column": 5
          },
          "text": "watchAccuracy"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 108,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 108,
            "column": 1
          },
          "text": "Start monitoring compass accuracy.\nOn Android, this monitors the magnetometer accuracy and emits accuracyChange events.\nDevelopers can listen to these events and implement their own UI for calibration prompts.\nOn iOS and Web, this method does nothing as compass accuracy monitoring is not available."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 113,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoCompass, CompassAccuracy } from '@capgo/capacitor-compass';\n\n// Start monitoring accuracy\nawait CapgoCompass.watchAccuracy();\n\n// Listen for accuracy changes and implement custom UI\nCapgoCompass.addListener('accuracyChange', (event) => {\n  console.log('Accuracy changed to:', event.accuracy);\n  if (event.accuracy < CompassAccuracy.MEDIUM) {\n    // Show your custom calibration UI\n  }\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 128,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 128,
            "column": 5
          },
          "text": "unwatchAccuracy"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 130,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 130,
            "column": 1
          },
          "text": "Stop monitoring compass accuracy.\nThis stops the accuracy monitoring."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 133,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoCompass } from '@capgo/capacitor-compass';\n\nawait CapgoCompass.unwatchAccuracy();"
    },
    {
      "type": "heading",
      "location": {
        "line": 139,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 139,
            "column": 5
          },
          "text": "getAccuracy"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 141,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 141,
            "column": 1
          },
          "text": "Get the current compass accuracy level.\nOn Android, returns the current magnetometer sensor accuracy.\nOn iOS and Web, always returns CompassAccuracy.UNKNOWN as accuracy monitoring is not available."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 145,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoCompass, CompassAccuracy } from '@capgo/capacitor-compass';\n\nconst { accuracy } = await CapgoCompass.getAccuracy();\nif (accuracy < CompassAccuracy.MEDIUM) {\n  console.log('Compass needs calibration');\n}"
    },
