  "sourceSha256": "11b1a065e9a1408865552e1abd6c595fc7d177703a5fb492194b35ad6109f058",
  "metadata": {
    "title": "Getting Started",
    "description": "Learn how to install and use the Verisoul Capacitor plugin.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-verisoul` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-verisoul\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Configure Verisoul"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 25,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 1
          },
          "text": "Call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 6
          },
          "text": "configure()"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 19
          },
          "text": " once, early in your app startup. Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 57
          },
          "text": "sandbox"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 66
          },
          "text": " for testing and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 25,
            "column": 83
          },
          "text": "prod"
        },
        {
          "type": "text",
          "location": {
            "line": 25,
            "column": 89
          },
          "text": " for production traffic."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 27,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { Verisoul } from '@capgo/capacitor-verisoul';\n\nawait Verisoul.configure({\n  environment: 'prod',\n  projectId: 'YOUR_PROJECT_ID',\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 36,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 36,
            "column": 4
          },
          "text": "Get a session ID"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 38,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 38,
            "column": 1
          },
          "text": "After Verisoul has collected enough native signals, request the session ID and send it to your backend. Your backend should call Verisoul's server-side API for the risk assessment."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 40,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const { sessionId } = await Verisoul.getSessionId();\n\nawait fetch('/api/risk/verisoul', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ sessionId }),\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 50,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 4
          },
          "text": "Reset on account changes"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 52,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 1
          },
          "text": "Call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 52,
            "column": 6
          },
          "text": "reinitialize()"
        },
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 22
          },
          "text": " when user context changes, such as logout followed by login as another account."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 54,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await Verisoul.reinitialize();"
    },
    {
      "type": "heading",
      "location": {
        "line": 58,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 58,
            "column": 4
          },
          "text": "Android touch signals"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 60,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 60,
            "column": 1
          },
          "text": "On Android, forward touch events when your app needs Verisoul touch-pattern collection."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 62,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "await Verisoul.recordTouchEvent({\n  x: 120,\n  y: 240,\n  action: 'down',\n});"
    },
