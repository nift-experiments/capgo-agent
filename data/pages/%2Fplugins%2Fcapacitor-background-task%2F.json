      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 1
          },
          "text": "Define the task at module scope so it is available when the OS wakes the app:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 48,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { BackgroundTask, BackgroundTaskResult } from '@capgo/capacitor-background-task';\n\nconst SYNC_TASK = 'sync-offline-data';\n\nBackgroundTask.defineTask(SYNC_TASK, async () => {\n  try {\n    await fetch('https://api.example.com/sync', { method: 'POST' });\n    return BackgroundTaskResult.Success;\n  } catch {\n    return BackgroundTaskResult.Failed;\n  }\n});\n\nawait BackgroundTask.registerTaskAsync(SYNC_TASK, {\n  minimumInterval: 30,\n  requiresNetwork: true,\n});"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 68,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 68,
            "column": 1
          },
          "text": "Check status and registered task names:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 70,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const status = await BackgroundTask.getStatusAsync();\nconst tasks = await BackgroundTask.getRegisteredTasksAsync();\n\nconsole.log({ status, tasks });"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 77,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
