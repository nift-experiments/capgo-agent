        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "Schedule periodic background fetch work in a Capacitor app with named tasks, persistent registration, status checks, unregistering, and a development trigger. The plugin uses Android WorkManager and iOS BGTaskScheduler."
        }
      ]
    },
