      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 182,
            "column": 1
          },
          "text": "Information about a scheduled alarm."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 183,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface AlarmInfo {\n  /** Unique identifier for the alarm */\n  id: string;\n  /** Hour of day in 24h format (0-23) */\n  hour: number;\n  /** Minute of hour (0-59) */\n  minute: number;\n  /** Optional label for the alarm */\n  label?: string;\n  /** Whether the alarm is enabled */\n  enabled?: boolean;\n}"
    },
