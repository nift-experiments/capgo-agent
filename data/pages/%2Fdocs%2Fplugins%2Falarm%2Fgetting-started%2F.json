          },
          "text": "PermissionResult"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 169,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 169,
            "column": 1
          },
          "text": "Result of a permissions request."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 170,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface PermissionResult {\n  /** Overall grant for requested scope */\n  granted: boolean;\n  /** Optional details by permission key */\n  details?: Record<string, boolean>;\n  /** Optional human readable diagnostic */\n  message?: string;\n}"
    },
    {
