      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-alarm` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-alarm\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoAlarm } from '@capgo/capacitor-alarm';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "createAlarm"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Create a native OS alarm using the platform clock app.\nOn Android this uses the Alarm Clock intent; on iOS this uses AlarmKit if available (iOS 16+)."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 36,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoAlarm } from '@capgo/capacitor-alarm';\n\nconst result = await CapgoAlarm.createAlarm({\n  hour: 7,\n  minute: 30,\n  label: 'Wake up',\n  skipUi: false,\n  vibrate: true\n});\nconsole.log('Alarm created:', result.success);"
    },
    {
      "type": "heading",
      "location": {
        "line": 49,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 49,
            "column": 5
          },
          "text": "openAlarms"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "Open the platform's native alarm list UI, if available."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 53,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoAlarm } from '@capgo/capacitor-alarm';\n\nconst result = await CapgoAlarm.openAlarms();\nif (result.success) {\n  console.log('Alarms UI opened');\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 62,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 62,
            "column": 5
          },
          "text": "getOSInfo"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 64,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 64,
            "column": 1
          },
          "text": "Get information about the OS and capabilities."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 66,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoAlarm } from '@capgo/capacitor-alarm';\n\nconst info = await CapgoAlarm.getOSInfo();\nconsole.log('Platform:', info.platform);\nconsole.log('Supports native alarms:', info.supportsNativeAlarms);\nif (info.platform === 'android') {\n  console.log('Can schedule exact alarms:', info.canScheduleExactAlarms);\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 77,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 77,
            "column": 5
          },
          "text": "requestPermissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 79,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 79,
            "column": 1
          },
          "text": "Request relevant permissions for alarm usage on the platform.\nOn Android, may route to settings for exact alarms."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 82,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoAlarm } from '@capgo/capacitor-alarm';\n\nconst result = await CapgoAlarm.requestPermissions({ exactAlarm: true });\nif (result.granted) {\n  console.log('Permissions granted');\n} else {\n  console.log('Permissions denied');\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 93,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 93,
            "column": 5
          },
          "text": "checkPermissions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 95,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 95,
            "column": 1
          },
          "text": "Check the current permission state for native alarm access without triggering UI.\nOn iOS this reports AlarmKit readiness; on Android it reports capability details."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 98,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoAlarm } from '@capgo/capacitor-alarm';\n\nconst status = await CapgoAlarm.checkPermissions();\nconsole.log('AlarmKit allowed?', status.details?.alarmKit);"
    },
    {
      "type": "heading",
      "location": {
        "line": 105,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 105,
            "column": 5
          },
          "text": "getAlarms"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 107,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 107,
            "column": 1
          },
          "text": "Get a list of alarms scheduled by this app.\nOn iOS 26+, returns alarms from AlarmKit. On Android, this is not supported\nas the system does not provide an API to query alarms."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 111,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapgoAlarm } from '@capgo/capacitor-alarm';\n\nconst { alarms } = await CapgoAlarm.getAlarms();\nconsole.log('Scheduled alarms:', alarms);\nalarms.forEach(alarm => {\n  console.log(`Alarm ${alarm.id}: ${alarm.hour}:${alarm.minute} - ${alarm.label}`);\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 121,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 121,
            "column": 4
          },
          "text": "Type Reference"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
