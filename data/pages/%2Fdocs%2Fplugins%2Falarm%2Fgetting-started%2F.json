        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 123,
            "column": 5
          },
          "text": "NativeAlarmCreateOptions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 124,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 124,
            "column": 1
          },
          "text": "Options for creating a native OS alarm via the platform clock app."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 125,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface NativeAlarmCreateOptions {\n  /** Hour of day in 24h format (0-23) */\n  hour: number;\n  /** Minute of hour (0-59) */\n  minute: number;\n  /** Optional label for the alarm */\n  label?: string;\n  /** Android only: attempt to skip UI if possible */\n  skipUi?: boolean;\n  /** Android only: set alarm to vibrate */\n  vibrate?: boolean;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 140,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 140,
            "column": 5
          },
          "text": "NativeActionResult"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 141,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 141,
            "column": 1
          },
          "text": "Result of a native action."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 142,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface NativeActionResult {\n  /** Whether the action was successful */\n  success: boolean;\n  /** Optional message with additional information */\n  message?: string;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 151,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 151,
            "column": 5
          },
          "text": "OSInfo"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 152,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 152,
            "column": 1
          },
          "text": "Returned info about current OS and capabilities."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 153,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface OSInfo {\n  /** Platform identifier: 'ios' | 'android' | 'web' */\n  platform: string;\n  /** OS version string */\n  version: string;\n  /** Whether the platform exposes a native alarm app integration */\n  supportsNativeAlarms: boolean;\n  /** Whether scheduling local notifications is supported */\n  supportsScheduledNotifications: boolean;\n  /** Android only: whether exact alarms are allowed */\n  canScheduleExactAlarms?: boolean;\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 168,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
