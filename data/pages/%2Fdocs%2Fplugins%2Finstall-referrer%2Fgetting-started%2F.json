    "title": "Getting Started",
    "description": "Install @capgo/capacitor-install-referrer and read install attribution data in a Capacitor app.",
    "sidebar": {
      "order": 2
    }
  },
  "blocks": [
    {
      "type": "heading",
      "location": {
        "line": 2,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-install-referrer` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-install-referrer\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { InstallReferrer } from '@capgo/capacitor-install-referrer';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "Read Attribution Details"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 31,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await InstallReferrer.getReferrer();\n\nif (result.platform === 'android') {\n  console.log('Install referrer:', result.referrer);\n  console.log('Click timestamp:', result.clickTimestampSeconds);\n  console.log('Install timestamp:', result.installBeginTimestampSeconds);\n}\n\nif (result.platform === 'ios') {\n  console.log('AdServices token:', result.attributionToken);\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 45,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 45,
            "column": 4
          },
          "text": "Fetch Apple Attribution On iOS"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 47,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 1
          },
          "text": "If you want native code to call Apple's attribution endpoint, pass "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 47,
            "column": 68
          },
          "text": "fetchAppleAttribution"
        },
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 91
          },
          "text": "."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 49,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await InstallReferrer.getReferrer({\n  fetchAppleAttribution: true,\n  appleAttributionRetryCount: 3,\n  appleAttributionRetryDelayMs: 5000,\n});\n\n// result.appleAttribution is the parsed Apple attribution response.\n// See the iOS attribution page for the Apple-provided payload fields.\nconsole.log(result.appleAttribution);"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 61,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 1
          },
          "text": "Apple can return "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 61,
            "column": 18
          },
          "text": "404"
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 23
          },
          "text": " while attribution data is still being prepared for a valid token. The retry options control how often the native plugin retries before rejecting. See "
        },
        {
          "type": "link",
          "location": {
            "line": 61,
            "column": 174
          },
          "url": "/docs/plugins/install-referrer/ios/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 61,
                "column": 175
              },
              "text": "iOS attribution"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 61,
            "column": 228
          },
          "text": " for platform details."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 63,
