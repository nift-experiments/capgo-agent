    },
    {
      "type": "paragraph",
      "location": {
        "line": 59,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 59,
            "column": 1
          },
          "text": "Options for starting an inline install flow."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 60,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface StartInlineInstallOptions {\n  /** Package name of the app to be installed (target app). */\n  id: string;\n  /** Referrer string to pass to Play. Optional but recommended. */\n  referrer?: string;\n  /**\n   * Package name of your app (caller). Defaults to the current app package\n   * if omitted.\n   */\n  callerId?: string;\n  /** Optional Custom Store Listing ID. */\n  csl_id?: string;\n  /** Whether to request the Play overlay. Defaults to true. */\n  overlay?: boolean;\n  /** If true, falls back to full Play Store deep link when overlay unavailable. Defaults to true. */\n  fallback?: boolean;\n}"
    },
    {
