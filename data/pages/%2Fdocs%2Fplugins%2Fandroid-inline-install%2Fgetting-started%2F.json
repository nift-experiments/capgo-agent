        "line": 81,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 81,
            "column": 1
          },
          "text": "Result of starting an inline install flow."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 82,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface StartInlineInstallResult {\n  /** True when the inline install intent has been started. */\n  started: boolean;\n  /** True if a fallback deep link was used instead of inline overlay. */\n  fallbackUsed?: boolean;\n}"
    },
