    {
      "type": "heading",
      "location": {
        "line": 48,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 48,
            "column": 4
          },
          "text": "A word about using the Firebase SDK on Capacitor"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 50,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 1
          },
          "text": "When using the Firebase JS SDK on Capacitor, you need to be aware that when using the authentication methods, you need to initialize the Firebase Auth instance a bit differently."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 52,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 1
          },
          "text": "On the web platform, you would use the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 52,
            "column": 40
          },
          "text": "getAuth"
        },
        {
          "type": "text",
          "location": {
            "line": 52,
            "column": 49
          },
          "text": " function to get the Firebase Auth instance."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 54,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { initializeApp } from 'firebase/app';\nimport { getAuth } from 'firebase/auth';\n\nconst app = initializeApp(firebaseConfig);\nconst auth = getAuth(app);"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 62,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 1
          },
          "text": "Unfortunately, on Capacitor, this does not work and causes Firebase auth to hang. As stated in "
        },
        {
          "type": "link",
          "location": {
            "line": 62,
            "column": 96
          },
          "url": "https://harryherskowitz.com/2021/08/23/firebase-capacitor.html",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 62,
                "column": 97
              },
              "text": "this blog post"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 176
          },
          "text": ", you need to use the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 62,
            "column": 198
          },
          "text": "initializeAuth"
        },
        {
          "type": "text",
          "location": {
            "line": 62,
            "column": 214
          },
          "text": " function to initialize the Firebase Auth instance.\nThis looks like this:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 65,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { initializeApp } from 'firebase/app';\nimport { initializeAuth } from 'firebase/auth';\n\nconst app = initializeApp(firebaseConfig);\n\nfunction whichAuth() {\n  let auth;\n  if (Capacitor.isNativePlatform()) {\n    auth = initializeAuth(app, {\n      persistence: indexedDBLocalPersistence,\n    });\n  } else {\n    auth = getAuth(app);\n  }\n  return auth;\n}\n\nexport const auth = whichAuth();"
    },
