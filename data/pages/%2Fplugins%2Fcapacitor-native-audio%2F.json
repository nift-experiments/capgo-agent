      "lang": "typescript",
      "meta": null,
      "text": "import { NativeAudio } from '@capgo/capacitor-native-audio';\n\nawait NativeAudio.configure({\n  focus: false,\n  background: false,\n  ignoreSilent: false,\n  showNotification: false,\n  backgroundPlayback: false,\n});"
