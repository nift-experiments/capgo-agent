              "type": "paragraph",
              "location": {
                "line": 87,
                "column": 4
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 87,
                    "column": 4
                  },
                  "text": "Remove the "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 87,
                    "column": 15
                  },
                  "text": "js/capacitor-welcome.js"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 87,
                    "column": 40
                  },
                  "text": " import. Your "
                },
                {
                  "type": "inlineCode",
                  "location": {
                    "line": 87,
                    "column": 54
                  },
                  "text": "index.html"
                },
                {
                  "type": "text",
                  "location": {
                    "line": 87,
                    "column": 66
                  },
                  "text": " is now ready."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 89,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 89,
            "column": 4
          },
          "text": "vite.config.js"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 91,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 91,
            "column": 1
          },
          "text": "To bundle our Node.js modules with "
        },
        {
          "type": "link",
          "location": {
            "line": 91,
            "column": 36
          },
          "url": "https://vitejs.dev/",
          "title": null,
          "blocks": [
            {
              "type": "strong",
              "location": {
                "line": 91,
                "column": 37
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 91,
                    "column": 39
                  },
                  "text": "Vite"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 91,
            "column": 67
          },
          "text": ", we need a config file specifying the output destination for our bundled script. The following configuration will take the file "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 91,
            "column": 196
          },
          "text": "src/index.js"
        },
        {
          "type": "text",
          "location": {
            "line": 91,
            "column": 210
          },
          "text": " and bundle it for production as "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 91,
            "column": 243
          },
          "text": "www/js/main.js"
        },
        {
          "type": "text",
          "location": {
            "line": 91,
            "column": 259
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 93,
        "column": 1
      },
      "lang": "javascript",
      "meta": null,
      "text": "import { defineConfig } from 'vite';\nimport path from 'node:path';\n\nexport default defineConfig({\n  build: {\n    outDir: path.resolve(__dirname, 'www'),\n    rollupOptions: {\n      input: './src/index.js',\n      output: {\n        format: 'es',\n        file: path.resolve(__dirname, 'www/js/main.js')\n      }\n    }\n  }\n});"
    },
    {
      "type": "heading",
      "location": {
        "line": 111,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 111,
            "column": 4
          },
          "text": "capacitor.config.json"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 113,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 113,
            "column": 1
          },
          "text": "In the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 113,
            "column": 8
          },
          "text": "capacitor.config.json"
        },
        {
          "type": "text",
          "location": {
            "line": 113,
            "column": 31
          },
          "text": " file, locate the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 113,
            "column": 49
          },
          "text": "\"bundledWebRuntime\": true"
        },
        {
          "type": "text",
          "location": {
            "line": 113,
            "column": 76
          },
          "text": " property and change it to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 113,
            "column": 103
          },
          "text": "false"
        },
        {
          "type": "text",
          "location": {
            "line": 113,
            "column": 110
          },
          "text": ". This adjustment ensures that Capacitor does not bundle the files, allowing us to use Vite for that purpose instead."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 115,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 115,
            "column": 1
          },
          "text": "With these changes, your Capacitor application's basic setup is complete, and you're ready to start developing your app with pure JavaScript."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 117,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 117,
            "column": 4
          },
          "text": "‣ Developing Your App"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 119,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 119,
            "column": 1
          },
          "text": "Now that the groundwork is laid, you can begin writing your application logic in the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 119,
            "column": 86
          },
          "text": "src/index.js"
        },
        {
          "type": "text",
          "location": {
            "line": 119,
            "column": 100
          },
          "text": " file. Here, you can import any necessary Node.js modules, define your app's functionality, and interact with Capacitor's native plugins."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 121,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 121,
            "column": 1
          },
          "text": "Remember to run Vite's build command to bundle your JavaScript files whenever you make changes:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 123,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "vite build"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 127,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 127,
            "column": 1
          },
          "text": "This command will generate the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 127,
            "column": 32
          },
          "text": "main.js"
        },
        {
          "type": "text",
          "location": {
            "line": 127,
            "column": 41
          },
          "text": " file in your "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 127,
            "column": 55
          },
          "text": "www/js"
        },
        {
          "type": "text",
          "location": {
            "line": 127,
            "column": 63
          },
          "text": " directory, which your "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 127,
            "column": 86
          },
          "text": "index.html"
        },
        {
          "type": "text",
          "location": {
            "line": 127,
            "column": 98
          },
          "text": " file will reference."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 129,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 129,
            "column": 4
          },
          "text": "‣ Testing and Debugging"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 131,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 131,
            "column": 1
          },
          "text": "Capacitor provides a convenient way to test your application on various platforms. Use the following commands to open your app in the respective platform's development environment:"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 133,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 133,
            "column": 1
          },
          "text": "For Android:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 134,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx cap add android\nnpx cap open android"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 139,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 139,
            "column": 1
          },
          "text": "For iOS (macOS only):"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 140,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx cap add ios\nnpx cap open ios"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 145,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 145,
            "column": 1
          },
          "text": "For Web/PWA:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 146,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx cap serve"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 150,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 150,
            "column": 1
          },
          "text": "These commands will allow you to run your application in Android Studio, Xcode, or your web browser, where you can test and debug as needed."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 152,
        "column": 1
      },
      "depth": 2,
      "blocks": [
