        {
          "type": "text",
          "location": {
            "line": 1,
            "column": 3
          },
          "text": "Using @capgo/capacitor-transitions"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 3,
        "column": 1
      },
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "@capgo/capacitor-transitions"
        },
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 31
          },
          "text": " adds Ionic-style route transitions to Capacitor apps without adopting Ionic UI. It runs in the web layer, keeps your existing router, and can auto-enable an iOS edge swipe-back gesture only inside native Capacitor iOS."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 5,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 7,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-transitions"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 11,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 1
          },
          "text": "There is no native sync step because the package does not add native plugin code."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 13,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 4
          },
          "text": "Register the elements"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 15,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import '@capgo/capacitor-transitions';"
    },
    {
      "type": "heading",
      "location": {
        "line": 19,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 4
          },
          "text": "Wrap your pages"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 21,
        "column": 1
      },
      "lang": "html",
      "meta": null,
      "text": "<cap-router-outlet platform=\"auto\" swipe-gesture=\"auto\">\n  <cap-page>\n    <cap-header slot=\"header\">\n      <h1>Inbox</h1>\n    </cap-header>\n\n    <cap-content slot=\"content\">\n      <button>Open message</button>\n    </cap-content>\n\n    <cap-footer slot=\"footer\">\n      <nav>Tabs</nav>\n    </cap-footer>\n  </cap-page>\n</cap-router-outlet>"
    },
    {
      "type": "heading",
      "location": {
        "line": 39,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 39,
            "column": 4
          },
          "text": "Connect it to a router"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 41,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 41,
            "column": 1
          },
          "text": "Set the transition direction before your normal route update:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 43,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { setDirection } from '@capgo/capacitor-transitions/react';\n\nsetDirection('forward');\nrouter.push('/message/42');\n\nsetDirection('back');\nrouter.back();"
    },
    {
      "type": "heading",
      "location": {
        "line": 53,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 4
          },
          "text": "React example"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 55,
        "column": 1
      },
      "lang": "tsx",
      "meta": null,
      "text": "import { useEffect, useRef } from 'react';\nimport { useNavigate } from 'react-router-dom';\nimport { initTransitions, setDirection, setupPage, setupRouterOutlet } from '@capgo/capacitor-transitions/react';\nimport '@capgo/capacitor-transitions';\n\ninitTransitions({ platform: 'auto' });\n\nexport function AppShell() {\n  const outletRef = useRef<HTMLElement>(null);\n\n  useEffect(() => {\n    if (!outletRef.current) return;\n    setupRouterOutlet(outletRef.current, { platform: 'auto', swipeGesture: 'auto' });\n  }, []);\n\n  return <cap-router-outlet ref={outletRef}>{/* routes */}</cap-router-outlet>;\n}\n\nexport function InboxPage() {\n  const navigate = useNavigate();\n  const pageRef = useRef<HTMLElement>(null);\n\n  useEffect(() => {\n    if (!pageRef.current) return;\n    return setupPage(pageRef.current);\n  }, []);\n\n  return (\n    <cap-page ref={pageRef}>\n      <cap-header slot=\"header\">\n        <h1>Inbox</h1>\n      </cap-header>\n      <cap-content slot=\"content\">\n        <button\n          onClick={() => {\n            setDirection('forward');\n            navigate('/message/42');\n          }}\n        >\n          Open message\n        </button>\n      </cap-content>\n    </cap-page>\n  );\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 103,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 103,
            "column": 1
          },
          "text": "The React subpath includes JSX typings for the custom elements. If TypeScript still reports that "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 103,
            "column": 98
          },
          "text": "cap-router-outlet"
        },
        {
          "type": "text",
          "location": {
            "line": 103,
            "column": 117
          },
          "text": " does not exist on "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 103,
            "column": 136
          },
          "text": "JSX.IntrinsicElements"
        },
        {
          "type": "text",
          "location": {
            "line": 103,
            "column": 159
          },
          "text": ", add this file:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 105,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "// src/capgo-transitions.d.ts\nimport '@capgo/capacitor-transitions/react';"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 110,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 110,
            "column": 1
          },
          "text": "For Vite, Create React App, and most webpack React apps, keeping that file under "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 110,
            "column": 82
          },
          "text": "src/"
        },
        {
          "type": "text",
          "location": {
            "line": 110,
            "column": 88
          },
          "text": " is enough. For Next.js or custom TypeScript setups, make sure it is included by "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 110,
            "column": 169
          },
          "text": "tsconfig.json"
        },
        {
          "type": "text",
          "location": {
            "line": 110,
            "column": 184
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 112,
        "column": 1
      },
      "lang": "json",
      "meta": null,
      "text": "{\n  \"include\": [\"src\", \"src/capgo-transitions.d.ts\"]\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 118,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 118,
            "column": 4
          },
          "text": "Enable swipe back"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 120,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 120,
            "column": 1
          },
          "text": "Use "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 120,
            "column": 5
          },
          "text": "swipe-gesture=\"auto\""
        },
        {
          "type": "text",
          "location": {
            "line": 120,
            "column": 27
          },
          "text": " to enable the gesture only when Capacitor reports a native iOS runtime:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 122,
        "column": 1
      },
      "lang": "html",
      "meta": null,
      "text": "<cap-router-outlet swipe-gesture=\"auto\"></cap-router-outlet>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 126,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 126,
            "column": 1
          },
          "text": "You can also force it from JavaScript:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 128,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "const outlet = document.querySelector('cap-router-outlet');\n\noutlet?.setSwipeGesture(true);\noutlet?.setSwipeGesture(false);\noutlet?.setSwipeGesture('auto');"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 136,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 136,
            "column": 1
          },
          "text": "The gesture follows the finger during the transition, then completes or cancels when the user releases. Add "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 136,
            "column": 109
          },
          "text": "data-swipe-gesture-ignore"
        },
        {
          "type": "text",
          "location": {
            "line": 136,
            "column": 136
          },
          "text": " on buttons, sliders, or drawers that should not start the edge gesture."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 138,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 138,
            "column": 4
          },
          "text": "Use with native navigation"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 140,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 140,
            "column": 1
          },
          "text": "Install "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 140,
            "column": 9
          },
          "text": "@capgo/native-navigation"
        },
        {
          "type": "text",
          "location": {
            "line": 140,
            "column": 35
          },
          "text": " when the native layer should own the navbar or tabbar:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 142,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/native-navigation\nnpx cap sync"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 147,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 147,
            "column": 1
          },
          "text": "Configure native chrome, then keep transitions focused on the WebView pages:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 149,
        "column": 1
      },
      "lang": "ts",
      "meta": null,
      "text": "import { NativeNavigation } from '@capgo/native-navigation';\nimport { setDirection } from '@capgo/capacitor-transitions/react';\nimport { router } from './router';\n\nawait NativeNavigation.configure({\n  contentInsetMode: 'css',\n});\n\nawait NativeNavigation.setNavbar({\n  title: 'Inbox',\n  backButton: { visible: false },\n});\n\nawait NativeNavigation.addListener('navbarBack', () => {\n  setDirection('back');\n  router.back();\n});\n\nasync function openMessage(id: string) {\n  setDirection('forward');\n  router.push(`/message/${id}`);\n\n  await NativeNavigation.setNavbar({\n    title: 'Message',\n    backButton: { visible: true, title: 'Inbox' },\n  });\n}"
    },
