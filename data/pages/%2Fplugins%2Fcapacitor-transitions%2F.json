      "type": "code",
      "location": {
        "line": 181,
        "column": 1
      },
      "lang": "html",
      "meta": null,
      "text": "<cap-router-outlet platform=\"auto\" swipe-gesture=\"auto\">\n  <cap-page>\n    <cap-content slot=\"content\" fullscreen>\n      <main class=\"native-page\">Inbox content</main>\n    </cap-content>\n  </cap-page>\n</cap-router-outlet>"
    },
    {
      "type": "code",
      "location": {
        "line": 191,
        "column": 1
      },
      "lang": "css",
      "meta": null,
      "text": ".native-page {\n  padding-top: var(--cap-native-navigation-top);\n  padding-bottom: var(--cap-native-navigation-bottom);\n}"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 198,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 198,
            "column": 1
          },
          "text": "Do not duplicate the native navbar as a moving web header. "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 198,
            "column": 60
          },
          "text": "@capgo/native-navigation"
        },
        {
          "type": "text",
          "location": {
            "line": 198,
            "column": 86
          },
          "text": " keeps the bar native; "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 198,
            "column": 109
          },
          "text": "@capgo/capacitor-transitions"
        },
        {
          "type": "text",
          "location": {
            "line": 198,
            "column": 139
          },
          "text": " animates the page content underneath it."
        }
      ]
