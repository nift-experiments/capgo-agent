      },
      "depth": 1,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 1,
            "column": 3
          },
          "text": "Using @capgo/capacitor-persistent-uuid"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 3,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 3,
            "column": 1
          },
          "text": "Generate one persistent app-scoped UUID for Capacitor and keep it stable across reinstall and update flows where normal app storage is removed."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 5,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 5,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 7,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npm install @capgo/capacitor-persistent-uuid\nnpx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 12,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 4
          },
          "text": "What This Plugin Exposes"
        }
      ]
    },
    {
      "type": "list",
      "location": {
        "line": 14,
        "column": 1
      },
      "ordered": false,
      "start": null,
      "spread": false,
      "blocks": [
        {
          "type": "listItem",
          "location": {
            "line": 14,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 14,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 14,
                    "column": 3
                  },
                  "text": "getId - Read the stored UUID, creating one if none exists for the selected scope."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 15,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 15,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 15,
                    "column": 3
                  },
                  "text": "resetId - Rotate the stored UUID for logout, privacy reset, or test cleanup flows."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 16,
            "column": 1
          },
          "spread": false,
          "checked": null,
          "blocks": [
            {
              "type": "paragraph",
              "location": {
                "line": 16,
                "column": 3
              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 16,
                    "column": 3
                  },
                  "text": "scope - Optional namespace for apps whose debug and production package identifiers differ."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 18,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 18,
            "column": 4
          },
          "text": "Example Usage"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 20,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { PersistentUuid } from '@capgo/capacitor-persistent-uuid';\n\nconst { id, created, scope } = await PersistentUuid.getId();\n\nconsole.log(id);\nconsole.log(created);\nconsole.log(scope);"
    },
    {
      "type": "heading",
      "location": {
        "line": 30,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 30,
            "column": 4
          },
          "text": "Share One UUID Across Build Variants"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 32,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const result = await PersistentUuid.getId({\n  scope: 'com.example.app',\n});\n\nconsole.log(result.id);"
    },
    {
      "type": "heading",
      "location": {
        "line": 40,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 40,
            "column": 4
          },
          "text": "Reset The Identifier"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 42,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "const replacement = await PersistentUuid.resetId();\nconsole.log(replacement.id);"
    },
    {
      "type": "heading",
      "location": {
        "line": 47,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 4
          },
          "text": "Platform Notes"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 49,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 49,
            "column": 1
          },
          "text": "Android stores the UUID in AccountManager so it can survive Android Studio reinstall cycles and debug vs Play signing differences when the package name or custom scope is stable. iOS stores the UUID in Keychain and keeps it through app and iOS updates while Keychain access remains compatible. Web uses localStorage as a development fallback."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "This plugin does not expose a hardware ID and does not survive factory reset, manual account removal, Keychain clearing, browser storage clearing, or resetId."
        }
      ]
    },
    {
