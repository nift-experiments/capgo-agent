          "type": "text",
          "location": {
            "line": 2,
            "column": 4
          },
          "text": "Install"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "You can use our AI-Assisted Setup to install the plugin. Add the Capgo skills to your AI tool using the following command:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "npx skills add https://github.com/Cap-go/capgo-skills --skill capacitor-plugins"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 10,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 1
          },
          "text": "Then use the following prompt:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 12,
        "column": 1
      },
      "lang": "text",
      "meta": null,
      "text": "Use the `capacitor-plugins` skill from `Cap-go/capgo-skills` to install the `@capgo/capacitor-persistent-account` plugin in my project."
    },
    {
      "type": "paragraph",
      "location": {
        "line": 16,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 16,
            "column": 1
          },
          "text": "If you prefer Manual Setup, install the plugin by running the following commands and follow the platform-specific instructions below:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 18,
        "column": 1
      },
      "lang": "bash",
      "meta": null,
      "text": "bun add @capgo/capacitor-persistent-account\nbunx cap sync"
    },
    {
      "type": "heading",
      "location": {
        "line": 23,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 4
          },
          "text": "Import"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorPersistentAccount } from '@capgo/capacitor-persistent-account';"
    },
    {
      "type": "heading",
      "location": {
        "line": 29,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 29,
            "column": 4
          },
          "text": "API Overview"
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 31,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 31,
            "column": 5
          },
          "text": "readAccount"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 33,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 33,
            "column": 1
          },
          "text": "Reads the stored account data from persistent storage."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 35,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 35,
            "column": 1
          },
          "text": "Retrieves account data that was previously saved using saveAccount(). The data\npersists across app sessions and survives app reinstallation on supported platforms."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 38,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorPersistentAccount } from '@capgo/capacitor-persistent-account';\n\nconst result = await CapacitorPersistentAccount.readAccount();\nif (result.data) {\n  console.log('Account data:', result.data);\n} else {\n  console.log('No account data found');\n}"
    },
    {
      "type": "heading",
      "location": {
        "line": 49,
        "column": 1
      },
      "depth": 3,
      "blocks": [
        {
          "type": "inlineCode",
          "location": {
            "line": 49,
            "column": 5
          },
          "text": "saveAccount"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 51,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 51,
            "column": 1
          },
          "text": "Saves account data to persistent storage."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 53,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 53,
            "column": 1
          },
          "text": "Stores the provided account data using platform-specific secure storage mechanisms.\nThe data will persist across app sessions and survive app reinstallation.\nAny existing account data will be overwritten."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 57,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorPersistentAccount } from '@capgo/capacitor-persistent-account';\n\nawait CapacitorPersistentAccount.saveAccount({\n  data: {\n    userId: '12345',\n    username: 'john.doe',\n    email: 'john@example.com'\n  }\n});"
    },
