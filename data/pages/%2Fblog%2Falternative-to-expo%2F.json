              },
              "text": "EAS vs Capgo"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 84
          },
          "text": ". This post covers the live-update path and the current Capgo stack around it."
        }
      ]
    },
