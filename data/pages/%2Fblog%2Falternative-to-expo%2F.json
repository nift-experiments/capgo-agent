  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "EAS Update lets Expo and React Native teams ship JavaScript fixes without a store review. Capgo does that job for Capacitor apps: you keep the web UI, wrap it with Capacitor, and push web-bundle updates through the Capgo updater plugin."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Capgo does not update Expo apps. If the app is React Native, stay on "
        },
        {
          "type": "link",
          "location": {
            "line": 4,
            "column": 70
          },
          "url": "https://docs.expo.dev/eas-update/introduction/",
          "title": null,
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 4,
                "column": 71
              },
              "text": "EAS Update"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 130
          },
          "text": ". If the app is a web codebase you want on iOS and Android, Capgo is the Expo alternative."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 6,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 1
          },
          "text": "The full service-by-service comparison lives on "
        },
        {
          "type": "link",
          "location": {
            "line": 6,
            "column": 49
          },
          "url": "/alternatives/expo/",
          "title": null,
