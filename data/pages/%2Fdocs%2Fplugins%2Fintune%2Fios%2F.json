    },
    {
      "type": "paragraph",
      "location": {
        "line": 8,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 1
          },
          "text": "Ionic's Intune docs currently note that apps built with Xcode 26 must use Intune iOS SDK "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 8,
            "column": 90
          },
          "text": "21.1.0+"
        },
        {
          "type": "text",
          "location": {
            "line": 8,
            "column": 99
          },
          "text": " starting on January 19, 2026. This plugin is already on that newer SDK line."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 10,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 10,
            "column": 4
          },
          "text": "1. Add Intune and MSAL settings to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 10,
            "column": 39
          },
          "text": "Info.plist"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 12,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 1
          },
          "text": "Add an "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 12,
            "column": 8
          },
          "text": "IntuneMAMSettings"
        },
        {
          "type": "text",
          "location": {
            "line": 12,
            "column": 27
          },
          "text": " dictionary:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 14,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>IntuneMAMSettings</key>\n<dict>\n  <key>ADALClientId</key>\n  <string>YOUR_CLIENT_ID</string>\n  <key>ADALRedirectUri</key>\n  <string>msauth.com.example.app://auth</string>\n  <key>ADALAuthority</key>\n  <string>https://login.microsoftonline.com/common</string>\n</dict>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 26,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 26,
            "column": 1
          },
          "text": "The plugin reads:"
        }
      ]
    },
