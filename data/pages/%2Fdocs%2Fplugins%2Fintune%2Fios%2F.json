    {
      "type": "code",
      "location": {
        "line": 35,
        "column": 1
      },
      "lang": "swift",
      "meta": null,
      "text": "import MSAL\n\nfunc application(\n  _ app: UIApplication,\n  open url: URL,\n  options: [UIApplication.OpenURLOptionsKey: Any] = [:]\n) -> Bool {\n  return MSALPublicClientApplication.handleMSALResponse(\n    url,\n    sourceApplication: options[.sourceApplication] as? String\n  )\n}"
    },
