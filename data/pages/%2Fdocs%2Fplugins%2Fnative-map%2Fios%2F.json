{
  "version": 1,
  "route": "/docs/plugins/native-map/ios/",
  "source": "corpus/source/apps/docs/src/content/docs/docs/plugins/native-map/ios.mdx",
  "sourceSha256": "9677d3f424c609114728d84ba1fc3206280b179f6aaec76f91642dc80f3bbeb5",
  "metadata": {
    "title": "iOS setup",
    "description": "MapKit and location permission setup for @capgo/capacitor-native-map.",
    "sidebar": {
      "order": 3
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 2,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 1
          },
          "text": "iOS uses "
        },
        {
          "type": "strong",
          "location": {
            "line": 2,
            "column": 10
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 2,
                "column": 12
              },
              "text": "Apple MapKit"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 26
          },
          "text": ". You do "
        },
        {
          "type": "strong",
          "location": {
            "line": 2,
            "column": 35
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 2,
                "column": 37
              },
              "text": "not"
            }
          ]
        },
        {
          "type": "text",
          "location": {
            "line": 2,
            "column": 42
          },
          "text": " need a Google Maps API key on iOS."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "If you call "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 13
          },
          "text": "enableCurrentLocation"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 36
          },
          "text": ", add a location usage string to "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 4,
            "column": 69
          },
          "text": "ios/App/App/Info.plist"
        },
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 93
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 6,
        "column": 1
      },
      "lang": "xml",
      "meta": null,
      "text": "<key>NSLocationWhenInUseUsageDescription</key>\n<string>We use your location to show you on the map.</string>"
    },
    {
      "type": "paragraph",
      "location": {
        "line": 11,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 1
          },
          "text": "The plugin requests location with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 11,
            "column": 35
          },
          "text": "keepAlive"
        },
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 46
          },
          "text": " so "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 11,
            "column": 50
          },
          "text": "enableCurrentLocation"
        },
        {
          "type": "text",
          "location": {
            "line": 11,
            "column": 73
          },
          "text": " can resolve reliably after permission is granted."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 13,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 13,
            "column": 4
          },
          "text": "Map behind the WebView"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 15,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 1
          },
          "text": "The native "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 15,
            "column": 12
          },
          "text": "MKMapView"
        },
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 23
          },
          "text": " mounts into the Capacitor WKWebView hierarchy and tracks the bound DOM element through "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 15,
            "column": 111
          },
          "text": "onResize"
        },
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 121
          },
          "text": " and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 15,
            "column": 126
          },
          "text": "onDisplay"
        },
        {
          "type": "text",
          "location": {
            "line": 15,
            "column": 137
          },
          "text": ". When Ionic pages re-enter, call paths in the plugin re-mount the map if WebKit rebuilt scroll views."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 17,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 17,
            "column": 1
          },
          "text": "Use a transparent WebView or page background where the map should show through HTML layers above the map container."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 19,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 1
          },
          "text": "In "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 19,
            "column": 4
          },
          "text": "toBack"
        },
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 12
          },
          "text": " mode, put "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 19,
            "column": 23
          },
          "text": "data-map-overlay"
        },
        {
          "type": "text",
          "location": {
            "line": 19,
            "column": 41
          },
          "text": " on HUD wrappers so the README overlay CSS enables taps. The native touch router sends gestures to the map when the hit target is transparent and not under an interactive element."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 21,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 21,
            "column": 4
          },
          "text": "iOS-only plugin methods"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 23,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 1
          },
          "text": "The native iOS bridge also exposes "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 23,
            "column": 36
          },
          "text": "takeSnapshot"
        },
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 50
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 23,
            "column": 52
          },
          "text": "searchAutocomplete"
        },
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 72
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 23,
            "column": 74
          },
          "text": "searchPlaces"
        },
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 88
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 23,
            "column": 90
          },
          "text": "searchResolve"
        },
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 105
          },
          "text": ", "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 23,
            "column": 107
          },
          "text": "geocode"
        },
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 116
          },
          "text": ", and "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 23,
            "column": 122
          },
          "text": "reverseGeocode"
        },
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 138
          },
          "text": ". These are not on the "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 23,
            "column": 161
          },
          "text": "NativeMap"
        },
        {
          "type": "text",
          "location": {
            "line": 23,
            "column": 172
          },
          "text": " class wrapper yet. Call them on the low-level plugin handle when you need MapKit search or geocoding on iOS:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 25,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { registerPlugin } from '@capacitor/core';\n\ntype NativeMapBridge = {\n  takeSnapshot(options: { id: string }): Promise<{ image: string }>;\n  geocode(options: { address: string }): Promise<Record<string, unknown>>;\n};\n\nconst NativeMapBridge = registerPlugin<NativeMapBridge>('NativeMap');"
    }
  ]
}
