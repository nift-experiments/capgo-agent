            "column": 62
          },
          "text": "partialResults"
        },
        {
          "type": "text",
          "location": {
            "line": 98,
            "column": 78
          },
          "text": " listener with "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 98,
            "column": 93
          },
          "text": "forced: true"
        },
        {
          "type": "text",
          "location": {
            "line": 98,
            "column": 107
          },
          "text": "."
        }
      ]
    },
