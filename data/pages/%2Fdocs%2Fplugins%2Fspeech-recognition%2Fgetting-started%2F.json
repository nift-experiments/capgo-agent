            "column": 6
          },
          "text": "partialResults"
        },
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 22
          },
          "text": " is "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 67,
            "column": 26
          },
          "text": "true"
        },
        {
          "type": "text",
          "location": {
            "line": 67,
            "column": 32
          },
          "text": ", the returned promise resolves immediately and updates are\nstreamed through the "
        },
