      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 95,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 95,
            "column": 1
          },
          "text": "On Android, this first tries a normal stop and then falls back to destroy/recreate after "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 95,
            "column": 90
          },
          "text": "timeout"
        },
        {
          "type": "text",
          "location": {
            "line": 95,
            "column": 99
          },
          "text": ".\nOn iOS, the current session is stopped immediately."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 98,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 98,
            "column": 1
          },
          "text": "If a partial transcript is cached, it is emitted through the "
