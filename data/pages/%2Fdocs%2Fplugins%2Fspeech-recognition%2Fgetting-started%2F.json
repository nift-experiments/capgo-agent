      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 44,
            "column": 1
          },
          "text": "Checks whether the platform's newer on-device recognition path is available for the selected locale."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 46,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 1
          },
          "text": "This is the capability check you should use before enabling "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 46,
            "column": 61
          },
          "text": "useOnDeviceRecognition"
        },
        {
          "type": "text",
          "location": {
            "line": 46,
            "column": 85
          },
          "text": ".\nA "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 47,
            "column": 3
          },
          "text": "true"
        },
        {
          "type": "text",
          "location": {
            "line": 47,
            "column": 9
          },
          "text": " result means the current device, OS version, and locale can use the newer\non-device path for that platform."
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 50,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 1
          },
          "text": "Returns "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 50,
            "column": 9
          },
          "text": "false"
        },
        {
          "type": "text",
          "location": {
            "line": 50,
            "column": 16
          },
          "text": " when the device only supports the legacy recognizer path."
        }
      ]
    },
    {
