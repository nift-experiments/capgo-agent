        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 70,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 70,
            "column": 1
          },
          "text": "Checks if the flashlight is currently turned on or off."
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 72,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorFlash } from '@capgo/capacitor-flash';\n\nconst { value } = await CapacitorFlash.isSwitchedOn();\nconsole.log('Flashlight is on:', value);"
    },
