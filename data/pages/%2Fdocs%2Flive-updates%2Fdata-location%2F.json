  "metadata": {
    "title": "Data Location",
    "description": "Configure Capgo Cloud and the updater plugin to keep live update data in Europe.",
    "sidebar": {
      "order": 8
    }
  },
  "blocks": [
    {
      "type": "paragraph",
      "location": {
        "line": 4,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 4,
            "column": 1
          },
          "text": "Capgo Cloud can keep the live update data generated by the updater plugin in Europe. For apps with EU data residency requirements, configure the plugin to use the EU Capgo Cloud host for update checks, statistics, and channel self-assignment."
        }
      ]
    },
    {
      "type": "heading",
      "location": {
        "line": 6,
        "column": 1
      },
      "depth": 2,
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 6,
            "column": 4
          },
          "text": "What the EU host controls"
        }
      ]
    },
    {
