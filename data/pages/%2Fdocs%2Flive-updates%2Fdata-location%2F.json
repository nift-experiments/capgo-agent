        "line": 56,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 56,
            "column": 1
          },
          "text": "The Electron updater uses the same Capgo Cloud endpoint names:"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 58,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { ElectronUpdater } from '@capgo/electron-updater';\n\nconst updater = new ElectronUpdater({\n  appId: 'com.example.app',\n  updateUrl: 'https://plugin.eu.capgo.app/updates',\n  statsUrl: 'https://plugin.eu.capgo.app/stats',\n  channelUrl: 'https://plugin.eu.capgo.app/channel_self',\n});"
    },
