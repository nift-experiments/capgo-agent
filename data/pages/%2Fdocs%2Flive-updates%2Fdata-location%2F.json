              },
              "blocks": [
                {
                  "type": "text",
                  "location": {
                    "line": 72,
                    "column": 3
                  },
                  "text": "It does not rewrite historical plugin requests that were already sent to the default global host."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 73,
