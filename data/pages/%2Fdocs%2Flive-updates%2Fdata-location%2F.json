                {
                  "type": "text",
                  "location": {
                    "line": 71,
                    "column": 3
                  },
                  "text": "The EU host applies to future plugin requests after users install a build with the new configuration."
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "location": {
            "line": 72,
            "column": 1
