        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 1
          },
          "text": "Set the URLs in "
        },
        {
          "type": "inlineCode",
          "location": {
            "line": 28,
            "column": 17
          },
          "text": "capacitor.config.ts"
        },
        {
          "type": "text",
          "location": {
            "line": 28,
            "column": 38
          },
          "text": ":"
        }
      ]
    },
    {
      "type": "code",
      "location": {
        "line": 30,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import type { CapacitorConfig } from '@capacitor/cli';\n\nconst config: CapacitorConfig = {\n  appId: 'com.example.app',\n  appName: 'My App',\n  webDir: 'dist',\n  plugins: {\n    CapacitorUpdater: {\n      autoUpdate: 'atBackground',\n      updateUrl: 'https://plugin.eu.capgo.app/updates',\n      statsUrl: 'https://plugin.eu.capgo.app/stats',\n      channelUrl: 'https://plugin.eu.capgo.app/channel_self',\n    },\n  },\n};\n\nexport default config;"
    },
    {
      "type": "component",
      "name": "Aside",
      "props": {
        "type": "note"
      },
      "blocks": [
        {
          "type": "paragraph",
          "location": {
            "line": 51,
            "column": 1
          },
          "blocks": [
            {
              "type": "text",
              "location": {
                "line": 51,
                "column": 1
              },
              "text": "For iOS and Android production apps, changes to "
            },
            {
              "type": "inlineCode",
              "location": {
                "line": 51,
                "column": 49
              },
              "text": "capacitor.config.ts"
            },
            {
              "type": "text",
              "location": {
                "line": 51,
                "column": 70
              },
              "text": " are applied through the native binary. Sync the native projects and release a new app version so existing installs start using the EU endpoints."
            }
          ]
        }
      ],
      "location": {
        "line": 50,
        "column": 1
      }
    },
    {
      "type": "heading",
