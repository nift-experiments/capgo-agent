    {
      "type": "code",
      "location": {
        "line": 257,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "export interface CallInvite {\n  /** Unique identifier for the incoming call invitation */\n  callSid: string;\n  /** Phone number or client identifier of the caller (may include custom caller name) */\n  from: string;\n  /** Phone number or client identifier being called */\n  to: string;\n  /** Custom parameters passed with the call invitation */\n  customParams: Record<string, string>;\n}"
    },
