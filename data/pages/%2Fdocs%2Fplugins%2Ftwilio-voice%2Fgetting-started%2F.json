    },
    {
      "type": "code",
      "location": {
        "line": 130,
        "column": 1
      },
      "lang": "typescript",
      "meta": null,
      "text": "import { CapacitorTwilioVoice } from '@capgo/capacitor-twilio-voice';\n\nCapacitorTwilioVoice.addListener('callInviteReceived', async (data) => {\n  if (shouldRejectCall(data.from)) {\n    await CapacitorTwilioVoice.rejectCall({\n      callSid: data.callSid\n    });\n  }\n});"
    },
