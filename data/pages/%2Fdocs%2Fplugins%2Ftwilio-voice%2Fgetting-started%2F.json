            "column": 4
          },
          "text": "Source Of Truth"
        }
      ]
    },
    {
      "type": "paragraph",
      "location": {
        "line": 272,
        "column": 1
      },
      "blocks": [
        {
          "type": "text",
          "location": {
            "line": 272,
            "column": 1
          },
          "text": "This page is generated from the plugin's "
        },
