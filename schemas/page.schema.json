{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "route",
    "source",
    "sourceSha256",
    "metadata",
    "blocks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "route": {
      "type": "string",
      "pattern": "^/"
    },
    "source": {
      "type": "string"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ]
      }
    }
  }
}
